+import { describe, expect, it } from 'vitest';
+import { TOPPINGS, ladder } from '../../content/games/pizza';
+import { VOICE_LINES } from '../../content/voice-lines';
+import { BAKE_LINE, askLineId, countLineIds, enoughLineId, retryLineId } from './lines';
+import { allQuestions, levelIndex, roundQuestions } from './questions';
+
+const SEEDS = Array.from({ length: 200 }, (_, i) => i * 7919 + 3);
+
+describe('roundQuestions (Story 3.1)', () => {
+  it('same seed and level → the identical list', () => {
+    for (const seed of SEEDS) expect(roundQuestions(seed, 0)).toEqual(roundQuestions(seed, 0));
+  });
+
+  it.each(ladder.map((l, i) => [i, l] as const))('level %i: the level’s count, counts in range, toppings from the first `toppings`', (i, l) => {
+    const pool = TOPPINGS.slice(0, l.toppings);
+    for (const seed of SEEDS) {
+      const qs = roundQuestions(seed, i);
+      expect(qs).toHaveLength(l.questions);
+      for (const q of qs) {
+        expect(pool).toContain(q.topping);
+        expect(q.count).toBeGreaterThanOrEqual(l.minSlices);
+        expect(q.count).toBeLessThanOrEqual(l.maxSlices);
+      }
+    }
+  });
+
+  it('consecutive questions never repeat both topping and count', () => {
+    for (const seed of SEEDS) {
+      const qs = roundQuestions(seed, 0);
+      for (let i = 1; i < qs.length; i++) expect(qs[i]).not.toEqual(qs[i - 1]);
+    }
+  });
+
+  it('level 0 asks 1–3 slices of sausage or mushroom, and every combination occurs over many seeds', () => {
+    const seen = new Set(SEEDS.flatMap((s) => roundQuestions(s, 0).map((q) => `${q.topping}.${q.count}`)));
+    expect([...seen].sort()).toEqual(['mushroom.1', 'mushroom.2', 'mushroom.3', 'sausage.1', 'sausage.2', 'sausage.3']);
+  });
+
+  it('clamps the level', () => {
+    expect(levelIndex(9)).toBe(ladder.length - 1);
+    expect(levelIndex(-3)).toBe(0);
+    expect(levelIndex(Number.NaN)).toBe(0);
+    expect(roundQuestions(5, 9)).toEqual(roundQuestions(5, ladder.length - 1));
+  });
+});
+
+describe('pizza line ids (Story 3.1)', () => {
+  const ids = new Set<string>(VOICE_LINES.map((l) => l.id));
+
+  it('every reachable (topping, count) of every level has its ask, retry, enough and count lines', () => {
+    for (const l of ladder) {
+      for (const q of allQuestions(l)) {
+        expect(ids.has(askLineId(q)), askLineId(q)).toBe(true);
+        expect(ids.has(retryLineId(q)), retryLineId(q)).toBe(true);
+        expect(ids.has(enoughLineId(q.count)), enoughLineId(q.count)).toBe(true);
+        for (const c of countLineIds(q.count)) expect(ids.has(c), c).toBe(true);
+      }
+    }
+    expect(ids.has(BAKE_LINE)).toBe(true);
+  });
+
+  it('id shapes', () => {
+    expect(askLineId({ topping: 'sausage', count: 3 })).toBe('vo.pizza.ask.sausage.3');
+    expect(retryLineId({ topping: 'mushroom' })).toBe('vo.pizza.retry.mushroom');
+    expect(enoughLineId(2)).toBe('vo.pizza.enough.2');
+    expect(countLineIds(3)).toEqual(['vo.pizza.count.1', 'vo.pizza.count.2', 'vo.pizza.count.3']);
+  });
+});
diff --git a/app/src/games/pizza/questions.ts b/app/src/games/pizza/questions.ts
new file mode 100644
index 0000000..1bc8b37
--- /dev/null
+++ b/app/src/games/pizza/questions.ts
@@ -0,0 +1,58 @@
+// Tiệm pizza questions (Story 3.1), pure: which topping the fox asks for and how many slices. Derived
+// from the round seed and level only, so a round is reproducible (resume, tests). Story 3.2 adds its
+// round-level constraints here.
+import { TOPPINGS, ladder, type PizzaLevel, type ToppingId } from '../../content/games/pizza';
+import { mulberry32, questionSeed, randInt, redrawSeed } from '../../core/rng';
+
+export interface PizzaQuestion {
+  readonly topping: ToppingId;
+  readonly count: number;
+}
+
+export function levelIndex(level: number): number {
+  const l = Math.floor(level);
+  return Number.isFinite(l) ? Math.max(0, Math.min(ladder.length - 1, l)) : 0;
+}
+
+export function levelOf(level: number): PizzaLevel {
+  return ladder[levelIndex(level)]!;
+}
+
+/** The toppings in play at a level: the first `toppings` of TOPPINGS. */
+export function toppingsOf(lvl: PizzaLevel): readonly ToppingId[] {
+  return TOPPINGS.slice(0, lvl.toppings);
+}
+
+/** Every (topping, count) a level can ask, in a fixed order. */
+export function allQuestions(lvl: PizzaLevel): PizzaQuestion[] {
+  const out: PizzaQuestion[] = [];
+  for (const topping of toppingsOf(lvl)) for (let count = lvl.minSlices; count <= lvl.maxSlices; count++) out.push({ topping, count });
+  return out;
+}
+
+const same = (a: PizzaQuestion, b: PizzaQuestion): boolean => a.topping === b.topping && a.count === b.count;
+
+/**
+ * The round's questions: `mulberry32(seed)` draws a topping among the level's toppings and a count in
+ * [minSlices, maxSlices] for each of the level's `questions`. Question i > 0 never repeats question
+ * i − 1 in both topping and count: one salted re-draw among the questions that differ (bounded, no
+ * loop). An out-of-range level is clamped. Deterministic for (seed, level).
+ */
+export function roundQuestions(seed: number, level: number): PizzaQuestion[] {
+  const lvl = levelOf(level);
+  const pool = toppingsOf(lvl);
+  const span = lvl.maxSlices - lvl.minSlices + 1;
+  const rand = mulberry32(seed);
+  const out: PizzaQuestion[] = [];
+  for (let i = 0; i < lvl.questions; i++) {
+    let q: PizzaQuestion = { topping: pool[randInt(rand, pool.length)]!, count: lvl.minSlices + randInt(rand, span) };
+    const prev = out[i - 1];
+    if (prev && same(prev, q)) {
+      const others = allQuestions(lvl).filter((o) => !same(o, prev));
+      const salted = mulberry32(redrawSeed(questionSeed(seed, i)));
+      if (others.length > 0) q = others[randInt(salted, others.length)]!;
+    }
+    out.push(q);
+  }
+  return out;
+}
