+/** What a start lays out: its commands, whether the resume was taken, and the warnings to log. */
+export interface StartPlan {
+  readonly commands: PizzaCommand[];
+  readonly accepted: boolean;
+  readonly warnings: string[];
+}
+
+/**
+ * The first commands of a start. No resume → question 0. A resume → question `resumeAt.questionIndex`
+ * with an empty base (the base already restored the tally; restoring `placed` is Story 3.2). An
+ * out-of-range index → question 0, not accepted, one warning.
+ */
+export function startCommands(round: PizzaRound, resumeAt: { readonly questionIndex: number } | null): StartPlan {
+  if (!resumeAt) return { commands: round.start(), accepted: false, warnings: [] };
+  const i = resumeAt.questionIndex;
+  if (!Number.isInteger(i) || i < 0 || i >= round.questionCount) {
+    return { commands: round.start(), accepted: false, warnings: [`pizza: resume question ${i} is out of range — the round starts at question 1`] };
+  }
+  return { commands: round.begin(i), accepted: true, warnings: [] };
