+// Story 3.3: validateDinoPuzzle (one failing case per rule against the real layout and atlas), the
+// multiatlas reader and the multi-page asset rule.
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { PIECES, SPECIES, screen } from '../../src/content/games/dino-puzzle.ts';
+import type { Point, ScreenLayout } from '../../src/content/layout-types.ts';
+
+type EditableLayout = Omit<ScreenLayout, 'anchors' | 'slots'> & { anchors: Record<string, Point>; slots: Record<string, Point> };
+import { atlasFrames, centredRect, dinoPuzzleLimits, rectGap, validateAssets, validateDinoPuzzle, type AtlasJsonLike } from './rules.ts';
+
+const APP = join(import.meta.dirname, '..', '..');
+const realLayout = (): EditableLayout => JSON.parse(readFileSync(join(APP, 'src', 'content', 'generated', 'dino-puzzle.layout.json'), 'utf8'));
+const realJson = (): unknown => JSON.parse(readFileSync(join(APP, 'public', 'assets', 'atlases', 'dino-puzzle.json'), 'utf8'));
+const realAtlas = (): AtlasJsonLike => atlasFrames(realJson());
+const limits = () => dinoPuzzleLimits(screen, SPECIES, PIECES[3]);
+
+type Frames = Record<string, { spriteSourceSize: { x: number; y: number; w: number; h: number } }>;
+const framesOf = (a: AtlasJsonLike): Frames => a.frames as Frames;
+
+describe('validateDinoPuzzle (Story 3.3)', () => {
+  it('the real layout and atlas pass; layout-only (render without frames) passes too', () => {
+    expect(validateDinoPuzzle(realLayout(), limits(), realAtlas())).toEqual([]);
+    expect(validateDinoPuzzle(realLayout(), limits())).toEqual([]);
+  });
+
+  it('required: a missing slot, start or frame is named', () => {
+    const l = realLayout();
+    delete l.slots['triceratops-tail'];
+    delete l.anchors['stegosaurus-head-neck-start'];
+    const a = realAtlas();
+    delete framesOf(a)['apatosaurus/blink/00'];
+    const p = validateDinoPuzzle(l, limits(), a);
+    expect(p).toContain('slot "triceratops-tail": missing');
+    expect(p).toContain('anchor "stegosaurus-head-neck-start": missing');
+    expect(p).toContain('atlas "dino-puzzle": frame "apatosaurus/blink/00" is missing');
+  });
+
+  it('sizes: a dino off 360 ± 40 and a piece under 90 px are named', () => {
+    const a = realAtlas();
+    framesOf(a)['triceratops/idle/00']!.spriteSourceSize.w = 900;
+    framesOf(a)['stegosaurus-head-neck/idle/00']!.spriteSourceSize = { ...framesOf(a)['stegosaurus-head-neck/idle/00']!.spriteSourceSize, w: 120, h: 150 };
+    const p = validateDinoPuzzle(realLayout(), limits(), a);
+    expect(p.some((m) => m.startsWith('frame "triceratops/idle/00": longest side 450 is not 360 ± 40'))).toBe(true);
+    expect(p.some((m) => m.startsWith('frame "stegosaurus-head-neck/idle/00": longest side 75 is under 90'))).toBe(true);
+  });
+
+  it('slots: a slot more than 3 px from its piece frame’s trimmed centre is named', () => {
