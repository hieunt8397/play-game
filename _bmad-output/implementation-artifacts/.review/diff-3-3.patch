+      const slot = layout.slots[id];
+      const piece = atlas ? designRect(atlas, `${id}/idle/00`, rs) : undefined;
+      if (piece) {
+        const longest = Math.max(piece.w, piece.h);
+        if (longest < input.itemMin) problems.push(`frame "${id}/idle/00": longest side ${round2(longest)} is under ${input.itemMin}`);
+        if (slot) {
