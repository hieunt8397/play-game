+// Story 1.9: the hint ring contrast rule (pure part) and its ring geometry.
+import { describe, expect, it } from 'vitest';
+import { Tokens } from '../../src/core/tokens.ts';
+import { contrastRatio, iceCreamRings, mapRings, outsidePoints, ringContrastProblems, ringLayers, ringReach, RING_SAMPLES, type Rgb } from './hint-contrast.ts';
+
+const PINK: Rgb = [0xff, 0xc6, 0xe4];
+const GRASS: Rgb = [0x5c, 0xb8, 0x4a];
+/** Mid grey: just under 3:1 against white and against the purple line. */
+const GREY: Rgb = [149, 149, 149];
+
+describe('ringContrastProblems', () => {
+  it('contrast ratios follow WCAG', () => {
+    expect(contrastRatio([255, 255, 255], [0, 0, 0])).toBeCloseTo(21);
+    expect(contrastRatio(GREY, ringLayers().core)).toBeLessThan(3);
+    expect(contrastRatio(GREY, ringLayers().line)).toBeLessThan(3);
+  });
+
+  it('a counter or grass pixel passes (against the line or the core)', () => {
+    expect(ringContrastProblems('ice-cream', [{ label: 'slot.scoop-1', pixels: [PINK, GRASS, [255, 255, 255]] }])).toEqual([]);
+  });
+
+  it('a pixel below 3:1 on both layers fails, naming the screen and the slot', () => {
+    const problems = ringContrastProblems('ice-cream', [{ label: 'slot.scoop-2', pixels: [PINK, GREY] }]);
+    expect(problems).toHaveLength(1);
+    expect(problems[0]).toContain('"ice-cream" slot.scoop-2');
+    expect(problems[0]).toContain('1/2');
+  });
+});
+
+describe('ring geometry', () => {
+  it('samples 32 points just outside the halo at the largest pulse', () => {
+    const pts = outsidePoints({ cx: 100, cy: 100, rx: 50, ry: 40 });
+    expect(pts).toHaveLength(RING_SAMPLES);
+    expect(pts[0]!.x).toBeCloseTo(100 + 50 * Tokens.components.hintRing.pulse.to + ringReach());
+  });
+
+  it('ice-cream: one ring per slot.scoop-*, from the frame bounds + pad, or the minSize circle without an atlas', () => {
+    const layout = {
+      v: 1 as const,
+      screenId: 'ice-cream',
+      design: { width: 1024, height: 768 },
+      renderScale: 2,
+      anchors: {},
+      hits: {},
+      paths: {},
+      slots: { 'scoop-1': { x: 152, y: 520 }, 'scoop-2': { x: 332, y: 520 }, 'cone-1': { x: 512, y: 400 } },
+    };
+    const pad = Tokens.ui.hintRingPad;
+    const bare = iceCreamRings(layout, undefined);
+    expect(bare.map((r) => r.label)).toEqual(['slot.scoop-1', 'slot.scoop-2']);
+    expect(bare[0]!.ring).toEqual({ cx: 152, cy: 520, rx: 45 + pad, ry: 45 + pad });
+    const atlas = { frames: { 'scoop-vanilla/idle/00': { spriteSourceSize: { x: 544, y: 908, w: 230, h: 168 } } } };
+    const withAtlas = iceCreamRings(layout, atlas);
+    expect(withAtlas[1]!.ring).toEqual({ cx: 329.5, cy: 496, rx: 57.5 + pad, ry: 42 + pad });
+    expect(withAtlas[0]!.ring.cx).toBeCloseTo(149.5);
+  });
+
+  it('map: the ellipse inscribed in each hit bbox', () => {
+    const rings = mapRings({
+      v: 1,
+      screenId: 'map',
+      design: { width: 1024, height: 768 },
+      renderScale: 2,
+      anchors: {},
+      slots: {},
+      paths: {},
+      hits: { pizza: [{ x: 10, y: 20 }, { x: 110, y: 20 }, { x: 60, y: 80 }] },
+    });
+    expect(rings).toEqual([{ label: 'station pizza', ring: { cx: 60, cy: 50, rx: 50, ry: 30 } }]);
+  });
+});
diff --git a/app/tools/lint/validate-content.ts b/app/tools/lint/validate-content.ts
new file mode 100644
index 0000000..2b51ae4
--- /dev/null
+++ b/app/tools/lint/validate-content.ts
@@ -0,0 +1,156 @@
+// `npm run validate:content` — runs the content validators (AD-12): GameIds, the audio catalog
+// (id grammar, path convention, the file existing under public/) and the voice lines (rules of
+// content/validate.ts with the real filesystem and `lineHash`, including stray files), the screen
+// layouts (src/content/generated/<screen>.layout.json against stations and touch rules) and the image
+// assets (atlases, backgrounds, 8 MiB cap on every file under public/assets) — Story 1.4 — and the
+// station rules (label, name line, invite line of awake stations) — Story 1.5 — and the game content
+// (awake ⇔ GAME_CONTENT, game audio ids exist) — Story 1.7 — and the hint ring contrast on the real
+// plates (tools/lint/hint-contrast.ts) — Story 1.9.
+import { existsSync, readdirSync, readFileSync, statSync } from 'node:fs';
+import { dirname, join, relative, resolve, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { ATLASES, BACKGROUNDS, SCREEN_IDS } from '../../src/content/assets.ts';
+import { AUDIO_CATALOG } from '../../src/content/audio-catalog.ts';
+import { GAME_CONTENT } from '../../src/content/games/index.ts';
+import type { ScreenLayout } from '../../src/content/layout-types.ts';
+import { KART_FRAME, STATIONS, stationFrame } from '../../src/content/stations.ts';
+import { Tokens } from '../../src/core/tokens.ts';
+import { RENDER_SCALE, iceCreamLimits, layoutLimits, pngSizeOf, validateAssets, validateIceCream, validateLayout, type AtlasJsonLike } from '../layout/rules.ts';
+import { screen as iceCreamScreen } from '../../src/content/games/ice-cream.ts';
+import { GAME_IDS } from '../../src/content/types.ts';
+import { validateContent } from '../../src/content/validate.ts';
+import { VOICE_LINES } from '../../src/content/voice-lines.ts';
+import { lineHash } from '../tts/line-hash.ts';
+import { hintContrastProblems } from './hint-contrast.ts';
+
+const VOICE_DIR = 'assets/audio/vo';
+
+const APP_DIR = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');
+/** Where `npm run render` writes `<screen>.layout.json`. */
+export const LAYOUT_DIR = join(APP_DIR, 'src', 'content', 'generated');
+
+/** Frames each screen's atlas must hold. */
+export const REQUIRED_FRAMES: Readonly<Record<string, readonly string[]>> = {
+  map: [...STATIONS.map((s) => stationFrame(s.id)), KART_FRAME],
+  'ice-cream': iceCreamScreen.frames,
+};
+
+function listFiles(dir: string): string[] {
+  if (!existsSync(dir)) return [];
+  return readdirSync(dir, { withFileTypes: true }).flatMap((e) => (e.isDirectory() ? listFiles(join(dir, e.name)) : [join(dir, e.name)]));
+}
+
+/** The id → geometry records of a layout. */
+const LAYOUT_RECORDS = ['anchors', 'hits', 'slots', 'paths'] as const;
+
+function readAtlas(publicDir: string | undefined, screen: (typeof SCREEN_IDS)[number]): AtlasJsonLike | undefined {
+  if (!publicDir) return undefined;
+  try {
+    return JSON.parse(readFileSync(resolve(publicDir, ATLASES[screen].json), 'utf8')) as AtlasJsonLike;
+  } catch {
+    return undefined; // assetProblems reports a missing atlas
+  }
+}
+
+/** Layout problems of every screen (missing or invalid JSON included); `publicDir` adds the atlas-based rules. */
+export function layoutProblems(layoutDir: string, publicDir?: string): string[] {
+  const problems: string[] = [];
+  for (const screen of SCREEN_IDS) {
+    const file = join(layoutDir, `${screen}.layout.json`);
+    let layout: ScreenLayout;
+    try {
+      layout = JSON.parse(readFileSync(file, 'utf8')) as ScreenLayout;
+    } catch {
+      problems.push(`layout "${screen}": ${screen}.layout.json is missing or invalid (run npm run render -- ${screen})`);
+      continue;
+    }
+    if (layout === null || typeof layout !== 'object') {
+      problems.push(`layout "${screen}": not a JSON object`);
+      continue;
+    }
+    if (layout.v !== 1 || layout.screenId !== screen) problems.push(`layout "${screen}": not a v1 layout of screen "${screen}"`);
+    const missing = LAYOUT_RECORDS.filter((k) => layout[k] === null || typeof layout[k] !== 'object' || Array.isArray(layout[k]));
+    for (const k of missing) problems.push(`layout "${screen}": missing "${k}"`);
+    if (missing.length > 0) continue;
+    if (screen === 'map') {
+      for (const p of validateLayout(layout, { stations: STATIONS, gameIds: GAME_IDS, limits: layoutLimits() })) problems.push(`layout "${screen}": ${p}`);
+    } else if (screen === 'ice-cream') {
+      for (const p of validateIceCream(layout, iceCreamLimits(iceCreamScreen), readAtlas(publicDir, screen))) problems.push(`layout "${screen}": ${p}`);
+    }
+  }
+  return problems;
+}
+
+/** Asset problems under `publicDir` (atlases, backgrounds, size caps). */
+export function assetProblems(publicDir: string): string[] {
+  const scale = RENDER_SCALE;
+  return validateAssets({
+    atlases: SCREEN_IDS.map((id) => ({ ...ATLASES[id], frames: REQUIRED_FRAMES[id] ?? [] })),
+    backgrounds: SCREEN_IDS.map((id) => ({ ...BACKGROUNDS[id], width: Tokens.design.width * scale, height: Tokens.design.height * scale })),
+    files: listFiles(join(publicDir, 'assets')).map((f) => ({ path: relative(publicDir, f).split(sep).join('/'), bytes: statSync(f).size })),
+    pngSize: (path) => {
+      try {
+        return pngSizeOf(readFileSync(resolve(publicDir, path)));
+      } catch {
+        return undefined;
+      }
+    },
+    readJson: (path) => {
+      try {
+        return JSON.parse(readFileSync(resolve(publicDir, path), 'utf8')) as unknown;
+      } catch {
+        return undefined;
+      }
+    },
+  });
+}
+
+/** Validates the real content against the files under `publicDir` and the layouts in `layoutDir`; returns the problems. */
+export function run(publicDir: string, layoutDir: string = LAYOUT_DIR): string[] {
+  const fileExists = (path: string): boolean => existsSync(resolve(publicDir, path));
+  const content = validateContent({
+    gameIds: GAME_IDS,
+    audio: AUDIO_CATALOG,
+    fileExists,
+    stations: { stations: STATIONS, voiceIds: VOICE_LINES.map((l) => l.id), playable: Object.keys(GAME_CONTENT) },
+    games: {
+      games: Object.entries(GAME_CONTENT).map(([id, c]) => ({ id, audio: c?.assets.audio ?? [] })),
+      voiceIds: VOICE_LINES.map((l) => l.id),
+      audioIds: Object.keys(AUDIO_CATALOG),
+    },
+    voice: {
+      lines: VOICE_LINES,
+      hashLine: lineHash,
+      fileExists,
+      listVoiceFiles: () => {
+        const dir = resolve(publicDir, VOICE_DIR);
+        return existsSync(dir) ? readdirSync(dir) : [];
+      },
+      readHash: (path) => {
+        try {
+          return readFileSync(resolve(publicDir, path), 'utf8');
+        } catch {
+          return undefined;
+        }
+      },
+    },
+  });
+  return [...content, ...layoutProblems(layoutDir, publicDir), ...assetProblems(publicDir)];
+}
+
+async function main(): Promise<void> {
+  const publicDir = join(APP_DIR, 'public');
+  const contrast = await hintContrastProblems(publicDir, LAYOUT_DIR);
+  const problems = [...run(publicDir), ...contrast.problems];
+  if (problems.length > 0) {
+    for (const p of problems) console.error(`content: ${p}`);
+    process.exit(1);
+  }
+  console.log(
+    `content: OK (${GAME_IDS.length} game ids, ${Object.keys(AUDIO_CATALOG).length} audio ids, ${VOICE_LINES.length} voice lines, ${SCREEN_IDS.length} layout(s) with ${STATIONS.length} stations, ${SCREEN_IDS.length} atlas(es), ${listFiles(join(publicDir, 'assets')).length} asset files; hint contrast ${Object.entries(contrast.rings)
+      .map(([s, n]) => `${s} ${n} rings`)
+      .join(', ')})`,
+  );
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) await main();
