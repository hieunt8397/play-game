index 0000000..8644e86
--- /dev/null
+++ b/app/src/core/hint-director.ts
@@ -0,0 +1,146 @@
+// HintDirector (AD-5, NFR4; Story 1.8 API, Story 1.9 behaviour). A game reports each question and its
+// outcome here and never plays a prompt or retry line itself, never runs a hint timer and never draws
+// a hint. The decisions live in the pure `HintMachine` (hint-machine.ts); this adapter wires it to:
+//   - the scene's pausable clock: one looping `time.addEvent` of Timing.hintTickMs while a question is
+//     active (scene pause and a hidden page stop it, so hint time resumes where it stopped);
+//   - `speech:ended` through `bus.scoped(scene)` (the awaited token pauses the quiet clock);
+//   - `core/hint-visuals` (ring follow + bob, hand demo, dim), the InputGuard (unpick, snap ×2) and
+//     `hint:level { gameId: scene key, level }`.
+// One module-level active director serves the Hud Speaker (`speakerReplay`). Scene SHUTDOWN ends the
+// question and restores everything it changed.
+import type { GameId, HintLevel } from '../content/types';
+import { audio as audioDirector } from './audio-director';
+import { bus as globalBus, SCENE_SHUTDOWN, type Bus, type SceneLike } from './bus';
+import { HintMachine, type HintPorts, type HintQuestion, type HintStep, type HintVisualsPort, type StepLines } from './hint-machine';
+import { createHintVisuals, type HintVisuals } from './hint-visuals';
+import { inputGuard } from './input/guard';
+import { prefersReducedMotion } from './reduced-motion';
+import { Tokens } from './tokens';
+
+export type { HintAction, HintItem, HintQuestion, HintStep } from './hint-machine';
+
+export interface Hint {
+  beginQuestion(q: HintQuestion): void;
+  /** The current step is done; `next` is the following one (multi-step questions, Story 1.10). */
+  stepDone(next: HintStep | null, lines?: StepLines): void;
+  /** A wrong attempt: the retry voice (rate-limited) and the escalation. */
+  wrong(): void;
+  questionDone(): void;
+  /** Replays the current prompt from the start (the Speaker); `undefined` with no active question. */
+  replayPrompt(): number | undefined;
+  readonly level: HintLevel;
+}
+
+/** The audio slice the hint system uses. */
+export interface HintAudio {
+  setPrompt(id: string): void;
+  say(id: string): number;
+  replayPrompt?(): number | undefined;
+}
+
+/** The slice of a scene's clock the adapter uses. */
+export interface HintTimeEvent {
+  remove(dispatchCallback?: boolean): void;
+}
+
+export interface HintSceneLike extends SceneLike {
+  readonly time: { addEvent(cfg: { delay: number; loop: boolean; callback: () => void }): HintTimeEvent };
+  readonly scene?: { readonly key: string };
+}
+
+export interface HintDeps {
+  readonly audio: HintAudio;
+  readonly guard?: HintPorts['guard'];
+  readonly bus?: Bus;
+  /** Visuals (tests); default `createHintVisuals(scene)` for a real scene, nothing without one. */
+  readonly visuals?: HintVisualsPort & { destroy?(): void };
+}
+
+const NO_VISUALS: HintVisualsPort = { ring: () => undefined, hand: () => undefined, clearHand: () => undefined, dim: () => undefined };
+
+let activeDirector: Hint | undefined;
+
+/** The director of the active question, if any (tests, Hud). */
+export function activeHint(): Hint | undefined {
+  return activeDirector;
+}
+
+/** The Speaker: the active question's prompt, else the AudioDirector's stored prompt. */
+export function speakerReplay(audio: { replayPrompt(): number | undefined } = audioDirector): number | undefined {
+  return activeDirector?.replayPrompt() ?? audio.replayPrompt();
+}
+
+function isRealScene(scene: unknown): scene is Parameters<typeof createHintVisuals>[0] {
+  return typeof scene === 'object' && scene !== null && 'add' in scene && 'tweens' in scene;
+}
+
+function reducedMotion(): boolean {
+  return typeof window === 'undefined' ? false : prefersReducedMotion(window);
+}
+
+/** The hint system of a game scene (`MiniGameBase.hint`). Without a scene it only speaks (no clock). */
+export function createHint(scene: HintSceneLike | undefined, deps: HintDeps = { audio: audioDirector }): Hint {
+  const visuals: HintVisualsPort & { destroy?(): void } =
+    deps.visuals ?? (isRealScene(scene) ? (createHintVisuals(scene, { reduced: reducedMotion() }) as HintVisuals) : NO_VISUALS);
+  const gameId = scene?.scene?.key as GameId | undefined;
+  const bus = deps.bus ?? globalBus;
+  const machine = new HintMachine({
+    audio: {
+      say: (id) => deps.audio.say(id),
+      setPrompt: (id) => deps.audio.setPrompt(id),
+      ...(deps.audio.replayPrompt ? { replayPrompt: () => deps.audio.replayPrompt!() } : {}),
+    },
+    guard: deps.guard ?? inputGuard,
+    visuals,
+    emitLevel: (level) => {
+      if (gameId) bus.emit('hint:level', { gameId, level });
+    },
+  });
+  let tick: HintTimeEvent | undefined;
+  let closed = false;
+
+  const stopTick = (): void => {
+    tick?.remove(false);
+    tick = undefined;
+  };
+
+  const hint: Hint = {
+    beginQuestion(q) {
+      if (closed) return;
+      machine.beginQuestion(q);
+      activeDirector = hint;
+      if (!tick && scene) {
+        const ms = Tokens.Timing.hintTickMs;
+        tick = scene.time.addEvent({ delay: ms, loop: true, callback: () => machine.tick(ms) });
+      }
+    },
+    stepDone(next, lines) {
+      machine.stepDone(next, lines);
+    },
+    wrong() {
+      machine.wrong();
+    },
+    questionDone() {
+      machine.questionDone();
+      stopTick();
+      if (activeDirector === hint) activeDirector = undefined;
+    },
+    replayPrompt() {
+      return machine.replayPrompt();
+    },
+    get level() {
+      return machine.level;
+    },
+  };
+
+  if (scene) {
+    bus.scoped(scene).on('speech:ended', ({ token }) => machine.speechEnded(token));
+    scene.events.once(SCENE_SHUTDOWN, () => {
+      // Visuals first: the restore then sets alpha directly instead of tweening on a closing scene.
+      visuals.destroy?.();
+      hint.questionDone();
+      closed = true;
+    });
+  }
+  return hint;
+}
diff --git a/app/src/core/hint-director.test.ts b/app/src/core/hint-director.test.ts
new file mode 100644
index 0000000..575e0a7
--- /dev/null
+++ b/app/src/core/hint-director.test.ts
@@ -0,0 +1,158 @@
+// Story 1.9: the HintDirector adapter with a fake scene clock, fake Bus and fake visuals.
+import { describe, expect, it, vi } from 'vitest';
+import { Bus } from './bus';
+import { activeHint, createHint, speakerReplay, type HintQuestion, type HintSceneLike } from './hint-director';
+import { createDropTarget } from './input/drop';
+import { InputGuard } from './input/guard';
+import { Tokens } from './tokens';
+
+const T = Tokens.Timing;
+
+function fakeScene(key = 'ice-cream') {
+  const handlers = new Map<string, Set<() => void>>();
+  const events: { cb: () => void; removed: boolean; delay: number; loop: boolean }[] = [];
+  const scene: HintSceneLike & { emit(ev: string): void } = {
+    scene: { key },
+    events: {
+      once: (ev: string, fn: () => void) => {
+        let set = handlers.get(ev);
+        if (!set) handlers.set(ev, (set = new Set()));
+        const wrap = (): void => {
+          set!.delete(wrap);
+          fn();
+        };
+        set.add(wrap);
+        (fn as { wrap?: () => void }).wrap = wrap;
+      },
+      off: (ev: string, fn: () => void) => {
+        const w = (fn as { wrap?: () => void }).wrap;
+        if (w) handlers.get(ev)?.delete(w);
+      },
+    },
+    time: {
+      addEvent: (cfg) => {
+        const e = { cb: cfg.callback, removed: false, delay: cfg.delay, loop: cfg.loop };
+        events.push(e);
+        return { remove: () => void (e.removed = true) };
+      },
+    },
+    emit: (ev: string) => {
+      for (const fn of [...(handlers.get(ev) ?? [])]) fn();
+    },
+  };
+  /** Advances the scene clock by `ms` (only live events fire). */
+  const advance = (ms: number): void => {
+    for (let t = 0; t < ms; t += T.hintTickMs) for (const e of events) if (!e.removed) e.cb();
+  };
+  return { scene, events, advance };
+}
+
+function setup() {
+  const s = fakeScene();
+  const bus = new Bus();
+  let token = 0;
+  const audio = {
+    setPrompt: vi.fn(),
+    say: vi.fn(() => ++token),
+    replayPrompt: vi.fn(() => ++token),
+  };
+  const guard = new InputGuard();
+  const visuals = { ring: vi.fn(), hand: vi.fn(), clearHand: vi.fn(), dim: vi.fn(), destroy: vi.fn() };
+  const levels: number[] = [];
+  bus.on('hint:level', ({ gameId, level }) => {
+    expect(gameId).toBe('ice-cream');
+    levels.push(level);
+  });
+  const hint = createHint(s.scene, { audio, bus, guard, visuals });
+  const target = createDropTarget({ id: 'cone', circle: { x: 1, y: 1, r: 100 } }, guard);
+  const ask = { object: {} };
+  const other = { object: {} };
+  const q: HintQuestion = { promptLineId: 'P', retryLineId: 'R', step: { correct: [ask], distractors: [other], target, action: 'drag' } };
+  const end = (t: number): void => bus.emit('speech:ended', { token: t, completed: true });
+  return { ...s, bus, audio, guard, visuals, levels, hint, target, ask, other, q, end };
+}
+
+describe('HintDirector adapter (Story 1.9)', () => {
+  it('one looping tick event of hintTickMs while a question is active; removed by questionDone', () => {
+    const s = setup();
+    s.hint.beginQuestion(s.q);
+    expect(s.events).toHaveLength(1);
+    expect(s.events[0]).toMatchObject({ delay: T.hintTickMs, loop: true, removed: false });
+    s.hint.questionDone();
+    expect(s.events[0]!.removed).toBe(true);
+  });
+
+  it('speech:ended of the prompt starts the quiet clock; ticks escalate and emit hint:level with the scene key', () => {
+    const s = setup();
+    s.hint.beginQuestion(s.q);
+    s.advance(T.hintLevel2IdleMs);
+    expect(s.hint.level).toBe(0);
+    s.end(1);
+    s.advance(T.hintLevel2IdleMs);
+    expect(s.hint.level).toBe(2);
+    expect(s.levels).toEqual([2]);
+    expect(s.visuals.ring).toHaveBeenLastCalledWith(s.ask);
+  });
+
+  it('ticks stop when the time event stops (scene paused): no escalation until it runs again', () => {
+    const s = setup();
+    s.hint.beginQuestion(s.q);
+    s.end(1);
+    s.hint.wrong();
+    s.end(2);
+    s.advance(3000);
+    s.events[0]!.removed = true; // paused: Phaser stops the scene clock
+    s.advance(30000);
+    expect(s.hint.level).toBe(1);
+    s.events[0]!.removed = false;
+    s.advance(T.hintLevel2IdleMs - 3000);
+    expect(s.hint.level).toBe(2);
+  });
+
+  it('SHUTDOWN restores pickable, snap scale and the visuals, and clears the active director', () => {
+    const s = setup();
+    s.hint.beginQuestion(s.q);
+    s.end(1);
+    for (let i = 0; i < 4; i++) s.hint.wrong();
+    expect(s.guard.isPickable(s.other)).toBe(false);
+    expect(s.target.circle()?.r).toBe(200);
+    expect(activeHint()).toBe(s.hint);
+    s.scene.emit('shutdown');
+    expect(s.guard.isPickable(s.other)).toBe(true);
+    expect(s.target.circle()?.r).toBe(100);
+    expect(s.visuals.destroy).toHaveBeenCalled();
+    expect(s.visuals.ring).toHaveBeenLastCalledWith(undefined);
+    expect(s.events[0]!.removed).toBe(true);
+    expect(activeHint()).toBeUndefined();
+    expect(s.levels.at(-1)).toBe(0);
+    // After shutdown the director is inert, and speech:ended no longer reaches it.
+    s.hint.beginQuestion(s.q);
+    expect(s.events).toHaveLength(1);
+    expect(s.bus.listenerCount('speech:ended')).toBe(0);
+  });
+
+  it('speakerReplay: the active question replays its prompt; without one, audio.replayPrompt()', () => {
+    const s = setup();
+    const fallback = { replayPrompt: vi.fn(() => 42) };
+    s.hint.beginQuestion(s.q);
+    s.end(1);
+    const tok = speakerReplay(fallback);
+    expect(s.audio.replayPrompt).toHaveBeenCalledOnce();
+    expect(s.audio.setPrompt).toHaveBeenLastCalledWith('P');
+    expect(tok).toBe(2);
+    expect(fallback.replayPrompt).not.toHaveBeenCalled();
+    s.hint.questionDone();
+    expect(speakerReplay(fallback)).toBe(42);
+  });
+
+  it('without a scene it speaks but has no clock (the base field before create)', () => {
+    const audio = { setPrompt: vi.fn(), say: vi.fn(() => 1) };
+    const hint = createHint(undefined, { audio });
+    hint.beginQuestion({ promptLineId: 'P', retryLineId: 'R', step: { correct: [], distractors: [], target: null, action: 'drag' } });
+    expect(audio.say).toHaveBeenCalledWith('P');
+    hint.wrong();
+    expect(audio.say).toHaveBeenLastCalledWith('R');
+    hint.questionDone();
+    expect(hint.replayPrompt()).toBeUndefined();
+  });
+});
diff --git a/app/src/core/hint-visuals.ts b/app/src/core/hint-visuals.ts
