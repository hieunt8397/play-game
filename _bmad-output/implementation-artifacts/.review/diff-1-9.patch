+// Hud (Story 1.6): a parallel scene above Map and the games. Speaker (top-right, every mode) replays
+// the current prompt with a two-ring wave until that line ends; Home (top-left, 'game' mode only)
+// says "Về đảo nào!" and emits `hud:home`. Launched once by Map, never on Start. Wiring only: the
+// layout, wave maths and tap logic live in core/hud.ts; taps go through InputGuard on the `hud` layer.
+import { Scene, type GameObjects, type Tweens } from 'phaser';
+import { audio } from '../core/audio-director';
+import { bus } from '../core/bus';
+import { speakerReplay } from '../core/hint-director';
+import { HudController, hudLayout, waveFrame, wavePeriodMs, type HudLayout } from '../core/hud';
+import { getHudMode } from '../core/hud-mode';
+import { createTapRouter } from '../core/input/tap-router';
+import { createTapTarget } from '../core/input/tap-target';
+import { currentView, designInsets, NO_INSETS, visibleDesignRect } from '../core/input/space';
+import { prefersReducedMotion } from '../core/reduced-motion';
+import { Tokens } from '../core/tokens';
+import { createRoundButton, pressButton } from '../core/ui/round-button';
+
+const RESIZE = 'resize';
+
+function currentLayout(): HudLayout {
+  const view = currentView();
+  const { width, height } = Tokens.design;
+  if (!view) return hudLayout({ x: 0, y: 0, w: width, h: height }, NO_INSETS);
+  return hudLayout(visibleDesignRect(view), designInsets(view));
+}
+
+export class Hud extends Scene {
+  private waveTween: Tweens.Tween | undefined;
+
+  constructor() {
+    super('Hud');
+  }
+
+  create(): void {
+    const reduced = prefersReducedMotion(window);
+    const layout = currentLayout();
+    const speakerSpec = Tokens.components.buttonSpeaker;
+    const wave = speakerSpec.wave;
+
+    const rings: GameObjects.Arc[] = [];
+    for (let i = 0; i < wave.rings; i++) {
+      rings.push(this.add.circle(layout.speaker.x, layout.speaker.y, layout.size / 2, wave.color.value, 1).setVisible(false));
+    }
+    const speaker = createRoundButton(this, {
+      x: layout.speaker.x,
+      y: layout.speaker.y,
+      size: layout.size,
+      fill: speakerSpec.background,
+      icon: 'speaker',
+    });
+    const home = createRoundButton(this, {
+      x: layout.home.x,
+      y: layout.home.y,
+      size: layout.size,
+      fill: Tokens.components.buttonHome.background,
+      icon: 'home',
+    });
+
+    const applyWave = (tMs: number): void => {
+      const frame = waveFrame(tMs, reduced);
+      rings.forEach((ring, i) => {
+        const f = frame[i];
+        if (f) ring.setScale(f.scale).setAlpha(f.alpha);
+      });
+    };
+    const stopWave = (): void => {
+      this.waveTween?.stop();
+      this.waveTween = undefined;
+      for (const ring of rings) ring.setVisible(false);
+    };
+    const startWave = (): void => {
+      stopWave();
+      const period = wavePeriodMs();
+      applyWave(0);
+      for (const ring of rings) ring.setVisible(true);
+      this.waveTween = this.tweens.addCounter({
+        from: 0,
+        to: period,
+        duration: period,
+        repeat: -1,
+        onUpdate: (t) => applyWave(t.getValue() ?? 0),
+      });
+    };
+
+    const router = createTapRouter(this, { layer: 'hud' });
+    const controller = new HudController({
+      // Story 1.9: the active hint question replays its prompt (keeping its level); else the stored prompt.
+      replay: () => speakerReplay(audio),
+      say: (id) => audio.say(id),
+      sfx: (id) => audio.sfx(id),
+      emitHome: () => bus.emit('hud:home'),
+      view: {
+        pressSpeaker: () => pressButton(this, speaker),
+        pressHome: () => pressButton(this, home),
+        showWave: (on) => (on ? startWave() : stopWave()),
+        showHome: (on) => {
+          home.setVisible(on);
+          // Only called from setMode below, after homeTarget exists.
+          homeTarget.setEnabled(on);
+        },
+      },
+    });
+    const speakerTarget = createTapTarget(router, { circle: layout.speaker, onPress: () => controller.speaker() });
+    const homeTarget = createTapTarget(router, { circle: layout.home, onPress: () => controller.home() });
+    controller.setMode(getHudMode());
+
+    const relayout = (): void => {
+      const next = currentLayout();
+      speaker.setPosition(next.speaker.x, next.speaker.y);
+      for (const ring of rings) ring.setPosition(next.speaker.x, next.speaker.y);
+      home.setPosition(next.home.x, next.home.y);
+      speakerTarget.setCircle(next.speaker);
+      homeTarget.setCircle(next.home);
+    };
+    this.scale.on(RESIZE, relayout);
+
+    const scoped = bus.scoped(this);
+    scoped.on('hud:mode', ({ mode }) => controller.setMode(mode));
+    scoped.on('speech:ended', ({ token }) => controller.speechEnded(token));
+    this.events.once('shutdown', () => {
+      this.scale.off(RESIZE, relayout);
+      stopWave();
+    });
+  }
+}
diff --git a/app/src/games/mini-game-base.ts b/app/src/games/mini-game-base.ts
new file mode 100644
index 0000000..dbbac1c
--- /dev/null
+++ b/app/src/games/mini-game-base.ts
@@ -0,0 +1,112 @@
+// MiniGame contract (Story 1.7, AD-1). Every game scene extends MiniGameBase:
+//   - the scene key is its GameId; `init(data)` stores the shell's `{ level, seed, resume? }`;
+//   - `create()` sets the Hud to 'game' mode (Home shows), fades the scene in, turns `hud:home` into
+//     `round:abandon` and then calls the subclass `build()`;
+//   - `complete(outcome)` / `abandon()` go through RoundGuard: exactly one terminal event per start,
+//     after which the game is inert (input disabled, a second Home tap ignored).
+// Story 1.8: `hint` (core/hint-director) is the only way a game reports questions and attempts; on
+// Home the base ends the hint question and removes the scene's timed events before `round:abandon`,
+// so no pending slide, next question or voice fires afterwards.
+// Story 1.9 (AD-5, UX-DR72): ambient motion (`addAmbient`) plays only while no reason is held
+// (`holdAmbient`); the base holds 'hint' while this game's hint level is ≥ 2, so the ring/bob/hand
+// are the only prominent motion.
+// Games never navigate (`scene.start/stop/…`) or load (`this.load`): Map owns both (ESLint enforces it).
+import { Scene, type Tweens } from 'phaser';
+import type { GameId, GameStartData, RoundOutcome, Snapshot } from '../content/types';
+import { bus } from '../core/bus';
+import { createHint, type Hint } from '../core/hint-director';
+import { setHudMode } from '../core/hud-mode';
+import { revealScene } from '../core/motion';
+import { RoundGuard } from '../core/round-guard';
+
+/** Ambient motion stops from this hint level (the ring and bob appear). */
+const AMBIENT_HINT_LEVEL = 2;
+
+export abstract class MiniGameBase extends Scene {
+  readonly gameId: GameId;
+  protected level = 0;
+  protected seed = 0;
+  protected resumeAt: Snapshot | undefined = undefined;
+  private guard: RoundGuard | undefined;
+  /** The hint system of this start (created in `create`, before `build`). */
+  protected hint: Hint = createHint(undefined);
+  private ambient = new Set<Tweens.Tween>();
+  private holds = new Set<string>();
+
+  constructor(gameId: GameId) {
+    super(gameId);
+    this.gameId = gameId;
+  }
+
+  init(data: Partial<GameStartData> = {}): void {
+    this.level = data.level ?? 0;
+    this.seed = data.seed ?? 0;
+    this.resumeAt = data.resume;
+  }
+
+  create(): void {
+    this.guard = new RoundGuard(this.gameId, bus, () => {
+      this.input.enabled = false;
+    });
+    this.input.enabled = true;
+    this.ambient = new Set();
+    this.holds = new Set();
+    this.hint = createHint(this);
+    setHudMode('game');
+    const scoped = bus.scoped(this);
+    scoped.on('hud:home', () => this.abandon());
+    scoped.on('hint:level', ({ gameId, level }) => {
+      if (gameId === this.gameId) this.holdAmbient('hint', level >= AMBIENT_HINT_LEVEL);
+    });
+    this.build();
+    void revealScene(this);
+  }
+
+  /** True after the start's terminal event. */
+  protected get inert(): boolean {
+    return this.guard?.inert ?? false;
+  }
+
+  /** Registers an ambient (idle) tween: it plays only while no hold reason is set. */
+  protected addAmbient(tween: Tweens.Tween): Tweens.Tween {
+    this.pruneAmbient();
+    this.ambient.add(tween);
+    if (this.holds.size > 0) tween.pause();
+    return tween;
+  }
+
+  /** Holds (`on`) or releases one reason to stop the ambient tweens ('hint', 'celebrate', …). */
+  protected holdAmbient(reason: string, on: boolean): void {
+    const was = this.holds.size > 0;
+    if (on) this.holds.add(reason);
+    else this.holds.delete(reason);
+    const now = this.holds.size > 0;
+    if (was === now) return;
+    this.pruneAmbient();
+    for (const t of this.ambient) {
+      if (now) t.pause();
+      else t.resume();
+    }
+  }
+
+  private pruneAmbient(): void {
+    for (const t of this.ambient) if (t.isDestroyed()) this.ambient.delete(t);
+  }
+
+  /** Draws the game. */
+  protected abstract build(): void;
+
+  /** The resume snapshot of the current state (written by Map on `round:abandon` from Epic 2). */
+  abstract snapshot(): Snapshot;
+
+  protected complete(outcome: Omit<RoundOutcome, 'gameId'>): void {
+    this.guard?.complete({ ...outcome, gameId: this.gameId });
+  }
+
+  protected abandon(): void {
+    if (!this.guard || this.guard.inert) return;
+    this.hint.questionDone();
+    this.time.removeAllEvents();
+    this.guard.abandon(this.snapshot());
+  }
+}
diff --git a/app/src/games/registry.test.ts b/app/src/games/registry.test.ts
new file mode 100644
index 0000000..c901dbe
--- /dev/null
+++ b/app/src/games/registry.test.ts
@@ -0,0 +1,166 @@
+// Registry and MiniGame contract (Story 1.7) with Phaser's Scene stubbed (node has no canvas).
+import { describe, expect, it, vi } from 'vitest';
+
+vi.mock('phaser', () => {
+  class Scene {
+    readonly sys: { settings: { key: string } };
+    readonly input = { enabled: true };
+    readonly time = { removeAllEvents: vi.fn() };
+    readonly cameras = {
+      main: {
+        setBackgroundColor: vi.fn(),
+        fadeIn: vi.fn(),
+        once: vi.fn(),
+      },
+    };
+    private readonly onceFns = new Map<string, () => void>();
+    readonly events = {
+      once: (ev: string, fn: () => void) => this.onceFns.set(ev, fn),
+      off: (ev: string) => this.onceFns.delete(ev),
+    };
+    constructor(key: string) {
+      this.sys = { settings: { key } };
+    }
+    shutdown(): void {
+      this.onceFns.get('shutdown')?.();
+    }
+  }
+  return { Scene };
+});
+
+const { GAME_CONTENT } = await import('../content/games/index');
+const { STATIONS } = await import('../content/stations');
+const { bus } = await import('../core/bus');
+const { getHudMode, setHudMode } = await import('../core/hud-mode');
+const { GAMES, GAME_SCENES, isGameId, ladderLength } = await import('./registry');
+const { IceCream } = await import('./ice-cream/IceCream');
+const { MiniGameBase } = await import('./mini-game-base');
+
+/** A minimal game: the base contract without the ice-cream scene (which needs a real Phaser). */
+class TestGame extends MiniGameBase {
+  readonly hints: string[] = [];
+  constructor() {
+    super('ice-cream');
+  }
+  protected build(): void {
+    this.hint = {
+      beginQuestion: () => this.hints.push('begin'),
+      stepDone: () => undefined,
+      wrong: () => this.hints.push('wrong'),
+      questionDone: () => this.hints.push('done'),
+      replayPrompt: () => undefined,
+      level: 0,
+    };
+  }
+  ambientAdd(t: unknown) {
+    return this.addAmbient(t as never);
+  }
+  ambientHold(reason: string, on: boolean) {
+    this.holdAmbient(reason, on);
+  }
+  snapshot() {
+    return { v: 1 as const, level: this.level, seed: this.seed, questionIndex: 0, partial: { placed: [] } };
+  }
+}
+
+describe('games/registry', () => {
+  it('GAMES lists exactly the games with content, each with its scene keyed by its id', () => {
+    expect(Object.keys(GAMES)).toEqual(Object.keys(GAME_CONTENT));
+    for (const [id, entry] of Object.entries(GAMES)) {
+      const scene = new entry!.scene();
+      expect(scene.gameId).toBe(id);
+      expect((scene as unknown as { sys: { settings: { key: string } } }).sys.settings.key).toBe(id);
+      expect(entry!.ladder).toBe(GAME_CONTENT[id as keyof typeof GAME_CONTENT]!.ladder);
+    }
+    expect(GAME_SCENES).toEqual([IceCream]);
+  });
+
+  it('awake stations are exactly the registered games', () => {
+    expect(STATIONS.filter((s) => s.awake).map((s) => s.id)).toEqual(Object.keys(GAMES));
+    expect(isGameId('ice-cream')).toBe(true);
+    expect(isGameId('pizza')).toBe(false);
+  });
+
+  it('ladderLength: the ladder length, 1 without a ladder', () => {
+    expect(ladderLength({ ladder: [1, 2, 3] })).toBe(3);
+    expect(ladderLength({})).toBe(1);
+  });
+});
+
+describe('MiniGameBase', () => {
+  function start(data = { level: 0, seed: 42 }) {
+    const game = new TestGame();
+    game.init(data);
+    game.create();
+    return game as TestGame & { input: { enabled: boolean }; time: { removeAllEvents: ReturnType<typeof vi.fn> }; shutdown(): void };
+  }
+
+  it('create: Hud in game mode; snapshot carries level and seed', () => {
+    setHudMode('map');
+    const game = start({ level: 0, seed: 42 });
+    expect(getHudMode()).toBe('game');
+    expect(game.snapshot()).toEqual({ v: 1, level: 0, seed: 42, questionIndex: 0, partial: { placed: [] } });
+    game.shutdown();
+  });
+
+  it('hud:home twice: one round:abandon, then inert (input disabled)', () => {
+    const game = start();
+    const abandon = vi.fn();
+    const off = bus.on('round:abandon', abandon);
+    bus.emit('hud:home');
+    bus.emit('hud:home');
+    expect(abandon).toHaveBeenCalledTimes(1);
+    expect(abandon).toHaveBeenCalledWith({ gameId: 'ice-cream', snapshot: game.snapshot() });
+    expect(game.input.enabled).toBe(false);
+    game.shutdown();
+    off();
+  });
+
+  it('Home (Story 1.8): the hint question ends and the timed events are removed before round:abandon, once', () => {
+    const game = start();
+    const order: string[] = [];
+    game.time.removeAllEvents.mockImplementation(() => order.push('timers'));
+    const off = bus.on('round:abandon', () => order.push(`abandon:${game.hints.join(',')}`));
+    bus.emit('hud:home');
+    bus.emit('hud:home');
+    expect(order).toEqual(['timers', 'abandon:done']);
+    expect(game.time.removeAllEvents).toHaveBeenCalledTimes(1);
+    game.shutdown();
+    off();
+  });
+
+  it('ambient (Story 1.9): paused while hint level ≥ 2 for this game or any hold reason; resumed when none is left', () => {
+    const game = start();
+    const tween = { pause: vi.fn(), resume: vi.fn(), isDestroyed: () => false };
+    game.ambientAdd(tween);
+    bus.emit('hint:level', { gameId: 'pizza', level: 2 });
+    expect(tween.pause).not.toHaveBeenCalled();
+    bus.emit('hint:level', { gameId: 'ice-cream', level: 1 });
+    expect(tween.pause).not.toHaveBeenCalled();
+    bus.emit('hint:level', { gameId: 'ice-cream', level: 2 });
+    expect(tween.pause).toHaveBeenCalledOnce();
+    bus.emit('hint:level', { gameId: 'ice-cream', level: 3 });
+    game.ambientHold('celebrate', true);
+    expect(tween.pause).toHaveBeenCalledOnce();
+    bus.emit('hint:level', { gameId: 'ice-cream', level: 0 });
+    expect(tween.resume).not.toHaveBeenCalled();
+    game.ambientHold('celebrate', false);
+    expect(tween.resume).toHaveBeenCalledOnce();
+    // A tween added while held starts paused.
+    game.ambientHold('celebrate', true);
+    const late = { pause: vi.fn(), resume: vi.fn(), isDestroyed: () => false };
+    game.ambientAdd(late);
+    expect(late.pause).toHaveBeenCalledOnce();
+    game.shutdown();
+  });
+
+  it('after shutdown the scene no longer listens to hud:home', () => {
+    const game = start();
+    game.shutdown();
+    const abandon = vi.fn();
+    const off = bus.on('round:abandon', abandon);
+    bus.emit('hud:home');
+    expect(abandon).not.toHaveBeenCalled();
+    off();
+  });
+});
diff --git a/app/src/games/ice-cream/IceCream.ts b/app/src/games/ice-cream/IceCream.ts
new file mode 100644
index 0000000..be6c4b9
--- /dev/null
+++ b/app/src/games/ice-cream/IceCream.ts
@@ -0,0 +1,449 @@
+// Tiệm kem (Story 1.8): drag the scoop Shiba asks for onto the cone. The scene only wires Phaser:
+// the plate `bg.ice-cream`, the full-frame sprites of `atlas.ice-cream` (Shiba on its ground pivot,
+// scoops on their trimmed centres), DragControllers for the scoops and tweens. Every decision (drop
+// resolution, outcomes, questions) is the pure round model (round.ts, questions.ts); prompts and
+// retries go through `hint` only; audio here is SFX only. Every position comes from
+// LAYOUTS['ice-cream']; timers are scene-clock events (removed on Home by MiniGameBase).
+import type { GameObjects, Time, Tweens } from 'phaser';
+import { ATLASES, BACKGROUNDS } from '../../content/assets';
+import {
+  CONE_ANCHOR,
+  CONE_SLOTS,
+  HITS,
+  SCOOP_RENDER_SLOT,
+  SFX,
+  SHIBA_ANCHOR,
+  SHIBA_FRAMES,
+  askLine,
+  retryLine,
+  scoopFrame,
+  type FlavourId,
+} from '../../content/games/ice-cream';
+import type { Point, ScreenLayout } from '../../content/layout-types';
+import { LAYOUTS } from '../../content/layouts';
+import type { Snapshot } from '../../content/types';
+import { audio } from '../../core/audio-director';
+import { createDraggable, defaultDragArea, type Draggable } from '../../core/input/drag-controller';
+import { createDropTarget, intersectRect, type DropTarget } from '../../core/input/drop';
+import { inputGuard } from '../../core/input/guard';
+import { boundingBox, pointInPolygon } from '../../core/input/polygon';
+import { createTapRouter, type TapRouter } from '../../core/input/tap-router';
+import { amplitude, prefersReducedMotion } from '../../core/reduced-motion';
+import type { Rect } from '../../core/safe-rect';
+import { Tokens } from '../../core/tokens';
+import { originFor, trimmedCentre, trimmedSize, type TrimmedRect } from '../../core/ui/sprite-pivot';
+import { MiniGameBase } from '../mini-game-base';
+import { IceCreamRound, type Area, type RoundCommand, type RoundGeometry, type ScoopState } from './round';
+
+const EASE_OUT = 'Quad.easeOut';
+const SINE = 'Sine.easeInOut';
+
+interface FrameData {
+  readonly spriteSourceSize?: { x: number; y: number; w: number; h: number };
+}
+
+interface ScoopView {
+  readonly id: string;
+  readonly flavour: FlavourId;
+  readonly image: GameObjects.Image | undefined;
+  readonly shadow: GameObjects.Ellipse;
+  /** Undefined once the scoop sits on the cone. */
+  drag: Draggable | undefined;
+  /** Hit radius and the drawn half size. */
+  readonly radius: number;
+  readonly half: number;
+  /** The scoop is drawn here (its trimmed centre). */
+  pos: Point;
+  tween: Tweens.Tween | undefined;
+  returnTimer: Time.TimerEvent | undefined;
+}
+
+const NO_AREA: Area = { contains: () => false };
+
+export class IceCream extends MiniGameBase {
+  private round: IceCreamRound | undefined;
+  private router: TapRouter | undefined;
+  private scoops = new Map<string, ScoopView>();
+  private coneScoops: ScoopView[] = [];
+  private shiba: GameObjects.Image | undefined;
+  private breath: Tweens.Tween | undefined;
+  private cone: DropTarget | undefined;
+  private reduced = false;
+  private layout: ScreenLayout = LAYOUTS['ice-cream'];
+  /** Missing frames already reported (one warning each). */
+  private warned = new Set<string>();
+
+  constructor() {
+    super('ice-cream');
+  }
+
+  // --- build ----------------------------------------------------------------------------------------
+
+  protected build(): void {
+    this.cameras.main.setBackgroundColor(Tokens.colors.sky.css);
+    this.reduced = prefersReducedMotion(window);
+    this.layout = LAYOUTS['ice-cream'];
+    this.scoops = new Map();
+    this.coneScoops = [];
+    const scale = 1 / this.layout.renderScale;
+
+    const bg = BACKGROUNDS['ice-cream'].key;
+    if (this.textures.exists(bg)) this.add.image(0, 0, bg).setOrigin(0).setScale(scale);
+    else console.warn(`ice-cream: texture "${bg}" is missing — plate skipped`);
+
+    this.addShiba();
+    this.router = createTapRouter(this);
+    const coneAt = this.slot(CONE_SLOTS[0]);
+    this.cone = createDropTarget({ id: CONE_ANCHOR, circle: { x: coneAt.x, y: coneAt.y, r: Tokens.components.dropTarget.snapRadius } });
+
+    this.round = new IceCreamRound(this.geometry(), this.seed, this.level);
+    this.applyAll(this.round.start());
+  }
+
+  snapshot(): Snapshot {
+    return this.round?.snapshot() ?? { v: 1, level: this.level, seed: this.seed, questionIndex: 0, partial: { placed: [] } };
+  }
+
+  private slot(id: string): Point {
+    const p = this.layout.slots[id];
+    if (!p) console.warn(`ice-cream: slot "${id}" is missing from the layout`);
+    return p ?? { x: this.layout.design.width / 2, y: this.layout.design.height / 2 };
+  }
+
+  private area(id: string): Area {
+    const poly = this.layout.hits[id];
+    if (!poly) {
+      console.warn(`ice-cream: hit "${id}" is missing from the layout`);
+      return NO_AREA;
+    }
+    return { contains: (p) => pointInPolygon(p, poly) };
+  }
+
+  /** Trimmed rect of an atlas frame (render px); undefined when the frame is missing. */
+  private frameRect(frame: string): TrimmedRect | undefined {
+    const key = ATLASES['ice-cream'].key;
+    if (!this.textures.exists(key) || !this.textures.get(key).has(frame)) return undefined;
+    const ss = (this.textures.get(key).get(frame).customData as FrameData | undefined)?.spriteSourceSize;
+    return ss ? { x: ss.x, y: ss.y, width: ss.w, height: ss.h } : undefined;
+  }
+
+  /** Scoop frames are rendered at slot.scoop-2: a scoop at home slot `id` is drawn this far from it. */
+  private scoopOffset(flavour: FlavourId): Point {
+    const rect = this.frameRect(scoopFrame(flavour));
+    const ref = this.slot(SCOOP_RENDER_SLOT);
+    if (!rect) return { x: 0, y: 0 };
+    const c = trimmedCentre(rect, this.layout.renderScale);
+    return { x: c.x - ref.x, y: c.y - ref.y };
+  }
+
+  private geometry(): RoundGeometry {
+    const counterBox = boundingBox(this.layout.hits[HITS.counter] ?? []);
+    const counterRect: Rect = { x: counterBox.x, y: counterBox.y, w: counterBox.width, h: counterBox.height };
+    // The offset is the same for every flavour up to a few px; the average keeps homes on one line.
+    const ref = this.scoopOffset('vanilla');
+    return {
+      homeCentre: (slot) => {
+        const p = this.slot(slot);
+        return { x: p.x + ref.x, y: p.y + ref.y };
+      },
+      coneCentre: (n) => this.slot(CONE_SLOTS[Math.min(n, CONE_SLOTS.length - 1)]!),
+      cone: { contains: (p) => this.cone?.contains(p) ?? false },
+      shiba: this.area(HITS.shiba),
+      counterUpper: this.area(HITS.counterUpper),
+      counter: this.area(HITS.counter),
+      restRect: () => {
+        const a = defaultDragArea();
+        return a ? intersectRect(counterRect, a.bounds) : counterRect;
+      },
+      snapRadius: Tokens.components.dropTarget.snapRadius,
+      minSize: Tokens.components.draggableItem.minSize,
+      offCounterDelayMs: Tokens.Timing.dragOffCounterReturnDelayMs,
+      nextQuestionDelayMs: Tokens.Timing.correctMusicMaxMs,
+    };
+  }
+
+  // --- Shiba ----------------------------------------------------------------------------------------
+
+  private addShiba(): void {
+    const key = ATLASES['ice-cream'].key;
+    const anchor = this.layout.anchors[SHIBA_ANCHOR];
+    if (!anchor || !this.frameRect(SHIBA_FRAMES.idle)) {
+      console.warn(`ice-cream: Shiba (frame "${SHIBA_FRAMES.idle}" or anchor "${SHIBA_ANCHOR}") is missing`);
+      return;
+    }
+    const o = originFor(anchor, this.layout.design);
+    this.shiba = this.add.image(anchor.x, anchor.y, key, SHIBA_FRAMES.idle).setOrigin(o.x, o.y).setScale(1 / this.layout.renderScale);
+    this.breathe();
+  }
+
+  /** Breathing: scaleY 1 ↔ shibaBreathScale around the ground pivot, yoyo. */
+  private breathe(): void {
+    const img = this.shiba;
+    if (!img) return;
+    const base = 1 / this.layout.renderScale;
+    img.setScale(base);
+    this.breath?.stop();
+    // Ambient (Story 1.9): the base pauses it while the hint ring shows or Shiba celebrates.
+    this.breath = this.addAmbient(
+      this.tweens.add({
+        targets: img,
+        scaleY: base * amplitude(Tokens.ui.shibaBreathScale, this.reduced),
+        duration: Tokens.Timing.shibaBreathMs / 2,
+        ease: SINE,
+        yoyo: true,
+        repeat: -1,
+      }),
+    );
+  }
+
+  /** Happy frames (wag + lick) and bounces through character.celebrate.scales; breathing pauses. */
+  private celebrate(): void {
+    audio.sfx(SFX.happy);
+    const img = this.shiba;
+    if (!img) return;
+    this.holdAmbient('celebrate', true);
+    const spec = Tokens.components.character.celebrate;
+    const scales = spec.scales.map((s) => amplitude(s, this.reduced));
+    const frames = SHIBA_FRAMES.happy.filter((f) => this.frameRect(f) !== undefined);
+    const base = 1 / this.layout.renderScale;
+    const steps = scales.length - 1;
+    this.tweens.addCounter({
+      from: 0,
+      to: 1,
+      duration: spec.durationMs,
+      onUpdate: (t) => {
+        const v = t.getValue() ?? 0;
+        // `repeat` bounces through the scale keys over the whole duration.
+        const cycle = (v * spec.repeat) % 1;
+        const k = Math.min(steps - 1, Math.floor(cycle * steps));
+        const local = cycle * steps - k;
+        const s = scales[k]! + (scales[k + 1]! - scales[k]!) * Math.sin((local * Math.PI) / 2);
+        img.setScale(base * s);
+        if (frames.length > 0) img.setFrame(frames[Math.floor(v * frames.length * spec.repeat) % frames.length]!, false, false);
+      },
+      onComplete: () => {
+        img.setFrame(SHIBA_FRAMES.idle, false, false);
+        this.holdAmbient('celebrate', false);
+        this.breathe();
+      },
+    });
+  }
+
+  // --- scoops ---------------------------------------------------------------------------------------
+
+  private addScoop(s: ScoopState, popIn: boolean): ScoopView {
+    const key = ATLASES['ice-cream'].key;
+    const frame = scoopFrame(s.flavour);
+    const rect = this.frameRect(frame);
+    const rs = this.layout.renderScale;
+    const item = Tokens.components.draggableItem;
+    const size = rect ? trimmedSize(rect, rs) : { w: item.minSize, h: item.minSize };
+    const half = Math.max(size.w, size.h) / 2;
+    const shadowSpec = item.liftShadow;
+    const shadow = this.add
+      .ellipse(s.at.x + shadowSpec.x, s.at.y + shadowSpec.y, size.w, size.h / 2, shadowSpec.color.value, shadowSpec.color.alpha)
+      .setVisible(false);
+    let image: GameObjects.Image | undefined;
+    if (rect) {
+      const o = originFor(trimmedCentre(rect, rs), this.layout.design);
+      image = this.add.image(s.at.x, s.at.y, key, frame).setOrigin(o.x, o.y).setScale(1 / rs);
+    } else if (!this.warned.has(frame)) {
+      this.warned.add(frame);
+      console.warn(`ice-cream: frame "${frame}" is missing — scoop drawn without an image`);
+    }
+    const view: ScoopView = {
+      id: s.id,
+      flavour: s.flavour,
+      image,
+      shadow,
+      drag: undefined,
+      radius: half + item.hitPad,
+      half,
+      pos: { ...s.at },
+      tween: undefined,
+      returnTimer: undefined,
+    };
+    if (this.router) {
+      view.drag = createDraggable(this.router, {
+        circle: { x: s.at.x, y: s.at.y, r: view.radius },
+        // The finger keeps the scoop's core (minSize/2) inside the play area, so the lower counter stays reachable.
+        itemRadius: item.minSize / 2,
+        onLift: () => this.lift(view),
+        onMove: (p) => this.place(view, p),
+        onDrop: (p) => this.settle(view, () => this.round?.drop(view.id, p) ?? []),
+        onCancel: () => this.settle(view, () => this.round?.cancel(view.id) ?? []),
+      });
+      view.drag.object = image;
+    }
+    if (popIn && image) {
+      image.setScale(0);
+      this.tweens.add({ targets: image, scale: 1 / rs, duration: item.return.durationMs, ease: 'Back.easeOut' });
+    }
+    this.scoops.set(s.id, view);
+    return view;
+  }
+
+  /** Draws the scoop at `p`; its hit circle follows (a scoop is lifted where it is seen). */
+  private place(view: ScoopView, p: Point): void {
+    view.pos = { ...p };
+    view.image?.setPosition(p.x, p.y);
+    view.drag?.setCircle({ x: p.x, y: p.y, r: view.radius });
+    const spec = Tokens.components.draggableItem.liftShadow;
+    view.shadow.setPosition(p.x + spec.x, p.y + spec.y);
+  }
+
+  /** Lift: 1.1× and a shadow in the same pointerdown handler; any running motion stops. */
+  private lift(view: ScoopView): void {
+    this.applyAll(this.round?.lift(view.id) ?? []);
+    view.tween?.stop();
+    view.tween = undefined;
+    const rs = this.layout.renderScale;
+    view.image?.setScale(Tokens.components.draggableItem.liftScale / rs);
+    view.shadow.setVisible(true);
+    this.children.bringToTop(view.shadow);
+    if (view.image) this.children.bringToTop(view.image);
+  }
+
+  private settle(view: ScoopView, outcome: () => RoundCommand[]): void {
+    view.image?.setScale(1 / this.layout.renderScale);
+    view.shadow.setVisible(false);
+    this.applyAll(outcome());
+  }
+
+  /** Tweens a scoop to `to`; its hit circle follows every frame (place). */
+  private moveTo(view: ScoopView, to: Point, durationMs: number, onDone?: () => void): void {
+    view.tween?.stop();
+    const from = { ...view.pos };
+    view.tween = this.tweens.addCounter({
+      from: 0,
+      to: 1,
+      duration: durationMs,
+      ease: EASE_OUT,
+      onUpdate: (t) => {
+        const v = t.getValue() ?? 0;
+        this.place(view, { x: from.x + (to.x - from.x) * v, y: from.y + (to.y - from.y) * v });
+      },
+      onComplete: () => {
+        view.tween = undefined;
+        this.place(view, to);
+        onDone?.();
+      },
+    });
+  }
+
+  private destroyScoop(view: ScoopView): void {
+    view.tween?.stop();
+    view.returnTimer?.remove();
+    view.drag?.destroy();
+    view.image?.destroy();
+    view.shadow.destroy();
+  }
+
+  // --- round commands -------------------------------------------------------------------------------
+
+  private applyAll(cmds: readonly RoundCommand[]): void {
+    if (this.inert) return;
+    for (const c of cmds) this.apply(c);
+  }
+
+  private apply(c: RoundCommand): void {
+    switch (c.kind) {
+      case 'build':
+        for (const v of this.scoops.values()) this.destroyScoop(v);
+        this.scoops = new Map();
+        for (const s of c.scoops) this.addScoop(s, false);
+        return;
+      case 'beginQuestion': {
+        const drags = (ids: readonly string[]): Draggable[] => ids.flatMap((id) => this.scoops.get(id)?.drag ?? []);
+        this.hint.beginQuestion({
+          promptLineId: askLine(c.target),
+          retryLineId: retryLine(c.target),
+          step: { correct: drags(c.correct), distractors: drags(c.distractors), target: this.cone ?? null, action: 'drag' },
+        });
+        return;
+      }
+      case 'snap':
+        this.snap(c.id, c.to);
+        return;
+      case 'floatBack': {
+        const v = this.scoops.get(c.id);
+        if (v) this.moveTo(v, c.to, Tokens.components.draggableItem.return.durationMs);
+        return;
+      }
+      case 'rest': {
+        const v = this.scoops.get(c.id);
+        if (v) this.moveTo(v, c.at, Tokens.components.dropTarget.snap.durationMs);
+        return;
+      }
+      case 'returnLater': {
+        const v = this.scoops.get(c.id);
+        if (!v) return;
+        v.returnTimer?.remove();
+        v.returnTimer = this.time.delayedCall(c.ms, () => {
+          v.returnTimer = undefined;
+          this.round?.returned(c.id);
+          this.moveTo(v, c.to, Tokens.components.draggableItem.return.durationMs);
+        });
+        return;
+      }
+      case 'cancelReturn': {
+        const v = this.scoops.get(c.id);
+        v?.returnTimer?.remove();
+        if (v) v.returnTimer = undefined;
+        return;
+      }
+      case 'respawn':
+        this.addScoop(c.scoop, true);
+        return;
+      case 'pickable':
+        for (const v of this.scoops.values()) if (v.drag) inputGuard.setPickable(v.drag, c.on);
+        return;
+      case 'celebrate':
+        this.celebrate();
+        return;
+      case 'hintWrong':
+        this.hint.wrong();
+        return;
+      case 'questionDone':
+        this.hint.questionDone();
+        return;
+      case 'nextLater':
+        this.time.delayedCall(c.ms, () => this.applyAll(this.round?.next() ?? []));
+        return;
+      case 'clear':
+        this.clearCone();
+        return;
+    }
+  }
+
+  /** The correct scoop leaves the counter and snaps onto the cone with a small bounce. */
+  private snap(id: string, to: Point): void {
+    const v = this.scoops.get(id);
+    if (!v) return;
+    this.scoops.delete(id);
+    v.drag?.destroy();
+    v.drag = undefined;
+    v.returnTimer?.remove();
+    this.coneScoops.push(v);
+    audio.sfx(SFX.snap);
+    const snap = Tokens.components.dropTarget.snap;
+    this.moveTo(v, to, snap.durationMs);
+    if (v.image) {
+      const base = 1 / this.layout.renderScale;
+      this.tweens.add({ targets: v.image, scale: base * snap.scale, duration: snap.durationMs / 2, ease: EASE_OUT, yoyo: true, onComplete: () => v.image?.setScale(base) });
+    }
+  }
+
+  /** Shiba "ate" the cone scoops: they fade out. */
+  private clearCone(): void {
+    const eaten = this.coneScoops;
+    this.coneScoops = [];
+    for (const v of eaten) {
+      if (!v.image) {
+        this.destroyScoop(v);
+        continue;
+      }
+      this.tweens.add({ targets: v.image, alpha: 0, duration: Tokens.Timing.sceneFadeMs, onComplete: () => this.destroyScoop(v) });
+    }
+  }
+}
