index 0000000..19b8b4c
--- /dev/null
+++ b/app/src/games/ice-cream/round.test.ts
@@ -0,0 +1,175 @@
+import { describe, expect, it } from 'vitest';
+import type { Point } from '../../content/layout-types';
+import { pointInPolygon } from '../../core/input/polygon';
+import { IceCreamRound, type RoundCommand, type RoundGeometry } from './round';
+
+const rect = (x0: number, y0: number, x1: number, y1: number): Point[] => [
+  { x: x0, y: y0 },
+  { x: x1, y: y0 },
+  { x: x1, y: y1 },
+  { x: x0, y: y1 },
+];
+const poly = (pts: Point[]) => ({ contains: (p: Point) => pointInPolygon(p, pts) });
+
+const HOMES: Record<string, Point> = {
+  'scoop-1': { x: 152, y: 560 },
+  'scoop-2': { x: 332, y: 560 },
+  'scoop-3': { x: 692, y: 560 },
+  'scoop-4': { x: 872, y: 560 },
+};
+const CONE = { x: 512, y: 450, r: 100 };
+
+const GEO: RoundGeometry = {
+  homeCentre: (slot) => HOMES[slot]!,
+  coneCentre: (n) => ({ x: 512, y: 430 - 40 * Math.min(n, 2) }),
+  cone: { contains: (p) => Math.hypot(p.x - CONE.x, p.y - CONE.y) <= CONE.r },
+  shiba: poly(rect(420, 150, 600, 340)),
+  counterUpper: poly(rect(50, 500, 970, 620)),
+  counter: poly(rect(50, 500, 970, 760)),
+  restRect: () => ({ x: 50, y: 500, w: 920, h: 230 }),
+  snapRadius: 100,
+  minSize: 90,
+  offCounterDelayMs: 1500,
+  nextQuestionDelayMs: 2000,
+};
+
+function setup(seed = 7) {
+  const round = new IceCreamRound(GEO, seed, 0);
+  const cmds = round.start();
+  const scoops = round.scoopStates();
+  const target = scoops.find((s) => s.flavour === round.target)!;
+  const other = scoops.find((s) => s.flavour !== round.target)!;
+  return { round, cmds, target, other };
+}
+
+const kinds = (cmds: readonly RoundCommand[]) => cmds.map((c) => c.kind);
+
+describe('IceCreamRound', () => {
+  it('Enter {level 0, seed 7}: two scoops at scoop-2/3 and a beginQuestion for the target', () => {
+    const { round, cmds, target, other } = setup(7);
+    expect(kinds(cmds)).toEqual(['build', 'pickable', 'beginQuestion']);
+    const build = cmds[0] as Extract<RoundCommand, { kind: 'build' }>;
+    expect(build.scoops.map((s) => s.at)).toEqual([HOMES['scoop-2'], HOMES['scoop-3']]);
+    expect(cmds[2]).toEqual({ kind: 'beginQuestion', target: round.target, correct: [target.id], distractors: [other.id] });
+    expect(round.snapshot()).toEqual({ v: 1, level: 0, seed: 7, questionIndex: 0, partial: { placed: [] } });
+  });
+
+  it('correct scoop dropped 80 px from cone-1: questionDone first (Story 1.9), then snap, respawn at home, unpickable, celebrate, next in 2 s', () => {
+    const { round, target } = setup();
+    const cmds = round.drop(target.id, { x: CONE.x + 80, y: CONE.y });
+    expect(cmds).toEqual([
+      { kind: 'questionDone' },
+      { kind: 'snap', id: target.id, to: { x: 512, y: 430 } },
+      { kind: 'respawn', scoop: { id: expect.any(String), flavour: target.flavour, at: target.at } },
+      { kind: 'pickable', on: false },
+      { kind: 'celebrate' },
+      { kind: 'nextLater', ms: 2000 },
+    ]);
+    expect(round.isCelebrating).toBe(true);
+    expect(round.progress()).toEqual({ questionIndex: 0, partial: { placed: [target.flavour] } });
+    expect(round.scoopStates()).toHaveLength(2);
+  });
+
+  it.each([
+    ['Shiba', { x: 500, y: 250 }],
+    ['the upper counter', { x: 900, y: 600 }],
+  ])('correct scoop dropped on %s is served the same way', (_name, p) => {
+    const { round, target } = setup();
+    expect(round.resolve(target.id, p)).toBe('serve');
+    expect(kinds(round.drop(target.id, p))).toEqual(['questionDone', 'snap', 'respawn', 'pickable', 'celebrate', 'nextLater']);
+  });
+
+  it('wrong scoop on the cone floats back to its pre-lift spot and reports hintWrong only', () => {
+    const { round, other } = setup();
+    expect(round.drop(other.id, { x: CONE.x, y: CONE.y })).toEqual([{ kind: 'floatBack', id: other.id, to: other.at }, { kind: 'hintWrong' }]);
+    expect(round.progress().partial.placed).toEqual([]);
+    expect(round.isCelebrating).toBe(false);
+  });
+
+  it('own home: dropped within snapRadius/2 of its pre-lift spot settles with no hint', () => {
+    const { round, other } = setup();
+    const p = { x: other.at.x + 30, y: other.at.y + 30 };
+    expect(round.drop(other.id, p)).toEqual([{ kind: 'floatBack', id: other.id, to: other.at }]);
+  });
+
+  it('rest: lower counter on top of another scoop stays, nudged ≥ minSize apart; the new spot is its home for floats', () => {
+    const { round, other, target } = setup();
+    const onTop = { x: target.at.x + 10, y: 690 };
+    const lowNeighbour = { ...target.at, y: 690 };
+    // Put the target low first so both rest on the lower counter.
+    round.drop(target.id, lowNeighbour);
+    const cmds = round.drop(other.id, onTop);
+    expect(cmds).toHaveLength(1);
+    const rest = cmds[0] as Extract<RoundCommand, { kind: 'rest' }>;
+    expect(rest.kind).toBe('rest');
+    const t = round.scoopStates().find((s) => s.id === target.id)!;
+    expect(Math.hypot(rest.at.x - t.at.x, rest.at.y - t.at.y)).toBeGreaterThanOrEqual(90 - 1e-9);
+    // A later wrong serve floats back to the resting spot.
+    expect(round.drop(other.id, { x: CONE.x, y: CONE.y })[0]).toEqual({ kind: 'floatBack', id: other.id, to: rest.at });
+  });
+
+  it('off the counter: slides back after 1500 ms; lifting again cancels the slide', () => {
+    const { round, other } = setup();
+    expect(round.drop(other.id, { x: 500, y: 60 })).toEqual([{ kind: 'returnLater', id: other.id, to: other.at, ms: 1500 }]);
+    expect(round.lift(other.id)).toEqual([{ kind: 'cancelReturn', id: other.id }]);
+    expect(round.lift(other.id)).toEqual([]);
+  });
+
+  it('pause mid-drag (cancel): back to the pre-lift spot', () => {
+    const { round, other } = setup();
+    expect(round.cancel(other.id)).toEqual([{ kind: 'floatBack', id: other.id, to: other.at }]);
+  });
+
+  it('celebrating: a drag still running just floats back (no second serve, no hint)', () => {
+    const { round, target, other } = setup();
+    round.drop(target.id, { x: CONE.x, y: CONE.y });
+    expect(round.drop(other.id, { x: CONE.x, y: CONE.y })).toEqual([{ kind: 'floatBack', id: other.id, to: other.at }]);
+    expect(round.progress().partial.placed).toHaveLength(1);
+  });
+
+  it('next(): clears the cone, lays out question 1 with a different target', () => {
+    const { round, target } = setup();
+    const first = round.target;
+    round.drop(target.id, { x: CONE.x, y: CONE.y });
+    const cmds = round.next();
+    expect(kinds(cmds)).toEqual(['clear', 'build', 'pickable', 'beginQuestion']);
+    expect(round.questionIndex).toBe(1);
+    expect(round.target).not.toBe(first);
+    expect(round.isCelebrating).toBe(false);
+    expect(round.snapshot()).toMatchObject({ questionIndex: 1, partial: { placed: [] } });
+  });
+
+  it('the cone and the question survive wrong, home, rest and off outcomes', () => {
+    const { round, target, other } = setup();
+    const outcomes: Array<[string, Point]> = [
+      ['wrong', { x: CONE.x, y: CONE.y }],
+      ['home', { x: other.at.x + 20, y: other.at.y }],
+      ['rest', { x: 600, y: 700 }],
+      ['off', { x: 500, y: 60 }],
+    ];
+    const expectSurvives = (placed: string[]) => {
+      expect(round.target).toBe(target.flavour);
+      expect(round.questionIndex).toBe(0);
+      expect(round.progress().partial.placed).toEqual(placed);
+    };
+    // Before any serve: every outcome of the distractor keeps the question and an empty cone.
+    for (const [kind, p] of outcomes) {
+      expect(round.resolve(other.id, p), kind).toBe(kind === 'wrong' ? 'serve' : kind);
+      round.drop(other.id, p);
+      round.lift(other.id);
+      expectSurvives([]);
+    }
+    // After the target is served, the cone keeps it through the distractor's outcomes (they only float back).
+    round.drop(target.id, { x: CONE.x, y: CONE.y });
+    for (const [, p] of outcomes) {
+      round.drop(other.id, p);
+      expectSurvives([target.flavour]);
+    }
+  });
+
+  it('unknown scoop ids are ignored', () => {
+    const { round } = setup();
+    expect(round.drop('nope', { x: 0, y: 0 })).toEqual([]);
+    expect(round.cancel('nope')).toEqual([]);
+  });
+});
diff --git a/app/tools/lint/hint-contrast.ts b/app/tools/lint/hint-contrast.ts
new file mode 100644
index 0000000..dfd9e1a
--- /dev/null
+++ b/app/tools/lint/hint-contrast.ts
@@ -0,0 +1,201 @@
+// Hint ring contrast on the real render (Story 1.9, run inside `npm run validate:content`).
+// For every place a hint ring can show on a plate, 32 pixels of the background just outside the ring
+// (past the halo) must reach ≥ 3:1 against the ring core (white) or the ring line (purple):
+//   - `ice-cream`: around every scoop home `slot.scoop-*`. The ring is the runtime one — the scoop's
+//     trimmed bounds (vanilla frame of `atlas.ice-cream`, rendered at slot.scoop-2) + ui.hintRingPad;
+//     without the atlas, a circle of diameter draggableItem.minSize + 2·hintRingPad at the slot;
+//   - `map`: the ellipse inscribed in every station's `hits` bbox (the Map invitation ring).
+// The plates are read with sharp; `ringContrastProblems` is the pure part (unit-tested).
+import { readFileSync } from 'node:fs';
+import { join, resolve } from 'node:path';
+import sharp from 'sharp';
+import { ATLASES, BACKGROUNDS } from '../../src/content/assets.ts';
+import { SCOOP_RENDER_SLOT, scoopFrame } from '../../src/content/games/ice-cream.ts';
+import type { Point, ScreenLayout } from '../../src/content/layout-types.ts';
+import { Tokens } from '../../src/core/tokens.ts';
+
+export type Rgb = readonly [number, number, number];
+
+/** Samples per ring. */
+export const RING_SAMPLES = 32;
+/** WCAG non-text contrast. */
+export const MIN_RING_CONTRAST = 3;
+/** Extra design px between the halo's outer edge and the sampled pixels. */
+const OUTSIDE_GAP = 2;
+
+export function rgbOf(value: number): Rgb {
+  return [(value >> 16) & 255, (value >> 8) & 255, value & 255];
+}
+
+/** WCAG relative luminance of an sRGB colour (0–255 channels). */
+export function relativeLuminance([r, g, b]: Rgb): number {
+  const lin = (c: number): number => {
+    const s = c / 255;
+    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
+  };
+  return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
+}
+
+export function contrastRatio(a: Rgb, b: Rgb): number {
+  const la = relativeLuminance(a);
+  const lb = relativeLuminance(b);
+  return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
+}
+
+export interface RingSample {
+  /** e.g. `slot.scoop-1`, `station ice-cream`. */
+  readonly label: string;
+  readonly pixels: readonly Rgb[];
+}
+
+export interface RingLayers {
+  readonly core: Rgb;
+  readonly line: Rgb;
+}
+
+export function ringLayers(): RingLayers {
+  const spec = Tokens.components.hintRing;
+  return { core: rgbOf(spec.core.color.value), line: rgbOf(spec.line.color.value) };
+}
+
+/** Problems: every pixel must reach `min` against the core or against the line. */
+export function ringContrastProblems(screen: string, samples: readonly RingSample[], layers: RingLayers = ringLayers(), min = MIN_RING_CONTRAST): string[] {
+  const problems: string[] = [];
+  for (const s of samples) {
+    let failing = 0;
+    let worst = Number.POSITIVE_INFINITY;
+    for (const px of s.pixels) {
+      const best = Math.max(contrastRatio(px, layers.core), contrastRatio(px, layers.line));
+      if (best < min) failing += 1;
+      worst = Math.min(worst, best);
+    }
+    if (failing > 0) {
+      problems.push(`hint contrast "${screen}" ${s.label}: ${failing}/${s.pixels.length} background samples next to the ring are below ${min}:1 against both the ring core and line (worst ${worst.toFixed(2)}:1)`);
+    }
+  }
+  return problems;
+}
+
+/** A ring ellipse in design px (centre and radii of the core stroke). */
+export interface RingEllipse {
+  readonly cx: number;
+  readonly cy: number;
+  readonly rx: number;
+  readonly ry: number;
+}
+
+/** How far past the core radius the ring draws (half the core, the halo) plus a small gap. */
+export function ringReach(): number {
+  const spec = Tokens.components.hintRing;
+  return spec.core.width / 2 + spec.halo.width + OUTSIDE_GAP;
+}
+
+/** `n` design points just outside the ring (pulse at its largest, 1.05×). */
+export function outsidePoints(e: RingEllipse, n = RING_SAMPLES): Point[] {
+  const k = Tokens.components.hintRing.pulse.to;
+  const out = ringReach();
+  const pts: Point[] = [];
+  for (let i = 0; i < n; i++) {
+    const a = (2 * Math.PI * i) / n;
+    pts.push({ x: e.cx + Math.cos(a) * (e.rx * k + out), y: e.cy + Math.sin(a) * (e.ry * k + out) });
+  }
+  return pts;
+}
+
+interface Plate {
+  readonly data: Buffer;
+  readonly width: number;
+  readonly height: number;
+  readonly channels: number;
+}
+
+function pixelAt(plate: Plate, p: Point, renderScale: number): Rgb {
+  const x = Math.min(plate.width - 1, Math.max(0, Math.round(p.x * renderScale)));
+  const y = Math.min(plate.height - 1, Math.max(0, Math.round(p.y * renderScale)));
+  const i = (y * plate.width + x) * plate.channels;
+  return [plate.data[i]!, plate.data[i + 1]!, plate.data[i + 2]!];
+}
+
+async function readPlate(file: string): Promise<Plate | undefined> {
+  try {
+    const { data, info } = await sharp(file).removeAlpha().raw().toBuffer({ resolveWithObject: true });
+    return { data, width: info.width, height: info.height, channels: info.channels };
+  } catch {
+    return undefined;
+  }
+}
+
+function readJson<T>(file: string): T | undefined {
+  try {
+    return JSON.parse(readFileSync(file, 'utf8')) as T;
+  } catch {
+    return undefined;
+  }
+}
+
+interface FrameJson {
+  readonly spriteSourceSize?: { x: number; y: number; w: number; h: number };
+}
+
+/** The ice-cream scoop rings: the runtime ring of the vanilla frame moved to each home slot. */
+export function iceCreamRings(layout: ScreenLayout, atlas: { frames?: Record<string, FrameJson> } | undefined): { label: string; ring: RingEllipse }[] {
+  const pad = Tokens.ui.hintRingPad;
+  const rs = layout.renderScale;
+  const ss = atlas?.frames?.[scoopFrame('vanilla')]?.spriteSourceSize;
+  const ref = layout.slots[SCOOP_RENDER_SLOT];
+  const rings: { label: string; ring: RingEllipse }[] = [];
+  for (const [id, slot] of Object.entries(layout.slots)) {
+    if (!id.startsWith('scoop-')) continue;
+    if (ss && ref) {
+      const cx = (ss.x + ss.w / 2) / rs - ref.x + slot.x;
+      const cy = (ss.y + ss.h / 2) / rs - ref.y + slot.y;
+      rings.push({ label: `slot.${id}`, ring: { cx, cy, rx: ss.w / rs / 2 + pad, ry: ss.h / rs / 2 + pad } });
+    } else {
+      const r = Tokens.components.draggableItem.minSize / 2 + pad;
+      rings.push({ label: `slot.${id}`, ring: { cx: slot.x, cy: slot.y, rx: r, ry: r } });
+    }
+  }
+  return rings;
+}
+
+/** The Map invitation rings: inscribed in each station's hit bbox. */
+export function mapRings(layout: ScreenLayout): { label: string; ring: RingEllipse }[] {
+  return Object.entries(layout.hits).map(([id, poly]) => {
+    const xs = poly.map((p) => p.x);
+    const ys = poly.map((p) => p.y);
+    const x0 = Math.min(...xs);
+    const x1 = Math.max(...xs);
+    const y0 = Math.min(...ys);
+    const y1 = Math.max(...ys);
+    return { label: `station ${id}`, ring: { cx: (x0 + x1) / 2, cy: (y0 + y1) / 2, rx: (x1 - x0) / 2, ry: (y1 - y0) / 2 } };
+  });
+}
+
+export interface HintContrastReport {
+  readonly problems: string[];
+  /** Rings sampled per screen. */
+  readonly rings: Readonly<Record<string, number>>;
+}
+
+/** Reads the plates under `publicDir` and the layouts in `layoutDir`. Missing files are reported elsewhere. */
+export async function hintContrastProblems(publicDir: string, layoutDir: string): Promise<HintContrastReport> {
+  const problems: string[] = [];
+  const rings: Record<string, number> = {};
+  const screens: { id: 'ice-cream' | 'map'; rings: (l: ScreenLayout) => { label: string; ring: RingEllipse }[] }[] = [
+    { id: 'ice-cream', rings: (l) => iceCreamRings(l, readJson(resolve(publicDir, ATLASES['ice-cream'].json))) },
+    { id: 'map', rings: mapRings },
+  ];
+  for (const s of screens) {
+    const layout = readJson<ScreenLayout>(join(layoutDir, `${s.id}.layout.json`));
+    const plate = await readPlate(resolve(publicDir, BACKGROUNDS[s.id].path));
+    if (!layout || !plate) {
+      problems.push(`hint contrast "${s.id}": the plate or the layout cannot be read`);
+      continue;
+    }
+    const list = s.rings(layout);
+    rings[s.id] = list.length;
+    const samples = list.map(({ label, ring }) => ({ label, pixels: outsidePoints(ring).map((p) => pixelAt(plate, p, layout.renderScale)) }));
+    problems.push(...ringContrastProblems(s.id, samples));
+  }
+  return { problems, rings };
+}
