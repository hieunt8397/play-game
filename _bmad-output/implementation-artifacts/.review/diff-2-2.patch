+// reward-service (Story 2.2, AD-2): the boot-time core service that turns a finished round into a
+// decoration. Not a scene: it subscribes with the global `bus.on` and is installed by main.ts before
+// `new Game`, so it is subscribed before Map and runs first, also while Map sleeps or is stopped
+// (Chạm là nói, Epic 4).
+//   round:complete {gameId}  → progress.grantDecoration(gameId) → push the result to pendingFlyIns
+//   reward:earned  {gameId}  → the same, then emit reward:granted {gameId, decorationId}
+// The grant is written synchronously before anything is queued or emitted, so an app kill mid-
+// animation can never lose a reward or grant it twice. A null grant (no slots / empty catalogue)
+// does nothing more. This module is the ONLY caller of grantDecoration (a Vitest source scan
+// enforces it). A second install on the same Bus is a no-op returning the same uninstall function.
+import type { GameId, GrantResult } from '../content/types';
+import { bus as appBus, type Bus } from './bus';
+import { ProgressStore } from './progress-store';
+import { session as appSession } from './session-store';
+
+export interface RewardServiceDeps {
+  readonly bus?: Bus;
+  readonly progress?: { grantDecoration(stationId: GameId): GrantResult | null };
+  readonly session?: { pendingFlyIns: GrantResult[] };
+}
+
+const installed = new WeakMap<Bus, () => void>();
+
+export function installRewardService(deps: RewardServiceDeps = {}): () => void {
+  const bus = deps.bus ?? appBus;
+  const existing = installed.get(bus);
+  if (existing) return existing;
+  const progress = deps.progress ?? ProgressStore;
+  const session = deps.session ?? appSession;
+
+  const grant = (gameId: GameId): GrantResult | null => {
+    const result = progress.grantDecoration(gameId);
+    if (result) session.pendingFlyIns.push(result);
+    return result;
+  };
+
+  const offs = [
+    bus.on('round:complete', ({ gameId }) => {
+      grant(gameId);
+    }),
+    bus.on('reward:earned', ({ gameId }) => {
+      const result = grant(gameId);
+      if (result) bus.emit('reward:granted', { gameId, decorationId: result.slot.decorationId });
+    }),
+  ];
+
+  const uninstall = (): void => {
+    if (installed.get(bus) !== uninstall) return;
+    installed.delete(bus);
+    for (const off of offs) off();
+  };
+  installed.set(bus, uninstall);
+  return uninstall;
+}
