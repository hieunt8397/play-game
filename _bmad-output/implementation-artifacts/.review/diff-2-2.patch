+// Story 2.2: the static decoration draw plan — position, origin, depth, footprint, tap rect, and every
+// skip/warn case.
+import { describe, expect, it } from 'vitest';
+import type { ScreenLayout } from '../content/layout-types';
+import type { DecorationSlot } from '../content/types';
+import { decorationFootprint, diffDecorations, planDecorations, spriteSourceRect, type Rect } from './decoration-plan';
+
+const layout: ScreenLayout = {
+  v: 1,
+  screenId: 'map',
+  design: { width: 1024, height: 768 },
+  renderScale: 2,
+  anchors: {},
+  hits: {},
+  slots: {
+    'ice-cream-1': { x: 200, y: 400 },
+    'ice-cream-2': { x: 260, y: 420 },
+    'ice-cream-3': { x: 150, y: 380 },
+    'pizza-2': { x: 600, y: 500 },
+  },
+  paths: {},
+};
+const stations = [
+  { id: 'ice-cream', slots: ['ice-cream-1', 'ice-cream-2', 'ice-cream-3'] },
+  { id: 'pizza', slots: ['pizza-1', 'pizza-2'] },
+];
+const catalogue = {
+  'ice-cream': [{ id: 'parasol' }, { id: 'giant-cone' }],
+  pizza: [{ id: 'tomato' }],
+};
+// Rendered at slot 1 (200, 400) → render px (400, 800); the trimmed rect sits around it.
+const RECTS: Record<string, Rect> = {
+  'decoration/parasol/00': { x: 340, y: 600, width: 120, height: 210 },
+  'decoration/giant-cone/00': { x: 360, y: 640, width: 80, height: 170 },
+  'decoration/tomato/00': { x: 0, y: 0, width: 100, height: 100 },
+};
+const frameRect = (f: string): Rect | undefined => RECTS[f];
+const entry = (slotId: string, decorationId: string, seq: number, stationId: DecorationSlot['stationId'] = 'ice-cream'): DecorationSlot => ({
+  slotId,
+  stationId,
+  decorationId,
+  seq,
+});
+const PAD = 24;
+
+describe('planDecorations', () => {
+  it('empty island: nothing planned, no warning', () => {
+    expect(planDecorations([], layout, stations, catalogue, frameRect, PAD)).toEqual({ items: [], warnings: [] });
+  });
+
+  it('at slot 1: image on the slot, origin at the pivot, scale 1/renderScale, depth y; footprint = trimmed rect / 2', () => {
+    const { items, warnings } = planDecorations([entry('ice-cream-1', 'parasol', 1)], layout, stations, catalogue, frameRect, PAD);
+    expect(warnings).toEqual([]);
+    expect(items).toHaveLength(1);
+    const it0 = items[0]!;
+    expect(it0).toMatchObject({
+      key: 'ice-cream-1#1',
+      frame: 'decoration/parasol/00',
+      x: 200,
+      y: 400,
+      originX: 200 / 1024,
+      originY: 400 / 768,
+      scale: 0.5,
+      depth: 400,
+      footprint: { x: 170, y: 300, width: 60, height: 105 },
+    });
+    expect(it0.hit).toEqual([
+      { x: 146, y: 276 },
+      { x: 254, y: 276 },
+      { x: 254, y: 429 },
+      { x: 146, y: 429 },
+    ]);
+  });
+
+  it('at slot 2: the same pivot origin, placed at the slot; the footprint shifts by S − pivot', () => {
+    const { items } = planDecorations([entry('ice-cream-2', 'giant-cone', 2)], layout, stations, catalogue, frameRect, PAD);
+    expect(items[0]).toMatchObject({
+      x: 260,
+      y: 420,
+      originX: 200 / 1024,
+      originY: 400 / 768,
+      depth: 420,
+      footprint: { x: 180 + 60, y: 320 + 20, width: 40, height: 85 },
+    });
+  });
+
+  it('items are sorted by depth', () => {
+    const { items } = planDecorations(
+      [entry('ice-cream-2', 'parasol', 3), entry('ice-cream-3', 'giant-cone', 2), entry('ice-cream-1', 'giant-cone', 1)],
+      layout,
+      stations,
+      catalogue,
+      frameRect,
+      PAD,
+    );
+    expect(items.map((i) => i.slotId)).toEqual(['ice-cream-3', 'ice-cream-1', 'ice-cream-2']);
+  });
+
+  it('unknown decorationId: skipped with one warning naming it', () => {
+    const { items, warnings } = planDecorations([entry('ice-cream-1', 'unicorn', 1)], layout, stations, catalogue, frameRect, PAD);
+    expect(items).toEqual([]);
+    expect(warnings).toHaveLength(1);
+    expect(warnings[0]).toContain('"unicorn"');
+  });
+
+  it("another station's item is unknown here (its frame was rendered at another pivot)", () => {
+    const { items, warnings } = planDecorations([entry('ice-cream-1', 'tomato', 1)], layout, stations, catalogue, frameRect, PAD);
+    expect(items).toEqual([]);
+    expect(warnings).toHaveLength(1);
+  });
