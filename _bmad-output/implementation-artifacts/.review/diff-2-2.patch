+// Decoration draw plan (Story 2.2), pure. Turns the saved decorations (ProgressStore.getDecorations)
+// plus the generated map layout and the catalogue into what Map draws, statically:
+//   - every frame of a station's decorations was rendered at `pivot = slots[station.slots[0]]` (slot 1),
+//     full-frame and pixel-aligned to the plate there. At a slot S the image goes to (S.x, S.y) with
+//     origin (pivot.x/design.width, pivot.y/design.height) and scale 1/renderScale; depth S.y (the same
+//     scheme as the stations), so it stands on S exactly as rendered at the pivot;
+//   - footprint: the trimmed frame rect (spriteSourceSize ÷ renderScale) shifted by S − pivot;
+//     tap rect: the footprint padded by tappableProp.hitPad (24 px) on every side, as a 4-point polygon.
+// Skipped entries (each with one warning, nothing drawn): an unknown station, a decorationId not in
+// its station's catalogue, a missing frame, a slotId with no anchor or not in its station's slots
+// (or a station whose slot 1 has no anchor), and duplicate slots (the highest seq is kept).
+// An empty island plans nothing. The `.ts` specifiers let tools/layout/rules.ts import the footprint
+// maths under Node type stripping (one definition for the runtime and the check gate).
+import type { Point, ScreenLayout } from '../content/layout-types.ts';
+import type { DecorationSlot } from '../content/types.ts';
+import { Tokens } from './tokens.ts';
+
+/** A rect in px (x, y = top-left). */
+export interface Rect {
+  readonly x: number;
+  readonly y: number;
+  readonly width: number;
+  readonly height: number;
+}
+
+export interface PlannedDecoration {
+  /** Map diff key: `slotId` + `seq`. */
+  readonly key: string;
+  readonly slotId: string;
+  readonly stationId: string;
+  readonly decorationId: string;
+  readonly seq: number;
+  readonly frame: string;
+  /** Image position (the slot) and origin (the render pivot). */
+  readonly x: number;
+  readonly y: number;
+  readonly originX: number;
+  readonly originY: number;
+  readonly scale: number;
+  readonly depth: number;
+  /** Visible (trimmed) rect at this slot, design px. */
+  readonly footprint: Rect;
+  /** Tap area: the footprint padded by tappableProp.hitPad. */
+  readonly hit: readonly Point[];
+}
+
+export interface DecorationPlan {
+  readonly items: readonly PlannedDecoration[];
+  readonly warnings: readonly string[];
+}
+
+export interface DecorationStationInput {
+  readonly id: string;
+  readonly slots: readonly string[];
+}
+
+/** The map atlas frame of a decoration (same grammar as content/decorations › decorationFrame). */
+export const decorationFrameName = (id: string): string => `decoration/${id}/00`;
+
+/** The trimmed frame rect `ss` (render px, in the full frame rendered at `pivot`) placed at slot `at`, design px. */
+export function decorationFootprint(ss: Rect, pivot: Point, at: Point, renderScale: number): Rect {
+  return {
+    x: ss.x / renderScale + at.x - pivot.x,
+    y: ss.y / renderScale + at.y - pivot.y,
+    width: ss.width / renderScale,
+    height: ss.height / renderScale,
+  };
+}
+
+/** The tap rect: `footprint` grown by `pad` on every side. */
+export function padRect(r: Rect, pad: number): Rect {
+  return { x: r.x - pad, y: r.y - pad, width: r.width + 2 * pad, height: r.height + 2 * pad };
+}
+
+/** The 4 corners of `r`, clockwise from top-left. */
+export function rectPolygon(r: Rect): Point[] {
+  return [
+    { x: r.x, y: r.y },
+    { x: r.x + r.width, y: r.y },
+    { x: r.x + r.width, y: r.y + r.height },
+    { x: r.x, y: r.y + r.height },
+  ];
+}
+
+export function planDecorations(
+  saved: readonly DecorationSlot[],
+  layout: ScreenLayout,
+  stations: readonly DecorationStationInput[],
+  catalogue: Readonly<Record<string, ReadonlyArray<{ readonly id: string }>>>,
+  frameRect: (frame: string) => Rect | undefined,
+  hitPad: number = Tokens.components.tappableProp.hitPad,
+): DecorationPlan {
+  const warnings: string[] = [];
+  const rs = layout.renderScale;
+
+  // Duplicate slots: keep the highest seq (first one wins a tie).
+  const bySlot = new Map<string, DecorationSlot>();
+  for (const d of saved) {
+    const kept = bySlot.get(d.slotId);
+    if (kept && kept.seq >= d.seq) {
+      warnings.push(`map: decoration "${d.decorationId}" (seq ${d.seq}) shares slot "${d.slotId}" with a newer one — skipped`);
+      continue;
+    }
+    if (kept) warnings.push(`map: decoration "${kept.decorationId}" (seq ${kept.seq}) shares slot "${d.slotId}" with a newer one — skipped`);
+    bySlot.set(d.slotId, d);
+  }
+
+  const items: PlannedDecoration[] = [];
+  for (const d of bySlot.values()) {
+    const station = stations.find((s) => s.id === d.stationId);
+    if (!station) {
+      warnings.push(`map: decoration "${d.decorationId}" belongs to unknown station "${d.stationId}" — skipped`);
+      continue;
+    }
+    if (!(catalogue[station.id] ?? []).some((c) => c.id === d.decorationId)) {
+      warnings.push(`map: decoration "${d.decorationId}" is not in the "${station.id}" catalogue — skipped`);
+      continue;
+    }
+    const at = layout.slots[d.slotId];
+    if (!station.slots.includes(d.slotId) || !at) {
+      warnings.push(`map: decoration "${d.decorationId}": slot "${d.slotId}" is not a slot of "${station.id}" with an anchor — skipped`);
+      continue;
+    }
+    const pivotId = station.slots[0]!;
+    const pivot = layout.slots[pivotId];
+    if (!pivot) {
+      warnings.push(`map: decoration "${d.decorationId}": pivot slot "${pivotId}" has no anchor — skipped`);
+      continue;
+    }
+    const frame = decorationFrameName(d.decorationId);
+    const ss = frameRect(frame);
+    if (!ss) {
+      warnings.push(`map: frame "${frame}" is missing from the map atlas — decoration "${d.decorationId}" skipped`);
+      continue;
+    }
+    const footprint = decorationFootprint(ss, pivot, at, rs);
+    items.push({
+      key: `${d.slotId}#${d.seq}`,
+      slotId: d.slotId,
+      stationId: station.id,
+      decorationId: d.decorationId,
+      seq: d.seq,
+      frame,
+      x: at.x,
+      y: at.y,
+      originX: pivot.x / layout.design.width,
+      originY: pivot.y / layout.design.height,
+      scale: 1 / rs,
+      depth: at.y,
+      footprint,
+      hit: rectPolygon(padRect(footprint, hitPad)),
+    });
+  }
+  items.sort((a, b) => a.depth - b.depth);
+  return { items, warnings };
+}
+
+/** Hit priority of decoration tap targets: below every station polygon and the kart (z 0). */
+export const DECORATION_Z = -1;
+
+/** A Phaser atlas frame's `customData.spriteSourceSize` (render px), as free-tex-packer writes it. */
+export interface SpriteSourceSize {
+  readonly x: number;
+  readonly y: number;
+  readonly w: number;
+  readonly h: number;
+}
+
+/** `{x, y, w, h}` → `{x, y, width, height}`; undefined when the frame carries no spriteSourceSize. */
+export function spriteSourceRect(ss: SpriteSourceSize | undefined): Rect | undefined {
+  return ss ? { x: ss.x, y: ss.y, width: ss.w, height: ss.h } : undefined;
+}
+
+export interface DecorationDiff {
+  /** Keys of drawn props to destroy (removed, or replaced: same slot, new seq). */
+  readonly remove: readonly string[];
+  /** Planned items with no prop yet. */
+  readonly add: readonly PlannedDecoration[];
+}
+
+/** Keyed diff (`slotId#seq`) between the props Map has drawn and a new plan: keep, remove, add. */
+export function diffDecorations(drawn: Iterable<string>, items: readonly PlannedDecoration[]): DecorationDiff {
+  const have = new Set(drawn);
+  const want = new Set(items.map((i) => i.key));
+  return { remove: [...have].filter((k) => !want.has(k)), add: items.filter((i) => !have.has(i.key)) };
+}
