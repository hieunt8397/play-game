+    const { items, warnings } = planDecorations([entry('ice-cream-1', 'sundae', 1)], layout, stations, cat, frameRect, PAD);
+    expect(items).toEqual([]);
+    expect(warnings).toEqual([expect.stringContaining('"decoration/sundae/00"')]);
+  });
+
+  it('slot not in the station, or with no anchor, or a pivot with no anchor: skipped, one warning each', () => {
+    const { items, warnings } = planDecorations(
+      [entry('ice-cream-9', 'parasol', 1), entry('pizza-1', 'parasol', 2), entry('pizza-2', 'tomato', 3, 'pizza')],
