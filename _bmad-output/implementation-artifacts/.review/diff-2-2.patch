+// Decoration grant planning (Story 2.2, AD-2), pure. ProgressStore.grantDecoration calls it and then
+// writes the result in one synchronous commit. For one station:
+//   1. Cleanup: drop this station's orphans (a slotId no longer in `slots`) and duplicate-slot entries
+//      (the highest seq is kept). Other stations' entries are never touched.
+//   2. Item: the catalogue entry after the one held by the station's highest-seq entry, wrapping at
+//      the end; the first item when the station has no entry or that item left the catalogue.
+//   3. Slot: the first slot in `slots` order with no entry; when every slot is taken, the slot whose
+//      entry has the lowest seq, and `replaced` names the decoration it held.
+//   4. seq = the document seq + 1 (both the new entry's seq and the new document seq). No clock.
+// No slots or an empty catalogue → null (the caller warns and writes nothing).
+import type { DecorationSlot, GameId, GrantResult } from '../content/types';
+
+export interface GrantPlan {
+  /** The whole new decorations list (other stations untouched, in their order). */
+  readonly decorations: DecorationSlot[];
+  /** The new document seq. */
+  readonly seq: number;
+  readonly result: GrantResult;
+}
+
+/** This station's entries without orphans and duplicate slots (the highest seq per slot is kept). */
+export function cleanStation(decorations: readonly DecorationSlot[], stationId: GameId, slots: readonly string[]): DecorationSlot[] {
+  const bySlot = new Map<string, DecorationSlot>();
+  for (const d of decorations) {
+    if (d.stationId !== stationId || !slots.includes(d.slotId)) continue;
+    const kept = bySlot.get(d.slotId);
+    if (!kept || d.seq > kept.seq) bySlot.set(d.slotId, d);
+  }
+  return [...bySlot.values()];
+}
+
+export function planGrant(
+  decorations: readonly DecorationSlot[],
+  seq: number,
+  stationId: GameId,
+  slots: readonly string[],
+  items: readonly string[],
+): GrantPlan | null {
+  if (slots.length === 0 || items.length === 0) return null;
+  const own = cleanStation(decorations, stationId, slots);
+
+  const newest = own.reduce<DecorationSlot | undefined>((a, d) => (!a || d.seq > a.seq ? d : a), undefined);
+  const at = newest ? items.indexOf(newest.decorationId) : -1;
+  const decorationId = at < 0 ? items[0]! : items[(at + 1) % items.length]!;
+
+  const taken = new Map(own.map((d) => [d.slotId, d]));
+  let slotId = slots.find((s) => !taken.has(s));
+  let replaced: DecorationSlot | undefined;
+  if (slotId === undefined) {
+    replaced = own.reduce((a, d) => (d.seq < a.seq ? d : a));
+    slotId = replaced.slotId;
+  }
+
+  const next = seq + 1;
+  const slot: DecorationSlot = { slotId, stationId, decorationId, seq: next };
+  const kept = new Set(own.filter((d) => d !== replaced));
+  const others = decorations.filter((d) => d.stationId !== stationId || kept.has(d));
+  return {
+    decorations: [...others.map((d) => ({ ...d })), slot],
+    seq: next,
+    result: replaced ? { slot: { ...slot }, replaced: { decorationId: replaced.decorationId } } : { slot: { ...slot } },
+  };
+}
