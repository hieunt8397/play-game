+import { installRewardService } from './reward-service';
+import { SessionStore } from './session-store';
+
+function memoryStorage() {
+  const data = new Map<string, string>();
+  return {
+    data,
+    getItem: (k: string) => data.get(k) ?? null,
+    setItem: vi.fn((k: string, v: string) => void data.set(k, v)),
+  } satisfies StorageLike & { data: Map<string, string> };
+}
+
+async function setup() {
+  const bus = new Bus();
+  const storage = memoryStorage();
+  const progress = new ProgressStoreService();
+  await progress.init({ storage, persist: async () => true });
+  const session = new SessionStore();
+  const uninstall = installRewardService({ bus, progress, session });
+  return { bus, storage, progress, session, uninstall };
+}
+
+const outcome = (gameId: RoundOutcome['gameId']): RoundOutcome => ({ gameId, questions: 3, firstTryCorrect: 3, maxHintLevel: 0 });
+
+afterEach(() => vi.restoreAllMocks());
