+describe('installRewardService', () => {
+  it('reward:earned (touch-talk): 1 entry at touch-talk-1, 1 pending fly-in, 1 reward:granted with fire-truck', async () => {
+    const { bus, progress, session } = await setup();
+    const granted = vi.fn();
+    bus.on('reward:granted', granted);
+    bus.emit('reward:earned', { gameId: 'touch-talk' });
+    expect(progress.getDecorations()).toEqual([{ slotId: 'touch-talk-1', stationId: 'touch-talk', decorationId: 'fire-truck', seq: 1 }]);
+    expect(session.pendingFlyIns).toEqual([{ slot: { slotId: 'touch-talk-1', stationId: 'touch-talk', decorationId: 'fire-truck', seq: 1 } }]);
+    expect(granted).toHaveBeenCalledTimes(1);
+    expect(granted).toHaveBeenCalledWith({ gameId: 'touch-talk', decorationId: 'fire-truck' });
+  });
+
+  it('round:complete: exactly 1 grant, 1 pending fly-in, no reward:granted', async () => {
