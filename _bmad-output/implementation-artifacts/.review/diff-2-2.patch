+// Island decorations (Story 2.2, AD-2). Data only: per station, the CC0 low-poly models a finished
+// round can place on that station's slots, in a fixed order. `ProgressStore.grantDecoration` gives the
+// entry after the station's newest one (wrapping), so the order is the order a child sees them.
+// - `id`: kebab-case and unique across all stations; the map atlas frame is `decoration/<id>/00`.
+// - `model`: path relative to the project's `assets/` folder (Kenney / Quaternius, CC0). build_map.py
+//   imports it, normalises its size and renders it as `state.<id>` under `sprite.decoration`.
+// Every station has more items than slots, so a replacement always brings in a different item.
+// No T-rex anywhere (UX-DR75); Shiba, the fox and the station dinos are already game characters.
+import type { GameId } from './types.ts';
+
+export interface DecorationItem {
+  readonly id: string;
+  /** Relative to `assets/` (e.g. `kenney/kenney_food-kit/Models/GLB format/pizza.glb`). */
+  readonly model: string;
+}
+
+const COMMERCIAL = 'kenney/kenney_city-kit-commercial_2.1/Models/GLB format';
+const FOOD = 'kenney/kenney_food-kit/Models/GLB format';
+const CARS = 'kenney/kenney_car-kit/Models/GLB format';
+const ROADS = 'kenney/kenney_city-kit-roads/Models/GLB format';
+const CUTEFISH = 'quaternius/cutefish';
+const DINOSAURS = 'quaternius/dinosaurs';
+const ANIMALS = 'quaternius/animals';
+
+const item = (id: string, folder: string, file: string): DecorationItem => ({ id, model: `${folder}/${file}` });
+
+export const DECORATIONS: Readonly<Record<GameId, readonly DecorationItem[]>> = {
+  'ice-cream': [
+    item('parasol', COMMERCIAL, 'detail-parasol-a.glb'),
+    item('giant-cone', FOOD, 'ice-cream.glb'),
+    item('popsicle', FOOD, 'popsicle.glb'),
+    item('sundae', FOOD, 'sundae.glb'),
+  ],
+  pizza: [
+    item('pizza-pie', FOOD, 'pizza.glb'),
+    item('tomato', FOOD, 'tomato.glb'),
+    item('cheese', FOOD, 'cheese.glb'),
+    item('pizza-box', FOOD, 'pizza-box.glb'),
+  ],
+  race: [
+    item('cone', CARS, 'cone.glb'),
+    item('traffic-light', ROADS, 'traffic-light.glb'),
+    item('race-car', CARS, 'race-future.glb'),
+    item('barrier', ROADS, 'construction-barrier.glb'),
+  ],
+  fishing: [
+    item('boat', CUTEFISH, 'Boat.fbx'),
+    item('puffer', CUTEFISH, 'Puffer.fbx'),
+    item('koi', CUTEFISH, 'Koi.fbx'),
+    item('butterfly-fish', CUTEFISH, 'ButterflyFish.fbx'),
+  ],
+  'touch-talk': [
+    item('fire-truck', CARS, 'firetruck.glb'),
+    item('ambulance', CARS, 'ambulance.glb'),
+    item('taxi', CARS, 'taxi.glb'),
+    item('street-lamp', ROADS, 'light-curved.glb'),
+  ],
+  'dino-puzzle': [
+    item('parasaurolophus', DINOSAURS, 'Parasaurolophus.fbx'),
+    // Swapped in for a T-rex (UX-DR75, 2026-10-08; see spec-cross-notes).
+    item('pineapple', FOOD, 'pineapple.glb'),
+    item('dino-egg', FOOD, 'egg.glb'),
+    item('coconut', FOOD, 'coconut.glb'),
+  ],
+  'shadow-match': [
+    item('mushroom', FOOD, 'mushroom.glb'),
+    item('pumpkin', FOOD, 'pumpkin.glb'),
+    item('lamp-post', ROADS, 'light-square.glb'),
+    item('alpaca', ANIMALS, 'Alpaca.fbx'),
+  ],
+};
+
+/** The map atlas frame of a decoration (one state, one frame). */
+export const decorationFrame = (id: string): string => `decoration/${id}/00`;
