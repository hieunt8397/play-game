+// Story 2.2: every grant row of the I/O matrix on the pure planner.
+import { describe, expect, it } from 'vitest';
+import type { DecorationSlot } from '../content/types';
+import { cleanStation, planGrant } from './decoration-grant';
+
+const SLOTS = ['ice-cream-1', 'ice-cream-2', 'ice-cream-3'];
+const ITEMS = ['parasol', 'giant-cone', 'popsicle', 'sundae'];
+
+/** Runs `n` grants on ice-cream starting from `start` (default: an empty document) and `seq0`; returns the final list and seq. */
+function grantN(n: number, start: DecorationSlot[] = [], seq0 = 0) {
+  let decorations = start;
+  let seq = seq0;
+  const results = [];
+  for (let i = 0; i < n; i++) {
+    const plan = planGrant(decorations, seq, 'ice-cream', SLOTS, ITEMS)!;
+    decorations = plan.decorations;
+    seq = plan.seq;
+    results.push(plan.result);
+  }
+  return { decorations, seq, results };
+}
+
+describe('planGrant', () => {
+  it('first grant: slot -1 ← parasol, seq 1', () => {
+    const plan = planGrant([], 0, 'ice-cream', SLOTS, ITEMS)!;
+    expect(plan.result).toEqual({ slot: { slotId: 'ice-cream-1', stationId: 'ice-cream', decorationId: 'parasol', seq: 1 } });
+    expect(plan.seq).toBe(1);
+    expect(plan.decorations).toEqual([plan.result.slot]);
+  });
+
+  it('fill 3: -1,-2,-3 ← parasol, giant-cone, popsicle; seq 1,2,3', () => {
+    const { decorations, seq } = grantN(3);
+    expect(decorations.map((d) => [d.slotId, d.decorationId, d.seq])).toEqual([
+      ['ice-cream-1', 'parasol', 1],
+      ['ice-cream-2', 'giant-cone', 2],
+      ['ice-cream-3', 'popsicle', 3],
+    ]);
+    expect(seq).toBe(3);
+  });
+
+  it('full: the 4th grant replaces slot -1 (lowest seq) with sundae', () => {
+    const { results, decorations } = grantN(4);
+    expect(results[3]).toEqual({
+      slot: { slotId: 'ice-cream-1', stationId: 'ice-cream', decorationId: 'sundae', seq: 4 },
+      replaced: { decorationId: 'parasol' },
+    });
+    expect(decorations).toHaveLength(3);
+  });
+
+  it('second lap: 5th → -2 ← parasol (wrap), 6th → -3 ← giant-cone; never more than 3 entries', () => {
+    const { results, decorations } = grantN(6);
+    expect(results[4]).toEqual({
+      slot: { slotId: 'ice-cream-2', stationId: 'ice-cream', decorationId: 'parasol', seq: 5 },
+      replaced: { decorationId: 'giant-cone' },
+    });
+    expect(results[5]?.slot).toMatchObject({ slotId: 'ice-cream-3', decorationId: 'giant-cone', seq: 6 });
+    expect(results[5]?.replaced).toEqual({ decorationId: 'popsicle' });
+    expect(decorations).toHaveLength(3);
+    expect(new Set(decorations.map((d) => d.slotId)).size).toBe(3);
+  });
+
+  it('isolation: another station full is never touched', () => {
+    const pizza: DecorationSlot[] = [1, 2, 3].map((n) => ({ slotId: `pizza-${n}`, stationId: 'pizza', decorationId: 'tomato', seq: n }));
+    const plan = planGrant(pizza, 3, 'ice-cream', SLOTS, ITEMS)!;
+    expect(plan.decorations.slice(0, 3)).toEqual(pizza);
+    expect(plan.result.slot).toMatchObject({ slotId: 'ice-cream-1', decorationId: 'parasol', seq: 4 });
+  });
+
+  it('orphan / duplicate: dropped on the next grant of that station (the highest seq kept)', () => {
+    const saved: DecorationSlot[] = [
+      { slotId: 'ice-cream-9', stationId: 'ice-cream', decorationId: 'sundae', seq: 7 },
+      { slotId: 'ice-cream-1', stationId: 'ice-cream', decorationId: 'parasol', seq: 2 },
+      { slotId: 'ice-cream-1', stationId: 'ice-cream', decorationId: 'giant-cone', seq: 3 },
+      { slotId: 'pizza-9', stationId: 'pizza', decorationId: 'tomato', seq: 1 },
+    ];
+    const plan = planGrant(saved, 7, 'ice-cream', SLOTS, ITEMS)!;
+    // Newest valid item is giant-cone (seq 3) → popsicle into the first free slot (-2).
+    expect(plan.result).toEqual({ slot: { slotId: 'ice-cream-2', stationId: 'ice-cream', decorationId: 'popsicle', seq: 8 } });
+    expect(plan.decorations.map((d) => `${d.slotId}:${d.decorationId}`)).toEqual([
+      'ice-cream-1:giant-cone',
+      'pizza-9:tomato', // another station's orphan is left alone
+      'ice-cream-2:popsicle',
+    ]);
+  });
+
+  it('gone item: the newest item is not in the catalogue → the first item', () => {
+    const saved: DecorationSlot[] = [{ slotId: 'ice-cream-1', stationId: 'ice-cream', decorationId: 'unicorn', seq: 1 }];
+    expect(planGrant(saved, 1, 'ice-cream', SLOTS, ITEMS)!.result.slot).toMatchObject({ slotId: 'ice-cream-2', decorationId: 'parasol', seq: 2 });
+  });
+
+  it('seq comes from the document counter, not from the entries', () => {
+    expect(planGrant([], 41, 'ice-cream', SLOTS, ITEMS)!.result.slot.seq).toBe(42);
+  });
+
+  it('no slots or an empty catalogue → null', () => {
+    expect(planGrant([], 0, 'ice-cream', [], ITEMS)).toBeNull();
+    expect(planGrant([], 0, 'ice-cream', SLOTS, [])).toBeNull();
+  });
+
+  it('returns copies: mutating the result never changes the input', () => {
+    const saved: DecorationSlot[] = [{ slotId: 'pizza-1', stationId: 'pizza', decorationId: 'tomato', seq: 1 }];
+    const plan = planGrant(saved, 1, 'ice-cream', SLOTS, ITEMS)!;
+    plan.decorations[0]!.seq = 99;
+    expect(saved[0]!.seq).toBe(1);
+  });
+});
+
+describe('cleanStation', () => {
+  it('keeps one entry per listed slot of the station, the highest seq', () => {
+    const list: DecorationSlot[] = [
+      { slotId: 'ice-cream-1', stationId: 'ice-cream', decorationId: 'a', seq: 5 },
+      { slotId: 'ice-cream-1', stationId: 'ice-cream', decorationId: 'b', seq: 4 },
+      { slotId: 'ice-cream-4', stationId: 'ice-cream', decorationId: 'c', seq: 6 },
+      { slotId: 'ice-cream-2', stationId: 'pizza', decorationId: 'd', seq: 1 },
+    ];
+    expect(cleanStation(list, 'ice-cream', SLOTS).map((d) => d.decorationId)).toEqual(['a']);
+  });
+});
