+    expect(items).toEqual([]);
+    expect(warnings).toHaveLength(3);
+    expect(warnings[2]).toContain('pivot slot "pizza-1"');
+  });
+
+  it('unknown station: skipped with a warning', () => {
+    const odd = { slotId: 'race-1', stationId: 'race', decorationId: 'cone', seq: 1 } as DecorationSlot;
+    const { items, warnings } = planDecorations([odd], layout, stations, catalogue, frameRect, PAD);
+    expect(items).toEqual([]);
+    expect(warnings).toHaveLength(1);
+  });
+
+  it('duplicate slot: the highest seq is drawn, the other is skipped with one warning (either order)', () => {
+    for (const saved of [
+      [entry('ice-cream-1', 'parasol', 1), entry('ice-cream-1', 'giant-cone', 4)],
+      [entry('ice-cream-1', 'giant-cone', 4), entry('ice-cream-1', 'parasol', 1)],
+    ]) {
+      const { items, warnings } = planDecorations(saved, layout, stations, catalogue, frameRect, PAD);
+      expect(items.map((i) => i.decorationId)).toEqual(['giant-cone']);
+      expect(warnings).toEqual([expect.stringContaining('"parasol"')]);
+    }
+  });
+});
+
+describe('decorationFootprint', () => {
+  it('trimmed rect ÷ renderScale, shifted by at − pivot', () => {
+    expect(decorationFootprint({ x: 100, y: 200, width: 50, height: 80 }, { x: 10, y: 20 }, { x: 15, y: 10 }, 2)).toEqual({
+      x: 55,
+      y: 90,
+      width: 25,
+      height: 40,
+    });
+  });
+});
+
+describe('Map sync helpers (review loop 1)', () => {
+  const plan = (saved: DecorationSlot[]) => planDecorations(saved, layout, stations, catalogue, frameRect, PAD).items;
+
+  it('spriteSourceRect maps {x,y,w,h} to {x,y,width,height}; missing data → undefined', () => {
+    expect(spriteSourceRect({ x: 1, y: 2, w: 3, h: 4 })).toEqual({ x: 1, y: 2, width: 3, height: 4 });
+    expect(spriteSourceRect(undefined)).toBeUndefined();
+  });
+
+  it('a grant made while Map sleeps is added on the next sync; drawn ones are kept', () => {
+    const before = plan([entry('ice-cream-1', 'parasol', 1)]);
+    const drawn = before.map((i) => i.key);
+    const after = plan([entry('ice-cream-1', 'parasol', 1), entry('ice-cream-2', 'giant-cone', 2)]);
+    const diff = diffDecorations(drawn, after);
+    expect(diff.remove).toEqual([]);
+    expect(diff.add.map((i) => i.key)).toEqual(['ice-cream-2#2']);
+  });
+
+  it('a replacement (same slot, new seq) destroys the old prop and adds the new one', () => {
+    const drawn = plan([entry('ice-cream-1', 'parasol', 1)]).map((i) => i.key);
+    const diff = diffDecorations(drawn, plan([entry('ice-cream-1', 'giant-cone', 4)]));
+    expect(diff.remove).toEqual(['ice-cream-1#1']);
+    expect(diff.add.map((i) => [i.key, i.decorationId])).toEqual([['ice-cream-1#4', 'giant-cone']]);
+  });
+
+  it('an emptied document removes every prop', () => {
+    expect(diffDecorations(['ice-cream-1#1', 'pizza-2#3'], [])).toEqual({ remove: ['ice-cream-1#1', 'pizza-2#3'], add: [] });
+  });
+});
