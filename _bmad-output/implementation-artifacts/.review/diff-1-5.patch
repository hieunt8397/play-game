@@ -0,0 +1,82 @@
+// Tap routing (Story 1.5, minimal; Story 1.6 adds layers, InputGuard registration, up events and
+// `toDesign`). One `pointerdown` listener per scene. Every tap first calls `onAnyTap` (hit or miss),
+// then the topmost enabled target containing the point — the last one registered — gets `onTap`.
+// A miss does nothing else. This is the only place (with core/input) that touches pointer events.
+import type { Point } from './polygon';
+
+export interface PointerLike {
+  readonly x: number;
+  readonly y: number;
+}
+
+/** Slice of `Phaser.Scene` the router needs (fakeable in node tests). */
+export interface RouterSceneLike {
+  readonly input: {
+    on(event: string, fn: (pointer: PointerLike) => void): unknown;
+    off(event: string, fn: (pointer: PointerLike) => void): unknown;
+  };
+  readonly events: {
+    once(event: string, fn: () => void): unknown;
+  };
+}
+
+export interface RouterTarget {
+  contains(p: Point): boolean;
+  isEnabled(): boolean;
+  onTap(p: Point): void;
+}
+
+export interface TapRouter {
+  /** Registers a target on top of the earlier ones; returns its removal function. */
+  add(target: RouterTarget): () => void;
+  /** Called first on every tap, hit or miss (Map: reset idle). */
+  onAnyTap: ((p: Point) => void) | undefined;
+  /** Removes the listener and every target (also runs on scene shutdown). */
+  destroy(): void;
+}
+
+export const POINTER_DOWN = 'pointerdown';
+const SHUTDOWN = 'shutdown';
+
+/** The design point of a pointer. Story 1.6 swaps in `toDesign`. */
+export function pointerPoint(pointer: PointerLike): Point {
+  return { x: pointer.x, y: pointer.y };
+}
+
+export function createTapRouter(scene: RouterSceneLike): TapRouter {
+  let targets: RouterTarget[] = [];
+  let live = true;
+
+  const onDown = (pointer: PointerLike): void => {
+    const p = pointerPoint(pointer);
+    router.onAnyTap?.(p);
+    for (let i = targets.length - 1; i >= 0; i--) {
+      const t = targets[i]!;
+      if (t.isEnabled() && t.contains(p)) {
+        t.onTap(p);
+        return;
+      }
+    }
+  };
+
+  const router: TapRouter = {
+    onAnyTap: undefined,
+    add(target) {
+      targets.push(target);
+      return () => {
+        targets = targets.filter((t) => t !== target);
+      };
+    },
+    destroy() {
+      if (!live) return;
+      live = false;
+      scene.input.off(POINTER_DOWN, onDown);
+      targets = [];
+      router.onAnyTap = undefined;
+    },
+  };
+
+  scene.input.on(POINTER_DOWN, onDown);
+  scene.events.once(SHUTDOWN, () => router.destroy());
+  return router;
+}
