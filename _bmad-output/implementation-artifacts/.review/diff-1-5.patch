+// `tappable-prop` on the Map (Story 1.5; Story 2.2 decorations reuse it). A full-frame atlas image
+// placed on its ground pivot, with a padded rect hotspot. A tap bounces it to
+// tappableProp.react.scale over react.durationMs and calls `onTap` (the caller plays the sound).
+// It never opens a game.
+import type { GameObjects, Scene } from 'phaser';
+import { HotspotPolygon } from '../input/hotspot-polygon';
+import type { Point } from '../input/polygon';
+import type { TapRouter } from '../input/tap-router';
+import type { PlannedImage } from '../map-plan';
+import { amplitude } from '../reduced-motion';
+import { Tokens } from '../tokens';
+import { bounce } from './scale-motion';
+
+export interface MapPropOptions {
+  readonly texture: string;
+  /** Placement of the full frame (core/map-plan). */
+  readonly frame: PlannedImage;
+  /** The hit polygon (the trimmed rect padded by hitPad). */
+  readonly rect: readonly Point[];
+  readonly onTap: () => void;
+  readonly depth?: number | undefined;
+  readonly reduced?: boolean;
+}
+
+export interface MapProp {
+  readonly image: GameObjects.Image;
+  readonly hotspot: HotspotPolygon;
+  destroy(): void;
+}
+
+export function createMapProp(scene: Scene, router: TapRouter, opts: MapPropOptions): MapProp {
+  const f = opts.frame;
+  const image = scene.add.image(f.x, f.y, opts.texture, f.frame).setOrigin(f.originX, f.originY).setScale(f.scale);
+  if (opts.depth !== undefined) image.setDepth(opts.depth);
+  const react = Tokens.components.tappableProp.react;
+  const peak = amplitude(react.scale, opts.reduced ?? false);
+  const hotspot = new HotspotPolygon(router, opts.rect, () => {
+    bounce(scene, image, f.scale, peak, react.durationMs);
+    opts.onTap();
+  });
+  return {
+    image,
+    hotspot,
+    destroy() {
+      hotspot.destroy();
+      image.destroy();
+    },
+  };
+}
