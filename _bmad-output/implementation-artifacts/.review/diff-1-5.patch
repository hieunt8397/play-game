@@ -0,0 +1,150 @@
+// I/O matrix (Story 1.2): "Load fails" and "Gate dev" rows.
+import { describe, expect, it, vi } from 'vitest';
+import { AUDIO_CATALOG, AUDIO_IDS } from '../content/audio-catalog';
+import {
+  bootAudio,
+  bootTextures,
+  FONT_FAMILY,
+  FONT_PROBE,
+  FONT_URL,
+  kartTimeScale,
+  nextLoadState,
+  waitForReady,
+  type LoadEvent,
+  type LoadState,
+  type ReadyDeps,
+} from './boot-load';
+import { Timing } from './timing';
+
+describe('nextLoadState', () => {
+  const table: Array<[LoadState, LoadEvent, LoadState]> = [
+    ['loading', 'complete', 'ready'],
+    ['loading', 'error', 'waiting'],
+    ['loading', 'online', 'loading'],
+    ['loading', 'retryTick', 'loading'],
+    ['waiting', 'online', 'loading'],
+    ['waiting', 'retryTick', 'loading'],
+    ['waiting', 'error', 'waiting'],
+    ['waiting', 'complete', 'ready'],
+    ['ready', 'error', 'ready'],
+    ['ready', 'online', 'ready'],
+    ['ready', 'retryTick', 'ready'],
+    ['ready', 'complete', 'ready'],
+  ];
+  it.each(table)('%s + %s → %s', (state, event, expected) => {
+    expect(nextLoadState(state, event)).toBe(expected);
+  });
+
+  it('a failed load slows the kart, retries, then reaches ready', () => {
+    let s: LoadState = 'loading';
+    expect(kartTimeScale(s)).toBe(1);
+    s = nextLoadState(s, 'error');
+    expect(kartTimeScale(s)).toBe(Timing.loadingKartWaitTimeScale);
+    expect(Timing.loadingKartWaitTimeScale).toBeLessThan(1);
+    s = nextLoadState(s, 'online');
+    expect(kartTimeScale(s)).toBe(1);
+    s = nextLoadState(s, 'complete');
+    expect(s).toBe('ready');
+  });
+});
+
+function fakes(opts: { fontOk?: boolean; probeFaces?: number; registration?: unknown } = {}) {
+  const { fontOk = true, probeFaces = 1, registration = undefined } = opts;
+  const faces: Array<{ family: string; source: string; descriptors: { weight: string }; load: () => Promise<unknown> }> = [];
+  let resolveReady: (v: unknown) => void = () => undefined;
+  const sw = {
+    getRegistration: vi.fn(async () => registration),
+    ready: new Promise((r) => {
+      resolveReady = r;
+    }),
+  };
+  const fonts = {
+    add: vi.fn(),
+    delete: vi.fn(),
+    load: vi.fn(async (_font: string) => Array.from({ length: probeFaces }, () => ({}))),
+  };
+  const deps: ReadyDeps = {
+    isDev: false,
+    sw,
+    fonts,
+    fontFace: (family, source, descriptors) => {
+      const face = { family, source, descriptors, load: () => (fontOk ? Promise.resolve(face) : Promise.reject(new Error('NetworkError'))) };
+      faces.push(face);
+      return face;
+    },
+  };
+  return { deps, sw, fonts, faces, resolveReady: (v: unknown) => resolveReady(v) };
+}
+
+describe('waitForReady', () => {
+  it('registers the vendored Baloo 2 with a relative URL and awaits the 600 18px probe', async () => {
+    const f = fakes();
+    await waitForReady(f.deps);
+    expect(f.faces).toHaveLength(1);
+    expect(f.faces[0]?.family).toBe(FONT_FAMILY);
+    expect(f.faces[0]?.source).toBe(`url(${FONT_URL})`);
+    expect(FONT_URL).not.toMatch(/^(\/|https?:)/);
+    expect(f.fonts.add).toHaveBeenCalledWith(f.faces[0]);
+    expect(f.fonts.load).toHaveBeenCalledWith(FONT_PROBE);
+    expect(FONT_PROBE).toBe("600 18px 'Baloo 2'");
+  });
+
+  it('gate dev: skips the SW step in DEV even with a registration', async () => {
+    const f = fakes({ registration: {} });
+    await waitForReady({ ...f.deps, isDev: true });
+    expect(f.sw.getRegistration).not.toHaveBeenCalled();
+    expect(f.fonts.load).toHaveBeenCalled();
+  });
+
+  it('skips the SW step when there is no registration or no SW support', async () => {
+    const f = fakes();
+    await waitForReady(f.deps);
+    expect(f.sw.getRegistration).toHaveBeenCalled();
+    await waitForReady({ ...f.deps, sw: undefined });
+    expect(f.fonts.load).toHaveBeenCalledTimes(2);
+  });
+
+  it('with a registration, waits for serviceWorker.ready before the font', async () => {
+    const f = fakes({ registration: {} });
+    let done = false;
+    const p = waitForReady(f.deps).then(() => {
+      done = true;
+    });
+    await Promise.resolve();
+    await Promise.resolve();
+    expect(done).toBe(false);
+    expect(f.fonts.load).not.toHaveBeenCalled();
+    f.resolveReady({});
+    await p;
+    expect(done).toBe(true);
+  });
+
+  it('rejects when the font fails, removing the failed face so a retry starts fresh', async () => {
+    const f = fakes({ fontOk: false });
+    await expect(waitForReady(f.deps)).rejects.toThrow('NetworkError');
+    expect(f.fonts.delete).toHaveBeenCalledWith(f.faces[0]);
+  });
+
+  it('rejects when the probe matches no face', async () => {
+    const f = fakes({ probeFaces: 0 });
+    await expect(waitForReady(f.deps)).rejects.toThrow(/did not load/);
+  });
+});
+
+describe('bootAudio', () => {
+  it('loads every catalog id and the shell voice lines keyed by id', () => {
+    const list = bootAudio();
+    expect(list).toContainEqual(['vo.shell.greeting', 'assets/audio/vo/vo.shell.greeting.m4a']);
+    for (const id of AUDIO_IDS) expect(list).toContainEqual([id, AUDIO_CATALOG[id].path]);
+    expect(list.filter(([key]) => key.startsWith('vo.') && !key.startsWith('vo.shell.'))).toEqual([]);
+  });
+});
+
+describe('bootTextures (Story 1.5)', () => {
+  it('loads the map atlas and the map plate', () => {
+    expect(bootTextures()).toEqual([
+      { kind: 'atlas', key: 'atlas.map', png: 'assets/atlases/map.png', json: 'assets/atlases/map.json' },
+      { kind: 'image', key: 'bg.map', path: 'assets/bg/map.png' },
+    ]);
+  });
+});
diff --git a/app/src/scenes/Boot.ts b/app/src/scenes/Boot.ts
new file mode 100644
index 0000000..fc46c27
--- /dev/null
+++ b/app/src/scenes/Boot.ts
@@ -0,0 +1,114 @@
+// Boot (Story 1.2): sky + loading-strip only (no text, no bar, no button). Loads the shared/map
+// assets (the SFX/music catalog, every vo.shell.* voice line, and since Story 1.5 the map atlas and
+// plate), then waits for the readiness gate (SW + self-hosted Baloo 2).
+// On a loader error or gate rejection the kart slows and waits; the load retries on window
+// `online` or every Tokens.Timing.loadRetryMs. Errors go only to console.warn.
+// When ready: launches AudioUnlockOverlay (it sleeps itself) and starts Start.
+import { Scene } from "phaser";
+import {
+  bootAudio,
+  bootTextures,
+  kartTimeScale,
+  nextLoadState,
+  waitForReady,
+  type LoadEvent,
+  type LoadState,
+} from "../core/boot-load";
+import { Tokens } from "../core/tokens";
+import {
+  createLoadingStrip,
+  type LoadingStrip,
+} from "../core/ui/loading-strip";
+
+const LOADER_ERROR = "loaderror";
+const LOADER_COMPLETE = "complete";
+const ONLINE = "online";
+/** Audio cache key → URL of everything Boot loads. */
+const BOOT_AUDIO = bootAudio();
+/** Textures Boot loads (Story 1.5: atlas.map + bg.map). */
+const BOOT_TEXTURES = bootTextures();
+
+export class Boot extends Scene {
+  private state: LoadState = "loading";
+  private strip: LoadingStrip | undefined;
+  private readonly onOnline = (): void => this.dispatch("online");
+
+  constructor() {
+    super("Boot");
+  }
+
+  create(): void {
+    this.state = "loading";
+    this.cameras.main.setBackgroundColor(Tokens.colors.sky.css);
+    this.strip = createLoadingStrip(this, Tokens.safeRect);
+
+    window.addEventListener(ONLINE, this.onOnline);
+    this.events.once("shutdown", () =>
+      window.removeEventListener(ONLINE, this.onOnline),
+    );
+    this.time.addEvent({
+      delay: Tokens.Timing.loadRetryMs,
+      loop: true,
+      callback: () => this.dispatch("retryTick"),
+    });
+
+    this.attempt();
+  }
+
+  private dispatch(event: LoadEvent): void {
+    const prev = this.state;
+    const next = nextLoadState(prev, event);
+    if (next === prev) return;
+    this.state = next;
+    this.strip?.setTimeScale(kartTimeScale(next));
+    if (next === "ready") {
+      this.scene.launch("AudioUnlockOverlay");
+      this.scene.start("Start");
+    } else if (next === "loading") {
+      this.attempt();
+    }
+  }
+
+  /** One load attempt: queue the assets not yet cached, then the readiness gate. */
+  private attempt(): void {
+    const missing = BOOT_AUDIO.filter(([key]) => !this.cache.audio.exists(key));
+    const missingTextures = BOOT_TEXTURES.filter((t) => !this.textures.exists(t.key));
+    if (missing.length === 0 && missingTextures.length === 0) {
+      this.gate();
+      return;
+    }
+    let failed = false;
+    const onError = (file: { key: string; src?: string }): void => {
+      failed = true;
+      console.warn(`boot: failed to load "${file.key}"`, file.src);
+    };
+    this.load.on(LOADER_ERROR, onError);
+    this.load.once(LOADER_COMPLETE, () => {
+      this.load.off(LOADER_ERROR, onError);
+      if (failed) this.dispatch("error");
+      else this.gate();
+    });
+    for (const [key, url] of missing) this.load.audio(key, url);
+    for (const tex of missingTextures) {
+      if (tex.kind === "atlas") this.load.atlas(tex.key, tex.png, tex.json);
+      else this.load.image(tex.key, tex.path);
+    }
+    this.load.start();
+  }
+
+  private gate(): void {
+    waitForReady({
+      isDev: import.meta.env.DEV,
+      sw: "serviceWorker" in navigator ? navigator.serviceWorker : undefined,
+      fonts: document.fonts,
+      fontFace: (family, source, descriptors) =>
+        new FontFace(family, source, descriptors),
+    }).then(
+      () => this.dispatch("complete"),
+      (error: unknown) => {
+        console.warn("boot: readiness gate failed — retrying", error);
+        this.dispatch("error");
+      },
+    );
+  }
+}
diff --git a/app/src/scenes/Map.ts b/app/src/scenes/Map.ts
new file mode 100644
index 0000000..0dff56e
--- /dev/null
+++ b/app/src/scenes/Map.ts
@@ -0,0 +1,219 @@
+// Map (Story 1.5): the island. Draws the plate `bg.map`, the 7 station sprites from `atlas.map`
+// (full-frame on their ground pivots, spec-1-4 contract), a static parent-facing label under each
+// station and the kart as the map's tappable prop. Taps go through core/input (one router per scene):
+// awake station → bounce + name line (prompt), sleeping station → bounce + happy sound, kart →
+// prop bounce + small sound; every tap resets idle. Idle: core/map-idle drives the ambient motion
+// and up to 3 invitations (hint ring + bob + invite and name lines). Planning, idle, geometry and
+// routing are pure core code; this scene only wires Phaser. No navigation yet (Story 1.7).
+import { Scene, type GameObjects } from 'phaser';
+import { ATLASES, BACKGROUNDS } from '../content/assets';
+import { LAYOUTS } from '../content/layouts';
+import { STATIONS } from '../content/stations';
+import { inviteLine, stationNameLine } from '../content/voice-lines';
+import { audio } from '../core/audio-director';
+import { createHintRing, type HintRing } from '../core/hint-visuals';
+import { HotspotPolygon } from '../core/input/hotspot-polygon';
+import { boundingBox } from '../core/input/polygon';
+import { createTapRouter } from '../core/input/tap-router';
+import { createMapIdle, type MapIdle, type MapIdleEvent } from '../core/map-idle';
+import { planMap, type MapPlan, type PlannedStation } from '../core/map-plan';
+import { amplitude, prefersReducedMotion } from '../core/reduced-motion';
+import { Tokens } from '../core/tokens';
+import { createMapProp } from '../core/ui/map-prop';
+import { bob, bounce, isMoving, stopMotion } from '../core/ui/scale-motion';
+
+const SFX_HAPPY = 'sfx.shell.happy';
+const SFX_PROP = 'sfx.shell.prop';
+
+interface StationView {
+  readonly plan: PlannedStation;
+  readonly image: GameObjects.Image | undefined;
+}
+
+interface FrameData {
+  readonly spriteSourceSize?: { x: number; y: number; w: number; h: number };
+}
+
+export class MapScene extends Scene {
+  private idle: MapIdle | undefined;
+  private views = new Map<string, StationView>();
+  private ring: HintRing | undefined;
+  private reduced = false;
+  private plan: MapPlan | undefined;
+
+  constructor() {
+    super('Map');
+  }
+
+  create(): void {
+    this.cameras.main.setBackgroundColor(Tokens.colors.sky.css);
+    this.reduced = prefersReducedMotion(window);
+    this.views = new Map();
+    this.ring = undefined;
+
+    const layout = LAYOUTS.map;
+    const atlasKey = ATLASES.map.key;
+    const hasAtlas = this.textures.exists(atlasKey);
+    const labels = new Map<string, GameObjects.Text>();
+    const label = (text: string): GameObjects.Text => {
+      let t = labels.get(text);
+      if (!t) {
+        t = this.addLabel(text);
+        labels.set(text, t);
+      }
+      return t;
+    };
+
+    const plan = planMap(
+      layout,
+      STATIONS,
+      (frame) => hasAtlas && this.textures.get(atlasKey).has(frame),
+      (frame) => {
+        const data = this.textures.get(atlasKey).get(frame).customData as FrameData | undefined;
+        const ss = data?.spriteSourceSize;
+        return ss ? { x: ss.x, y: ss.y, width: ss.w, height: ss.h } : undefined;
+      },
+      {
+        atlasKey,
+        measureLabel: (text) => {
+          const t = label(text);
+          return { w: t.width, h: t.height };
+        },
+      },
+    );
+    this.plan = plan;
+    for (const w of plan.warnings) console.warn(w);
+
+    const bgKey = BACKGROUNDS.map.key;
+    if (this.textures.exists(bgKey)) {
+      this.add.image(plan.bg.x, plan.bg.y, bgKey).setOrigin(0).setScale(plan.bg.scale).setDepth(plan.bg.depth);
+    } else {
+      console.warn(`map: texture "${bgKey}" is missing — plate skipped`);
+    }
+
+    const router = createTapRouter(this);
+    router.onAnyTap = () => this.handle(this.idle?.tap() ?? []);
+
+    // Hotspots register back to front (by depth), so the frontmost target wins an overlap.
+    const kart = plan.kart;
+    let kartAdded = false;
+    const addKart = (): void => {
+      if (!kart || kartAdded) return;
+      kartAdded = true;
+      createMapProp(this, router, {
+        texture: atlasKey,
+        frame: kart.image,
+        rect: kart.hit,
+        depth: kart.depth,
+        reduced: this.reduced,
+        onTap: () => audio.sfx(SFX_PROP),
+      });
+    };
+    for (const s of plan.stations) {
+      if (kart && kart.depth < s.depth) addKart();
+      const image = s.image
+        ? this.add.image(s.image.x, s.image.y, atlasKey, s.image.frame).setOrigin(s.image.originX, s.image.originY).setScale(s.image.scale).setDepth(s.depth)
+        : undefined;
+      this.views.set(s.id, { plan: s, image });
+      new HotspotPolygon(router, s.hit, () => this.tapStation(s.id));
+      label(s.label).setPosition(s.labelPos.x, s.labelPos.y).setDepth(plan.labelDepth);
+    }
+    addKart();
+
+    this.idle = createMapIdle({
+      stations: plan.stations.map((s) => s.id),
+      awake: plan.stations.filter((s) => s.awake).map((s) => s.id),
+      timing: {
+        ambientMinMs: Tokens.Timing.mapAmbientMinMs,
+        ambientMaxMs: Tokens.Timing.mapAmbientMaxMs,
+        inviteFirstMs: Tokens.Timing.mapInviteFirstMs,
+        inviteGapMs: Tokens.Timing.mapInviteGapMs,
+        inviteMaxCount: Tokens.Timing.mapInviteMaxCount,
+        inviteHoldMs: Tokens.Timing.mapInviteHoldMs,
+      },
+    });
+    this.events.once('shutdown', () => {
+      this.ring?.destroy();
+      this.ring = undefined;
+      this.idle = undefined;
+    });
+  }
+
+  override update(_time: number, delta: number): void {
+    if (this.idle) this.handle(this.idle.tick(delta));
+  }
+
+  private handle(events: readonly MapIdleEvent[]): void {
+    for (const ev of events) {
+      if (ev.kind === 'ambient') this.ambient(ev.id);
+      else if (ev.kind === 'invite') this.invite(ev.id);
+      else this.endInvite(ev.id);
+    }
+  }
+
+  private addLabel(text: string): GameObjects.Text {
+    const spec = Tokens.components.stationLabel;
+    const type = spec.typography;
+    return this.add
+      .text(0, 0, text, {
+        fontFamily: type.fontFamily,
+        fontSize: `${type.fontSize}px`,
+        fontStyle: String(type.fontWeight),
+        color: spec.color.css,
+        stroke: spec.outline.color.css,
+        strokeThickness: spec.outline.width,
+        align: 'center',
+      })
+      .setOrigin(0.5, 0)
+      .setAlpha(spec.opacity);
+  }
+
+  /** Feedback starts in this pointerdown handler (≤ Timing.feedbackMaxMs). */
+  private tapStation(id: string): void {
+    const view = this.views.get(id);
+    if (!view) return;
+    if (view.image) {
+      bounce(this, view.image, view.plan.image?.scale ?? 1, amplitude(Tokens.ui.stationTapScale, this.reduced), Tokens.Timing.stationTapMs);
+    }
+    if (view.plan.awake) {
+      const line = stationNameLine(id);
+      audio.say(line);
+      audio.setPrompt(line);
+    } else {
+      audio.sfx(SFX_HAPPY);
+    }
+  }
+
+  private ambient(id: string): void {
+    const view = this.views.get(id);
+    if (!view?.image || isMoving(view.image)) return;
+    bounce(this, view.image, view.plan.image?.scale ?? 1, amplitude(Tokens.ui.ambientScale, this.reduced), Tokens.Timing.mapAmbientMoveMs);
+  }
+
+  private invite(id: string): void {
+    const view = this.views.get(id);
+    if (!view) return;
+    this.ring = createHintRing(this, boundingBox(view.plan.hit), { reduced: this.reduced, depth: this.plan?.ringDepth });
+    if (view.image) {
+      const pulse = Tokens.components.stationHotspot.pulse;
+      bob(
+        this,
+        view.image,
+        view.plan.image?.scale ?? 1,
+        amplitude(pulse.from, this.reduced),
+        amplitude(pulse.to, this.reduced),
+        pulse.durationMs,
+      );
+    }
+    const line = inviteLine(id);
+    audio.sayChain([line, stationNameLine(id)]);
+    audio.setPrompt(line);
+  }
+
+  private endInvite(id: string): void {
+    this.ring?.destroy();
+    this.ring = undefined;
+    const view = this.views.get(id);
+    if (view?.image) stopMotion(view.image, view.plan.image?.scale ?? 1);
+  }
+}
