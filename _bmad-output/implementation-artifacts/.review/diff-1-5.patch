+// A polygon tap area registered on a TapRouter (Story 1.5). The polygon is used exactly as given
+// (layout hit polygons are already padded; no extra padding here).
+import { pointInPolygon, type Point } from './polygon';
+import type { TapRouter } from './tap-router';
+
+export class HotspotPolygon {
+  private enabledFlag = true;
+  private readonly remove: () => void;
+  private readonly points: readonly Point[];
+
+  constructor(router: TapRouter, points: readonly Point[], onTap: (p: Point) => void) {
+    this.points = points.map((p) => ({ x: p.x, y: p.y }));
+    this.remove = router.add({
+      contains: (p) => pointInPolygon(p, this.points),
+      isEnabled: () => this.enabledFlag,
+      onTap,
+    });
+  }
+
+  get enabled(): boolean {
+    return this.enabledFlag;
+  }
+
+  setEnabled(enabled: boolean): this {
+    this.enabledFlag = enabled;
+    return this;
+  }
+
+  /** Unregisters the hotspot; it never fires again. */
+  destroy(): void {
+    this.enabledFlag = false;
+    this.remove();
+  }
+}
diff --git a/app/src/core/input/input.test.ts b/app/src/core/input/input.test.ts
