+    scene.tap(7, 5);
+    expect(b).toHaveBeenCalledWith({ x: 7, y: 5 });
+    expect(a).not.toHaveBeenCalled();
+    scene.tap(2, 5);
+    expect(a).toHaveBeenCalledTimes(1);
