+import { describe, expect, it } from 'vitest';
+import { SessionStore } from './session-store';
+
+describe('SessionStore', () => {
+  it('cold start: no last station, no trips, level 0', () => {
+    const s = new SessionStore();
+    expect(s.lastStation).toBeUndefined();
+    expect(s.kartTrips).toBe(0);
+    expect(s.levelFor('ice-cream', 3)).toBe(0);
+  });
+
+  it('levelFor clamps the stored level to the ladder', () => {
+    const s = new SessionStore();
+    s.levels['ice-cream'] = 5;
+    expect(s.levelFor('ice-cream', 3)).toBe(2);
+    s.levels['ice-cream'] = -2;
+    expect(s.levelFor('ice-cream', 3)).toBe(0);
+    s.levels['ice-cream'] = 1;
+    expect(s.levelFor('ice-cream', 3)).toBe(1);
+    expect(s.levelFor('ice-cream', 0)).toBe(0);
+  });
+
+  it('startData: level from the store, seed floor(rng × 2^31)', () => {
+    const s = new SessionStore();
+    s.levels.pizza = 1;
+    expect(s.startData('pizza', 5, () => 0.5)).toEqual({ level: 1, seed: 2 ** 30 });
+    expect(s.startData('pizza', 5, () => 0).seed).toBe(0);
+    const top = s.startData('pizza', 5, () => 1).seed;
+    expect(top).toBeLessThan(2 ** 31);
+    expect(Number.isInteger(top)).toBe(true);
+  });
+});
diff --git a/app/src/core/road.ts b/app/src/core/road.ts
new file mode 100644
index 0000000..b9b16c4
--- /dev/null
+++ b/app/src/core/road.ts
@@ -0,0 +1,83 @@
+// Road geometry (Story 1.7), pure. An open polyline in design px (`LAYOUTS.map.paths.road`) measured
+// by arc length `s` from its first point. The kart lives on `s`: a station's stop is
+// `project(anchors['<id>-stop'])`, the start is `project(anchors['kart-start'])`.
+// Works on any polyline (Story 4.1 may reuse it for the race track).
+import type { Point } from '../content/layout-types';
+
+export interface Road {
+  /** Total arc length (0 for fewer than two points). */
+  readonly length: number;
+  /** Arc length of the nearest point of the road to `p` (the first one on ties). */
+  project(p: Point): number;
+  /** The point at arc length `s` (clamped to [0, length]). */
+  pointAt(s: number): Point;
+  /**
+   * x component (−1…1) of the unit direction of travel at `s` when moving with `sign` (> 0 forward,
+   * < 0 backward). At a vertex the segment ahead in that direction is used. 0 on a vertical segment.
+   */
+  dirAt(s: number, sign: number): number;
+}
+
+interface Segment {
+  readonly a: Point;
+  readonly b: Point;
+  /** Arc length at `a`. */
+  readonly s0: number;
+  readonly len: number;
+}
+
+export function createRoad(points: readonly Point[]): Road {
+  const segs: Segment[] = [];
+  let total = 0;
+  for (let i = 1; i < points.length; i++) {
+    const a = points[i - 1]!;
+    const b = points[i]!;
+    const len = Math.hypot(b.x - a.x, b.y - a.y);
+    if (len === 0) continue;
+    segs.push({ a, b, s0: total, len });
+    total += len;
+  }
+  const first: Point = points[0] ?? { x: 0, y: 0 };
+  const clampS = (s: number): number => (Number.isFinite(s) ? Math.min(total, Math.max(0, s)) : 0);
+
+  /** Index of the segment holding `s`; at a vertex, the later one when `ahead`, else the earlier one. */
+  const segIndex = (s: number, ahead: boolean): number => {
+    for (let i = 0; i < segs.length; i++) {
+      const g = segs[i]!;
+      const end = g.s0 + g.len;
+      if (ahead ? s < end : s <= end) return i;
+    }
+    return segs.length - 1;
+  };
+
+  return {
+    length: total,
+    project(p) {
+      let best = 0;
+      let bestD = Infinity;
+      for (const g of segs) {
+        const dx = g.b.x - g.a.x;
+        const dy = g.b.y - g.a.y;
+        const t = Math.min(1, Math.max(0, ((p.x - g.a.x) * dx + (p.y - g.a.y) * dy) / (g.len * g.len)));
+        const d = Math.hypot(g.a.x + dx * t - p.x, g.a.y + dy * t - p.y);
+        if (d < bestD) {
+          bestD = d;
+          best = g.s0 + g.len * t;
+        }
+      }
+      return best;
+    },
+    pointAt(s) {
+      if (segs.length === 0) return { x: first.x, y: first.y };
+      const c = clampS(s);
+      const g = segs[segIndex(c, true)]!;
+      const t = (c - g.s0) / g.len;
+      return { x: g.a.x + (g.b.x - g.a.x) * t, y: g.a.y + (g.b.y - g.a.y) * t };
+    },
+    dirAt(s, sign) {
+      if (segs.length === 0 || sign === 0) return 0;
+      const g = segs[segIndex(clampS(s), sign > 0)]!;
+      return ((g.b.x - g.a.x) / g.len) * Math.sign(sign);
+    },
+  };
+}
diff --git a/app/src/core/road.test.ts b/app/src/core/road.test.ts
new file mode 100644
index 0000000..73e67b3
--- /dev/null
+++ b/app/src/core/road.test.ts
@@ -0,0 +1,66 @@
+import { describe, expect, it } from 'vitest';
+import { LAYOUTS } from '../content/layouts';
+import { createRoad } from './road';
+
+// An L: (0,0) → (100,0) → (100,50).
+const L = createRoad([
+  { x: 0, y: 0 },
+  { x: 100, y: 0 },
+  { x: 100, y: 50 },
+]);
+
+describe('createRoad', () => {
+  it('length is the sum of the segments', () => {
+    expect(L.length).toBe(150);
+  });
+
+  it('project: interior, end and corner points', () => {
+    expect(L.project({ x: 40, y: 10 })).toBeCloseTo(40);
+    expect(L.project({ x: 110, y: 30 })).toBeCloseTo(130);
+    expect(L.project({ x: -20, y: -5 })).toBe(0);
+    expect(L.project({ x: 120, y: 90 })).toBe(150);
+    expect(L.project({ x: 130, y: -30 })).toBeCloseTo(100);
+  });
+
+  it('pointAt: interpolates and clamps', () => {
+    expect(L.pointAt(50)).toEqual({ x: 50, y: 0 });
+    expect(L.pointAt(125)).toEqual({ x: 100, y: 25 });
+    expect(L.pointAt(-5)).toEqual({ x: 0, y: 0 });
+    expect(L.pointAt(999)).toEqual({ x: 100, y: 50 });
+  });
+
+  it('pointAt(project(p)) round-trips for points on the road', () => {
+    for (const s of [0, 33, 100, 140]) expect(L.project(L.pointAt(s))).toBeCloseTo(s);
+  });
+
+  it('dirAt: x direction of travel, the segment ahead at a vertex', () => {
+    expect(L.dirAt(50, 1)).toBe(1);
+    expect(L.dirAt(50, -1)).toBe(-1);
+    expect(L.dirAt(100, 1)).toBe(0); // going down the vertical leg
+    expect(L.dirAt(100, -1)).toBe(-1); // coming back along the horizontal one
+    expect(L.dirAt(120, 1)).toBe(0);
+    expect(L.dirAt(50, 0)).toBe(0);
+  });
+
+  it('degenerate roads stay safe', () => {
+    const empty = createRoad([]);
+    expect(empty.length).toBe(0);
+    expect(empty.pointAt(10)).toEqual({ x: 0, y: 0 });
+    expect(empty.dirAt(0, 1)).toBe(0);
+    const dot = createRoad([{ x: 5, y: 6 }, { x: 5, y: 6 }]);
+    expect(dot.length).toBe(0);
+    expect(dot.project({ x: 0, y: 0 })).toBe(0);
+    expect(dot.pointAt(0)).toEqual({ x: 5, y: 6 });
+  });
+
+  it('the real map road: every stop and the start project within a few px of the road', () => {
+    const layout = LAYOUTS.map;
+    const road = createRoad(layout.paths.road ?? []);
+    expect(road.length).toBeGreaterThan(1000);
+    for (const [id, p] of Object.entries(layout.anchors)) {
+      if (!id.endsWith('-stop') && id !== 'kart-start') continue;
+      const q = road.pointAt(road.project(p));
+      expect(Math.hypot(q.x - p.x, q.y - p.y), id).toBeLessThan(20);
+    }
+  });
+});
diff --git a/app/src/core/kart-trip.ts b/app/src/core/kart-trip.ts
new file mode 100644
index 0000000..74818df
--- /dev/null
+++ b/app/src/core/kart-trip.ts
@@ -0,0 +1,237 @@
+// Kart trip controller (Story 1.7), pure. Turns station and kart taps plus `tick(delta)` into
+// commands the Map applies; nothing here touches Phaser, timers or tweens, so the kart moves only on
+// `tick` (a paused scene freezes it) and Vitest covers the timing.
+//
+//   parked → (awake tap) departing [Timing.stationTapMs] → driving → arrived → (settled) entering
+//   entering → entered() → parked at that stop
+//
+// - Awake tap (parked/departing/driving): bounce, say + setPrompt the name, `load` the first time this
+//   trip targets the id. parked → departing; departing keeps its timer; driving re-targets from the
+//   current `s` with a new duration counted from the tap. Re-tapping the current target (or any awake
+//   tap while `arrived`) only bounces and says the name.
+// - Drive duration: clamp(|Δs| / cruise, minMs, capMs()), or 0 when Δs = 0; linear in `s`.
+// - Sleeping-station tap (any state but entering): bounce + happy SFX only.
+// - Kart tap: bounce + beep; while driving the remaining time × boostTimeScale.
+// - `enter` is emitted once, when the drive has ended and `assetsSettled(target)` was seen (either order).
+// - entering ignores every tap; `entered()` parks the kart at that stop.
+import { MAX_TICK_MS } from './map-idle';
+import type { Road } from './road';
+import { Tokens } from './tokens';
+
+export { MAX_TICK_MS };
+
+export const SFX_HAPPY = 'sfx.shell.happy';
+export const SFX_KART_BEEP = 'sfx.shell.kart-beep';
+/** The bounce target of the kart itself. */
+export const KART_TARGET = 'kart';
+/** |dx| below this (a near-vertical road stretch) keeps the current facing (move dx = 0). */
+export const FACING_MIN_DX = 0.25;
+
+export type TripState = 'parked' | 'departing' | 'driving' | 'arrived' | 'entering';
+
+export type TripCommand =
+  | { readonly kind: 'bounce'; readonly target: string }
+  | { readonly kind: 'say'; readonly lineId: string }
+  | { readonly kind: 'setPrompt'; readonly lineId: string }
+  | { readonly kind: 'sfx'; readonly id: string }
+  | { readonly kind: 'load'; readonly gameId: string }
+  /** `dx`: x direction of travel (−1…1); 0 = keep the current facing. */
+  | { readonly kind: 'move'; readonly x: number; readonly y: number; readonly dx: number }
+  | { readonly kind: 'enter'; readonly gameId: string };
+
+export interface KartTripTiming {
+  readonly departMs: number;
+  readonly minMs: number;
+  readonly cruisePxPerMs: number;
+  readonly boostTimeScale: number;
+}
+
+export interface KartTripOptions {
+  readonly road: Pick<Road, 'pointAt' | 'dirAt'>;
+  /** Arc length of each station's stop (`project(anchors['<id>-stop'])`). */
+  readonly stops: Readonly<Record<string, number>>;
+  readonly startS: number;
+  /** Drive cap: kartDriveMaxMs until the session's first arrival, then kartDriveRepeatMaxMs. */
+  readonly capMs: () => number;
+  /** True when the station opens a game (its id is in games/registry GAMES). */
+  readonly isAwake: (id: string) => boolean;
+  /** The name line of a station (content/voice-lines › stationNameLine). */
+  readonly nameLine: (id: string) => string;
+  /** Called on every arrival (Map counts the session's trips). */
+  readonly onArrive?: (id: string) => void;
+  readonly timing?: KartTripTiming;
+}
+
+export const DEFAULT_TRIP_TIMING: KartTripTiming = {
+  departMs: Tokens.Timing.stationTapMs,
+  minMs: Tokens.Timing.kartDriveMinMs,
+  cruisePxPerMs: Tokens.ui.kartCruisePxPerMs,
+  boostTimeScale: Tokens.ui.kartBoostTimeScale,
+};
+
+interface Drive {
+  from: number;
+  to: number;
+  duration: number;
+  elapsed: number;
+}
+
+export class KartTrip {
+  private _state: TripState = 'parked';
+  private _s: number;
+  private _target: string | undefined;
+  private departLeft = 0;
+  private drive: Drive | undefined;
+  /** Ids already loaded this trip. */
+  private readonly loaded = new Set<string>();
+  /** Ids whose assets settled this trip. */
+  private readonly settled = new Set<string>();
+  private readonly timing: KartTripTiming;
+  private readonly opts: KartTripOptions;
+
+  constructor(opts: KartTripOptions) {
+    this.opts = opts;
+    this._s = opts.startS;
+    this.timing = opts.timing ?? DEFAULT_TRIP_TIMING;
+  }
+
+  get state(): TripState {
+    return this._state;
+  }
+
+  get s(): number {
+    return this._s;
+  }
+
+  get target(): string | undefined {
+    return this._target;
+  }
+
+  /** Remaining drive time (ms) while driving, else 0. */
+  get remainingMs(): number {
+    return this.drive ? Math.max(0, this.drive.duration - this.drive.elapsed) : 0;
+  }
+
+  /** Duration (ms) of the current drive (since its start, re-target or boost), else 0. */
+  get driveMs(): number {
+    return this.drive?.duration ?? 0;
+  }
+
+  /** Drive time for |Δs| = `distance` px under the current cap. */
+  durationFor(distance: number): number {
+    const d = Math.abs(distance);
+    if (d === 0) return 0;
+    return Math.min(this.opts.capMs(), Math.max(this.timing.minMs, d / this.timing.cruisePxPerMs));
+  }
+
+  tapStation(id: string): TripCommand[] {
+    if (this._state === 'entering') return [];
+    if (!this.opts.isAwake(id)) return [{ kind: 'bounce', target: id }, { kind: 'sfx', id: SFX_HAPPY }];
+    const line = this.opts.nameLine(id);
+    const out: TripCommand[] = [{ kind: 'bounce', target: id }, { kind: 'say', lineId: line }];
+    const stop = this.opts.stops[id];
+    if (this._state === 'arrived' || stop === undefined) return out;
+    if (this._state !== 'parked' && id === this._target) return out;
+    out.push({ kind: 'setPrompt', lineId: line });
+    if (!this.loaded.has(id)) {
+      this.loaded.add(id);
+      out.push({ kind: 'load', gameId: id });
+    }
+    this._target = id;
+    if (this._state === 'parked') {
+      this._state = 'departing';
+      this.departLeft = this.timing.departMs;
+    } else if (this._state === 'driving') {
+      this.startDrive();
+    }
+    return out;
+  }
+
+  tapKart(): TripCommand[] {
+    if (this._state === 'entering') return [];
+    if (this._state === 'driving' && this.drive) {
+      const left = Math.max(0, this.drive.duration - this.drive.elapsed);
+      this.drive = { from: this._s, to: this.drive.to, duration: left * this.timing.boostTimeScale, elapsed: 0 };
+    }
+    return [
+      { kind: 'bounce', target: KART_TARGET },
+      { kind: 'sfx', id: SFX_KART_BEEP },
+    ];
+  }
+
+  tick(deltaMs: number): TripCommand[] {
+    let d = Math.min(MAX_TICK_MS, Math.max(0, Number.isFinite(deltaMs) ? deltaMs : 0));
+    if (this._state === 'departing') {
+      this.departLeft -= d;
+      if (this.departLeft > 0) return [];
+      d = -this.departLeft;
+      this.startDrive();
+    }
+    if (this._state !== 'driving' || !this.drive) return [];
+    const drive = this.drive;
+    drive.elapsed += d;
+    const done = drive.elapsed >= drive.duration;
+    this._s = done ? drive.to : drive.from + ((drive.to - drive.from) * drive.elapsed) / drive.duration;
+    const out: TripCommand[] = [this.move(Math.sign(drive.to - drive.from))];
+    if (done) out.push(...this.arrive());
+    return out;
+  }
+
+  /** The game's assets are cached (or failed): enter once the kart has also arrived. */
+  assetsSettled(id: string): TripCommand[] {
+    this.settled.add(id);
+    return this._state === 'arrived' && id === this._target ? this.enter() : [];
+  }
+
+  /** The game scene started: park at its stop for the next trip. */
+  entered(): void {
+    this._state = 'parked';
+    this.resetTrip();
+  }
+
+  /** Parks the kart at `s` (Map wake / re-create); returns the move that places it. */
+  parkAt(s: number): TripCommand[] {
+    this._state = 'parked';
+    this._s = s;
+    this.resetTrip();
+    return [this.move(0)];
+  }
+
+  private resetTrip(): void {
+    this._target = undefined;
+    this.drive = undefined;
+    this.departLeft = 0;
+    this.loaded.clear();
+    this.settled.clear();
+  }
+
+  private startDrive(): void {
+    const to = this._target === undefined ? this._s : (this.opts.stops[this._target] ?? this._s);
+    this.drive = { from: this._s, to, duration: this.durationFor(to - this._s), elapsed: 0 };
+    this._state = 'driving';
+  }
+
+  /** Move to the current `s`; facing from the segment just travelled (`sign` of Δs, 0 = keep). */
+  private move(sign: number): TripCommand {
+    const p = this.opts.road.pointAt(this._s);
+    const dx = sign === 0 ? 0 : -this.opts.road.dirAt(this._s, -sign);
+    // On a near-vertical stretch keep the facing instead of flipping on a tiny x component.
+    return { kind: 'move', x: p.x, y: p.y, dx: Math.abs(dx) < FACING_MIN_DX ? 0 : dx };
+  }
+
+  private arrive(): TripCommand[] {
+    this._state = 'arrived';
+    this.drive = undefined;
+    const id = this._target;
+    if (id === undefined) return [];
+    this.opts.onArrive?.(id);
+    return this.settled.has(id) ? this.enter() : [];
+  }
+
+  private enter(): TripCommand[] {
+    const id = this._target;
+    if (id === undefined) return [];
+    this._state = 'entering';
+    return [{ kind: 'enter', gameId: id }];
+  }
+}
diff --git a/app/src/core/kart-trip.test.ts b/app/src/core/kart-trip.test.ts
new file mode 100644
index 0000000..5415664
--- /dev/null
+++ b/app/src/core/kart-trip.test.ts
@@ -0,0 +1,285 @@
+// Story 1.7 I/O matrix (trip rows): first trip, long road, short hop, same stop, later trip,
+// re-target, re-tap target, sleeping tap, kart boost, kart parked, wait for assets, assets first,
+// entering, pause.
+import { describe, expect, it } from 'vitest';
+import { KartTrip, KART_TARGET, SFX_HAPPY, SFX_KART_BEEP, type TripCommand } from './kart-trip';
+import { createRoad } from './road';
+import { Timing } from './timing';
+
+// Straight road 0 → 3000 px along x; start at s = 100.
+const road = createRoad([
+  { x: 0, y: 0 },
+  { x: 3000, y: 0 },
+]);
+const STOPS: Record<string, number> = { 'ice-cream': 1300, race: 130, fishing: 2800 };
+const AWAKE = new Set(['ice-cream', 'race', 'fishing']);
+const name = (id: string): string => `vo.shell.station-name.${id}`;
+
+function make(opts: { cap?: () => number; start?: number } = {}) {
+  const arrivals: string[] = [];
+  let trips = 0;
+  const cap = opts.cap ?? (() => (trips > 0 ? Timing.kartDriveRepeatMaxMs : Timing.kartDriveMaxMs));
+  const trip = new KartTrip({
+    road,
+    stops: STOPS,
+    startS: opts.start ?? 100,
+    capMs: cap,
+    isAwake: (id) => AWAKE.has(id),
+    nameLine: name,
+    onArrive: (id) => {
+      arrivals.push(id);
+      trips++;
+    },
+  });
+  return { trip, arrivals };
+}
+
+const kinds = (cmds: readonly TripCommand[]): string[] => cmds.map((c) => c.kind);
+
+/** Ticks in 10 ms steps until `stop(state)` or `max` ms; returns elapsed ms and every command. */
+function runUntil(trip: KartTrip, done: () => boolean, max = 10_000, step = 10) {
+  const cmds: TripCommand[] = [];
+  let t = 0;
+  while (!done() && t < max) {
+    cmds.push(...trip.tick(step));
+    t += step;
+  }
+  return { t, cmds };
+}
+
+describe('KartTrip', () => {
+  it('first trip: bounce, say + setPrompt, load; drive after 500 ms; capped at 2000 ms', () => {
+    const { trip, arrivals } = make();
+    const cmds = trip.tapStation('ice-cream');
+    expect(cmds).toEqual([
+      { kind: 'bounce', target: 'ice-cream' },
+      { kind: 'say', lineId: name('ice-cream') },
+      { kind: 'setPrompt', lineId: name('ice-cream') },
+      { kind: 'load', gameId: 'ice-cream' },
+    ]);
+    expect(trip.state).toBe('departing');
+    expect(trip.tick(490)).toEqual([]); // clamped to 250 twice
+    expect(trip.tick(Timing.stationTapMs - 250 - 10)).toEqual([]);
+    expect(trip.state).toBe('departing');
+    trip.tick(10);
+    expect(trip.state).toBe('driving');
+    // Δs = 1200 → 2000 ms at 0.6 px/ms, cap 2000.
+    expect(trip.driveMs).toBe(2000);
+    const { t, cmds: moves } = runUntil(trip, () => trip.state !== 'driving');
+    expect(t).toBe(2000);
+    expect(trip.state).toBe('arrived');
+    expect(arrivals).toEqual(['ice-cream']);
+    expect(trip.s).toBe(1300);
+    // Moves follow the road, facing right (+x).
+    expect(moves.every((c) => c.kind === 'move' && c.y === 0 && c.dx === 1)).toBe(true);
+    const xs = moves.map((c) => (c.kind === 'move' ? c.x : NaN));
+    expect(xs).toEqual([...xs].sort((a, b) => a - b));
+    expect(xs.at(-1)).toBe(1300);
+  });
+
+  it('long road: duration = cap', () => {
+    const { trip } = make({ start: 0 });
+    expect(trip.durationFor(road.length)).toBe(Timing.kartDriveMaxMs);
+    trip.tapStation('fishing');
+    trip.tick(250);
+    trip.tick(250);
+    expect(trip.driveMs).toBe(Timing.kartDriveMaxMs);
+  });
+
+  it('short hop: 30 px → kartDriveMinMs', () => {
+    const { trip } = make();
+    trip.tapStation('race');
+    trip.tick(250);
+    trip.tick(250);
+    expect(trip.driveMs).toBe(Timing.kartDriveMinMs);
+  });
+
+  it('same stop: departing, then a 0 ms drive, arrived', () => {
+    const { trip } = make({ start: 1300 });
+    trip.tapStation('ice-cream');
+    expect(trip.state).toBe('departing');
+    trip.tick(250);
+    const cmds = trip.tick(250);
+    expect(trip.state).toBe('arrived');
+    expect(kinds(cmds)).toEqual(['move']);
+    expect(cmds[0]).toMatchObject({ x: 1300, dx: 0 });
+  });
+
+  it('later trip: cap 1500 after the first arrival', () => {
+    const { trip } = make();
+    trip.tapStation('ice-cream');
+    trip.assetsSettled('ice-cream');
+    runUntil(trip, () => trip.state === 'entering');
+    trip.entered();
+    expect(trip.state).toBe('parked');
+    expect(trip.s).toBe(1300);
+    trip.tapStation('race'); // Δs = 1170 → 1950 ms uncapped
+    runUntil(trip, () => trip.state === 'driving');
+    expect(trip.driveMs).toBe(Timing.kartDriveRepeatMaxMs);
+  });
+
+  it('re-target while driving: new drive from the current s, ≤ cap from the tap; says the new name', () => {
+    const { trip } = make();
+    trip.tapStation('ice-cream');
+    runUntil(trip, () => trip.state === 'driving');
+    runUntil(trip, () => trip.s >= 700);
+    const at = trip.s;
+    const cmds = trip.tapStation('fishing');
+    expect(cmds).toEqual([
+      { kind: 'bounce', target: 'fishing' },
+      { kind: 'say', lineId: name('fishing') },
+      { kind: 'setPrompt', lineId: name('fishing') },
+      { kind: 'load', gameId: 'fishing' },
+    ]);
