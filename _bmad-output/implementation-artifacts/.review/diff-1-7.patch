@@ -0,0 +1,62 @@
+// MiniGame contract (Story 1.7, AD-1). Every game scene extends MiniGameBase:
+//   - the scene key is its GameId; `init(data)` stores the shell's `{ level, seed, resume? }`;
+//   - `create()` sets the Hud to 'game' mode (Home shows), fades the scene in, turns `hud:home` into
+//     `round:abandon` and then calls the subclass `build()`;
+//   - `complete(outcome)` / `abandon()` go through RoundGuard: exactly one terminal event per start,
+//     after which the game is inert (input disabled, a second Home tap ignored).
+// Games never navigate (`scene.start/stop/…`) or load (`this.load`): Map owns both (ESLint enforces it).
+import { Scene } from 'phaser';
+import type { GameId, GameStartData, RoundOutcome, Snapshot } from '../content/types';
+import { bus } from '../core/bus';
+import { setHudMode } from '../core/hud-mode';
+import { revealScene } from '../core/motion';
+import { RoundGuard } from '../core/round-guard';
+
+export abstract class MiniGameBase extends Scene {
+  readonly gameId: GameId;
+  protected level = 0;
+  protected seed = 0;
+  protected resumeAt: Snapshot | undefined = undefined;
+  private guard: RoundGuard | undefined;
+
+  constructor(gameId: GameId) {
+    super(gameId);
+    this.gameId = gameId;
+  }
+
+  init(data: Partial<GameStartData> = {}): void {
+    this.level = data.level ?? 0;
+    this.seed = data.seed ?? 0;
+    this.resumeAt = data.resume;
+  }
+
+  create(): void {
+    this.guard = new RoundGuard(this.gameId, bus, () => {
+      this.input.enabled = false;
+    });
+    this.input.enabled = true;
+    setHudMode('game');
+    bus.scoped(this).on('hud:home', () => this.abandon());
+    this.build();
+    void revealScene(this);
+  }
+
+  /** True after the start's terminal event. */
+  protected get inert(): boolean {
+    return this.guard?.inert ?? false;
+  }
+
+  /** Draws the game. */
+  protected abstract build(): void;
+
+  /** The resume snapshot of the current state (written by Map on `round:abandon` from Epic 2). */
+  abstract snapshot(): Snapshot;
+
+  protected complete(outcome: Omit<RoundOutcome, 'gameId'>): void {
+    this.guard?.complete({ ...outcome, gameId: this.gameId });
+  }
+
+  protected abandon(): void {
+    this.guard?.abandon(this.snapshot());
+  }
+}
diff --git a/app/src/games/registry.ts b/app/src/games/registry.ts
