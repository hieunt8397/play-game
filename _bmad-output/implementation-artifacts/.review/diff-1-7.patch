+// Tiệm kem (Story 1.7 skeleton): the sky background only; Home (Hud) returns to the island.
+// Story 1.8 adds the truck, the ice creams and the Shiba.
+import type { Snapshot } from '../../content/types';
+import { Tokens } from '../../core/tokens';
+import { MiniGameBase } from '../mini-game-base';
+
+export class IceCream extends MiniGameBase {
+  constructor() {
+    super('ice-cream');
+  }
+
+  protected build(): void {
+    this.cameras.main.setBackgroundColor(Tokens.colors.sky.css);
+  }
+
+  snapshot(): Snapshot {
+    return { v: 1, level: this.level, seed: this.seed, questionIndex: 0, partial: null };
+  }
+}
