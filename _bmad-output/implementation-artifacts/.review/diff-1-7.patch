+import { describe, expect, it, vi } from 'vitest';
+import { enterPlan, enterStation, FADE_IN_COMPLETE, FADE_OUT_COMPLETE, revealScene, ZOOM_COMPLETE, type CameraLike } from './motion';
+import { Timing } from './timing';
+import { Tokens } from './tokens';
+
+function fakeCamera() {
+  const handlers = new Map<string, () => void>();
+  const cam = {
+    pan: vi.fn(),
+    zoomTo: vi.fn(),
+    fadeOut: vi.fn(),
+    fadeIn: vi.fn(),
+    once: vi.fn((ev: string, fn: () => void) => handlers.set(ev, fn)),
+  } satisfies CameraLike;
+  return { cam, fire: (ev: string) => handlers.get(ev)?.() };
+}
+
+describe('enterPlan', () => {
+  it('normal: zoom to cameraZoomScale over cameraZoomInMs', () => {
+    expect(enterPlan(false)).toEqual({ kind: 'zoom', zoom: Tokens.ui.cameraZoomScale, ms: Timing.cameraZoomInMs });
+  });
+
+  it('reduced motion: a 300 ms fade, no zoom', () => {
+    expect(enterPlan(true)).toEqual({ kind: 'fade', ms: Timing.sceneFadeMs });
+    expect(Timing.sceneFadeMs).toBe(300);
+  });
+});
+
+describe('enterStation / revealScene', () => {
+  it('normal: pans to the focus and zooms; resolves on zoom complete', async () => {
+    const { cam, fire } = fakeCamera();
+    const done = vi.fn();
+    const p = enterStation({ cameras: { main: cam } }, { x: 200, y: 300 }, false).then(done);
+    expect(cam.pan).toHaveBeenCalledWith(200, 300, Timing.cameraZoomInMs, expect.any(String), true);
+    expect(cam.zoomTo).toHaveBeenCalledWith(Tokens.ui.cameraZoomScale, Timing.cameraZoomInMs, expect.any(String), true);
+    expect(cam.fadeOut).not.toHaveBeenCalled();
+    await Promise.resolve();
+    expect(done).not.toHaveBeenCalled();
+    fire(ZOOM_COMPLETE);
+    await p;
+    expect(done).toHaveBeenCalled();
+  });
+
+  it('reduced: fades out to the sky colour, no pan or zoom', async () => {
+    const { cam, fire } = fakeCamera();
+    const p = enterStation({ cameras: { main: cam } }, { x: 0, y: 0 }, true);
+    expect(cam.zoomTo).not.toHaveBeenCalled();
+    expect(cam.pan).not.toHaveBeenCalled();
+    const v = Tokens.colors.sky.value;
+    expect(cam.fadeOut).toHaveBeenCalledWith(Timing.sceneFadeMs, Math.floor(v / 65536), Math.floor(v / 256) % 256, v % 256);
+    fire(FADE_OUT_COMPLETE);
+    await expect(p).resolves.toBeUndefined();
+  });
+
+  it('revealScene fades in over sceneFadeMs', async () => {
+    const { cam, fire } = fakeCamera();
+    const p = revealScene({ cameras: { main: cam } });
+    expect(cam.fadeIn).toHaveBeenCalledWith(Timing.sceneFadeMs, expect.any(Number), expect.any(Number), expect.any(Number));
+    fire(FADE_IN_COMPLETE);
+    await expect(p).resolves.toBeUndefined();
+  });
+});
diff --git a/app/src/core/map-idle.ts b/app/src/core/map-idle.ts
new file mode 100644
index 0000000..0bee385
--- /dev/null
+++ b/app/src/core/map-idle.ts
@@ -0,0 +1,150 @@
+// Map idle scheduler (Story 1.5, EXPERIENCE › Mời chơi). Pure: time comes in through `tick(deltaMs)`
+// (the Map feeds `update` deltas, which stop while the scene is paused), randomness through `rng`.
+//   - ambient: every rand(ambientMin..ambientMax) one station moves; never the same id twice in a row;
+//   - invite: after `inviteFirstMs` of idle, for the next awake station (round-robin); later ones need
+//     idle ≥ inviteFirstMs AND ≥ inviteGapMs since the previous invitation started; at most
+//     `inviteMaxCount` per Map visit (taps do not reset the count);
+//   - while an invitation shows (`inviteHoldMs` or until a tap) no ambient fires; it ends with `inviteEnd`;
+//   - `tap()` resets the idle clock and the ambient timer and ends a showing invitation.
+//   - `suspend()` (Story 1.7: the kart is travelling) stops everything and ends a showing invitation;
+//     `resume()` resets the idle clock and the ambient timer; `reset()` starts a new Map visit
+//     (invite count 0, clocks reset).
+// Deltas are clamped to MAX_TICK_MS so a resume never fires a burst.
+
+export const MAX_TICK_MS = 250;
+
+export type MapIdleEvent =
+  | { readonly kind: 'ambient'; readonly id: string }
+  | { readonly kind: 'invite'; readonly id: string }
+  | { readonly kind: 'inviteEnd'; readonly id: string };
+
+export interface MapIdleTiming {
+  readonly ambientMinMs: number;
+  readonly ambientMaxMs: number;
+  readonly inviteFirstMs: number;
+  readonly inviteGapMs: number;
+  readonly inviteMaxCount: number;
+  readonly inviteHoldMs: number;
+}
+
+export interface MapIdleOptions {
+  /** Every station that may move (ambient). */
+  readonly stations: readonly string[];
+  /** Stations that may be invited, in round-robin order. */
+  readonly awake: readonly string[];
+  readonly timing: MapIdleTiming;
+  /** Uniform [0, 1) (default Math.random). */
+  readonly rng?: () => number;
+}
+
+export interface MapIdle {
+  tick(deltaMs: number): MapIdleEvent[];
+  tap(): MapIdleEvent[];
+  /** Stops ambient motion and invitations (kart travelling); ends a showing invitation. Idempotent. */
+  suspend(): MapIdleEvent[];
+  /** Restarts after `suspend`, with the idle clock and the ambient timer reset. No-op when not suspended. */
+  resume(): void;
+  /** A new Map visit: invite count 0, clocks reset, a showing invitation ends. Keeps the suspend state. */
+  reset(): MapIdleEvent[];
+  readonly suspended: boolean;
+  /** The station whose invitation is showing, if any. */
+  readonly showing: string | undefined;
+  /** Invitations started this visit. */
+  readonly invites: number;
+}
+
+export function createMapIdle(opts: MapIdleOptions): MapIdle {
+  const { stations, awake, timing } = opts;
+  const rng = opts.rng ?? Math.random;
+  const nextAmbientDelay = (): number => timing.ambientMinMs + rng() * (timing.ambientMaxMs - timing.ambientMinMs);
+
+  let elapsed = 0;
+  let idle = 0;
+  let ambientLeft = nextAmbientDelay();
+  let lastAmbient: string | undefined;
+  let invites = 0;
+  let lastInviteAt: number | undefined;
+  let awakeIndex = 0;
+  let showing: { id: string; left: number } | undefined;
+  let suspended = false;
+
+  const pickAmbient = (): string | undefined => {
+    if (stations.length === 0) return undefined;
+    const pool = stations.length > 1 ? stations.filter((id) => id !== lastAmbient) : stations;
+    const id = pool[Math.min(pool.length - 1, Math.floor(rng() * pool.length))];
+    lastAmbient = id;
+    return id;
+  };
+
+  const inviteDue = (): boolean =>
+    awake.length > 0 &&
+    invites < timing.inviteMaxCount &&
+    idle >= timing.inviteFirstMs &&
+    (lastInviteAt === undefined || elapsed - lastInviteAt >= timing.inviteGapMs);
+
+  const endShowing = (): MapIdleEvent[] => {
+    if (!showing) return [];
+    const id = showing.id;
+    showing = undefined;
+    ambientLeft = nextAmbientDelay();
+    return [{ kind: 'inviteEnd', id }];
+  };
+
+  return {
+    tick(deltaMs) {
+      if (suspended) return [];
+      const d = Math.min(MAX_TICK_MS, Math.max(0, Number.isFinite(deltaMs) ? deltaMs : 0));
+      elapsed += d;
+      idle += d;
+      if (showing) {
+        showing.left -= d;
+        return showing.left <= 0 ? endShowing() : [];
+      }
+      if (inviteDue()) {
+        const id = awake[awakeIndex % awake.length]!;
+        awakeIndex++;
+        invites++;
+        lastInviteAt = elapsed;
+        showing = { id, left: timing.inviteHoldMs };
+        return [{ kind: 'invite', id }];
+      }
+      ambientLeft -= d;
+      if (ambientLeft > 0) return [];
+      ambientLeft = nextAmbientDelay();
+      const id = pickAmbient();
+      return id === undefined ? [] : [{ kind: 'ambient', id }];
+    },
+    tap() {
+      idle = 0;
+      ambientLeft = nextAmbientDelay();
+      return endShowing();
+    },
+    suspend() {
+      suspended = true;
+      return endShowing();
+    },
+    resume() {
+      if (!suspended) return;
+      suspended = false;
+      idle = 0;
+      ambientLeft = nextAmbientDelay();
+    },
+    reset() {
+      const ended = endShowing();
+      invites = 0;
+      lastInviteAt = undefined;
+      idle = 0;
+      ambientLeft = nextAmbientDelay();
+      return ended;
+    },
+    get suspended() {
+      return suspended;
+    },
+    get showing() {
+      return showing?.id;
+    },
+    get invites() {
+      return invites;
+    },
+  };
+}
diff --git a/app/src/core/map-idle.test.ts b/app/src/core/map-idle.test.ts
new file mode 100644
index 0000000..f8aba9e
--- /dev/null
+++ b/app/src/core/map-idle.test.ts
@@ -0,0 +1,178 @@
+// Story 1.5 I/O matrix: Ambient, First invite, Invite ends, Later invites, Tap resets, No awake,
+// Pause/resume.
+import { describe, expect, it } from 'vitest';
+import { createMapIdle, MAX_TICK_MS, type MapIdle, type MapIdleEvent, type MapIdleTiming } from './map-idle';
+import { Timing } from './timing';
+
+const TIMING: MapIdleTiming = {
+  ambientMinMs: Timing.mapAmbientMinMs,
+  ambientMaxMs: Timing.mapAmbientMaxMs,
+  inviteFirstMs: Timing.mapInviteFirstMs,
+  inviteGapMs: Timing.mapInviteGapMs,
+  inviteMaxCount: Timing.mapInviteMaxCount,
+  inviteHoldMs: Timing.mapInviteHoldMs,
+};
+const STATIONS = ['ice-cream', 'pizza', 'race', 'fishing', 'touch-talk', 'dino-puzzle', 'shadow-match'];
+const STEP = 50;
+
+/** Deterministic rng cycling through `values`. */
+function seq(values: number[]): () => number {
+  let i = 0;
+  return () => values[i++ % values.length]!;
+}
+
+interface Timed {
+  at: number;
+  ev: MapIdleEvent;
+}
+
+/** Ticks `ms` in STEP slices starting at `start`; returns the timed events. */
+function run(idle: MapIdle, ms: number, start = 0): Timed[] {
+  const out: Timed[] = [];
+  for (let t = STEP; t <= ms; t += STEP) for (const ev of idle.tick(STEP)) out.push({ at: start + t, ev });
+  return out;
+}
+
+const make = (opts: { awake?: string[]; rng?: () => number } = {}) =>
+  createMapIdle({ stations: STATIONS, awake: opts.awake ?? ['ice-cream'], timing: TIMING, rng: opts.rng ?? seq([0.5]) });
+
+describe('createMapIdle', () => {
+  it('ambient: one event every 4–6 s; the id never repeats back to back', () => {
+    const idle = make({ awake: [], rng: seq([0, 0.99, 0.3, 0.7, 0.1, 0.5]) });
+    const evs = run(idle, 120_000);
+    expect(evs.length).toBeGreaterThan(15);
+    expect(evs.every((e) => e.ev.kind === 'ambient')).toBe(true);
+    let prev = 0;
+    for (const e of evs) {
+      const gap = e.at - prev;
+      expect(gap).toBeGreaterThanOrEqual(TIMING.ambientMinMs);
+      expect(gap).toBeLessThanOrEqual(TIMING.ambientMaxMs + STEP);
+      prev = e.at;
+    }
+    for (let i = 1; i < evs.length; i++) expect(evs[i]!.ev.id).not.toBe(evs[i - 1]!.ev.id);
+  });
+
+  it('ambient: every station is eligible', () => {
+    let x = 0;
+    const idle = make({ awake: [], rng: () => ((x = (x + 0.137) % 1), x) });
+    const ids = new Set(run(idle, 300_000).map((e) => e.ev.id));
+    expect([...ids].sort()).toEqual([...STATIONS].sort());
+  });
+
+  it('first invite after 8 s idle for the awake station; no ambient while it shows; it ends after the hold', () => {
+    const idle = make();
+    const evs = run(idle, TIMING.inviteFirstMs + TIMING.inviteHoldMs + 1000);
+    const invite = evs.find((e) => e.ev.kind === 'invite')!;
+    expect(invite.ev.id).toBe('ice-cream');
+    expect(invite.at).toBe(TIMING.inviteFirstMs);
+    const end = evs.find((e) => e.ev.kind === 'inviteEnd')!;
+    expect(end.ev.id).toBe('ice-cream');
+    expect(end.at).toBe(TIMING.inviteFirstMs + TIMING.inviteHoldMs);
+    expect(evs.filter((e) => e.at > invite.at && e.at < end.at)).toEqual([]);
+  });
+
+  it('a tap ends a showing invitation with inviteEnd and resets idle', () => {
+    const idle = make();
+    run(idle, TIMING.inviteFirstMs);
+    expect(idle.showing).toBe('ice-cream');
+    expect(idle.tap()).toEqual([{ kind: 'inviteEnd', id: 'ice-cream' }]);
+    expect(idle.showing).toBeUndefined();
+    expect(idle.tap()).toEqual([]);
+  });
+
+  it('later invites: ≥ 20 s after the previous start, at most 3 per visit', () => {
+    const idle = make();
+    const invites = run(idle, 70_000).filter((e) => e.ev.kind === 'invite');
+    expect(invites.map((e) => e.at)).toEqual([8000, 28000, 48000]);
+    expect(run(idle, 120_000, 70_000).filter((e) => e.ev.kind === 'invite')).toEqual([]);
+  });
+
+  it('taps do not reset the invitation count', () => {
+    const idle = make();
+    let count = 0;
+    for (let i = 0; i < 5; i++) {
+      count += run(idle, 30_000).filter((e) => e.ev.kind === 'invite').length;
+      idle.tap();
+    }
+    expect(count).toBe(TIMING.inviteMaxCount);
+    expect(idle.invites).toBe(TIMING.inviteMaxCount);
+  });
+
+  it('tap at idle 7 s: no invitation until 8 s after the tap', () => {
+    const idle = make();
+    run(idle, 7000);
+    idle.tap();
+    const evs = run(idle, 9000, 7000);
+    const invite = evs.find((e) => e.ev.kind === 'invite')!;
+    expect(invite.at).toBe(15_000);
+  });
+
+  it('round-robin over several awake stations', () => {
+    const idle = make({ awake: ['ice-cream', 'pizza'] });
+    const ids = run(idle, 70_000)
+      .filter((e) => e.ev.kind === 'invite')
+      .map((e) => e.ev.id);
+    expect(ids).toEqual(['ice-cream', 'pizza', 'ice-cream']);
+  });
+
+  it('no awake station: ambient only, never invite', () => {
+    const idle = make({ awake: [] });
+    const evs = run(idle, 70_000);
+    expect(evs.length).toBeGreaterThan(0);
+    expect(evs.some((e) => e.ev.kind !== 'ambient')).toBe(false);
+  });
+
+  it('a 30 s delta after a pause counts as 250 ms (no burst)', () => {
+    const idle = make();
+    expect(MAX_TICK_MS).toBe(250);
+    expect(idle.tick(30_000)).toEqual([]);
+    // 250 ms counted: the first invite still needs 8000 − 250 ms more.
+    const evs = run(idle, TIMING.inviteFirstMs - 250, 250);
+    expect(evs.filter((e) => e.ev.kind === 'invite').map((e) => e.at)).toEqual([TIMING.inviteFirstMs]);
+  });
+
+  it('ignores negative and non-finite deltas', () => {
+    const idle = make();
+    expect(idle.tick(-1000)).toEqual([]);
+    expect(idle.tick(Number.NaN)).toEqual([]);
+    const evs = run(idle, TIMING.inviteFirstMs);
+    expect(evs.find((e) => e.ev.kind === 'invite')?.at).toBe(TIMING.inviteFirstMs);
+  });
+});
+
+describe('createMapIdle › suspend / resume / reset (Story 1.7)', () => {
+  it('suspend ends a showing invitation and stops everything until resume', () => {
+    const idle = make();
+    const shown = run(idle, TIMING.inviteFirstMs);
+    expect(shown.at(-1)?.ev).toEqual({ kind: 'invite', id: 'ice-cream' });
+    expect(idle.suspend()).toEqual([{ kind: 'inviteEnd', id: 'ice-cream' }]);
+    expect(idle.suspend()).toEqual([]);
+    expect(idle.suspended).toBe(true);
+    expect(run(idle, 60_000)).toEqual([]);
+  });
+
+  it('resume resets the idle clock and the ambient timer', () => {
+    const idle = make();
+    run(idle, 3000);
+    idle.suspend();
+    run(idle, 10_000);
+    idle.resume();
+    expect(idle.suspended).toBe(false);
+    // rng 0.5 → ambient after 5000 ms counted from the resume; invite after 8000 ms.
+    const evs = run(idle, TIMING.inviteFirstMs);
+    expect(evs.map((e) => [e.at, e.ev.kind])).toEqual([
+      [5000, 'ambient'],
+      [TIMING.inviteFirstMs, 'invite'],
+    ]);
+  });
+
+  it('reset: a new visit gets its invitations back', () => {
+    const idle = make();
+    run(idle, 120_000);
+    expect(idle.invites).toBe(TIMING.inviteMaxCount);
+    idle.reset();
+    expect(idle.invites).toBe(0);
+    const evs = run(idle, TIMING.inviteFirstMs);
+    expect(evs.filter((e) => e.ev.kind === 'invite').map((e) => e.at)).toEqual([TIMING.inviteFirstMs]);
+  });
+});
diff --git a/app/src/core/map-plan.ts b/app/src/core/map-plan.ts
new file mode 100644
index 0000000..5292af7
--- /dev/null
+++ b/app/src/core/map-plan.ts
@@ -0,0 +1,201 @@
+// Map planning (Story 1.5), pure. Turns the generated layout (spec-1-4 contract) + content stations
+// into what the Map scene draws and registers:
+//   - each station's full-frame image `<id>/idle/00`: positioned at anchors[id] with origin
+//     anchor/design and scale 1/renderScale, so a bounce scales around the ground pivot;
+//   - its hit polygon (hits[id], exactly as stored), its static label position, awake flag, depth;
+//   - the kart (Story 1.7: it drives, so it is planned as a movable sprite, not a prop): frame
+//     `MAP_KART.frame` at 1/renderScale with its pivot at the trimmed rect's centre x and the ground y
+//     of `anchor.kart-start` (where the frame was rendered), so it sits on the road wherever it is
+//     placed; a hit circle r = components.kart.size/2 + hitPad around the visible centre;
+//   - warnings for missing frames (image skipped, hotspot/label kept) and missing stations (skipped).
+// Slots are never planned (UX-DR42). Depth sorts by the anchor y; labels sit above every sprite.
+import { MAP_KART } from '../content/assets';
+import { KART_START_ANCHOR, stationFrame } from '../content/stations';
+import type { Point, ScreenLayout } from '../content/layout-types';
+import type { Box } from './input/polygon';
+import type { Rect } from './safe-rect';
+import { Tokens } from './tokens';
+
+export interface PlanStationInput {
+  readonly id: string;
+  readonly label: string;
+  readonly awake: boolean;
+}
+
+export interface Size {
+  readonly w: number;
+  readonly h: number;
+}
+
+/** A full-frame sprite placed on its ground pivot. */
+export interface PlannedImage {
+  readonly frame: string;
+  readonly x: number;
+  readonly y: number;
+  readonly originX: number;
+  readonly originY: number;
+  readonly scale: number;
+}
+
+export interface PlannedStation {
+  readonly id: string;
+  readonly label: string;
+  readonly awake: boolean;
+  readonly anchor: Point;
+  /** Undefined when the frame is missing from the atlas. */
+  readonly image: PlannedImage | undefined;
+  readonly hit: readonly Point[];
+  /** Label: centre x, top y. */
+  readonly labelPos: Point;
+  readonly depth: number;
+}
+
+export interface PlannedProp {
+  readonly id: string;
+  readonly image: PlannedImage;
+  /** Visible (trimmed) frame rect in design px. */
+  readonly rect: Box;
+  /** `rect` padded by Tokens.spacing.hitPad, as 4 points. */
+  readonly hit: readonly Point[];
+  readonly depth: number;
+}
+
+/** The moving kart (Story 1.7). Placed by setting its pivot on a road point. */
+export interface PlannedKart {
+  /** Undefined when the frame is missing (the kart keeps its hit target and behaviour, AR51). */
+  readonly frame: string | undefined;
+  /** Full-frame origin (0..1) of the pivot. */
+  readonly originX: number;
+  readonly originY: number;
+  readonly scale: number;
+  /** Visible centre minus pivot (design px): the hit circle's centre offset. */
+  readonly centerOffset: Point;
+  /** Hit circle radius: components.kart.size/2 + components.kart.hitPad. */
+  readonly hitRadius: number;
+}
+
+export interface MapPlan {
+  readonly bg: { readonly x: number; readonly y: number; readonly scale: number; readonly depth: number };
+  /** In depth order (back to front) — also the hotspot registration order (front wins). */
+  readonly stations: readonly PlannedStation[];
+  readonly kart: PlannedKart;
+  readonly labelDepth: number;
+  /** Above the sprites, below the labels. */
+  readonly ringDepth: number;
+  readonly warnings: readonly string[];
+}
+
+export interface PlanOptions {
+  /** Measured label size (Phaser Text); default: an estimate from the label typography. */
+  readonly measureLabel?: (label: string) => Size;
+  readonly safeRect?: Rect;
+  /** Gap between the anchor and the label top. */
+  readonly labelGap?: number;
+  /** Texture key named in warnings. */
+  readonly atlasKey?: string;
+}
+
+/** Rough glyph width / font size of Baloo 2 (estimate used only without a real measure). */
+const GLYPH_WIDTH_EM = 0.55;
+
+export function estimateLabelSize(label: string): Size {
+  const t = Tokens.components.stationLabel.typography;
+  return { w: label.length * t.fontSize * GLYPH_WIDTH_EM, h: t.fontSize * t.lineHeight };
+}
+
+/** Label position: centred on the anchor x, top at anchor.y + gap, clamped inside `safe`. */
+export function labelPosition(anchor: Point, size: Size, safe: Rect, gap: number): Point {
+  const clamp = (v: number, lo: number, hi: number): number => (hi < lo ? (lo + hi) / 2 : Math.min(hi, Math.max(lo, v)));
+  return {
+    x: clamp(anchor.x, safe.x + size.w / 2, safe.x + safe.w - size.w / 2),
+    y: clamp(anchor.y + gap, safe.y, safe.y + safe.h - size.h),
+  };
+}
+
+function placeImage(frame: string, at: Point, layout: ScreenLayout): PlannedImage {
+  return {
+    frame,
+    x: at.x,
+    y: at.y,
+    originX: at.x / layout.design.width,
+    originY: at.y / layout.design.height,
+    scale: 1 / layout.renderScale,
+  };
+}
+
+export function planMap(
+  layout: ScreenLayout,
+  stations: readonly PlanStationInput[],
+  hasFrame: (frame: string) => boolean,
+  frameRect: (frame: string) => Box | undefined,
+  opts: PlanOptions = {},
+): MapPlan {
+  const measure = opts.measureLabel ?? estimateLabelSize;
+  const safe = opts.safeRect ?? Tokens.safeRect;
+  const gap = opts.labelGap ?? Tokens.spacing['1'];
+  const atlas = opts.atlasKey ?? 'atlas';
+  const warnings: string[] = [];
+
+  const planned: PlannedStation[] = [];
+  for (const s of stations) {
+    const anchor = layout.anchors[s.id];
+    const hit = layout.hits[s.id];
+    if (!anchor || !hit) {
+      warnings.push(`map: station "${s.id}" is missing from the layout (${!anchor ? 'anchors' : 'hits'}) — skipped`);
+      continue;
+    }
+    const frame = stationFrame(s.id);
+    const image = hasFrame(frame) ? placeImage(frame, anchor, layout) : undefined;
+    if (!image) warnings.push(`map: frame "${frame}" is missing from ${atlas} — image skipped`);
+    planned.push({
+      id: s.id,
+      label: s.label,
+      awake: s.awake,
+      anchor,
+      image,
+      hit,
+      labelPos: labelPosition(anchor, measure(s.label), safe, gap),
+      depth: anchor.y,
+    });
+  }
+  planned.sort((a, b) => a.depth - b.depth);
+
+  const kart = planKart(layout, hasFrame, frameRect);
+  if (!kart.frame) warnings.push(`map: frame "${MAP_KART.frame}" is missing from ${atlas} — kart drawn without an image`);
+
+  // The kart's depth follows its y on the road, which stays inside the design height.
+  const maxDepth = Math.max(layout.design.height, ...planned.map((s) => s.depth));
+  return {
+    bg: { x: 0, y: 0, scale: 1 / layout.renderScale, depth: -1 },
+    stations: planned,
+    kart,
+    ringDepth: maxDepth + 1,
+    labelDepth: maxDepth + 2,
+    warnings,
+  };
+}
+
+/** Kart placement from the trimmed frame rect (see the file header). */
+export function planKart(
+  layout: ScreenLayout,
+  hasFrame: (frame: string) => boolean,
+  frameRect: (frame: string) => Box | undefined,
+): PlannedKart {
+  const spec = Tokens.components.kart;
+  const hitRadius = spec.size / 2 + spec.hitPad;
+  const rs = layout.renderScale;
+  const scale = 1 / rs;
+  const ss = hasFrame(MAP_KART.frame) ? frameRect(MAP_KART.frame) : undefined;
+  if (!ss) return { frame: undefined, originX: 0.5, originY: 0.5, scale, centerOffset: { x: 0, y: 0 }, hitRadius };
+  const centre = { x: (ss.x + ss.width / 2) / rs, y: (ss.y + ss.height / 2) / rs };
+  const ground = layout.anchors[KART_START_ANCHOR];
+  const pivot = { x: centre.x, y: ground?.y ?? centre.y };
+  return {
+    frame: MAP_KART.frame,
+    originX: pivot.x / layout.design.width,
+    originY: pivot.y / layout.design.height,
+    scale,
+    centerOffset: { x: centre.x - pivot.x, y: centre.y - pivot.y },
+    hitRadius,
+  };
+}
