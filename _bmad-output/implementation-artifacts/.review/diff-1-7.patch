@@ -0,0 +1,44 @@
+// Terminal-once guard of a MiniGame start (Story 1.7, AD-1). Exactly one `round:complete` or
+// `round:abandon` per start; after it the game is `inert` (MiniGameBase disables its input) and every
+// later complete/abandon (a second Home tap, a late callback) is ignored.
+import type { GameId, RoundOutcome, Snapshot } from '../content/types';
+import type { Bus } from './bus';
+
+export class RoundGuard {
+  private done = false;
+  private readonly gameId: GameId;
+  private readonly bus: Pick<Bus, 'emit'>;
+  private readonly onInert: () => void;
+
+  /** `onInert` runs once, right after the terminal event (MiniGameBase: `input.enabled = false`). */
+  constructor(gameId: GameId, bus: Pick<Bus, 'emit'>, onInert: () => void = () => undefined) {
+    this.gameId = gameId;
+    this.bus = bus;
+    this.onInert = onInert;
+  }
+
+  get inert(): boolean {
+    return this.done;
+  }
+
+  /** Emits `round:complete`; false (nothing emitted) when already terminal. */
+  complete(outcome: RoundOutcome): boolean {
+    if (!this.end()) return false;
+    this.bus.emit('round:complete', { ...outcome, gameId: this.gameId });
+    return true;
+  }
+
+  /** Emits `round:abandon {gameId, snapshot}`; false (nothing emitted) when already terminal. */
+  abandon(snapshot: Snapshot): boolean {
+    if (!this.end()) return false;
+    this.bus.emit('round:abandon', { gameId: this.gameId, snapshot });
+    return true;
+  }
+
+  private end(): boolean {
+    if (this.done) return false;
+    this.done = true;
+    this.onInert();
+    return true;
+  }
+}
