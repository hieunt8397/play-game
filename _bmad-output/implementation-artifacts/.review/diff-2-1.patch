+
+/**
+ * Story 2.1, called by Map synchronously on `round:complete`: when the outcome belongs to the running
+ * game, persist `nextLevel(run.level, outcome, ladderLength)` through `progress.setDifficulty` and
+ * return it. A missing run, a different `gameId` or an unknown ladder writes nothing (undefined).
+ */
+export function persistRoundLevel(
+  run: RunningGame | undefined,
+  outcome: RoundOutcome,
+  ladderLength: number | undefined,
+  progress: Pick<ProgressStoreService, 'setDifficulty'>,
+): number | undefined {
+  if (!run || run.id !== outcome.gameId || ladderLength === undefined) return undefined;
+  const level = nextLevel(run.level, outcome, ladderLength);
+  progress.setDifficulty(run.id, level);
+  return level;
+}
