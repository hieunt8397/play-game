+# Builds art/map.blend from the vendored reference scene art/src/map-v2.blend (Story 1.4).
+#
+# Run by `npm run art:build -- map` (tools/render/build.ts), never by hand:
+#   blender -b --factory-startup art/src/map-v2.blend --python-exit-code 1 --python build_map.py -- \
+#     --out <tmp>/map.blend --params <tmp>/params.json
+# params.json (written by build.ts from Tokens): creature colours (hex), hitPad, renderScale,
+# design size and the interactive rect (design px) used to keep slots on screen.
+#
+# Steps: fail on SUBSURF; prune the Tiệm kem preview; regroup station objects into
+# `sprite.<id>` collections; recolour creatures; create the layout objects (`hit.*`, `anchor.*`,
+# `slot.*`, `path.road`) in a `layout` collection with hide_render; set the render size; save.
+# Every constant below is in Blender world units (metres), read off the reference scene.
+import json
+import math
+import sys
+
+import bmesh
+import bpy
+from bpy_extras.object_utils import world_to_camera_view
+from mathutils import Vector
+
+# --- the station table ---------------------------------------------------------------------------
+# sprite: collections (`C:`) or root objects (`O:`; the object and all its children) drawn as the
+# station sprite. area: objects that stay in the plate but count toward the hit hull.
+STATIONS = {
+    'ice-cream': {'sprite': ['C:IceCream'], 'area': []},
+    'pizza': {'sprite': ['C:Pizza'], 'area': []},
+    'race': {'sprite': ['C:Race', 'C:RaceCars'], 'area': []},
+    'fishing': {'sprite': ['O:A_FishGold', 'O:A_FishClown', 'O:A_FishKoi', 'O:A_Dock', 'O:A_Rod'], 'area': ['Pond', 'PStone*']},
+    'touch-talk': {'sprite': ['C:Town'], 'area': []},
+    'dino-puzzle': {'sprite': ['O:A_DinoNeck', 'O:A_DinoTri', 'O:A_DinoSteg'], 'area': ['Fence*', 'FenceRail']},
+    'shadow-match': {'sprite': ['C:Cave'], 'area': []},
+}
+KART = {'sprite': ['C:Car']}
+
+# The Tiệm kem preview of the reference (Story 1.8 builds its own scene).
+PRUNE_COLLECTIONS = ['GameIce']
+PRUNE_OBJECTS = ['CamGame2', 'HintRing']
+
+# Rule fixes (spec: edge pieces may stay in the plate; a station may shift ≤ 0.6 m in XY).
+# Objects listed here stay in the plate even though their collection is a station sprite.
+KEEP_IN_PLATE = {
+    # The outer race flags sit on the island's right edge; in the sprite they push the race hit
+    # polygon past the right dead zone. They stay in the plate (decor), the arch and car stay tappable.
+    'race': ['FlagPole-1', 'Flag-1', 'FlagPole1', 'Flag1'],
+    # The stop sign and traffic light stand at the road edge in front of the town; in the sprite they
+    # pull the touch-talk polygon down onto the road and the pizza sign.
+    'touch-talk': ['A_StopSign', 'road-sign-stop', 'A_TrafficLight', 'traffic-light',
+                   # The tall right-hand building (building-g) stands right in front of the cave on
+                   # screen; as plate scenery it no longer hides the cave's tap area.
+                   'A_House3', 'building-g'],
+}
+# Station shifts in metres (world XY), each at most 0.6.
+STATION_SHIFT = {
+    'pizza': (0.0, -0.6),  # toward the camera: the pizza sign no longer reaches into the town
+    'dino-puzzle': (0.0, 0.6),  # away from the pond (the fence and the jumping fish overlap on screen)
+    'shadow-match': (0.6, 0.0),  # right, away from the town's buildings
+}
+MAX_SHIFT = 0.6
+
+# Creature recolour: (root object, material base name, colour token).
+RECOLOUR = [
+    ('A_Shiba', 'Main', 'creatureOrange'),  # Main_Light (white face and belly) is kept
+    ('A_DinoTri', 'Purple', 'creatureGreen'),  # Triceratops (its Tìm bóng role)
+    ('A_DinoSteg', 'DarkBrown', 'creaturePink'),  # Stegosaurus
+    ('A_DinoNeck', 'Brown', 'creatureBlue'),  # long-neck
+    ('A_FishGold', 'Goldfish_Main', 'creatureOrange'),
+    ('A_FishClown', 'Clownfish_Main', 'creaturePurple'),
+    ('A_FishKoi', 'Koi_Main', 'creatureGreen'),
+]
+
+# The road: centreline of the `Road` mesh strip (midpoints of its 225 vertex pairs, simplified with
+# Douglas-Peucker at 0.03 m), read once from map-v2.blend. Width 1.45 m, top at z 0.46 + 0.07.
+ROAD_CENTRE = [
+    (-9.00, -5.00), (-6.71, -4.81), (-5.50, -4.60), (-4.84, -4.37), (-3.09, -3.49), (-2.22, -3.22),
+    (-1.78, -3.20), (-1.14, -3.32), (0.37, -3.93), (1.04, -4.14), (1.50, -4.20), (2.24, -4.21),
+    (3.56, -4.11), (4.59, -3.91), (5.50, -3.60), (6.34, -3.13), (7.12, -2.51), (7.60, -2.01),
+    (7.91, -1.51), (8.00, -1.04), (7.85, -0.53), (7.38, 0.19), (6.71, 0.81), (6.35, 1.04),
+    (6.00, 1.20), (5.63, 1.26), (5.23, 1.24), (3.18, 0.69), (2.50, 0.60), (1.62, 0.66),
+    (-0.12, 0.97), (-1.00, 1.00), (-1.87, 0.79), (-3.62, 0.10), (-4.06, 0.01), (-4.50, 0.00),
+    (-4.97, 0.07), (-5.76, 0.27), (-6.56, 0.57), (-7.05, 0.81), (-7.48, 1.07), (-7.80, 1.33),
+    (-8.00, 1.60), (-8.07, 1.89), (-8.04, 2.23), (-7.91, 2.60), (-7.72, 2.97), (-7.32, 3.52),
+    (-6.84, 3.97), (-6.50, 4.20), (-6.12, 4.36), (-5.68, 4.48), (-4.38, 4.62), (-2.25, 4.58),
+    (-1.50, 4.46), (0.50, 3.99), (1.50, 3.90), (2.03, 3.94), (2.88, 4.09), (5.50, 4.80),
+]
+ROAD_HALF_WIDTH = 0.725
+ROAD_TOP_Z = 0.53
+
+# Decoration slots: grass points around each station's anchor.
+SLOTS_PER_STATION = 2
+SLOT_RADII = [1.4, 1.8, 2.2, 2.6, 3.0, 3.5, 4.0, 4.5, 5.0, 5.5, 6.0, 6.5, 7.0]
+SLOT_ANGLE_STEP_DEG = 10
+SLOT_ROAD_CLEARANCE = 0.3  # beyond the road edge
+SLOT_FOOTPRINT = 0.35  # radius that must be clear grass
+SLOT_SPACING = 1.0  # between any two slots
+SLOT_SCREEN_MARGIN = 16  # design px inside the interactive rect
+SLOT_HULL_MARGIN = 6  # design px beyond the padded station hulls
+GRASS = 'Grass'
+
+RENDER_SIZE = (2048, 1536)
+
+
+def fail(msg):
+    raise RuntimeError(f'build_map: {msg}')
+
+
+def parse_args():
+    argv = sys.argv[sys.argv.index('--') + 1:] if '--' in sys.argv else []
+    args = {}
+    for i in range(0, len(argv) - 1, 2):
+        args[argv[i].lstrip('-')] = argv[i + 1]
+    for key in ('out', 'params'):
+        if key not in args:
+            fail(f'missing --{key}')
+    with open(args['params'], encoding='utf8') as f:
+        args['params'] = json.load(f)
+    return args
+
+
+def srgb_to_linear(c):
+    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
+
+
+def hex_to_linear(hex_colour):
+    h = hex_colour.lstrip('#')
+    return tuple(srgb_to_linear(int(h[i:i + 2], 16) / 255) for i in (0, 2, 4)) + (1.0,)
+
+
+def descendants(obj):
+    out = [obj]
+    for child in obj.children:
+        out.extend(descendants(child))
+    return out
+
+
+def match(name, pattern):
+    return name.startswith(pattern[:-1]) if pattern.endswith('*') else name == pattern
+
+
+def resolve_members(spec):
+    objs = []
+    for item in spec:
+        kind, name = item.split(':', 1)
+        if kind == 'C':
+            coll = bpy.data.collections.get(name)
+            if coll is None:
+                fail(f'collection "{name}" not found')
+            objs.extend(coll.all_objects)
+        else:
+            obj = bpy.data.objects.get(name)
+            if obj is None:
+                fail(f'object "{name}" not found')
+            objs.extend(descendants(obj))
+    seen = []
+    for o in objs:
+        if o not in seen:
+            seen.append(o)
+    return seen
+
+
+def area_objects(patterns):
+    out = [o for o in bpy.data.objects if any(match(o.name, p) for p in patterns)]
+    if patterns and not out:
+        fail(f'area objects {patterns} not found')
+    return sorted(out, key=lambda o: o.name)
+
+
+def move_to(obj, coll):
+    for c in list(obj.users_collection):
+        c.objects.unlink(obj)
+    coll.objects.link(obj)
+
+
+def check_no_subsurf():
+    for o in bpy.data.objects:
+        for m in o.modifiers:
+            if m.type == 'SUBSURF':
+                fail(f'object "{o.name}" has a subdivision modifier (not allowed)')
+
+
+def prune():
+    for name in PRUNE_COLLECTIONS:
+        coll = bpy.data.collections.get(name)
+        if coll is None:
+            fail(f'collection "{name}" to prune not found')
+        for o in list(coll.all_objects):
+            bpy.data.objects.remove(o, do_unlink=True)
+        bpy.data.collections.remove(coll)
+    for name in PRUNE_OBJECTS:
+        o = bpy.data.objects.get(name)
+        if o is not None:
+            bpy.data.objects.remove(o, do_unlink=True)
+
+
+def recolour(colours):
+    for root_name, mat_base, token in RECOLOUR:
+        root = bpy.data.objects.get(root_name)
+        if root is None:
+            fail(f'recolour root "{root_name}" not found')
+        hit = 0
+        for o in descendants(root):
+            for slot in o.material_slots:
+                m = slot.material
+                if m is None or m.name.split('.')[0] != mat_base or m.node_tree is None:
+                    continue
+                bsdf = next((n for n in m.node_tree.nodes if n.type == 'BSDF_PRINCIPLED'), None)
+                if bsdf is None:
+                    continue
+                bsdf.inputs['Base Color'].default_value = hex_to_linear(colours[token])
+                hit += 1
+        if hit == 0:
+            fail(f'recolour: no material "{mat_base}" under "{root_name}"')
+
+
+def eval_world_verts(objs, depsgraph):
+    pts = []
+    for o in objs:
+        if o.type != 'MESH' or o.hide_render:
+            continue
+        ev = o.evaluated_get(depsgraph)
+        me = ev.to_mesh()
+        mw = ev.matrix_world
+        pts.extend(mw @ v.co for v in me.vertices)
+        ev.to_mesh_clear()
+    return pts
+
+
+def roots(objs):
+    s = set(objs)
+    return [o for o in objs if o.parent not in s]
+
+
+def nearest_on_road(p):
+    best = None
+    for (ax, ay), (bx, by) in zip(ROAD_CENTRE, ROAD_CENTRE[1:]):
+        dx, dy = bx - ax, by - ay
+        t = max(0.0, min(1.0, ((p[0] - ax) * dx + (p[1] - ay) * dy) / (dx * dx + dy * dy)))
+        q = (ax + t * dx, ay + t * dy)
+        d = math.dist(p, q)
+        if best is None or d < best[0]:
+            best = (d, q)
+    return best
+
+
+def add_empty(name, loc, coll):
+    e = bpy.data.objects.new(name, None)
+    e.location = loc
+    e.empty_display_type = 'PLAIN_AXES'
+    e.empty_display_size = 0.3
+    coll.objects.link(e)
+    return e
+
+
+def hull_object(name, pts, coll):
+    bm = bmesh.new()
+    verts = [bm.verts.new(p) for p in pts]
+    res = bmesh.ops.convex_hull(bm, input=verts)
+    junk = list({g for g in res['geom_interior'] + res['geom_unused'] if isinstance(g, bmesh.types.BMVert)})
+    bmesh.ops.delete(bm, geom=junk, context='VERTS')
+    me = bpy.data.meshes.new(name)
+    bm.to_mesh(me)
+    bm.free()
+    o = bpy.data.objects.new(name, me)
+    coll.objects.link(o)
+    return o
+
+
+class Screen:
+    """Projects world points to design px with the scene camera (same as render_screen.py)."""
+
+    def __init__(self, scene, params):
+        self.scene = scene
+        self.cam = scene.camera
+        self.w, self.h = params['design']['width'], params['design']['height']
+
+    def project(self, p):
+        v = world_to_camera_view(self.scene, self.cam, Vector(p))
+        return (v.x * self.w, (1 - v.y) * self.h)
+
+
+def hull_2d(points):
+    pts = sorted(set(points))
+    if len(pts) < 3:
+        return pts
+
+    def cross(o, a, b):
+        return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])
+
+    lower, upper = [], []
+    for p in pts:
+        while len(lower) >= 2 and cross(lower[-2], lower[-1], p) <= 0:
+            lower.pop()
+        lower.append(p)
+    for p in reversed(pts):
+        while len(upper) >= 2 and cross(upper[-2], upper[-1], p) <= 0:
+            upper.pop()
+        upper.append(p)
+    return lower[:-1] + upper[:-1]
+
+
+def point_in_poly(p, poly):
+    inside = False
+    for (ax, ay), (bx, by) in zip(poly, poly[1:] + poly[:1]):
+        if (ay > p[1]) != (by > p[1]) and p[0] < (bx - ax) * (p[1] - ay) / (by - ay) + ax:
+            inside = not inside
+    return inside
+
+
+def dist_to_poly(p, poly):
+    best = math.inf
+    for (ax, ay), (bx, by) in zip(poly, poly[1:] + poly[:1]):
+        dx, dy = bx - ax, by - ay
+        L = dx * dx + dy * dy
+        t = 0.0 if L == 0 else max(0.0, min(1.0, ((p[0] - ax) * dx + (p[1] - ay) * dy) / L))
+        best = min(best, math.dist(p, (ax + t * dx, ay + t * dy)))
+    return best
+
+
+def is_grass(scene, depsgraph, x, y):
+    hit, _loc, _n, _i, obj, _m = scene.ray_cast(depsgraph, Vector((x, y, 50.0)), Vector((0, 0, -1)))
+    return hit and obj.original.name == GRASS
+
+
+def choose_slots(scene, depsgraph, screen, params, centres, station_polys):
+    rect = params['rect']
+    clearance = params['hitPad'] + SLOT_HULL_MARGIN
+    chosen = {}
+    taken = []
+    for sid in STATIONS:
+        cx, cy = centres[sid]
+        cands = []
+        for r in SLOT_RADII:
+            row = []
+            for k in range(0, 360, SLOT_ANGLE_STEP_DEG):
+                a = math.radians(k)
+                p = (round(cx + r * math.cos(a), 3), round(cy + r * math.sin(a), 3))
+                road_d = nearest_on_road(p)[0]
+                row.append((-road_d, k, p, road_d))
+            row.sort()
+            cands.extend(row)
+        picks = []
+        why = {'road': 0, 'spacing': 0, 'grass': 0, 'rect': 0, 'station': 0}
+        for _neg, _k, p, road_d in cands:
+            if len(picks) == SLOTS_PER_STATION:
+                break
+            if road_d < ROAD_HALF_WIDTH + SLOT_ROAD_CLEARANCE + SLOT_FOOTPRINT:
+                why['road'] += 1
+                continue
+            if any(math.dist(p, q) < SLOT_SPACING for q in taken + picks):
+                why['spacing'] += 1
+                continue
+            ring = [(p[0] + SLOT_FOOTPRINT * math.cos(math.radians(a)), p[1] + SLOT_FOOTPRINT * math.sin(math.radians(a))) for a in range(0, 360, 45)]
+            if not all(is_grass(scene, depsgraph, x, y) for x, y in [p] + ring):
+                why['grass'] += 1
+                continue
+            sx, sy = screen.project((p[0], p[1], 0.45))
+            if not (rect['x0'] + SLOT_SCREEN_MARGIN <= sx <= rect['x1'] - SLOT_SCREEN_MARGIN and rect['y0'] + SLOT_SCREEN_MARGIN <= sy <= rect['y1'] - SLOT_SCREEN_MARGIN):
+                why['rect'] += 1
+                continue
+            if any(point_in_poly((sx, sy), poly) or dist_to_poly((sx, sy), poly) < clearance for poly in station_polys.values()):
+                why['station'] += 1
+                continue
+            picks.append(p)
+        if len(picks) < SLOTS_PER_STATION:
+            # The layout rules (render/check) then report the missing slot by id.
+            print(f'build_map: WARNING only {len(picks)} grass slot(s) found for station "{sid}" (rejected: {why})')
+        chosen[sid] = picks
+        taken.extend(picks)
+    return chosen
+
+
+def main():
+    args = parse_args()
+    params = args['params']
+    scene = bpy.context.scene
+
+    check_no_subsurf()
+    prune()
+
+    # Regroup into sprite.<id> collections.
+    sprite_parent = bpy.data.collections.new('sprites')
+    scene.collection.children.link(sprite_parent)
+    groups = {}
+    emptied = set()
+    for sid, spec in list(STATIONS.items()) + [('kart', KART)]:
+        members = resolve_members(spec['sprite'])
+        for c in spec['sprite']:
+            if c.startswith('C:'):
+                emptied.add(c[2:])
+        keep = set(KEEP_IN_PLATE.get(sid, []))
+        coll = bpy.data.collections.new(f'sprite.{sid}')
+        sprite_parent.children.link(coll)
+        coll['occlude'] = 0 if sid == 'kart' else 1
+        sprite_objs = []
+        for o in members:
+            if o.name in keep:
+                continue
+            move_to(o, coll)
+            sprite_objs.append(o)
+        groups[sid] = sprite_objs
+    for name in sorted(emptied):
+        coll = bpy.data.collections.get(name)
+        if coll is not None and len(coll.all_objects) == 0:
+            bpy.data.collections.remove(coll)
+        elif coll is not None:
+            # Plate leftovers (kept edge pieces) move to the plate's World collection.
+            for o in list(coll.all_objects):
+                move_to(o, bpy.data.collections['World'])
+            bpy.data.collections.remove(coll)
+
+    # Rule-fix shifts.
+    for sid, (dx, dy) in STATION_SHIFT.items():
+        if math.hypot(dx, dy) > MAX_SHIFT + 1e-9:
+            fail(f'shift of "{sid}" exceeds {MAX_SHIFT} m')
+        for o in roots(groups[sid] + area_objects(STATIONS[sid]['area'])):
+            o.location.x += dx
+            o.location.y += dy
+
+    recolour(params['colours'])
+
+    scene.render.resolution_x, scene.render.resolution_y = RENDER_SIZE
+    scene.render.resolution_percentage = 100
+    bpy.context.view_layer.update()
+    depsgraph = bpy.context.evaluated_depsgraph_get()
+
+    layout = bpy.data.collections.new('layout')
+    scene.collection.children.link(layout)
+    layout.hide_render = True
+    screen = Screen(scene, params)
+
+    centres = {}
+    station_polys = {}
+    for sid, spec in STATIONS.items():
+        sprite_pts = eval_world_verts(groups[sid], depsgraph)
+        area_pts = eval_world_verts(area_objects(spec['area']), depsgraph)
+        if not sprite_pts:
+            fail(f'station "{sid}" has no visible mesh')
+        hull_object(f'hit.{sid}', sprite_pts + area_pts, layout)
+        xs = [p.x for p in sprite_pts]
+        ys = [p.y for p in sprite_pts]
+        zmin = min(p.z for p in sprite_pts)
+        cx, cy = (min(xs) + max(xs)) / 2, (min(ys) + max(ys)) / 2
+        add_empty(f'anchor.{sid}', (cx, cy, zmin), layout)
+        centres[sid] = (cx, cy)
+        _d, (sx, sy) = nearest_on_road((cx, cy))
+        add_empty(f'anchor.{sid}-stop', (sx, sy, ROAD_TOP_Z), layout)
+        station_polys[sid] = hull_2d([screen.project(p) for p in sprite_pts + area_pts])
+
+    kart_pts = eval_world_verts(groups['kart'], depsgraph)
+    kx = (min(p.x for p in kart_pts) + max(p.x for p in kart_pts)) / 2
+    ky = (min(p.y for p in kart_pts) + max(p.y for p in kart_pts)) / 2
+    _d, (sx, sy) = nearest_on_road((kx, ky))
+    add_empty('anchor.kart-start', (sx, sy, ROAD_TOP_Z), layout)
+
+    curve = bpy.data.curves.new('path.road', 'CURVE')
+    curve.dimensions = '3D'
+    spline = curve.splines.new('POLY')
+    spline.points.add(len(ROAD_CENTRE) - 1)
+    for pt, (x, y) in zip(spline.points, ROAD_CENTRE):
+        pt.co = (x, y, ROAD_TOP_Z, 1.0)
+    layout.objects.link(bpy.data.objects.new('path.road', curve))
+
+    slots = choose_slots(scene, depsgraph, screen, params, centres, station_polys)
+    for sid, picks in slots.items():
+        for n, (x, y) in enumerate(picks, 1):
+            add_empty(f'slot.{sid}-{n}', (x, y, 0.45), layout)
+
+    bpy.ops.wm.save_as_mainfile(filepath=args['out'], compress=True)
+    print(f'build_map: saved {args["out"]}')
+
+
+main()
diff --git a/app/tools/render/blender/render_screen.py b/app/tools/render/blender/render_screen.py
new file mode 100644
index 0000000..72024e7
--- /dev/null
+++ b/app/tools/render/blender/render_screen.py
@@ -0,0 +1,155 @@
+# Renders one screen's .blend (Story 1.4). Generic: works for any art/<screen>.blend that follows
+# the naming contract. Run by `npm run render -- <screen>` (tools/render/render.ts), never by hand:
+#   blender -b --factory-startup art/<screen>.blend --python-exit-code 1 --python render_screen.py -- \
+#     --out <tmp dir> --screen <screen>
+#
+# Writes into --out:
+# (`--images 0` skips the renders and writes raw.json only, for diagnosis.)
+#   bg.png                          the plate: the whole scene from the scene camera; sprite objects
+#                                   have visible_camera = False but still cast their shadows
+#   frames/<object>/idle/00.png     one full-frame transparent render per `sprite.<object>` collection
+#                                   (the collection prop `occlude` = 1 turns plate objects into
+#                                   holdouts, so plate objects in front of the sprite cut it)
+#   raw.json                        every object of the `layout` collection projected to render px:
+#                                   hit = every evaluated vertex, anchor/slot = the origin,
+#                                   path = the evaluated spline points (in order). Each point is
+#                                   [x, y, depth]; x/y from the top-left, y down; depth <= 0 is
+#                                   behind the camera. tools/layout/to-layout.ts checks everything.
+import json
+import os
+import sys
+
+import bpy
+from bpy_extras.object_utils import world_to_camera_view
+
+
+def fail(msg):
+    raise RuntimeError(f'render_screen: {msg}')
+
+
+def parse_args():
+    argv = sys.argv[sys.argv.index('--') + 1:] if '--' in sys.argv else []
+    args = {}
+    for i in range(0, len(argv) - 1, 2):
+        args[argv[i].lstrip('-')] = argv[i + 1]
+    for key in ('out', 'screen'):
+        if key not in args:
+            fail(f'missing --{key}')
+    return args
+
+
+def sprite_collections():
+    return sorted((c for c in bpy.data.collections if c.name.startswith('sprite.')), key=lambda c: c.name)
+
+
+def project_layout(scene, depsgraph):
+    layout = bpy.data.collections.get('layout')
+    if layout is None:
+        fail('no "layout" collection')
+    if not layout.hide_render:
+        fail('the "layout" collection must have hide_render = True')
+    cam = scene.camera
+    w, h = scene.render.resolution_x, scene.render.resolution_y
+
+    def proj(co):
+        v = world_to_camera_view(scene, cam, co)
+        return [round(v.x * w, 3), round((1 - v.y) * h, 3), round(v.z, 4)]
+
+    objects = []
+    for o in sorted(layout.all_objects, key=lambda o: o.name):
+        ev = o.evaluated_get(depsgraph)
+        mw = ev.matrix_world
+        if o.type == 'MESH':
+            me = ev.to_mesh()
+            pts = [proj(mw @ v.co) for v in me.vertices]
+            ev.to_mesh_clear()
+        elif o.type == 'CURVE':
+            pts = []
+            for spline in ev.data.splines:
+                if spline.type == 'POLY':
+                    pts.extend(proj(mw @ p.co.xyz) for p in spline.points)
+                else:
+                    pts.extend(proj(mw @ p.co) for p in spline.bezier_points)
+        else:
+            pts = [proj(mw.translation)]
+        objects.append({'name': o.name, 'type': o.type, 'points': pts})
+    return objects
+
+
+def render_to(scene, path):
+    scene.render.filepath = path
+    bpy.ops.render.render(write_still=True)
+    if not os.path.isfile(path):
+        fail(f'render did not write {path}')
+
+
+def main():
+    args = parse_args()
+    out = os.path.abspath(args['out'])
+    scene = bpy.context.scene
+    if scene.camera is None:
+        fail('the scene has no camera')
+    r = scene.render
+    r.resolution_percentage = 100
+    r.image_settings.file_format = 'PNG'
+    r.image_settings.color_mode = 'RGBA'
+    r.image_settings.color_depth = '8'
+    r.image_settings.compression = 15
+    r.use_file_extension = False
+
+    bpy.context.view_layer.update()
+    depsgraph = bpy.context.evaluated_depsgraph_get()
+    sprites = sprite_collections()
+    sprite_objs = {c.name: list(c.all_objects) for c in sprites}
+    in_sprite = {o for objs in sprite_objs.values() for o in objs}
+    layout = bpy.data.collections['layout']
+    plate_objs = [o for o in scene.objects if o not in in_sprite and o.name not in layout.all_objects]
+
+    raw = {
+        'screenId': args['screen'],
+        'render': {'width': r.resolution_x, 'height': r.resolution_y},
+        'objects': project_layout(scene, depsgraph),
+        'frames': [],
+    }
+
+    if args.get('images', '1') == '0':  # diagnosis only: projection without renders
+        with open(os.path.join(out, 'raw.json'), 'w', encoding='utf8') as f:
+            json.dump(raw, f, indent=1, sort_keys=True)
+        return
+
+    # Plate: sprites hidden from the camera, still casting shadows.
+    film = r.film_transparent
+    for o in in_sprite:
+        o.visible_camera = False
+    render_to(scene, os.path.join(out, 'bg.png'))
+    for o in in_sprite:
+        o.visible_camera = True
+
+    # One full-frame transparent render per sprite collection.
+    r.film_transparent = True
+    for c in sprites:
+        name = c.name[len('sprite.'):]
+        occlude = bool(c.get('occlude', 0))
+        saved = [(o, o.hide_render, o.is_holdout) for o in scene.objects]
+        for o in in_sprite:
+            if o not in sprite_objs[c.name]:
+                o.hide_render = True
+        for o in plate_objs:
+            if occlude:
+                o.is_holdout = True
+            else:
+                o.hide_render = True
+        frame = f'{name}/idle/00'
+        render_to(scene, os.path.join(out, 'frames', name, 'idle', '00.png'))
+        raw['frames'].append(frame)
+        for o, hide, hold in saved:
+            o.hide_render = hide
+            o.is_holdout = hold
+    r.film_transparent = film
+
+    with open(os.path.join(out, 'raw.json'), 'w', encoding='utf8') as f:
+        json.dump(raw, f, indent=1, sort_keys=True)
+    print(f'render_screen: wrote {len(raw["frames"])} frames and {len(raw["objects"])} layout objects')
+
+
+main()
diff --git a/app/tools/atlas/pack.ts b/app/tools/atlas/pack.ts
new file mode 100644
index 0000000..5794538
--- /dev/null
+++ b/app/tools/atlas/pack.ts
@@ -0,0 +1,194 @@
+// `npm run atlas -- <screen>` (Story 1.4): packs app/.generated/render/<screen>/frames/**.png into
+// public/assets/atlases/<screen>.png|json (texture key `atlas.<screen>`, JSON hash) with
+// free-tex-packer-core 0.3.9, and re-encodes the plate to public/assets/bg/<screen>.png (`bg.<screen>`).
+// Fails with no write when packing needs more than one page, a page exceeds 2048 on either side, a
+// file exceeds 8 MiB or a frame name breaks `<object>/<state>/<nn>`.
+import { existsSync, mkdirSync, readFileSync, readdirSync, renameSync, writeFileSync } from 'node:fs';
+import { createRequire } from 'node:module';
+import { dirname, join, relative, resolve, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import sharp from 'sharp';
+import { ATLASES, BACKGROUNDS, FRAME_NAME, SCREEN_IDS, type ScreenId } from '../../src/content/assets.ts';
+import { MAX_FILE_BYTES, MAX_PAGE_SIDE } from '../layout/rules.ts';
+import type { PackFile, PackOptions, PackResult } from './free-tex-packer-core.d.ts';
+
+const require = createRequire(import.meta.url);
+sharp.cache(false);
+
+const APP_DIR = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');
+const RENDER_DIR = join(APP_DIR, '.generated', 'render');
+const PUBLIC_DIR = join(APP_DIR, 'public');
+
+/** PNG zlib level of the shipped background. */
+const BG_COMPRESSION = 9;
+
+/** The packer settings of every atlas (spec 1.4 › Atlas). */
+export function packOptions(screen: string): PackOptions {
+  return {
+    textureName: screen,
+    width: MAX_PAGE_SIDE,
+    height: MAX_PAGE_SIDE,
+    fixedSize: false,
+    powerOfTwo: false,
+    padding: 2,
+    allowRotation: false,
+    allowTrim: true,
+    detectIdentical: true,
+    removeFileExtension: true,
+    prependFolderName: true,
+    exporter: 'JsonHash',
+  };
+}
+
+interface FrameJson {
+  trimmed: boolean;
+  spriteSourceSize: { x: number; y: number; w: number; h: number };
+  sourceSize: { w: number; h: number };
+}
+
+interface AtlasJson {
+  frames: Record<string, FrameJson>;
+  meta: { size: { w: number; h: number }; image?: string };
+}
+
+/** Checks the packer output; returns the problems (empty = OK). */
+export function checkAtlas(screen: string, files: readonly PackResult[]): string[] {
+  const problems: string[] = [];
+  const pngs = files.filter((f) => f.name.endsWith('.png'));
+  const jsons = files.filter((f) => f.name.endsWith('.json'));
+  if (pngs.length !== 1 || jsons.length !== 1) {
+    problems.push(`atlas "${screen}": packing needs ${pngs.length} pages (max 1)`);
+    return problems;
+  }
+  const json = JSON.parse(jsons[0]!.buffer.toString('utf8')) as AtlasJson;
+  const { w, h } = json.meta.size;
+  if (w > MAX_PAGE_SIDE || h > MAX_PAGE_SIDE) problems.push(`atlas "${screen}": page ${w}×${h} exceeds ${MAX_PAGE_SIDE}`);
+  for (const name of Object.keys(json.frames)) {
+    if (!FRAME_NAME.test(name)) problems.push(`atlas "${screen}": frame "${name}" is not <object>/<state>/<nn>`);
+  }
+  for (const f of files) {
+    if (f.buffer.length > MAX_FILE_BYTES) problems.push(`atlas "${screen}": ${f.name} is ${f.buffer.length} bytes (max ${MAX_FILE_BYTES})`);
+  }
+  return problems;
+}
+
+/** Where a trimmed frame sat in its full frame. */
+export interface Trim {
+  left: number;
+  top: number;
+  width: number;
+  height: number;
+}
+
+/** Bounding box of the pixels with alpha > 0 in raw RGBA data; the whole frame when empty. */
+export function alphaBounds(data: Uint8Array, width: number, height: number): { left: number; top: number; right: number; bottom: number } {
+  let left = width;
+  let top = height;
+  let right = -1;
+  let bottom = -1;
+  const RGBA = 4;
+  for (let y = 0; y < height; y++) {
+    for (let x = 0; x < width; x++) {
+      if (data[(y * width + x) * RGBA + RGBA - 1]! > 0) {
+        if (x < left) left = x;
+        if (x > right) right = x;
+        if (y < top) top = y;
+        if (y > bottom) bottom = y;
+      }
+    }
+  }
+  return right < 0 ? { left: 0, top: 0, right: width - 1, bottom: height - 1 } : { left, top, right, bottom };
+}
+
+async function trimFrame(png: Buffer): Promise<{ png: Buffer; trim: Trim }> {
+  const { data, info } = await sharp(png).ensureAlpha().raw().toBuffer({ resolveWithObject: true });
+  const b = alphaBounds(data, info.width, info.height);
+  const box = { left: b.left, top: b.top, width: b.right - b.left + 1, height: b.bottom - b.top + 1 };
+  const out = await sharp(png).extract(box).png().toBuffer();
+  return { png: out, trim: { ...box, width: info.width, height: info.height } };
+}
+
+/** Puts each frame back into its full source frame (Phaser places it with spriteSourceSize). */
+export function restoreTrim(json: { frames: Record<string, FrameJson> }, trims: ReadonlyMap<string, Trim>): void {
+  for (const [name, f] of Object.entries(json.frames)) {
+    const t = trims.get(name);
+    if (!t) continue;
+    f.spriteSourceSize = { ...f.spriteSourceSize, x: f.spriteSourceSize.x + t.left, y: f.spriteSourceSize.y + t.top };
+    f.sourceSize = { w: t.width, h: t.height };
+    f.trimmed = true;
+  }
+}
+
+function listPngs(dir: string): string[] {
+  const out: string[] = [];
+  for (const e of readdirSync(dir, { withFileTypes: true })) {
+    const p = join(dir, e.name);
+    if (e.isDirectory()) out.push(...listPngs(p));
+    else if (e.name.endsWith('.png')) out.push(p);
+  }
+  return out.sort();
+}
+
+/** Atomically writes several files: all go to temp names first, then are renamed into place. */
+function writeAll(files: readonly { path: string; data: Buffer }[]): void {
+  for (const f of files) {
+    mkdirSync(dirname(f.path), { recursive: true });
+    writeFileSync(`${f.path}.tmp`, f.data);
+  }
+  for (const f of files) renameSync(`${f.path}.tmp`, f.path);
+}
+
+export async function packScreen(screenArg: string | undefined): Promise<string[]> {
+  if (!SCREEN_IDS.includes(screenArg as ScreenId)) {
+    throw new Error(`unknown screen "${screenArg ?? ''}": known screens are ${SCREEN_IDS.join(', ')}`);
+  }
+  const screen = screenArg as ScreenId;
+  const src = join(RENDER_DIR, screen);
+  const framesDir = join(src, 'frames');
+  const bgSrc = join(src, 'bg.png');
+  if (!existsSync(framesDir) || !existsSync(bgSrc)) throw new Error(`no render for "${screen}": run npm run render -- ${screen}`);
+
+  // free-tex-packer-core checks the untrimmed size against the page size before it trims, so a
+  // full-frame 2048×1536 sprite can never fit a 2048 page. Frames are trimmed here and the JSON
+  // gets the full-frame offsets back (restoreTrim), exactly as the packer's own trim would write.
+  const trims = new Map<string, Trim>();
+  const inputs: PackFile[] = [];
+  for (const p of listPngs(framesDir)) {
+    const path = relative(framesDir, p).split(sep).join('/');
+    const t = await trimFrame(readFileSync(p));
+    trims.set(path.replace(/\.png$/, ''), t.trim);
+    inputs.push({ path, contents: t.png });
+  }
+  const { packAsync } = require('free-tex-packer-core') as { packAsync: (f: PackFile[], o: PackOptions) => Promise<PackResult[]> };
+  const result = await packAsync(inputs, packOptions(screen));
+  const problems = checkAtlas(screen, result);
+  const bg = await sharp(bgSrc).png({ compressionLevel: BG_COMPRESSION }).toBuffer();
+  if (bg.length > MAX_FILE_BYTES) problems.push(`background "${screen}": ${bg.length} bytes (max ${MAX_FILE_BYTES})`);
+  if (problems.length > 0) throw new Error(problems.join('\n'));
+
+  const atlas = ATLASES[screen];
+  const png = result.find((f) => f.name.endsWith('.png'))!;
+  const jsonFile = result.find((f) => f.name.endsWith('.json'))!;
+  const json = JSON.parse(jsonFile.buffer.toString('utf8')) as AtlasJson;
+  restoreTrim(json, trims);
+  json.meta.image = atlas.png.split('/').pop()!;
+  const out = [
+    { path: join(PUBLIC_DIR, atlas.png), data: png.buffer },
+    { path: join(PUBLIC_DIR, atlas.json), data: Buffer.from(`${JSON.stringify(json, null, 2)}\n`) },
+    { path: join(PUBLIC_DIR, BACKGROUNDS[screen].path), data: bg },
+  ];
+  writeAll(out);
+  return out.map((f) => `${relative(APP_DIR, f.path).split('\\').join('/')} (${f.data.length} bytes)`);
+}
+
+async function main(): Promise<void> {
+  try {
+    const written = await packScreen(process.argv[2]);
+    for (const w of written) console.log(`atlas: wrote ${w}`);
+  } catch (e) {
+    console.error(`atlas: ${e instanceof Error ? e.message : JSON.stringify(e)}`);
+    process.exit(1);
+  }
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) void main();
diff --git a/app/tools/atlas/pack.test.ts b/app/tools/atlas/pack.test.ts
new file mode 100644
index 0000000..c2f321c
--- /dev/null
+++ b/app/tools/atlas/pack.test.ts
@@ -0,0 +1,68 @@
+import { describe, expect, it } from 'vitest';
+import { alphaBounds, checkAtlas, packOptions, packScreen, restoreTrim } from './pack.ts';
+
+const json = (frames: string[], w = 1024, h = 1024): Buffer =>
+  Buffer.from(JSON.stringify({ frames: Object.fromEntries(frames.map((f) => [f, {}])), meta: { size: { w, h } } }));
+
+describe('atlas packing', () => {
+  it('uses the pinned packer settings', () => {
+    expect(packOptions('map')).toEqual({
+      textureName: 'map',
+      width: 2048,
+      height: 2048,
+      fixedSize: false,
+      powerOfTwo: false,
+      padding: 2,
+      allowRotation: false,
+      allowTrim: true,
+      detectIdentical: true,
+      removeFileExtension: true,
+      prependFolderName: true,
+      exporter: 'JsonHash',
+    });
+  });
+
+  it('accepts one page with good frame names', () => {
+    expect(checkAtlas('map', [{ name: 'map.png', buffer: Buffer.alloc(10) }, { name: 'map.json', buffer: json(['pizza/idle/00', 'kart/idle/00']) }])).toEqual([]);
+  });
+
+  it('fails on more than one page', () => {
+    const files = [
+      { name: 'map-0.png', buffer: Buffer.alloc(1) },
+      { name: 'map-0.json', buffer: json([]) },
+      { name: 'map-1.png', buffer: Buffer.alloc(1) },
+      { name: 'map-1.json', buffer: json([]) },
+    ];
+    expect(checkAtlas('map', files)).toEqual(['atlas "map": packing needs 2 pages (max 1)']);
+  });
+
+  it('fails on a page over 2048, a bad frame name or a file over 8 MiB', () => {
+    expect(checkAtlas('map', [{ name: 'map.png', buffer: Buffer.alloc(1) }, { name: 'map.json', buffer: json(['pizza/idle/00'], 4096, 10) }])).toEqual([
+      'atlas "map": page 4096×10 exceeds 2048',
+    ]);
+    expect(checkAtlas('map', [{ name: 'map.png', buffer: Buffer.alloc(1) }, { name: 'map.json', buffer: json(['pizza.png']) }])).toEqual([
+      'atlas "map": frame "pizza.png" is not <object>/<state>/<nn>',
+    ]);
+    expect(checkAtlas('map', [{ name: 'map.png', buffer: Buffer.alloc(8388609) }, { name: 'map.json', buffer: json([]) }])).toEqual([
+      'atlas "map": map.png is 8388609 bytes (max 8388608)',
+    ]);
+  });
+
+  it('rejects an unknown screen', async () => {
+    await expect(packScreen('foo')).rejects.toThrow('unknown screen "foo": known screens are map');
+  });
+
+  it('alphaBounds finds the opaque box (whole frame when empty)', () => {
+    const data = new Uint8Array(4 * 4 * 3);
+    data[(1 * 4 + 2) * 4 + 3] = 255;
+    data[(2 * 4 + 1) * 4 + 3] = 1;
+    expect(alphaBounds(data, 4, 3)).toEqual({ left: 1, top: 1, right: 2, bottom: 2 });
+    expect(alphaBounds(new Uint8Array(4 * 4 * 3), 4, 3)).toEqual({ left: 0, top: 0, right: 3, bottom: 2 });
+  });
+
+  it('restoreTrim puts a pre-trimmed frame back into its full frame', () => {
+    const json = { frames: { 'pizza/idle/00': { trimmed: false, spriteSourceSize: { x: 0, y: 0, w: 250, h: 293 }, sourceSize: { w: 250, h: 293 } } } };
+    restoreTrim(json, new Map([['pizza/idle/00', { left: 1091, top: 702, width: 2048, height: 1536 }]]));
+    expect(json.frames['pizza/idle/00']).toEqual({ trimmed: true, spriteSourceSize: { x: 1091, y: 702, w: 250, h: 293 }, sourceSize: { w: 2048, h: 1536 } });
+  });
+});
