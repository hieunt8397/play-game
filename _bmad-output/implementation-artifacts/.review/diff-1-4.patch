index 0000000..0785733
--- /dev/null
+++ b/app/tools/layout/geometry.ts
@@ -0,0 +1,167 @@
+// Pure 2D geometry for screen layouts (Story 1.4): hulls, padding, widths and distances in design px.
+// Shared by `npm run render` (it refuses to publish a bad layout) and `validate:content`.
+import type { Point } from '../../src/content/layout-types.ts';
+
+const cross = (o: Point, a: Point, b: Point): number => (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x);
+
+/** Convex hull (Andrew's monotone chain), no collinear points. Counter-clockwise in y-up terms. */
+export function convexHull(points: readonly Point[]): Point[] {
+  const pts = [...points].sort((a, b) => a.x - b.x || a.y - b.y);
+  const unique = pts.filter((p, i) => i === 0 || p.x !== pts[i - 1]!.x || p.y !== pts[i - 1]!.y);
+  if (unique.length < 3) return unique;
+  const lower: Point[] = [];
+  for (const p of unique) {
+    while (lower.length >= 2 && cross(lower[lower.length - 2]!, lower[lower.length - 1]!, p) <= 0) lower.pop();
+    lower.push(p);
+  }
+  const upper: Point[] = [];
+  for (let i = unique.length - 1; i >= 0; i--) {
+    const p = unique[i]!;
+    while (upper.length >= 2 && cross(upper[upper.length - 2]!, upper[upper.length - 1]!, p) <= 0) upper.pop();
+    upper.push(p);
+  }
+  return lower.slice(0, -1).concat(upper.slice(0, -1));
+}
+
+/** Corner arc resolution of `padHull`: a 16-gon per vertex. */
+const PAD_SEGMENTS = 16;
+
+/**
+ * Pads a convex polygon outward by `pad`: the hull of a circumscribed 16-gon of radius `pad` around
+ * every vertex, so every point within `pad` of the polygon is inside the result.
+ */
+export function padHull(hull: readonly Point[], pad: number): Point[] {
+  if (pad <= 0) return convexHull(hull);
+  const r = pad / Math.cos(Math.PI / PAD_SEGMENTS);
+  const pts: Point[] = [];
+  for (const v of hull) {
+    for (let k = 0; k < PAD_SEGMENTS; k++) {
+      const a = (2 * Math.PI * k) / PAD_SEGMENTS;
+      pts.push({ x: v.x + r * Math.cos(a), y: v.y + r * Math.sin(a) });
+    }
+  }
+  return convexHull(pts);
+}
+
+/** Distance from `p` to the line through `a` and `b`. */
+function lineDistance(p: Point, a: Point, b: Point): number {
+  const len = Math.hypot(b.x - a.x, b.y - a.y);
+  return len === 0 ? Math.hypot(p.x - a.x, p.y - a.y) : Math.abs(cross(a, b, p)) / len;
+}
+
+/** Minimum width of a polygon (rotating calipers on its hull: min over edges of the farthest vertex). */
+export function minWidth(polygon: readonly Point[]): number {
+  const hull = convexHull(polygon);
+  if (hull.length < 3) return 0;
+  let best = Infinity;
+  for (let i = 0; i < hull.length; i++) {
+    const a = hull[i]!;
+    const b = hull[(i + 1) % hull.length]!;
+    let far = 0;
+    for (const p of hull) far = Math.max(far, lineDistance(p, a, b));
+    best = Math.min(best, far);
+  }
+  return best;
+}
+
+/** Ray-casting point-in-polygon (boundary counts as either). */
+export function pointInPolygon(p: Point, polygon: readonly Point[]): boolean {
+  let inside = false;
+  for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) {
+    const a = polygon[i]!;
+    const b = polygon[j]!;
+    if (a.y > p.y !== b.y > p.y && p.x < ((b.x - a.x) * (p.y - a.y)) / (b.y - a.y) + a.x) inside = !inside;
+  }
+  return inside;
+}
+
+/** Distance from `p` to the segment `a`–`b`. */
+export function distToSegment(p: Point, a: Point, b: Point): number {
+  const dx = b.x - a.x;
+  const dy = b.y - a.y;
+  const len2 = dx * dx + dy * dy;
+  const t = len2 === 0 ? 0 : Math.max(0, Math.min(1, ((p.x - a.x) * dx + (p.y - a.y) * dy) / len2));
+  return Math.hypot(p.x - (a.x + t * dx), p.y - (a.y + t * dy));
+}
+
+/** Distance from `p` to an open polyline (Infinity when it has no points). */
+export function distToPolyline(p: Point, line: readonly Point[]): number {
+  if (line.length === 1) return Math.hypot(p.x - line[0]!.x, p.y - line[0]!.y);
+  let best = Infinity;
+  for (let i = 0; i + 1 < line.length; i++) best = Math.min(best, distToSegment(p, line[i]!, line[i + 1]!));
+  return best;
+}
+
+function segmentsIntersect(a: Point, b: Point, c: Point, d: Point): boolean {
+  const d1 = cross(c, d, a);
+  const d2 = cross(c, d, b);
+  const d3 = cross(a, b, c);
+  const d4 = cross(a, b, d);
+  return ((d1 > 0 && d2 < 0) || (d1 < 0 && d2 > 0)) && ((d3 > 0 && d4 < 0) || (d3 < 0 && d4 > 0));
+}
+
+const edges = (poly: readonly Point[]): [Point, Point][] => poly.map((p, i) => [p, poly[(i + 1) % poly.length]!]);
+
+/** Distance between two polygons; 0 when they touch, intersect or one contains the other. */
+export function polygonDistance(a: readonly Point[], b: readonly Point[]): number {
+  if (a.length === 0 || b.length === 0) return Infinity;
+  if (pointInPolygon(a[0]!, b) || pointInPolygon(b[0]!, a)) return 0;
+  const ea = edges(a);
+  const eb = edges(b);
+  let best = Infinity;
+  for (const [p, q] of ea) {
+    for (const [r, s] of eb) {
+      if (segmentsIntersect(p, q, r, s)) return 0;
+      best = Math.min(best, distToSegment(p, r, s), distToSegment(q, r, s), distToSegment(r, p, q), distToSegment(s, p, q));
+    }
+  }
+  return best;
+}
+
+/** Keeps the part of a convex polygon where `n·p <= c` (Sutherland–Hodgman against one line). */
+export function clipHalfPlane(poly: readonly Point[], n: Point, c: number): Point[] {
+  const side = (p: Point): number => n.x * p.x + n.y * p.y - c;
+  const out: Point[] = [];
+  for (let i = 0; i < poly.length; i++) {
+    const a = poly[i]!;
+    const b = poly[(i + 1) % poly.length]!;
+    const sa = side(a);
+    const sb = side(b);
+    if (sa <= 0) out.push(a);
+    if ((sa < 0 && sb > 0) || (sa > 0 && sb < 0)) {
+      const t = sa / (sa - sb);
+      out.push({ x: a.x + t * (b.x - a.x), y: a.y + t * (b.y - a.y) });
+    }
+  }
+  return out;
+}
+
+/**
+ * Separates two convex polygons by at least `gap`: picks the edge normal (of either polygon) along
+ * which they are best separated, and clips both with parallel lines `gap / 2` either side of the
+ * middle of their projections. Returns them unchanged when they are already `gap` apart.
+ */
+export function separatePair(a: readonly Point[], b: readonly Point[], gap: number): [Point[], Point[]] {
+  if (polygonDistance(a, b) >= gap) return [[...a], [...b]];
+  let best: { n: Point; mid: number; sep: number } | undefined;
+  for (const poly of [a, b]) {
+    for (const [p, q] of edges(poly)) {
+      const len = Math.hypot(q.x - p.x, q.y - p.y);
+      if (len === 0) continue;
+      for (const sign of [1, -1]) {
+        const n = { x: (sign * (q.y - p.y)) / len, y: (sign * -(q.x - p.x)) / len };
+        const pa = a.map((v) => n.x * v.x + n.y * v.y);
+        const pb = b.map((v) => n.x * v.x + n.y * v.y);
+        const maxA = Math.max(...pa);
+        const minB = Math.min(...pb);
+        const sep = minB - maxA;
+        if (!best || sep > best.sep) best = { n, mid: (maxA + minB) / 2, sep };
+      }
+    }
+  }
+  if (!best) return [[...a], [...b]];
+  const { n, mid } = best;
+  const clippedA = clipHalfPlane(a, n, mid - gap / 2);
+  const clippedB = clipHalfPlane(b, { x: -n.x, y: -n.y }, -(mid + gap / 2));
+  return [clippedA, clippedB];
+}
diff --git a/app/tools/layout/geometry.test.ts b/app/tools/layout/geometry.test.ts
new file mode 100644
index 0000000..d0a39ae
--- /dev/null
+++ b/app/tools/layout/geometry.test.ts
@@ -0,0 +1,57 @@
+import { describe, expect, it } from 'vitest';
+import { clipHalfPlane, convexHull, distToPolyline, minWidth, padHull, pointInPolygon, polygonDistance, separatePair } from './geometry.ts';
+
+const sq = (x: number, y: number, s: number) => [
+  { x, y },
+  { x: x + s, y },
+  { x: x + s, y: y + s },
+  { x, y: y + s },
+];
+
+describe('geometry', () => {
+  it('convexHull drops interior and collinear points', () => {
+    const hull = convexHull([...sq(0, 0, 10), { x: 5, y: 5 }, { x: 5, y: 0 }, { x: 0, y: 0 }]);
+    expect(hull).toHaveLength(4);
+    expect(convexHull([{ x: 1, y: 1 }])).toHaveLength(1);
+  });
+
+  it('padHull grows a polygon by at least the pad everywhere', () => {
+    const padded = padHull(sq(0, 0, 100), 24);
+    expect(minWidth(padded)).toBeGreaterThanOrEqual(148);
+    expect(minWidth(padded)).toBeLessThan(150);
+    for (const p of [{ x: -23.9, y: 50 }, { x: 50, y: 123.9 }, { x: -16.9, y: -16.9 }]) expect(pointInPolygon(p, padded)).toBe(true);
+  });
+
+  it('minWidth is the calipers width', () => {
+    expect(minWidth(sq(0, 0, 80))).toBeCloseTo(80);
+    expect(minWidth([{ x: 0, y: 0 }, { x: 200, y: 0 }, { x: 100, y: 30 }])).toBeCloseTo(30);
+  });
+
+  it('polygonDistance is 0 when they intersect or contain', () => {
+    expect(polygonDistance(sq(0, 0, 10), sq(5, 5, 10))).toBe(0);
+    expect(polygonDistance(sq(0, 0, 100), sq(10, 10, 5))).toBe(0);
+    expect(polygonDistance(sq(0, 0, 10), sq(40, 0, 10))).toBeCloseTo(30);
+  });
+
+  it('pointInPolygon and distToPolyline', () => {
+    expect(pointInPolygon({ x: 5, y: 5 }, sq(0, 0, 10))).toBe(true);
+    expect(pointInPolygon({ x: 15, y: 5 }, sq(0, 0, 10))).toBe(false);
+    expect(distToPolyline({ x: 5, y: 3 }, [{ x: 0, y: 0 }, { x: 10, y: 0 }])).toBeCloseTo(3);
+    expect(distToPolyline({ x: 13, y: 4 }, [{ x: 0, y: 0 }, { x: 10, y: 0 }])).toBeCloseTo(5);
+  });
+
+  it('clipHalfPlane keeps one side of a line', () => {
+    const clipped = clipHalfPlane(sq(0, 0, 10), { x: 1, y: 0 }, 4);
+    expect(Math.max(...clipped.map((p) => p.x))).toBeCloseTo(4);
+    expect(minWidth(clipped)).toBeCloseTo(4);
+  });
+
+  it('separatePair leaves the gap between overlapping polygons', () => {
+    const [a, b] = separatePair(sq(0, 0, 100), sq(80, 0, 100), 40);
+    expect(polygonDistance(a, b)).toBeGreaterThanOrEqual(40 - 1e-9);
+    expect(minWidth(a)).toBeCloseTo(70);
+    expect(minWidth(b)).toBeCloseTo(70);
+    const far = separatePair(sq(0, 0, 10), sq(100, 0, 10), 40);
+    expect(far[0]).toEqual(sq(0, 0, 10));
+  });
+});
diff --git a/app/tools/layout/to-layout.ts b/app/tools/layout/to-layout.ts
new file mode 100644
index 0000000..c044735
--- /dev/null
+++ b/app/tools/layout/to-layout.ts
@@ -0,0 +1,150 @@
+// raw.json (render_screen.py, render px) → ScreenLayout v1 (design px). Pure (Story 1.4).
+// Checks the naming contract `<kind>.<id>`, duplicates and out-of-frame points; divides by the
+// render scale; hulls and pads hit polygons; rounds to 0.1; serialises with sorted keys.
+import type { Point, ScreenLayout } from '../../src/content/layout-types.ts';
+import { convexHull, padHull, separatePair } from './geometry.ts';
+
+export interface RawObject {
+  name: string;
+  type: string;
+  /** [x, y, depth] in render px (top-left origin, y down); depth <= 0 is behind the camera. */
+  points: number[][];
+}
+
+export interface RawProjection {
+  screenId: string;
+  render: { width: number; height: number };
+  objects: RawObject[];
+  frames: string[];
+}
+
+export interface ToLayoutOptions {
+  design: { width: number; height: number };
+  /** Tokens.spacing.hitPad: hit polygons are padded outward by this (design px). */
+  hitPad: number;
+  /**
+   * Hit ids kept at least `gap` apart (the map's stations, `Tokens.spacing.stationGap`). Padded
+   * hulls closer than that are clipped by parallel lines either side of their best separating axis
+   * (perspective makes tall props reach into the station behind them; see spec 1.4 Spec Change Log).
+   */
+  separate?: { ids: readonly string[]; gap: number };
+}
+
+/** Extra separation so rounding to 0.1 never brings two hits under the gap. */
+const SEPARATION_MARGIN = 0.5;
+
+export const LAYOUT_KINDS = ['anchor', 'hit', 'slot', 'path'] as const;
+export type LayoutKind = (typeof LAYOUT_KINDS)[number];
+
+/** `<kind>.<id>`, id kebab-case: `hit.pizza`, `anchor.pizza-stop`. */
+export const LAYOUT_NAME = /^(anchor|hit|slot|path)\.([a-z0-9]+(-[a-z0-9]+)*)$/;
+
+export class LayoutError extends Error {
+  readonly problems: string[];
+  constructor(problems: string[]) {
+    super(problems.join('\n'));
+    this.problems = problems;
+  }
+}
+
+/** Rounds to 0.1 (no -0). */
+export const round1 = (v: number): number => Math.round(v * 10) / 10 + 0;
+
+const roundPoint = (p: Point): Point => ({ x: round1(p.x), y: round1(p.y) });
+
+function sortRecord<T>(rec: Record<string, T>): Record<string, T> {
+  return Object.fromEntries(Object.keys(rec).sort().map((k) => [k, rec[k]!]));
+}
+
+/** Converts a raw projection to a layout, or throws a LayoutError listing every problem. */
+export function toLayout(raw: RawProjection, opts: ToLayoutOptions): ScreenLayout {
+  const problems: string[] = [];
+  const { width: rw, height: rh } = raw.render;
+  const scale = rw / opts.design.width;
+  if (!(scale > 0) || Math.abs(rh / opts.design.height - scale) > 1e-9) {
+    throw new LayoutError([`render size ${rw}×${rh} is not a multiple of the ${opts.design.width}×${opts.design.height} design`]);
+  }
+  const anchors: Record<string, Point> = {};
+  const hits: Record<string, Point[]> = {};
+  const slots: Record<string, Point> = {};
+  const paths: Record<string, Point[]> = {};
+  const seen = new Set<string>();
+
+  for (const obj of raw.objects) {
+    const m = LAYOUT_NAME.exec(obj.name);
+    if (!m) {
+      problems.push(`layout object "${obj.name}": name must be <anchor|hit|slot|path>.<kebab-id> (no Blender .001 suffix, lower case)`);
+      continue;
+    }
+    if (seen.has(obj.name)) {
+      problems.push(`layout object "${obj.name}": duplicate id`);
+      continue;
+    }
+    seen.add(obj.name);
+    const kind = m[1] as LayoutKind;
+    const id = m[2]!;
+    const out = obj.points.filter((p) => !(p[2]! > 0 && p[0]! >= 0 && p[0]! <= rw && p[1]! >= 0 && p[1]! <= rh));
+    if (out.length > 0) {
+      problems.push(`layout object "${obj.name}": ${out.length} point(s) behind the camera or outside the ${rw}×${rh} render`);
+      continue;
+    }
+    const pts: Point[] = obj.points.map((p) => ({ x: p[0]! / scale, y: p[1]! / scale }));
+    if (kind === 'anchor' || kind === 'slot') {
+      if (pts.length !== 1) {
+        problems.push(`layout object "${obj.name}": an ${kind} needs exactly one point (got ${pts.length})`);
+        continue;
+      }
+      (kind === 'anchor' ? anchors : slots)[id] = roundPoint(pts[0]!);
+    } else if (kind === 'path') {
+      if (pts.length < 2) {
+        problems.push(`layout object "${obj.name}": a path needs at least 2 points (got ${pts.length})`);
+        continue;
+      }
+      paths[id] = pts.map(roundPoint);
+    } else {
+      const hull = convexHull(pts);
+      if (hull.length < 3) {
+        problems.push(`layout object "${obj.name}": a hit needs at least 3 non-collinear points`);
+        continue;
+      }
+      hits[id] = padHull(hull, opts.hitPad);
+    }
+  }
+  if (problems.length > 0) throw new LayoutError(problems);
+  if (opts.separate) {
+    const ids = [...opts.separate.ids].filter((id) => hits[id]).sort();
+    for (let i = 0; i < ids.length; i++) {
+      for (let j = i + 1; j < ids.length; j++) {
+        const [a, b] = separatePair(hits[ids[i]!]!, hits[ids[j]!]!, opts.separate.gap + SEPARATION_MARGIN);
+        hits[ids[i]!] = a;
+        hits[ids[j]!] = b;
+      }
+    }
+  }
+  for (const id of Object.keys(hits)) hits[id] = hits[id]!.map(roundPoint);
+  return {
+    v: 1,
+    screenId: raw.screenId,
+    design: { width: opts.design.width, height: opts.design.height },
+    renderScale: scale,
+    anchors: sortRecord(anchors),
+    hits: sortRecord(hits),
+    slots: sortRecord(slots),
+    paths: sortRecord(paths),
+  };
+}
+
+function sortDeep(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(sortDeep);
+  if (value !== null && typeof value === 'object') {
+    const rec = value as Record<string, unknown>;
+    return Object.fromEntries(Object.keys(rec).sort().map((k) => [k, sortDeep(rec[k])]));
+  }
+  return value;
+}
+
+/** Deterministic JSON: sorted keys, 2-space indent, one `{ "x": …, "y": … }` point per line. */
+export function formatLayout(layout: ScreenLayout): string {
+  const text = JSON.stringify(sortDeep(layout), null, 2);
+  return `${text.replace(/\{\n\s+"x": (-?[\d.e+-]+),\n\s+"y": (-?[\d.e+-]+)\n\s+\}/g, '{ "x": $1, "y": $2 }')}\n`;
+}
