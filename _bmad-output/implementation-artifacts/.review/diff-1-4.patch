+import { describe, expect, it } from 'vitest';
+import { doctor } from './doctor.ts';
+
+describe('doctor', () => {
+  it('reports Blender, ffmpeg and edge-tts together', () => {
+    const lines = doctor({}, () => true, () => 'Blender 5.2.2 LTS\n');
+    expect(lines.map((l) => [l.tool, l.ok])).toEqual([
+      ['Blender', true],
+      ['ffmpeg', true],
+      ['edge-tts', true],
+    ]);
+    expect(lines[0]!.detail).toBe('Blender 5.2.2 LTS (blender)');
+  });
+
+  it('reports every missing tool and a wrong Blender version', () => {
+    const lines = doctor({}, (bin) => bin === 'blender', () => 'Blender 4.2.0\n');
+    expect(lines.every((l) => !l.ok)).toBe(true);
+    expect(lines[0]!.detail).toMatch(/needs Blender 5\.2 \(found 4\.2\.0\)/);
+    expect(lines[1]!.detail).toMatch(/^ffmpeg not found/);
+    expect(lines[2]!.detail).toMatch(/^edge-tts not found/);
+  });
+});
diff --git a/app/tools/lint/validate-content.ts b/app/tools/lint/validate-content.ts
new file mode 100644
index 0000000..c552fb7
--- /dev/null
+++ b/app/tools/lint/validate-content.ts
@@ -0,0 +1,119 @@
+// `npm run validate:content` — runs the content validators (AD-12): GameIds, the audio catalog
+// (id grammar, path convention, the file existing under public/) and the voice lines (rules of
+// content/validate.ts with the real filesystem and `lineHash`, including stray files), the screen
+// layouts (src/content/generated/<screen>.layout.json against stations and touch rules) and the image
+// assets (atlases, backgrounds, 8 MiB cap on every file under public/assets) — Story 1.4.
+import { existsSync, readdirSync, readFileSync, statSync } from 'node:fs';
+import { dirname, join, relative, resolve, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { ATLASES, BACKGROUNDS, SCREEN_IDS } from '../../src/content/assets.ts';
+import { AUDIO_CATALOG } from '../../src/content/audio-catalog.ts';
+import type { ScreenLayout } from '../../src/content/layout-types.ts';
+import { STATIONS } from '../../src/content/stations.ts';
+import { Tokens } from '../../src/core/tokens.ts';
+import { RENDER_SCALE, layoutLimits, pngSizeOf, validateAssets, validateLayout } from '../layout/rules.ts';
+import { GAME_IDS } from '../../src/content/types.ts';
+import { validateContent } from '../../src/content/validate.ts';
+import { VOICE_LINES } from '../../src/content/voice-lines.ts';
+import { lineHash } from '../tts/line-hash.ts';
+
+const VOICE_DIR = 'assets/audio/vo';
+
+const APP_DIR = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');
+/** Where `npm run render` writes `<screen>.layout.json`. */
+export const LAYOUT_DIR = join(APP_DIR, 'src', 'content', 'generated');
+
+/** Frames each screen's atlas must hold. */
+export const REQUIRED_FRAMES: Readonly<Record<string, readonly string[]>> = {
+  map: [...STATIONS.map((s) => `${s.id}/idle/00`), 'kart/idle/00'],
+};
+
+function listFiles(dir: string): string[] {
+  if (!existsSync(dir)) return [];
+  return readdirSync(dir, { withFileTypes: true }).flatMap((e) => (e.isDirectory() ? listFiles(join(dir, e.name)) : [join(dir, e.name)]));
+}
+
+/** Layout problems of every screen (missing or invalid JSON included). */
+export function layoutProblems(layoutDir: string): string[] {
+  const problems: string[] = [];
+  for (const screen of SCREEN_IDS) {
+    const file = join(layoutDir, `${screen}.layout.json`);
+    let layout: ScreenLayout;
+    try {
+      layout = JSON.parse(readFileSync(file, 'utf8')) as ScreenLayout;
+    } catch {
+      problems.push(`layout "${screen}": ${screen}.layout.json is missing or invalid (run npm run render -- ${screen})`);
+      continue;
+    }
+    if (layout.v !== 1 || layout.screenId !== screen) problems.push(`layout "${screen}": not a v1 layout of screen "${screen}"`);
+    if (screen === 'map') {
+      for (const p of validateLayout(layout, { stations: STATIONS, gameIds: GAME_IDS, limits: layoutLimits() })) problems.push(`layout "${screen}": ${p}`);
+    }
+  }
+  return problems;
+}
+
+/** Asset problems under `publicDir` (atlases, backgrounds, size caps). */
+export function assetProblems(publicDir: string): string[] {
+  const scale = RENDER_SCALE;
+  return validateAssets({
+    atlases: SCREEN_IDS.map((id) => ({ ...ATLASES[id], frames: REQUIRED_FRAMES[id] ?? [] })),
+    backgrounds: SCREEN_IDS.map((id) => ({ ...BACKGROUNDS[id], width: Tokens.design.width * scale, height: Tokens.design.height * scale })),
+    files: listFiles(join(publicDir, 'assets')).map((f) => ({ path: relative(publicDir, f).split(sep).join('/'), bytes: statSync(f).size })),
+    pngSize: (path) => {
+      try {
+        return pngSizeOf(readFileSync(resolve(publicDir, path)));
+      } catch {
+        return undefined;
+      }
+    },
+    readJson: (path) => {
+      try {
+        return JSON.parse(readFileSync(resolve(publicDir, path), 'utf8')) as unknown;
+      } catch {
+        return undefined;
+      }
+    },
+  });
+}
+
+/** Validates the real content against the files under `publicDir` and the layouts in `layoutDir`; returns the problems. */
+export function run(publicDir: string, layoutDir: string = LAYOUT_DIR): string[] {
+  const fileExists = (path: string): boolean => existsSync(resolve(publicDir, path));
+  const content = validateContent({
+    gameIds: GAME_IDS,
+    audio: AUDIO_CATALOG,
+    fileExists,
+    voice: {
+      lines: VOICE_LINES,
+      hashLine: lineHash,
+      fileExists,
+      listVoiceFiles: () => {
+        const dir = resolve(publicDir, VOICE_DIR);
+        return existsSync(dir) ? readdirSync(dir) : [];
+      },
+      readHash: (path) => {
+        try {
+          return readFileSync(resolve(publicDir, path), 'utf8');
+        } catch {
+          return undefined;
+        }
+      },
+    },
+  });
+  return [...content, ...layoutProblems(layoutDir), ...assetProblems(publicDir)];
+}
+
+function main(): void {
+  const publicDir = join(APP_DIR, 'public');
+  const problems = run(publicDir);
+  if (problems.length > 0) {
+    for (const p of problems) console.error(`content: ${p}`);
+    process.exit(1);
+  }
+  console.log(
+    `content: OK (${GAME_IDS.length} game ids, ${Object.keys(AUDIO_CATALOG).length} audio ids, ${VOICE_LINES.length} voice lines, ${SCREEN_IDS.length} layout(s) with ${STATIONS.length} stations, ${SCREEN_IDS.length} atlas(es), ${listFiles(join(publicDir, 'assets')).length} asset files)`,
+  );
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) main();
diff --git a/app/tools/lint/validate-content.test.ts b/app/tools/lint/validate-content.test.ts
new file mode 100644
index 0000000..e1275a0
--- /dev/null
+++ b/app/tools/lint/validate-content.test.ts
@@ -0,0 +1,125 @@
+// tools/lint/validate-content.ts wiring (Story 1.2 deferred item, picked up in 1.3): run(publicDir)
+// against temp public/ trees — real fs, real lineHash, real catalog and voice lines.
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, unlinkSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { dirname, join } from 'node:path';
+import { afterEach, describe, expect, it } from 'vitest';
+import { AUDIO_CATALOG } from '../../src/content/audio-catalog.ts';
+import { VOICE_LINES, voiceHashPath, voicePath } from '../../src/content/voice-lines.ts';
+import { lineHash } from '../tts/line-hash.ts';
+import { ATLASES, BACKGROUNDS } from '../../src/content/assets.ts';
+import { REQUIRED_FRAMES, run } from './validate-content.ts';
+
+const dirs: string[] = [];
+
+/** A PNG header (signature + IHDR) of the given size: the validator reads only the IHDR. */
+function pngHeader(width: number, height: number): Buffer {
+  const b = Buffer.alloc(33);
+  Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0, 0, 0, 13, 0x49, 0x48, 0x44, 0x52]).copy(b);
+  b.writeUInt32BE(width, 16);
+  b.writeUInt32BE(height, 20);
+  return b;
+}
+
+function atlasJson(frames: readonly string[]): string {
+  return JSON.stringify({ frames: Object.fromEntries(frames.map((f) => [f, {}])), meta: { size: { w: 1024, h: 1024 } } });
+}
+
+function put(root: string, rel: string, content: string | Buffer): void {
+  const file = join(root, rel);
+  mkdirSync(dirname(file), { recursive: true });
+  writeFileSync(file, content);
+}
+
+/** A public/ tree with every catalog file and every voice line's .m4a + current .hash. */
+function goodTree(): string {
+  const root = mkdtempSync(join(tmpdir(), 'bhc-public-'));
+  dirs.push(root);
+  for (const entry of Object.values(AUDIO_CATALOG)) put(root, entry.path, 'audio');
+  for (const line of VOICE_LINES) {
+    put(root, voicePath(line.id), 'audio');
+    put(root, voiceHashPath(line.id), `${lineHash(line)}\n`);
+  }
+  put(root, ATLASES.map.png, pngHeader(1024, 1024));
+  put(root, ATLASES.map.json, atlasJson(REQUIRED_FRAMES.map!));
+  put(root, BACKGROUNDS.map.path, pngHeader(2048, 1536));
+  return root;
+}
+
+afterEach(() => {
+  for (const d of dirs.splice(0)) rmSync(d, { recursive: true, force: true });
+});
+
+describe('validate-content run(publicDir)', () => {
+  it('a good tree passes', () => {
+    expect(run(goodTree())).toEqual([]);
+  });
+
+  it('the real public/ passes (committed voice files are current)', () => {
+    expect(run(join(import.meta.dirname, '..', '..', 'public'))).toEqual([]);
+  });
+
+  it('a missing voice file fails and names the id', () => {
+    const root = goodTree();
+    unlinkSync(join(root, voicePath('vo.shell.greeting')));
+    const problems = run(root);
+    expect(problems).toHaveLength(1);
+    expect(problems[0]).toMatch(/voice "vo\.shell\.greeting": file .*\.m4a is missing/);
+  });
+
+  it('an edited .hash fails and names the id', () => {
+    const root = goodTree();
+    put(root, voiceHashPath('vo.shell.greeting'), 'deadbeef\n');
+    const problems = run(root);
+    expect(problems).toHaveLength(1);
+    expect(problems[0]).toMatch(/voice "vo\.shell\.greeting": .* does not match the line/);
+  });
+
+  it('a stray voice file fails and names its id', () => {
+    const root = goodTree();
+    put(root, 'assets/audio/vo/vo.shell.old-hello.m4a', 'audio');
+    const problems = run(root);
+    expect(problems).toHaveLength(1);
+    expect(problems[0]).toMatch(/voice "vo\.shell\.old-hello": stray file/);
+  });
+
+  it('a missing catalog file fails (fileExists is wired to public/)', () => {
+    const root = goodTree();
+    unlinkSync(join(root, AUDIO_CATALOG['sfx.shell.pop'].path));
+    const problems = run(root);
+    expect(problems).toHaveLength(1);
+    expect(problems[0]).toMatch(/"sfx\.shell\.pop": file .* is missing/);
+  });
+
+  it('a missing atlas frame fails and names it', () => {
+    const root = goodTree();
+    put(root, ATLASES.map.json, atlasJson(REQUIRED_FRAMES.map!.filter((f) => f !== 'kart/idle/00')));
+    expect(run(root)).toEqual(['atlas "atlas.map": frame "kart/idle/00" is missing']);
+  });
+
+  it('a file over 8 MiB fails and names it', () => {
+    const root = goodTree();
+    put(root, 'assets/bg/huge.png', Buffer.alloc(8 * 1024 * 1024 + 1));
+    expect(run(root)).toEqual(['file assets/bg/huge.png: 8388609 bytes exceeds 8 MiB (8388608)']);
+  });
+
+  it('a wrong background size fails', () => {
+    const root = goodTree();
+    put(root, BACKGROUNDS.map.path, pngHeader(1024, 768));
+    expect(run(root)).toEqual(['background "bg.map": assets/bg/map.png is 1024×768 (must be 2048×1536)']);
+  });
+
+  it('a missing or broken layout fails naming the screen and the ids', () => {
+    const root = goodTree();
+    const layouts = mkdtempSync(join(tmpdir(), 'bhc-layout-'));
+    dirs.push(layouts);
+    expect(run(root, layouts)).toEqual(['layout "map": map.layout.json is missing or invalid (run npm run render -- map)']);
+    const real = JSON.parse(readFileSync(join(import.meta.dirname, '..', '..', 'src', 'content', 'generated', 'map.layout.json'), 'utf8'));
+    delete real.hits.pizza;
+    real.slots['race-1'] = real.anchors.race;
+    put(layouts, 'map.layout.json', JSON.stringify(real));
+    const problems = run(root, layouts);
+    expect(problems).toContain('layout "map": hit "pizza": missing or has fewer than 3 points');
+    expect(problems).toContain('layout "map": slot "race-1": inside the hit polygon of "race"');
+  });
+});
