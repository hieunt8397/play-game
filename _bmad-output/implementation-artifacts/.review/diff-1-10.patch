+// Session state (Story 1.7), memory only: a page reload starts fresh, so the kart is back at
+// `kart-start`. Epic 2 adds `resume` and `pendingFlyIns`; Story 2.1 moves the level to ProgressStore.
+import type { GameId, GameStartData, RoundOutcome } from '../content/types';
+import { nextLevel } from './difficulty';
+
+/** 2^31: seeds are non-negative 31-bit integers. */
+const SEED_RANGE = 2 ** 31;
+
+export class SessionStore {
+  /** The station of the last game started; Map parks the kart at its stop. */
+  lastStation: GameId | undefined = undefined;
+  /** Kart arrivals this session (the first trip is capped at kartDriveMaxMs, later ones at kartDriveRepeatMaxMs). */
+  kartTrips = 0;
+  /** Ladder level per game (Epic 1 keeps levels in memory). */
+  levels: Partial<Record<GameId, number>> = {};
+
+  /** `levels[id] ?? 0` clamped to `[0, ladderLength − 1]` (0 for an empty ladder). */
+  levelFor(id: GameId, ladderLength: number): number {
+    const max = Math.max(0, Math.floor(ladderLength) - 1);
+    const level = Math.floor(this.levels[id] ?? 0);
+    return Number.isFinite(level) ? Math.min(max, Math.max(0, level)) : 0;
+  }
+
+  /**
+   * Story 1.10: a round of `id` started at `startedLevel` completed; the next start uses
+   * `nextLevel(startedLevel, outcome, ladderLength)` (memory only; Story 2.1 persists it).
+   */
+  recordRound(id: GameId, startedLevel: number, outcome: Pick<RoundOutcome, 'questions' | 'firstTryCorrect' | 'maxHintLevel'>, ladderLength: number): number {
+    const level = nextLevel(startedLevel, outcome, ladderLength);
+    this.levels[id] = level;
+    return level;
+  }
+
+  /** Start data for a game: its session level and a fresh seed `floor(rng() × 2^31)`. */
+  startData(id: GameId, ladderLength: number, rng: () => number = Math.random): GameStartData {
+    const r = Math.min(Math.max(rng(), 0), 1 - Number.EPSILON);
+    return { level: this.levelFor(id, ladderLength), seed: Math.floor(r * SEED_RANGE) };
+  }
+}
+
+/** The app-wide session. */
+export const session = new SessionStore();
