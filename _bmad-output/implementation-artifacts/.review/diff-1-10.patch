+import { describe, expect, it } from 'vitest';
+import { SessionStore } from './session-store';
+
+describe('SessionStore', () => {
+  it('cold start: no last station, no trips, level 0', () => {
+    const s = new SessionStore();
+    expect(s.lastStation).toBeUndefined();
+    expect(s.kartTrips).toBe(0);
+    expect(s.levelFor('ice-cream', 3)).toBe(0);
+  });
+
+  it('levelFor clamps the stored level to the ladder', () => {
+    const s = new SessionStore();
+    s.levels['ice-cream'] = 5;
+    expect(s.levelFor('ice-cream', 3)).toBe(2);
+    s.levels['ice-cream'] = -2;
+    expect(s.levelFor('ice-cream', 3)).toBe(0);
+    s.levels['ice-cream'] = 1;
+    expect(s.levelFor('ice-cream', 3)).toBe(1);
+    expect(s.levelFor('ice-cream', 0)).toBe(0);
+  });
+
+  it('recordRound (Story 1.10): the next levelFor/startData uses nextLevel; a fresh store is back at 0', () => {
+    const s = new SessionStore();
+    expect(s.recordRound('ice-cream', 0, { questions: 3, firstTryCorrect: 3, maxHintLevel: 0 }, 4)).toBe(1);
+    expect(s.levelFor('ice-cream', 4)).toBe(1);
+    expect(s.startData('ice-cream', 4, () => 0).level).toBe(1);
+    s.recordRound('ice-cream', 1, { questions: 4, firstTryCorrect: 1, maxHintLevel: 4 }, 4);
+    expect(s.levelFor('ice-cream', 4)).toBe(0);
+    s.recordRound('ice-cream', 0, { questions: 3, firstTryCorrect: 2, maxHintLevel: 4 }, 4);
+    expect(s.levelFor('ice-cream', 4)).toBe(0);
+    s.recordRound('ice-cream', 0, { questions: 3, firstTryCorrect: 3, maxHintLevel: 0 }, 4);
+    expect(new SessionStore().levelFor('ice-cream', 4)).toBe(0);
+  });
+
+  it('startData: level from the store, seed floor(rng × 2^31)', () => {
+    const s = new SessionStore();
+    s.levels.pizza = 1;
+    expect(s.startData('pizza', 5, () => 0.5)).toEqual({ level: 1, seed: 2 ** 30 });
+    expect(s.startData('pizza', 5, () => 0).seed).toBe(0);
+    const top = s.startData('pizza', 5, () => 1).seed;
+    expect(top).toBeLessThan(2 ** 31);
+    expect(Number.isInteger(top)).toBe(true);
+  });
+});
