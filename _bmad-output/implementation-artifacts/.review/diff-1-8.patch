+import { describe, expect, it, vi } from 'vitest';
+import { createHint, type HintQuestion } from './hint-director';
+
+function setup() {
+  const audio = { setPrompt: vi.fn(), say: vi.fn() };
+  return { audio, hint: createHint(undefined, { audio }) };
+}
+
+const Q: HintQuestion = {
+  promptLineId: 'vo.ice-cream.ask.mint',
+  retryLineId: 'vo.ice-cream.retry.mint',
+  step: { correct: [], distractors: [], target: null, action: 'drag' },
+};
+
+describe('hint-director stub (Story 1.8)', () => {
+  it('beginQuestion sets the prompt and says it', () => {
+    const { audio, hint } = setup();
+    hint.beginQuestion(Q);
+    expect(audio.setPrompt).toHaveBeenCalledWith('vo.ice-cream.ask.mint');
+    expect(audio.say).toHaveBeenCalledWith('vo.ice-cream.ask.mint');
+  });
+
+  it('wrong() says the current retry line', () => {
+    const { audio, hint } = setup();
+    hint.beginQuestion(Q);
+    audio.say.mockClear();
+    hint.wrong();
+    expect(audio.say).toHaveBeenCalledExactlyOnceWith('vo.ice-cream.retry.mint');
+  });
+
+  it('wrong() before any question, or after questionDone, is a no-op', () => {
+    const { audio, hint } = setup();
+    hint.wrong();
+    expect(audio.say).not.toHaveBeenCalled();
+    hint.beginQuestion(Q);
+    hint.questionDone();
+    audio.say.mockClear();
+    hint.wrong();
+    expect(audio.say).not.toHaveBeenCalled();
+  });
+
+  it('stepDone and replayPrompt are valid no-ops', () => {
+    const { audio, hint } = setup();
+    hint.beginQuestion(Q);
+    audio.say.mockClear();
+    hint.stepDone(null);
+    hint.replayPrompt();
+    expect(audio.say).not.toHaveBeenCalled();
+  });
+});
