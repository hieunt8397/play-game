+// HintDirector (AD-5). Story 1.8 ships the stub with the final signatures: a game reports each
+// question and its outcome here and never plays a prompt or retry line itself. Story 1.9 replaces
+// the body of `createHint` with the timed escalation (ring, hand, dim, snap ×2) behind the same API.
+// Stub behaviour:
+//   beginQuestion(q) → audio.setPrompt(prompt) + audio.say(prompt); remembers the retry line;
+//   wrong()          → audio.say(retry) (no-op with no active question);
+//   questionDone()   → forgets the question; stepDone/replayPrompt → no-ops.
+import { audio as audioDirector } from './audio-director';
+import type { DropTarget } from './input/drop';
+import type { Draggable } from './input/drag-controller';
+import type { Point } from './input/polygon';
+
+export type HintAction = 'drag' | 'tap' | 'trace';
+
+/** What the hint system needs to demonstrate one step of a question. */
+export interface HintStep {
+  readonly correct: readonly Draggable[];
+  readonly distractors: readonly Draggable[];
+  readonly target: DropTarget | null;
+  readonly action: HintAction;
+  readonly path?: readonly Point[];
+}
+
+export interface HintQuestion {
+  readonly promptLineId: string;
+  readonly retryLineId: string;
+  readonly step: HintStep;
+}
+
+export interface Hint {
+  beginQuestion(q: HintQuestion): void;
+  /** The current step is done; `next` is the following one (multi-step questions, Story 1.10). */
+  stepDone(next: HintStep | null, lines?: { readonly promptLineId?: string; readonly retryLineId?: string }): void;
+  /** A wrong attempt: the retry voice (rate-limited and escalated from Story 1.9). */
+  wrong(): void;
+  questionDone(): void;
+  replayPrompt(): void;
+}
+
+/** The audio slice the hint system uses. */
+export interface HintAudio {
+  setPrompt(id: string): void;
+  say(id: string): unknown;
+}
+
+export interface HintDeps {
+  readonly audio: HintAudio;
+}
+
+/** The hint system of a game scene (`MiniGameBase.hint`). `scene` is used from Story 1.9 (timers, visuals). */
+export function createHint(_scene: unknown, deps: HintDeps = { audio: audioDirector }): Hint {
+  let active: HintQuestion | undefined;
+  return {
+    beginQuestion(q) {
+      active = q;
+      deps.audio.setPrompt(q.promptLineId);
+      deps.audio.say(q.promptLineId);
+    },
+    stepDone() {
+      // Story 1.9.
+    },
+    wrong() {
+      if (active) deps.audio.say(active.retryLineId);
+    },
+    questionDone() {
+      active = undefined;
+    },
+    replayPrompt() {
+      // Story 1.9 (the Speaker already replays the prompt through audio.replayPrompt).
+    },
+  };
+}
