+import { describe, expect, it } from 'vitest';
+import { FLAVOURS } from '../../content/games/ice-cream';
+import { questionFor } from './questions';
+
+describe('questionFor', () => {
+  it('is deterministic for the same seed, index and level', () => {
+    for (let i = 0; i < 10; i++) expect(questionFor(7, i, 0)).toEqual(questionFor(7, i, 0));
+  });
+
+  it('level 0: two distinct flavours at scoop-2 and scoop-3, the target among them', () => {
+    for (let i = 0; i < 20; i++) {
+      const q = questionFor(7, i, 0);
+      expect(q.index).toBe(i);
+      expect(q.scoops.map((s) => s.home)).toEqual(['scoop-2', 'scoop-3']);
+      expect(new Set(q.scoops.map((s) => s.flavour)).size).toBe(2);
+      expect(q.scoops.map((s) => s.flavour)).toContain(q.target);
+    }
+  });
+
+  it('consecutive targets differ, and all 4 flavours are asked in indexes 0..19', () => {
+    for (const seed of [0, 7, 42, 123456, 2 ** 31 - 1]) {
+      const targets = Array.from({ length: 20 }, (_, i) => questionFor(seed, i, 0).target);
+      for (let i = 1; i < targets.length; i++) expect(targets[i]).not.toBe(targets[i - 1]);
+      expect(new Set(targets)).toEqual(new Set(FLAVOURS));
+    }
+  });
+
+  it('different seeds give different rounds', () => {
+    const a = Array.from({ length: 6 }, (_, i) => questionFor(1, i, 0).target).join();
+    const b = Array.from({ length: 6 }, (_, i) => questionFor(2, i, 0).target).join();
+    expect(a).not.toBe(b);
+  });
+
+  it('clamps an out-of-range level', () => {
+    expect(questionFor(7, 3, 99)).toEqual(questionFor(7, 3, 0));
+  });
+});
diff --git a/app/src/games/ice-cream/round.ts b/app/src/games/ice-cream/round.ts
new file mode 100644
index 0000000..e9bea55
--- /dev/null
+++ b/app/src/games/ice-cream/round.ts
@@ -0,0 +1,229 @@
+// Tiệm kem round model (Story 1.8), pure: the scoops on the counter, the cone, drop resolution and
+// the outcome commands. The scene (IceCream.ts) only applies the commands with Phaser.
+// Drop resolution of a scoop, first match wins:
+//   1. inside the cone target (circle at slot.cone-1, r = snapRadius × snapScale) → serve
+//   2. inside hit.shiba → serve
+//   3. within snapRadius/2 of its own pre-lift position → home (settles back, no hint)
+//   4. inside hit.counter-upper → serve
+//   5. inside hit.counter → rest (nudged clear of the other scoops; its new pre-lift position)
+//   6. anywhere else → off (slides back after a delay; a new lift cancels the slide)
+// A correct serve snaps onto the cone, a fresh scoop of that flavour pops in at its home and Shiba
+// celebrates (every scoop unpickable meanwhile); a wrong serve floats back and reports `hintWrong`.
+// The cone contents and the question survive every outcome.
+import type { FlavourId } from '../../content/games/ice-cream';
+import type { Point } from '../../content/layout-types';
+import type { Snapshot } from '../../content/types';
+import { nudgeApart } from '../../core/input/drop';
+import type { Rect } from '../../core/safe-rect';
+import { questionFor, type Question } from './questions';
+
+export interface Area {
+  contains(p: Point): boolean;
+}
+
+export interface RoundGeometry {
+  /** Centre of a scoop resting at home slot `slot`. */
+  homeCentre(slot: string): Point;
+  /** Centre of the n-th scoop on the cone (0-based; clamped to the last slot). */
+  coneCentre(n: number): Point;
+  readonly cone: Area;
+  readonly shiba: Area;
+  readonly counterUpper: Area;
+  readonly counter: Area;
+  /** Where a resting scoop may lie: the counter's box ∩ the drag bounds. */
+  restRect(): Rect;
+  /** dropTarget.snapRadius (design px). */
+  readonly snapRadius: number;
+  /** draggableItem.minSize: resting scoops stay this far apart. */
+  readonly minSize: number;
+  readonly offCounterDelayMs: number;
+  /** After a correct snap, the next question starts this much later. */
+  readonly nextQuestionDelayMs: number;
+}
+
+export interface ScoopState {
+  readonly id: string;
+  readonly flavour: FlavourId;
+  /** Pre-lift position (centre). */
+  readonly at: Point;
+}
+
+export type RoundCommand =
+  | { readonly kind: 'build'; readonly scoops: readonly ScoopState[] }
+  | { readonly kind: 'beginQuestion'; readonly target: FlavourId; readonly correct: readonly string[]; readonly distractors: readonly string[] }
+  | { readonly kind: 'snap'; readonly id: string; readonly to: Point }
+  | { readonly kind: 'floatBack'; readonly id: string; readonly to: Point }
+  | { readonly kind: 'rest'; readonly id: string; readonly at: Point }
+  | { readonly kind: 'returnLater'; readonly id: string; readonly to: Point; readonly ms: number }
+  | { readonly kind: 'cancelReturn'; readonly id: string }
+  | { readonly kind: 'respawn'; readonly scoop: ScoopState }
+  | { readonly kind: 'pickable'; readonly on: boolean }
+  | { readonly kind: 'celebrate' }
+  | { readonly kind: 'hintWrong' }
+  | { readonly kind: 'questionDone' }
+  | { readonly kind: 'nextLater'; readonly ms: number }
+  | { readonly kind: 'clear' };
+
+export type DropOutcome = 'serve' | 'home' | 'rest' | 'off';
+
+export interface IceCreamProgress {
+  readonly questionIndex: number;
+  readonly partial: { readonly placed: FlavourId[] };
+}
+
+export class IceCreamRound {
+  private readonly geo: RoundGeometry;
+  private readonly seed: number;
+  private readonly level: number;
+  private index: number;
+  private question: Question;
+  private scoops = new Map<string, ScoopState>();
+  private placed: FlavourId[] = [];
+  private pendingReturn = new Set<string>();
+  private celebrating = false;
+  private nextId = 1;
+
+  constructor(geo: RoundGeometry, seed: number, level: number, startIndex = 0) {
+    this.geo = geo;
+    this.seed = seed;
+    this.level = level;
+    this.index = startIndex;
+    this.question = questionFor(seed, startIndex, level);
+  }
+
+  get questionIndex(): number {
+    return this.index;
+  }
+
+  get target(): FlavourId {
+    return this.question.target;
+  }
+
+  get isCelebrating(): boolean {
+    return this.celebrating;
+  }
+
+  /** Current scoops on the counter (not the ones on the cone). */
+  scoopStates(): ScoopState[] {
+    return [...this.scoops.values()];
+  }
+
+  conePlaced(): readonly FlavourId[] {
+    return this.placed;
+  }
+
+  /** Lays out the current question: its scoops and the hint question. */
+  start(): RoundCommand[] {
+    this.scoops = new Map();
+    this.pendingReturn = new Set();
+    this.celebrating = false;
+    for (const s of this.question.scoops) this.add(s.flavour, this.geo.homeCentre(s.home));
+    return [{ kind: 'build', scoops: this.scoopStates() }, { kind: 'pickable', on: true }, this.begin()];
+  }
+
+  /** A finger lifted scoop `id`: a pending slide back is cancelled. */
+  lift(id: string): RoundCommand[] {
+    if (!this.pendingReturn.delete(id)) return [];
+    return [{ kind: 'cancelReturn', id }];
+  }
+
+  /** Where a drop at `p` of scoop `id` resolves (no state change). */
+  resolve(id: string, p: Point): DropOutcome {
+    const item = this.scoops.get(id);
+    const g = this.geo;
+    if (g.cone.contains(p) || g.shiba.contains(p)) return 'serve';
+    if (item && Math.hypot(p.x - item.at.x, p.y - item.at.y) <= g.snapRadius / 2) return 'home';
+    if (g.counterUpper.contains(p)) return 'serve';
+    if (g.counter.contains(p)) return 'rest';
+    return 'off';
+  }
+
+  /** Scoop `id` released at `p` (its centre). */
+  drop(id: string, p: Point): RoundCommand[] {
+    const item = this.scoops.get(id);
+    if (!item) return [];
+    // While Shiba celebrates every scoop is unpickable; a drag already running just goes back.
+    if (this.celebrating) return [{ kind: 'floatBack', id, to: item.at }];
+    switch (this.resolve(id, p)) {
+      case 'serve':
+        return item.flavour === this.question.target
+          ? this.serveCorrect(item)
+          : [{ kind: 'floatBack', id, to: item.at }, { kind: 'hintWrong' }];
+      case 'home':
+        return [{ kind: 'floatBack', id, to: item.at }];
+      case 'rest': {
+        const others = this.scoopStates()
+          .filter((s) => s.id !== id)
+          .map((s) => s.at);
+        const at = nudgeApart(p, others, this.geo.minSize, this.geo.restRect());
+        this.scoops.set(id, { ...item, at });
+        return [{ kind: 'rest', id, at }];
+      }
+      case 'off':
+        this.pendingReturn.add(id);
+        return [{ kind: 'returnLater', id, to: item.at, ms: this.geo.offCounterDelayMs }];
+    }
+  }
+
+  /** The drag of `id` ended without a release (pause, lost up): back to its pre-lift spot. */
+  cancel(id: string): RoundCommand[] {
+    const item = this.scoops.get(id);
+    return item ? [{ kind: 'floatBack', id, to: item.at }] : [];
+  }
+
+  /** A delayed slide back ran. */
+  returned(id: string): void {
+    this.pendingReturn.delete(id);
+  }
+
+  /** Next question (the scene calls it `nextLater.ms` after a correct snap). */
+  next(): RoundCommand[] {
+    this.index += 1;
+    this.question = questionFor(this.seed, this.index, this.level);
+    this.placed = [];
+    return [{ kind: 'clear' }, ...this.start()];
+  }
+
+  /** The resumable state (AD-2). */
+  progress(): IceCreamProgress {
+    return { questionIndex: this.index, partial: { placed: [...this.placed] } };
+  }
+
+  snapshot(): Snapshot {
+    return { v: 1, level: this.level, seed: this.seed, questionIndex: this.index, partial: { placed: [...this.placed] } };
+  }
+
+  private serveCorrect(item: ScoopState): RoundCommand[] {
+    const to = this.geo.coneCentre(this.placed.length);
+    this.placed.push(item.flavour);
+    this.scoops.delete(item.id);
+    this.pendingReturn.delete(item.id);
+    const home = this.question.scoops.find((s) => s.flavour === item.flavour)?.home;
+    const fresh = this.add(item.flavour, home ? this.geo.homeCentre(home) : item.at);
+    this.celebrating = true;
+    return [
+      { kind: 'snap', id: item.id, to },
+      { kind: 'respawn', scoop: fresh },
+      { kind: 'pickable', on: false },
+      { kind: 'celebrate' },
+      { kind: 'questionDone' },
+      { kind: 'nextLater', ms: this.geo.nextQuestionDelayMs },
+    ];
+  }
+
+  private begin(): RoundCommand {
+    const all = this.scoopStates();
+    return {
+      kind: 'beginQuestion',
+      target: this.question.target,
+      correct: all.filter((s) => s.flavour === this.question.target).map((s) => s.id),
+      distractors: all.filter((s) => s.flavour !== this.question.target).map((s) => s.id),
+    };
+  }
+
+  private add(flavour: FlavourId, at: Point): ScoopState {
+    const s: ScoopState = { id: `scoop-${this.nextId++}`, flavour, at };
+    this.scoops.set(s.id, s);
+    return s;
+  }
+}
diff --git a/app/src/games/ice-cream/round.test.ts b/app/src/games/ice-cream/round.test.ts
new file mode 100644
index 0000000..6f389c4
--- /dev/null
+++ b/app/src/games/ice-cream/round.test.ts
@@ -0,0 +1,160 @@
+import { describe, expect, it } from 'vitest';
+import type { Point } from '../../content/layout-types';
+import { pointInPolygon } from '../../core/input/polygon';
+import { IceCreamRound, type RoundCommand, type RoundGeometry } from './round';
+
+const rect = (x0: number, y0: number, x1: number, y1: number): Point[] => [
+  { x: x0, y: y0 },
+  { x: x1, y: y0 },
+  { x: x1, y: y1 },
+  { x: x0, y: y1 },
+];
+const poly = (pts: Point[]) => ({ contains: (p: Point) => pointInPolygon(p, pts) });
+
+const HOMES: Record<string, Point> = {
+  'scoop-1': { x: 152, y: 560 },
+  'scoop-2': { x: 332, y: 560 },
+  'scoop-3': { x: 692, y: 560 },
+  'scoop-4': { x: 872, y: 560 },
+};
+const CONE = { x: 512, y: 450, r: 100 };
+
+const GEO: RoundGeometry = {
+  homeCentre: (slot) => HOMES[slot]!,
+  coneCentre: (n) => ({ x: 512, y: 430 - 40 * Math.min(n, 2) }),
+  cone: { contains: (p) => Math.hypot(p.x - CONE.x, p.y - CONE.y) <= CONE.r },
+  shiba: poly(rect(420, 150, 600, 340)),
+  counterUpper: poly(rect(50, 500, 970, 620)),
+  counter: poly(rect(50, 500, 970, 760)),
+  restRect: () => ({ x: 50, y: 500, w: 920, h: 230 }),
+  snapRadius: 100,
+  minSize: 90,
+  offCounterDelayMs: 1500,
+  nextQuestionDelayMs: 2000,
+};
+
+function setup(seed = 7) {
+  const round = new IceCreamRound(GEO, seed, 0);
+  const cmds = round.start();
+  const scoops = round.scoopStates();
+  const target = scoops.find((s) => s.flavour === round.target)!;
+  const other = scoops.find((s) => s.flavour !== round.target)!;
+  return { round, cmds, target, other };
+}
+
+const kinds = (cmds: readonly RoundCommand[]) => cmds.map((c) => c.kind);
+
+describe('IceCreamRound', () => {
+  it('Enter {level 0, seed 7}: two scoops at scoop-2/3 and a beginQuestion for the target', () => {
+    const { round, cmds, target, other } = setup(7);
+    expect(kinds(cmds)).toEqual(['build', 'pickable', 'beginQuestion']);
+    const build = cmds[0] as Extract<RoundCommand, { kind: 'build' }>;
+    expect(build.scoops.map((s) => s.at)).toEqual([HOMES['scoop-2'], HOMES['scoop-3']]);
+    expect(cmds[2]).toEqual({ kind: 'beginQuestion', target: round.target, correct: [target.id], distractors: [other.id] });
+    expect(round.snapshot()).toEqual({ v: 1, level: 0, seed: 7, questionIndex: 0, partial: { placed: [] } });
+  });
+
+  it('correct scoop dropped 80 px from cone-1: snap, respawn at home, unpickable, celebrate, questionDone, next in 2 s', () => {
+    const { round, target } = setup();
+    const cmds = round.drop(target.id, { x: CONE.x + 80, y: CONE.y });
+    expect(cmds).toEqual([
+      { kind: 'snap', id: target.id, to: { x: 512, y: 430 } },
+      { kind: 'respawn', scoop: { id: expect.any(String), flavour: target.flavour, at: target.at } },
+      { kind: 'pickable', on: false },
+      { kind: 'celebrate' },
+      { kind: 'questionDone' },
+      { kind: 'nextLater', ms: 2000 },
+    ]);
+    expect(round.isCelebrating).toBe(true);
+    expect(round.progress()).toEqual({ questionIndex: 0, partial: { placed: [target.flavour] } });
+    expect(round.scoopStates()).toHaveLength(2);
+  });
+
+  it.each([
+    ['Shiba', { x: 500, y: 250 }],
+    ['the upper counter', { x: 900, y: 600 }],
+  ])('correct scoop dropped on %s is served the same way', (_name, p) => {
+    const { round, target } = setup();
+    expect(round.resolve(target.id, p)).toBe('serve');
+    expect(kinds(round.drop(target.id, p))).toEqual(['snap', 'respawn', 'pickable', 'celebrate', 'questionDone', 'nextLater']);
+  });
+
+  it('wrong scoop on the cone floats back to its pre-lift spot and reports hintWrong only', () => {
+    const { round, other } = setup();
+    expect(round.drop(other.id, { x: CONE.x, y: CONE.y })).toEqual([{ kind: 'floatBack', id: other.id, to: other.at }, { kind: 'hintWrong' }]);
+    expect(round.progress().partial.placed).toEqual([]);
+    expect(round.isCelebrating).toBe(false);
+  });
+
+  it('own home: dropped within snapRadius/2 of its pre-lift spot settles with no hint', () => {
+    const { round, other } = setup();
+    const p = { x: other.at.x + 30, y: other.at.y + 30 };
+    expect(round.drop(other.id, p)).toEqual([{ kind: 'floatBack', id: other.id, to: other.at }]);
+  });
+
+  it('rest: lower counter on top of another scoop stays, nudged ≥ minSize apart; the new spot is its home for floats', () => {
+    const { round, other, target } = setup();
+    const onTop = { x: target.at.x + 10, y: 690 };
+    const lowNeighbour = { ...target.at, y: 690 };
+    // Put the target low first so both rest on the lower counter.
+    round.drop(target.id, lowNeighbour);
+    const cmds = round.drop(other.id, onTop);
+    expect(cmds).toHaveLength(1);
+    const rest = cmds[0] as Extract<RoundCommand, { kind: 'rest' }>;
+    expect(rest.kind).toBe('rest');
+    const t = round.scoopStates().find((s) => s.id === target.id)!;
+    expect(Math.hypot(rest.at.x - t.at.x, rest.at.y - t.at.y)).toBeGreaterThanOrEqual(90 - 1e-9);
+    // A later wrong serve floats back to the resting spot.
+    expect(round.drop(other.id, { x: CONE.x, y: CONE.y })[0]).toEqual({ kind: 'floatBack', id: other.id, to: rest.at });
+  });
+
+  it('off the counter: slides back after 1500 ms; lifting again cancels the slide', () => {
+    const { round, other } = setup();
+    expect(round.drop(other.id, { x: 500, y: 60 })).toEqual([{ kind: 'returnLater', id: other.id, to: other.at, ms: 1500 }]);
+    expect(round.lift(other.id)).toEqual([{ kind: 'cancelReturn', id: other.id }]);
+    expect(round.lift(other.id)).toEqual([]);
+  });
+
+  it('pause mid-drag (cancel): back to the pre-lift spot', () => {
+    const { round, other } = setup();
+    expect(round.cancel(other.id)).toEqual([{ kind: 'floatBack', id: other.id, to: other.at }]);
+  });
+
+  it('celebrating: a drag still running just floats back (no second serve, no hint)', () => {
+    const { round, target, other } = setup();
+    round.drop(target.id, { x: CONE.x, y: CONE.y });
+    expect(round.drop(other.id, { x: CONE.x, y: CONE.y })).toEqual([{ kind: 'floatBack', id: other.id, to: other.at }]);
+    expect(round.progress().partial.placed).toHaveLength(1);
+  });
+
+  it('next(): clears the cone, lays out question 1 with a different target', () => {
+    const { round, target } = setup();
+    const first = round.target;
+    round.drop(target.id, { x: CONE.x, y: CONE.y });
+    const cmds = round.next();
+    expect(kinds(cmds)).toEqual(['clear', 'build', 'pickable', 'beginQuestion']);
+    expect(round.questionIndex).toBe(1);
+    expect(round.target).not.toBe(first);
+    expect(round.isCelebrating).toBe(false);
+    expect(round.snapshot()).toMatchObject({ questionIndex: 1, partial: { placed: [] } });
+  });
+
+  it('the cone and the question survive wrong, home, rest and off outcomes', () => {
+    const { round, target, other } = setup();
+    round.drop(target.id, { x: CONE.x, y: CONE.y });
+    round.next();
+    const q = round.target;
+    const [a] = round.scoopStates();
+    round.drop(a!.id, { x: CONE.x, y: CONE.y });
+    round.drop(a!.id, { x: 500, y: 60 });
+    expect(round.target).toBe(q);
+    expect(round.questionIndex).toBe(1);
+    expect(other).toBeDefined();
+  });
+
+  it('unknown scoop ids are ignored', () => {
+    const { round } = setup();
+    expect(round.drop('nope', { x: 0, y: 0 })).toEqual([]);
+    expect(round.cancel('nope')).toEqual([]);
+  });
+});
diff --git a/app/src/scenes/Map.ts b/app/src/scenes/Map.ts
new file mode 100644
index 0000000..0a741bd
--- /dev/null
+++ b/app/src/scenes/Map.ts
@@ -0,0 +1,474 @@
+// Map (Stories 1.5, 1.7): the island. Draws the plate `bg.map`, the 7 station sprites from `atlas.map`
+// (full-frame on their ground pivots, spec-1-4 contract), a static parent-facing label under each
+// station and the kart on the road. Taps go through core/input (one router per scene):
+//   - awake station (in games/registry GAMES) → core/kart-trip: bounce + name, the game's assets
+//     start loading, the kart drives along `paths.road` to the station's stop, the camera zooms in
+//     (core/motion; a fade under reduced motion) and the shell starts the game; Map sleeps;
+//   - sleeping station → bounce + happy sound; kart → bounce + beep (a boost while driving);
+//   - every tap resets idle (core/map-idle), which is suspended while the kart travels.
+// A terminal event (`round:complete` / `round:abandon`) of the running game stops it and wakes Map:
+// the island fades back with the kart parked at `SessionStore.lastStation`. The game's own assets are
+// removed when its scene shuts down (AR39). Timing, routing and geometry are pure core code; this
+// scene only wires Phaser. The kart moves only in `update` (no timers or tweens), so a pause freezes it.
+import { Scene, type GameObjects } from 'phaser';
+import { ATLASES, BACKGROUNDS, MAP_KART } from '../content/assets';
+import type { Point } from '../content/layout-types';
+import { LAYOUTS } from '../content/layouts';
+import { KART_START_ANCHOR, ROAD_PATH, STATIONS, stopAnchor } from '../content/stations';
+import { inviteLine, stationNameLine } from '../content/voice-lines';
+import { audio } from '../core/audio-director';
+import { bus } from '../core/bus';
+import { AssetTracker, loadPlan, releasePlan } from '../core/game-assets';
+import { createHintRing, type HintRing } from '../core/hint-visuals';
+import { setHudMode } from '../core/hud-mode';
+import { HotspotPolygon } from '../core/input/hotspot-polygon';
+import { boundingBox, pointInPolygon } from '../core/input/polygon';
+import { createTapRouter } from '../core/input/tap-router';
+import { createTapTarget, type TapTarget } from '../core/input/tap-target';
+import { KART_TARGET, KartTrip, type TripCommand } from '../core/kart-trip';
+import { createMapIdle, type MapIdle, type MapIdleEvent } from '../core/map-idle';
+import { planMap, type MapPlan, type PlannedKart, type PlannedStation } from '../core/map-plan';
+import { enterStation, revealScene } from '../core/motion';
+import { amplitude, prefersReducedMotion } from '../core/reduced-motion';
+import { createRoad } from '../core/road';
+import { session } from '../core/session-store';
+import { Tokens } from '../core/tokens';
+import { bob, bounce, isMoving, stopMotion } from '../core/ui/scale-motion';
+import { GAMES, isGameId, ladderLength } from '../games/registry';
+
+const HUD_KEY = 'Hud';
+const WAKE = 'wake';
+const SHUTDOWN = 'shutdown';
+const FILE_COMPLETE = 'filecomplete';
+const LOAD_ERROR = 'loaderror';
+const LOAD_COMPLETE = 'complete';
+
+interface StationView {
+  readonly plan: PlannedStation;
+  readonly image: GameObjects.Image | undefined;
+}
+
+interface FrameData {
+  readonly spriteSourceSize?: { x: number; y: number; w: number; h: number };
+}
+
+interface KartView {
+  readonly plan: PlannedKart;
+  readonly body: GameObjects.Container;
+  readonly image: GameObjects.Image | undefined;
+  readonly target: TapTarget;
+}
+
+export class MapScene extends Scene {
+  private idle: MapIdle | undefined;
+  private views = new Map<string, StationView>();
+  private ring: HintRing | undefined;
+  private reduced = false;
+  private plan: MapPlan | undefined;
+  private stops: Record<string, number> = {};
+  private trip: KartTrip | undefined;
+  private kart: KartView | undefined;
+  /** Sign of the last x travel (the kart's facing); starts as the art faces. */
+  private travelSign: number = MAP_KART.artFacing;
+  private tracker = new AssetTracker();
+  /** The MiniGame started from here and not yet terminal. */
+  private running: string | undefined;
+  /** Games whose assets this Map loaded and has not released yet (a re-targeted trip loads more than one). */
+  private loadedGames = new Set<string>();
+
+  constructor() {
+    super('Map');
+  }
+
+  create(): void {
+    this.cameras.main.setBackgroundColor(Tokens.colors.sky.css);
+    this.reduced = prefersReducedMotion(window);
+    this.views = new Map();
+    this.ring = undefined;
+    this.tracker = new AssetTracker();
+    this.running = undefined;
+    this.loadedGames = new Set();
+
+    const layout = LAYOUTS.map;
+    const atlasKey = ATLASES.map.key;
+    const hasAtlas = this.textures.exists(atlasKey);
+    const labels = new Map<string, GameObjects.Text>();
+    const label = (text: string): GameObjects.Text => {
+      let t = labels.get(text);
+      if (!t) {
+        t = this.addLabel(text);
+        labels.set(text, t);
+      }
+      return t;
+    };
+
+    const plan = planMap(
+      layout,
+      // A station is awake only when its game is registered.
+      STATIONS.map((s) => ({ ...s, awake: s.awake && isGameId(s.id) })),
+      (frame) => hasAtlas && this.textures.get(atlasKey).has(frame),
+      (frame) => {
+        const data = this.textures.get(atlasKey).get(frame).customData as FrameData | undefined;
+        const ss = data?.spriteSourceSize;
+        return ss ? { x: ss.x, y: ss.y, width: ss.w, height: ss.h } : undefined;
+      },
+      {
+        atlasKey,
+        measureLabel: (text) => {
+          const t = label(text);
+          return { w: t.width, h: t.height };
+        },
+      },
+    );
+    this.plan = plan;
+    for (const w of plan.warnings) console.warn(w);
+
+    const bgKey = BACKGROUNDS.map.key;
+    if (this.textures.exists(bgKey)) {
+      this.add.image(plan.bg.x, plan.bg.y, bgKey).setOrigin(0).setScale(plan.bg.scale).setDepth(plan.bg.depth);
+    } else {
+      console.warn(`map: texture "${bgKey}" is missing — plate skipped`);
+    }
+
+    const router = createTapRouter(this);
+    router.onAnyTap = () => this.handle(this.idle?.tap() ?? []);
+
+    // Station hotspots register back to front (by depth), so the frontmost one wins an overlap.
+    for (const s of plan.stations) {
+      const image = s.image
+        ? this.add.image(s.image.x, s.image.y, atlasKey, s.image.frame).setOrigin(s.image.originX, s.image.originY).setScale(s.image.scale).setDepth(s.depth)
+        : undefined;
+      this.views.set(s.id, { plan: s, image });
+      new HotspotPolygon(router, s.hit, () => this.applyAll(this.trip?.tapStation(s.id) ?? []));
+      label(s.label).setPosition(s.labelPos.x, s.labelPos.y).setDepth(plan.labelDepth);
+    }
+
+    // The road and the kart (Story 1.7). The kart registers last: it is on top of the stations it passes.
+    const roadPoints = layout.paths[ROAD_PATH] ?? [];
+    if (roadPoints.length < 2) console.warn(`map: path "${ROAD_PATH}" is missing from the layout — the kart cannot drive`);
+    const road = createRoad(roadPoints);
+    this.stops = {};
+    for (const s of plan.stations) {
+      const stop = isGameId(s.id) ? layout.anchors[stopAnchor(s.id)] : undefined;
+      if (stop) this.stops[s.id] = road.project(stop);
+    }
+    const startAnchor: Point | undefined = layout.anchors[KART_START_ANCHOR];
+    const last = session.lastStation;
+    const startS = last !== undefined && this.stops[last] !== undefined ? this.stops[last] : startAnchor ? road.project(startAnchor) : 0;
+    this.trip = new KartTrip({
+      road,
+      stops: this.stops,
+      startS,
+      capMs: () => (session.kartTrips > 0 ? Tokens.Timing.kartDriveRepeatMaxMs : Tokens.Timing.kartDriveMaxMs),
+      isAwake: (id) => this.views.get(id)?.plan.awake ?? false,
+      nameLine: stationNameLine,
+      onArrive: () => {
+        session.kartTrips += 1;
+      },
+    });
+    this.kart = this.addKart(plan.kart, router, atlasKey, road.pointAt(startS));
+
+    this.idle = createMapIdle({
+      stations: plan.stations.map((s) => s.id),
+      awake: plan.stations.filter((s) => s.awake).map((s) => s.id),
+      timing: {
+        ambientMinMs: Tokens.Timing.mapAmbientMinMs,
+        ambientMaxMs: Tokens.Timing.mapAmbientMaxMs,
+        inviteFirstMs: Tokens.Timing.mapInviteFirstMs,
+        inviteGapMs: Tokens.Timing.mapInviteGapMs,
+        inviteMaxCount: Tokens.Timing.mapInviteMaxCount,
+        inviteHoldMs: Tokens.Timing.mapInviteHoldMs,
+      },
+    });
+
+    // Game assets load on Map's own loader while the kart drives.
+    const onFile = (key: string): void => this.tracker.fileDone(key);
+    const onError = (file: { key: string; src?: string }): void => {
+      console.warn(`map: failed to load "${file.key}" — the game starts without it`, file.src);
+      this.tracker.fileDone(file.key);
+    };
+    this.load.on(FILE_COMPLETE, onFile);
+    this.load.on(LOAD_ERROR, onError);
+    // A file that downloads but fails processing (bad JSON, undecodable audio) reports neither of the
+    // above; once the loader's queue is done, whatever is still pending is settled (AR51).
+    const onComplete = (): void => {
+      for (const key of this.tracker.flushPending()) console.warn(`map: "${key}" did not load — the game starts without it`);
+    };
+    this.load.on(LOAD_COMPLETE, onComplete);
+
+    // Scoped subscriptions stay alive while Map sleeps (they end on shutdown/destroy only).
+    const scoped = bus.scoped(this);
+    scoped.on('round:complete', (outcome) => this.returnFrom(outcome.gameId));
+    scoped.on('round:abandon', ({ gameId }) => this.returnFrom(gameId));
+    this.events.on(WAKE, this.onWake, this);
+
+    // Hud runs in parallel above Map and the games; launched once, never on Start.
+    if (!this.scene.isActive(HUD_KEY) && !this.scene.isPaused(HUD_KEY) && !this.scene.isSleeping(HUD_KEY)) {
+      this.scene.launch(HUD_KEY);
+    }
+    setHudMode('map');
+
+    this.events.once(SHUTDOWN, () => {
+      this.load.off(FILE_COMPLETE, onFile);
+      this.load.off(LOAD_ERROR, onError);
+      this.load.off(LOAD_COMPLETE, onComplete);
+      this.events.off(WAKE, this.onWake, this);
+      this.ring?.destroy();
+      this.ring = undefined;
+      this.idle = undefined;
+      this.trip = undefined;
+      this.kart = undefined;
+    });
+  }
+
+  override update(_time: number, delta: number): void {
+    if (this.idle) this.handle(this.idle.tick(delta));
+    if (!this.trip) return;
+    this.applyAll(this.trip.tick(delta));
+    for (const id of this.tracker.drainSettled()) this.applyAll(this.trip.assetsSettled(id));
+  }
+
+  // --- kart -------------------------------------------------------------------------------------
+
+  private addKart(plan: PlannedKart, router: ReturnType<typeof createTapRouter>, atlasKey: string, at: Point): KartView {
+    // The body (a container) takes the tap bounce; the image inside carries the facing mirror (scaleX),
+    // so a bounce never resets it. No flipX: it would shift the full-frame sprite.
+    const body = this.add.container(at.x, at.y).setDepth(at.y);
+    const image = plan.frame ? this.add.image(0, 0, atlasKey, plan.frame).setOrigin(plan.originX, plan.originY) : undefined;
+    if (image) body.add(image);
+    const target = createTapTarget(router, {
+      circle: { x: at.x + plan.centerOffset.x, y: at.y + plan.centerOffset.y, r: plan.hitRadius },
+      onPress: () => this.applyAll(this.trip?.tapKart() ?? []),
+      // A station drawn in front of the kart (deeper y) keeps its taps.
+      excludes: (p) => this.stationInFrontAt(p, body.depth),
+    });
+    const view: KartView = { plan, body, image, target };
+    this.faceKart(view);
+    return view;
+  }
+
+  private stationInFrontAt(p: Point, kartDepth: number): boolean {
+    for (const view of this.views.values()) {
+      if (view.plan.depth > kartDepth && pointInPolygon(p, view.plan.hit)) return true;
+    }
+    return false;
+  }
+
+  private faceKart(view: KartView): void {
+    view.image?.setScale(view.plan.scale * MAP_KART.artFacing * this.travelSign, view.plan.scale);
+  }
+
+  private placeKart(x: number, y: number, dx: number): void {
+    const view = this.kart;
+    if (!view) return;
+    if (dx !== 0) this.travelSign = Math.sign(dx);
+    view.body.setPosition(x, y).setDepth(y);
+    this.faceKart(view);
+    view.target.setCircle({ x: x + view.plan.centerOffset.x, y: y + view.plan.centerOffset.y, r: view.plan.hitRadius });
+  }
+
+  // --- trip commands -----------------------------------------------------------------------------
+
+  /** Feedback commands run inside the pointerdown handler (≤ Timing.feedbackMaxMs). */
+  private applyAll(cmds: readonly TripCommand[]): void {
+    for (const c of cmds) this.apply(c);
+    this.syncIdle();
+  }
+
+  private apply(c: TripCommand): void {
+    switch (c.kind) {
+      case 'bounce':
+        if (c.target === KART_TARGET) this.bounceKart();
+        else this.bounceStation(c.target);
+        return;
+      case 'say':
+        audio.say(c.lineId);
+        return;
+      case 'setPrompt':
+        audio.setPrompt(c.lineId);
+        return;
+      case 'sfx':
+        audio.sfx(c.id);
+        return;
+      case 'load':
+        this.loadGame(c.gameId);
+        return;
+      case 'move':
+        this.placeKart(c.x, c.y, c.dx);
+        return;
+      case 'enter':
+        void this.enterGame(c.gameId);
+        return;
+    }
+  }
+
+  /** Idle (ambient moves, invitations) pauses while the kart travels: one prominent motion (UX-DR72). */
+  private syncIdle(): void {
+    if (!this.idle || !this.trip) return;
+    if (this.trip.state === 'parked') this.idle.resume();
+    else this.handle(this.idle.suspend());
+  }
+
+  private bounceKart(): void {
+    if (!this.kart) return;
+    const react = Tokens.components.tappableProp.react;
+    bounce(this, this.kart.body, 1, amplitude(react.scale, this.reduced), react.durationMs);
+  }
+
+  private bounceStation(id: string): void {
+    const view = this.views.get(id);
+    if (!view?.image) return;
+    bounce(this, view.image, view.plan.image?.scale ?? 1, amplitude(Tokens.ui.stationTapScale, this.reduced), Tokens.Timing.stationTapMs);
+  }
+
+  // --- game assets, enter and return -------------------------------------------------------------
+
+  private loadGame(id: string): void {
+    const entry = isGameId(id) ? GAMES[id] : undefined;
+    if (!entry) {
+      this.tracker.track(id, []);
+      return;
+    }
+    const calls = loadPlan(entry.assets, (kind, key) => (kind === 'texture' ? this.textures.exists(key) : this.cache.audio.exists(key)));
+    this.tracker.track(id, calls.map((c) => c.key));
+    this.loadedGames.add(id);
+    if (calls.length === 0) return;
+    for (const c of calls) {
+      if (c.kind === 'atlas') this.load.atlas(c.key, c.png, c.json);
+      else if (c.kind === 'image') this.load.image(c.key, c.url);
+      else this.load.audio(c.key, c.url);
+    }
+    this.load.start();
+  }
+
+  private async enterGame(id: string): Promise<void> {
+    if (!isGameId(id)) return;
+    const entry = GAMES[id];
+    if (!entry) return;
+    session.lastStation = id;
+    const focus = LAYOUTS.map.anchors[id] ?? { x: this.kart?.body.x ?? 0, y: this.kart?.body.y ?? 0 };
+    await enterStation(this, focus, this.reduced);
+    if (!this.trip) return; // Map shut down meanwhile
+    const data = session.startData(id, ladderLength(entry));
+    // At most one MiniGame: stop any other one still around.
+    for (const other of Object.keys(GAMES)) {
+      if (this.scene.isActive(other) || this.scene.isPaused(other) || this.scene.isSleeping(other)) this.scene.stop(other);
+    }
+    this.running = id;
+    this.scene.get(id).events.once(SHUTDOWN, () => this.releaseGame(id));
+    this.scene.manager.start(id, data);
+    this.scene.sleep();
+    this.trip.entered();
+    this.syncIdle();
+  }
+
+  private returnFrom(gameId: string): void {
+    if (gameId !== this.running) return;
+    this.running = undefined;
+    this.scene.stop(gameId);
+    this.scene.wake();
+  }
+
+  /**
+   * The game scene shut down: drop its own textures and sounds (never the boot keys), plus those of
+   * every other game this visit loaded (a re-targeted trip) that is neither running nor the current target.
+   */
+  private releaseGame(id: string): void {
+    const ids = new Set([id, ...this.loadedGames]);
+    for (const gameId of ids) {
+      if (gameId === this.running || gameId === this.trip?.target) continue;
+      this.loadedGames.delete(gameId);
+      this.releaseAssets(gameId);
+    }
+  }
+
+  private releaseAssets(id: string): void {
+    const entry = isGameId(id) ? GAMES[id] : undefined;
+    if (!entry) return;
+    for (const r of releasePlan(entry.assets)) {
+      if (r.kind === 'texture') {
+        if (this.textures.exists(r.key)) this.textures.remove(r.key);
+      } else {
+        this.cache.audio.remove(r.key);
+      }
+    }
+  }
+
+  private onWake(): void {
+    const cam = this.cameras.main;
+    cam.resetFX();
+    cam.setZoom(1);
+    cam.setScroll(0, 0);
+    void revealScene(this);
+    setHudMode('map');
+    if (this.idle) this.handle(this.idle.reset());
+    const last = session.lastStation;
+    const s = last !== undefined ? this.stops[last] : undefined;
+    if (this.trip && s !== undefined) this.applyAll(this.trip.parkAt(s));
+    else this.syncIdle();
+  }
+
+  // --- idle ---------------------------------------------------------------------------------------
+
+  private handle(events: readonly MapIdleEvent[]): void {
+    for (const ev of events) {
+      if (ev.kind === 'ambient') this.ambient(ev.id);
+      else if (ev.kind === 'invite') this.invite(ev.id);
+      else this.endInvite(ev.id);
+    }
+  }
+
+  private addLabel(text: string): GameObjects.Text {
+    const spec = Tokens.components.stationLabel;
+    const type = spec.typography;
+    return this.add
+      .text(0, 0, text, {
+        fontFamily: type.fontFamily,
+        fontSize: `${type.fontSize}px`,
+        fontStyle: String(type.fontWeight),
+        color: spec.color.css,
+        stroke: spec.outline.color.css,
+        strokeThickness: spec.outline.width,
+        align: 'center',
+      })
+      .setOrigin(0.5, 0)
+      .setAlpha(spec.opacity);
+  }
+
+  private ambient(id: string): void {
+    const view = this.views.get(id);
+    if (!view?.image || isMoving(view.image)) return;
+    bounce(this, view.image, view.plan.image?.scale ?? 1, amplitude(Tokens.ui.ambientScale, this.reduced), Tokens.Timing.mapAmbientMoveMs);
+  }
+
+  private invite(id: string): void {
+    const view = this.views.get(id);
+    if (!view) return;
+    // One prominent motion at a time: settle any ambient bounce still running on another station.
+    for (const other of this.views.values()) {
+      if (other.image) stopMotion(other.image, other.plan.image?.scale ?? 1);
+    }
+    this.ring = createHintRing(this, boundingBox(view.plan.hit), { reduced: this.reduced, depth: this.plan?.ringDepth });
+    if (view.image) {
+      const pulse = Tokens.components.stationHotspot.pulse;
+      bob(
+        this,
+        view.image,
+        view.plan.image?.scale ?? 1,
+        amplitude(pulse.from, this.reduced),
+        amplitude(pulse.to, this.reduced),
+        pulse.durationMs,
+      );
+    }
+    const line = inviteLine(id);
+    audio.sayChain([line, stationNameLine(id)]);
+    audio.setPrompt(line);
+  }
+
+  private endInvite(id: string): void {
+    this.ring?.destroy();
+    this.ring = undefined;
+    const view = this.views.get(id);
+    if (view?.image) stopMotion(view.image, view.plan.image?.scale ?? 1);
+  }
+}
diff --git a/app/tools/atlas/pack.ts b/app/tools/atlas/pack.ts
new file mode 100644
index 0000000..360a393
--- /dev/null
+++ b/app/tools/atlas/pack.ts
@@ -0,0 +1,245 @@
+// `npm run atlas -- <screen>` (Story 1.4): packs app/.generated/render/<screen>/frames/**.png into
+// public/assets/atlases/<screen>.png|json (texture key `atlas.<screen>`, JSON hash) with
+// free-tex-packer-core 0.3.9, and re-encodes the plate to public/assets/bg/<screen>.png (`bg.<screen>`).
+// Fails with no write when packing needs more than one page, a page exceeds 2048 on either side, a
+// file exceeds 8 MiB or a frame name breaks `<object>/<state>/<nn>`.
+import { existsSync, mkdirSync, readFileSync, readdirSync, renameSync, writeFileSync } from 'node:fs';
+import { createRequire } from 'node:module';
+import { dirname, join, relative, resolve, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import sharp from 'sharp';
+import { ATLASES, BACKGROUNDS, FRAME_NAME, SCREEN_IDS, type ScreenId } from '../../src/content/assets.ts';
+import { screen as iceCreamScreen } from '../../src/content/games/ice-cream.ts';
+import type { ScreenLayout } from '../../src/content/layout-types.ts';
+import { MAX_FILE_BYTES, MAX_PAGE_SIDE, iceCreamLimits, validateIceCream, type AtlasJsonLike } from '../layout/rules.ts';
+import type { PackFile, PackOptions, PackResult } from './free-tex-packer-core.d.ts';
+
+const require = createRequire(import.meta.url);
+sharp.cache(false);
+
+const APP_DIR = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');
+const RENDER_DIR = join(APP_DIR, '.generated', 'render');
+const PUBLIC_DIR = join(APP_DIR, 'public');
+const LAYOUT_DIR = join(APP_DIR, 'src', 'content', 'generated');
+
+/** Screen rules that need the packed atlas (Story 1.8); they read the published layout. */
+export const ATLAS_RULES: Readonly<Partial<Record<ScreenId, (layout: ScreenLayout, atlas: AtlasJsonLike) => string[]>>> = {
+  'ice-cream': (layout, atlas) => validateIceCream(layout, iceCreamLimits(iceCreamScreen), atlas),
+};
+
+/** PNG zlib level of the shipped background. */
+const BG_COMPRESSION = 9;
+
+/** The packer settings of every atlas (spec 1.4 › Atlas). */
+export function packOptions(screen: string): PackOptions {
+  return {
+    textureName: screen,
+    width: MAX_PAGE_SIDE,
+    height: MAX_PAGE_SIDE,
+    fixedSize: false,
+    powerOfTwo: false,
+    padding: 2,
+    allowRotation: false,
+    allowTrim: true,
+    detectIdentical: true,
+    removeFileExtension: true,
+    prependFolderName: true,
+    exporter: 'JsonHash',
+  };
+}
+
+interface FrameJson {
+  trimmed: boolean;
+  spriteSourceSize: { x: number; y: number; w: number; h: number };
+  sourceSize: { w: number; h: number };
+}
+
+interface AtlasJson {
+  frames: Record<string, FrameJson>;
+  meta: { size: { w: number; h: number }; image?: string };
+}
+
+/** Checks the packer output; returns the problems (empty = OK). */
+export function checkAtlas(screen: string, files: readonly PackResult[]): string[] {
+  const problems: string[] = [];
+  const pngs = files.filter((f) => f.name.endsWith('.png'));
+  const jsons = files.filter((f) => f.name.endsWith('.json'));
+  if (pngs.length !== 1 || jsons.length !== 1) {
+    problems.push(`atlas "${screen}": packing needs ${pngs.length} pages (max 1)`);
+    return problems;
+  }
+  const json = JSON.parse(jsons[0]!.buffer.toString('utf8')) as AtlasJson;
+  const { w, h } = json.meta.size;
+  if (w > MAX_PAGE_SIDE || h > MAX_PAGE_SIDE) problems.push(`atlas "${screen}": page ${w}×${h} exceeds ${MAX_PAGE_SIDE}`);
+  for (const name of Object.keys(json.frames)) {
+    if (!FRAME_NAME.test(name)) problems.push(`atlas "${screen}": frame "${name}" is not <object>/<state>/<nn>`);
+  }
+  for (const f of files) {
+    if (f.buffer.length > MAX_FILE_BYTES) problems.push(`atlas "${screen}": ${f.name} is ${f.buffer.length} bytes (max ${MAX_FILE_BYTES})`);
+  }
+  return problems;
+}
+
+/** Where a trimmed frame sat in its full frame. */
+export interface Trim {
+  left: number;
+  top: number;
+  width: number;
+  height: number;
+}
+
+/** Bounding box of the pixels with alpha ≥ `minAlpha` (default > 0) in raw RGBA data; the whole frame when empty. */
+export function alphaBounds(data: Uint8Array, width: number, height: number, minAlpha = 1): { left: number; top: number; right: number; bottom: number } {
+  let left = width;
+  let top = height;
+  let right = -1;
+  let bottom = -1;
+  const RGBA = 4;
+  for (let y = 0; y < height; y++) {
+    for (let x = 0; x < width; x++) {
+      if (data[(y * width + x) * RGBA + RGBA - 1]! >= minAlpha) {
+        if (x < left) left = x;
+        if (x > right) right = x;
+        if (y < top) top = y;
+        if (y > bottom) bottom = y;
+      }
+    }
+  }
+  return right < 0 ? { left: 0, top: 0, right: width - 1, bottom: height - 1 } : { left, top, right, bottom };
+}
+
+/**
+ * Alpha below this is render noise (Story 1.8: EEVEE leaves scattered alpha 1–20 pixels around a
+ * sprite rendered against holdouts); it is cleared before trimming so it neither shows nor widens the frame.
+ */
+export const ALPHA_NOISE_FLOOR = 24;
+
+/**
+ * The trim box is the bounds of alpha ≥ this, grown by TRIM_MARGIN px: holdout edges leave 1 px
+ * slivers up to alpha ~60 at the frame border, which would otherwise stretch the trim across the frame.
+ */
+export const TRIM_ALPHA = 64;
+export const TRIM_MARGIN = 2;
+
+/** Clears pixels whose alpha is under `floor` (RGBA, in place); returns how many were cleared. */
+export function clearAlphaNoise(data: Uint8Array, floor = ALPHA_NOISE_FLOOR): number {
+  const RGBA = 4;
+  let n = 0;
+  for (let i = RGBA - 1; i < data.length; i += RGBA) {
+    if (data[i]! > 0 && data[i]! < floor) {
+      data[i - 3] = 0;
+      data[i - 2] = 0;
+      data[i - 1] = 0;
+      data[i] = 0;
+      n++;
+    }
+  }
+  return n;
+}
+
+async function trimFrame(png: Buffer): Promise<{ png: Buffer; trim: Trim }> {
+  const { data, info } = await sharp(png).ensureAlpha().raw().toBuffer({ resolveWithObject: true });
+  clearAlphaNoise(data);
+  const core = alphaBounds(data, info.width, info.height, TRIM_ALPHA);
+  const b = {
+    left: Math.max(0, core.left - TRIM_MARGIN),
+    top: Math.max(0, core.top - TRIM_MARGIN),
+    right: Math.min(info.width - 1, core.right + TRIM_MARGIN),
+    bottom: Math.min(info.height - 1, core.bottom + TRIM_MARGIN),
+  };
+  const box = { left: b.left, top: b.top, width: b.right - b.left + 1, height: b.bottom - b.top + 1 };
+  const raw = { raw: { width: info.width, height: info.height, channels: 4 as const } };
+  const out = await sharp(data, raw).extract(box).png().toBuffer();
+  return { png: out, trim: { ...box, width: info.width, height: info.height } };
+}
+
+/** Puts each frame back into its full source frame (Phaser places it with spriteSourceSize). */
+export function restoreTrim(json: { frames: Record<string, FrameJson> }, trims: ReadonlyMap<string, Trim>): void {
+  for (const [name, f] of Object.entries(json.frames)) {
+    const t = trims.get(name);
+    if (!t) continue;
+    f.spriteSourceSize = { ...f.spriteSourceSize, x: f.spriteSourceSize.x + t.left, y: f.spriteSourceSize.y + t.top };
+    f.sourceSize = { w: t.width, h: t.height };
+    f.trimmed = true;
+  }
+}
+
+function listPngs(dir: string): string[] {
+  const out: string[] = [];
+  for (const e of readdirSync(dir, { withFileTypes: true })) {
+    const p = join(dir, e.name);
+    if (e.isDirectory()) out.push(...listPngs(p));
+    else if (e.name.endsWith('.png')) out.push(p);
+  }
+  return out.sort();
+}
+
+/** Atomically writes several files: all go to temp names first, then are renamed into place. */
+function writeAll(files: readonly { path: string; data: Buffer }[]): void {
+  for (const f of files) {
+    mkdirSync(dirname(f.path), { recursive: true });
+    writeFileSync(`${f.path}.tmp`, f.data);
+  }
+  for (const f of files) renameSync(`${f.path}.tmp`, f.path);
+}
+
+export async function packScreen(screenArg: string | undefined): Promise<string[]> {
+  if (!SCREEN_IDS.includes(screenArg as ScreenId)) {
+    throw new Error(`unknown screen "${screenArg ?? ''}": known screens are ${SCREEN_IDS.join(', ')}`);
+  }
+  const screen = screenArg as ScreenId;
+  const src = join(RENDER_DIR, screen);
+  const framesDir = join(src, 'frames');
+  const bgSrc = join(src, 'bg.png');
+  if (!existsSync(framesDir) || !existsSync(bgSrc)) throw new Error(`no render for "${screen}": run npm run render -- ${screen}`);
+
+  // free-tex-packer-core checks the untrimmed size against the page size before it trims, so a
+  // full-frame 2048×1536 sprite can never fit a 2048 page. Frames are trimmed here and the JSON
+  // gets the full-frame offsets back (restoreTrim), exactly as the packer's own trim would write.
+  const trims = new Map<string, Trim>();
+  const inputs: PackFile[] = [];
+  for (const p of listPngs(framesDir)) {
+    const path = relative(framesDir, p).split(sep).join('/');
+    const t = await trimFrame(readFileSync(p));
+    trims.set(path.replace(/\.png$/, ''), t.trim);
+    inputs.push({ path, contents: t.png });
+  }
+  const { packAsync } = require('free-tex-packer-core') as { packAsync: (f: PackFile[], o: PackOptions) => Promise<PackResult[]> };
+  const result = await packAsync(inputs, packOptions(screen));
+  const problems = checkAtlas(screen, result);
+  const bg = await sharp(bgSrc).png({ compressionLevel: BG_COMPRESSION }).toBuffer();
+  if (bg.length > MAX_FILE_BYTES) problems.push(`background "${screen}": ${bg.length} bytes (max ${MAX_FILE_BYTES})`);
+  if (problems.length > 0) throw new Error(problems.join('\n'));
+
+  const atlas = ATLASES[screen];
+  const png = result.find((f) => f.name.endsWith('.png'))!;
+  const jsonFile = result.find((f) => f.name.endsWith('.json'))!;
+  const json = JSON.parse(jsonFile.buffer.toString('utf8')) as AtlasJson;
+  restoreTrim(json, trims);
+  json.meta.image = atlas.png.split('/').pop()!;
+  const rule = ATLAS_RULES[screen];
+  if (rule) {
+    const layout = JSON.parse(readFileSync(join(LAYOUT_DIR, `${screen}.layout.json`), 'utf8')) as ScreenLayout;
+    const atlasProblems = rule(layout, json);
+    if (atlasProblems.length > 0) throw new Error(atlasProblems.join('\n'));
+  }
+  const out = [
+    { path: join(PUBLIC_DIR, atlas.png), data: png.buffer },
+    { path: join(PUBLIC_DIR, atlas.json), data: Buffer.from(`${JSON.stringify(json, null, 2)}\n`) },
+    { path: join(PUBLIC_DIR, BACKGROUNDS[screen].path), data: bg },
+  ];
+  writeAll(out);
+  return out.map((f) => `${relative(APP_DIR, f.path).split('\\').join('/')} (${f.data.length} bytes)`);
+}
+
+async function main(): Promise<void> {
+  try {
+    const written = await packScreen(process.argv[2]);
+    for (const w of written) console.log(`atlas: wrote ${w}`);
+  } catch (e) {
+    console.error(`atlas: ${e instanceof Error ? e.message : JSON.stringify(e)}`);
+    process.exit(1);
+  }
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) void main();
