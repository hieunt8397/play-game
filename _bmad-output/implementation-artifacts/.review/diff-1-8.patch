+    v: 1,
+    screenId: 'map',
+    design: { width: 1024, height: 768 },
+    renderScale: 2,
+    anchors,
+    hits,
+    slots,
+    paths: { road: [{ x: 24, y: 600 }, { x: 1000, y: 600 }] },
