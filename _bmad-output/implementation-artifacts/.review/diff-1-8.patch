+const sq = (x: number, y: number, s: number): Point[] => [
+  { x, y },
+  { x: x + s, y },
+  { x: x + s, y: y + s },
+  { x, y: y + s },
+];
+
+interface MutableLayout {
+  v: 1;
+  screenId: string;
+  design: { width: number; height: number };
+  renderScale: number;
+  anchors: Record<string, Point>;
+  hits: Record<string, Point[]>;
+  slots: Record<string, Point>;
+  paths: Record<string, Point[]>;
