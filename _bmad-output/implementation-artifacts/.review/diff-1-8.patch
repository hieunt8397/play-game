+# Builds art/ice-cream.blend (Tiệm kem, Story 1.8) from the vendored island art/src/map-v2.blend.
+#
+# Run by `npm run art:build -- ice-cream` (tools/render/build.ts), never by hand:
+#   blender -b --factory-startup art/src/map-v2.blend --python-exit-code 1 --python build_ice_cream.py -- \
+#     --out <tmp>/ice-cream.blend --params <tmp>/params.json
+# params.json (written by build.ts from Tokens): colours (hex), art (flavour colours, chip, creature
+# light), draggableMinSize, rowGap, design size and renderScale.
+#
+# Steps: prune the reference's Tiệm kem preview and the island's own Shiba; re-aim `CamGame2` at eye
+# level close to the counter; build the counter (pink front, white top);
+# import Shiba (Quaternius ShibaInu.fbx: recoloured, idle pose at frame 1, lick + tail wag at 10–13);
+# the Kenney cone (plate) and four flavour scoops (sprites, all posed at `slot.scoop-2`); the layout
+# objects (`hit.*`, `anchor.*`, `slot.*`) in a hidden `layout` collection; render size; save.
+# Every constant is in Blender world units (metres) unless its name says otherwise.
+import json
+import math
+import os
+import sys
+
+import bmesh
+import bpy
+from bpy_extras.object_utils import world_to_camera_view
+from mathutils import Matrix, Vector
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from common import (  # noqa: E402
+    add_empty, descendants, eval_world_verts, flat_material, force_opaque, hull_object, move_to, parse_args,
+    recolor_creature,
+)
+
+ASSETS = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', '..', '..', 'assets'))
+SHIBA_FBX = os.path.join(ASSETS, 'quaternius', 'animals', 'ShibaInu.fbx')
+FOOD_KIT = os.path.join(ASSETS, 'kenney', 'kenney_food-kit', 'Models', 'GLB format')
+CONE_GLB = os.path.join(FOOD_KIT, 'ice-cream-cne.glb')
+SCOOP_GLB = os.path.join(FOOD_KIT, 'ice-cream-scoop-mint.glb')
+STRAWBERRY_GLB = os.path.join(FOOD_KIT, 'strawberry.glb')
+
+PRUNE_COLLECTIONS = ['GameIce']  # the reference's Tiệm kem preview (counter, scoops, HintRing)
+PRUNE_OBJECTS = ['HintRing', 'A_Shiba']  # A_Shiba: the island's own dog (this screen imports its own)
+CAMERA = 'CamGame2'
+
+# --- the counter ---------------------------------------------------------------------------------
+COUNTER_CENTRE = (-5.4, -4.38)  # where the reference preview stood, on the road in front of the truck
+COUNTER_BASE_Z = 0.45  # island ground
+COUNTER_SIZE = (4.6, 0.9, 1.0)  # width (x), depth (y), height (z) of the pink body
+COUNTER_TOP_THICKNESS = 0.08
+COUNTER_TOP_OVERHANG = 0.06
+ROW_Y = -4.40  # the scoop/cone row on the counter top
+
+# --- the camera (re-aimed CamGame2: eye level, close to the counter) ------------------------------
+CAM_LOCATION = (-5.4, -9.6, 3.3)
+CAM_TARGET = (-5.4, -3.6, 2.21)  # the row at the top of the lower third: more of the counter front shows
+CAM_LENS = 32.0
+
+# --- Shiba -----------------------------------------------------------------------------------------
+SHIBA_LOCATION = (-5.4, -2.8, 1.25)  # paws at the counter's back edge on screen (it stands behind the counter)
+SHIBA_SCALE = 0.62
+SHIBA_YAW_DEG = 25.0  # head towards the camera, a three-quarter view
+SHIBA_FUR = ('Main', 'creatureOrange')
+SHIBA_LIGHT = ('Main_Light', 'creatureLight')  # face and belly
+IDLE_ACTION = '|Idle'
+EAT_ACTION = '|Eating'
+IDLE_FRAME = 1
+HAPPY_FRAMES = [10, 11, 12, 13]
+EAT_SOURCE_FRAMES = [3, 6, 8, 6]  # the start of the Eating dip: the head leans to the cone and stays above the counter (later frames hide it)
+TAIL_WAG_DEG = 20.0
+SHIBA_STATES = {'idle': [IDLE_FRAME], 'happy': HAPPY_FRAMES}
+
+# --- cone and scoops -------------------------------------------------------------------------------
+FLAVOURS = ['strawberry', 'chocolate', 'vanilla', 'mint']
+SCOOP_WIDTH_MARGIN = 1.15  # projected width = draggableMinSize × this (the trimmed frame is a bit narrower)
+CONE_SCALE_OF_SCOOP = 0.85  # the cone is a little smaller than a scoop
+SCOOP_SEAT = 0.25  # cone-1 centre = cone top + this × scoop height
+SCOOP_STACK = 0.75  # each further cone slot is this × scoop height higher
+CONE_SLOTS = 3
+STRAWBERRY_SCALE = 0.55  # of the scoop's own scale
+STRAWBERRY_SINK = 0.2  # of the strawberry height, into the scoop
+CHIP_RADIUS = 0.022  # scoop-local units (before the scoop scale)
+CHIP_RAISE = 0.35  # of the chip radius above the surface
+CHIPS = [(35, 20), (35, 140), (35, 260), (60, 80), (60, 200), (60, 320)]  # (polar° from up, azimuth°)
+LEAF_SIZE = (0.06, 0.032)  # half length, half width (scoop-local)
+LEAF_THICKNESS = 0.012
+LEAVES = [(-25.0, 0.015), (35.0, -0.015)]  # (yaw°, x offset) of the two mint leaves on top
+LEAF_TILT_DEG = 35.0
+
+RENDER_SIZE = (2048, 1536)
+MAX_SHIBA_HULL_VERTS = 4000
+
+
+def fail(msg):
+    raise RuntimeError(f'build_ice_cream: {msg}')
+
+
+def remove_tree(obj):
+    for o in reversed(descendants(obj)):
+        bpy.data.objects.remove(o, do_unlink=True)
+
+
+def prune():
+    for name in PRUNE_COLLECTIONS:
+        coll = bpy.data.collections.get(name)
+        if coll is None:
+            fail(f'collection "{name}" to prune not found')
+        for o in list(coll.all_objects):
+            if o.name in bpy.data.objects:
+                bpy.data.objects.remove(o, do_unlink=True)
+        bpy.data.collections.remove(coll)
+    for name in PRUNE_OBJECTS:
+        o = bpy.data.objects.get(name)
+        if o is not None:
+            remove_tree(o)
+
+
+def import_new(op, **kw):
+    before = set(bpy.data.objects)
+    op(**kw)
+    return [o for o in bpy.data.objects if o not in before]
+
+
+def box(name, centre, size, mat_side, mat_top, coll):
+    """An axis-aligned box; the +z face gets `mat_top`, every other face `mat_side`."""
+    bm = bmesh.new()
+    bmesh.ops.create_cube(bm, size=1.0)
+    for v in bm.verts:
+        v.co = Vector((v.co.x * size[0], v.co.y * size[1], v.co.z * size[2]))
+    me = bpy.data.meshes.new(name)
+    bm.to_mesh(me)
+    bm.free()
+    me.materials.append(mat_side)
+    me.materials.append(mat_top)
+    for poly in me.polygons:
+        poly.material_index = 1 if poly.normal.z > 0.5 else 0
+    o = bpy.data.objects.new(name, me)
+    o.location = centre
+    coll.objects.link(o)
+    return o
+
+
+def aim_camera(scene):
+    cam = bpy.data.objects.get(CAMERA)
+    if cam is None:
+        fail(f'camera "{CAMERA}" not found')
+    cam.location = CAM_LOCATION
+    direction = Vector(CAM_TARGET) - Vector(CAM_LOCATION)
+    cam.rotation_mode = 'XYZ'
+    cam.rotation_euler = direction.to_track_quat('-Z', 'Y').to_euler()
+    cam.data.lens = CAM_LENS
+    scene.camera = cam
+    return cam
+
+
+class Screen:
+    """World → design px through the scene camera (same projection as render_screen.py)."""
+
+    def __init__(self, scene, params):
+        self.scene = scene
+        self.w, self.h = params['design']['width'], params['design']['height']
+
+    def project(self, p):
+        v = world_to_camera_view(self.scene, self.scene.camera, Vector(p))
+        return (v.x * self.w, (1 - v.y) * self.h)
+
+
+def bounds(pts):
+    xs, ys, zs = [p.x for p in pts], [p.y for p in pts], [p.z for p in pts]
+    return (min(xs), max(xs)), (min(ys), max(ys)), (min(zs), max(zs))
+
+
+def find_action(suffix):
+    for a in bpy.data.actions:
+        if a.name.endswith(suffix):
+            return a
+    fail(f'action "*{suffix}" not found in ShibaInu.fbx')
+
+
+def assign_action(arm, action):
+    ad = arm.animation_data or arm.animation_data_create()
+    ad.action = action
+    if action is not None and hasattr(ad, 'action_slot') and ad.action_slot is None and len(action.slots) > 0:
+        ad.action_slot = action.slots[0]
+
+
+def lateral_axis(arm, pb):
+    """The bone's local axis (x or z) closest to world up: rotating about it swings the bone sideways."""
+    m = arm.matrix_world.to_3x3() @ pb.bone.matrix_local.to_3x3()
+    x, z = m.col[0], m.col[2]
+    return 'X' if abs(x.z) >= abs(z.z) else 'Z'
+
+
+def pose_shiba(scene, arm):
+    """Keys frame 1 (Idle) and 10–13 (Eating: the lick, tail bones wagging ±20° alternately)."""
+    idle = find_action(IDLE_ACTION)
+    eat = find_action(EAT_ACTION)
+    plan = [(IDLE_FRAME, idle, int(idle.frame_range[0]), 0)]
+    for i, (tf, sf) in enumerate(zip(HAPPY_FRAMES, EAT_SOURCE_FRAMES)):
+        plan.append((tf, eat, sf, 1 if i % 2 == 0 else -1))
+    poses = []
+    for tf, action, sf, wag in plan:
+        assign_action(arm, action)
+        scene.frame_set(sf)
+        poses.append((tf, wag, {pb.name: pb.matrix_basis.copy() for pb in arm.pose.bones}))
+    assign_action(arm, None)
+    tails = [pb for pb in arm.pose.bones if 'Tail' in pb.name]
+    if not tails:
+        print('build_ice_cream: WARNING no pose bone named *Tail* — the happy frames keep no wag')
+    for tf, wag, pose in poses:
+        for pb in arm.pose.bones:
+            pb.matrix_basis = pose[pb.name]
+        if wag:
+            for pb in tails:
+                rot = Matrix.Rotation(math.radians(TAIL_WAG_DEG * wag), 4, lateral_axis(arm, pb))
+                pb.matrix_basis = pb.matrix_basis @ rot
+        for pb in arm.pose.bones:
+            pb.keyframe_insert('location', frame=tf)
+            pb.keyframe_insert('rotation_quaternion' if pb.rotation_mode == 'QUATERNION' else 'rotation_euler', frame=tf)
+            pb.keyframe_insert('scale', frame=tf)
+    scene.frame_set(IDLE_FRAME)
+
+
+def build_shiba(scene, params, coll):
+    new = import_new(bpy.ops.import_scene.fbx, filepath=SHIBA_FBX)
+    arm = next((o for o in new if o.type == 'ARMATURE'), None)
+    if arm is None:
+        fail('ShibaInu.fbx has no armature')
+    for o in new:
+        move_to(o, coll)
+    force_opaque(new)
+    colours = {**params['colours'], 'creatureLight': params['art']['creatureLight']}
+    for mat_base, token in (SHIBA_FUR, SHIBA_LIGHT):
+        if recolor_creature(arm, mat_base, colours[token]) == 0:
+            fail(f'Shiba: no material "{mat_base}"')
+    # The FBX actions key the armature object itself, so the placement goes on a parent empty.
+    root = add_empty('shiba-root', SHIBA_LOCATION, coll)
+    root.rotation_euler = (0.0, 0.0, math.radians(SHIBA_YAW_DEG))
+    root.scale = (SHIBA_SCALE,) * 3
+    arm.parent = root
+    pose_shiba(scene, arm)
+    return [root, *new]
+
+
+def import_scoop(name, scale, colour, location):
+    objs = import_new(bpy.ops.import_scene.gltf, filepath=SCOOP_GLB)
+    mesh = next((o for o in objs if o.type == 'MESH'), None)
+    if mesh is None:
+        fail('ice-cream-scoop-mint.glb has no mesh')
+    for o in objs:
+        if o is not mesh and o.type != 'MESH':
+            bpy.data.objects.remove(o, do_unlink=True)
+    mesh.parent = None
+    mesh.name = name
+    mesh.data.materials.clear()
+    mesh.data.materials.append(colour)
+    mesh.location = location
+    mesh.rotation_euler = (0.0, 0.0, 0.0)
+    mesh.scale = (scale,) * 3
+    return mesh
+
+
+def local_top(mesh):
+    zs = [v.co.z for v in mesh.data.vertices]
+    return max(zs)
+
+
+def surface_point(mesh, polar_deg, azimuth_deg):
+    """Scoop-local surface point in a direction from the scoop's inner centre (ray cast)."""
+    zs = [v.co.z for v in mesh.data.vertices]
+    origin = Vector((0.0, 0.0, (min(zs) + max(zs)) * 0.4))
+    t, a = math.radians(polar_deg), math.radians(azimuth_deg)
+    d = Vector((math.sin(t) * math.cos(a), math.sin(t) * math.sin(a), math.cos(t)))
+    ok, loc, normal, _i = mesh.ray_cast(origin, d)
+    if not ok:
+        fail(f'chip ray ({polar_deg}, {azimuth_deg}) missed the scoop')
+    return loc, normal
+
+
+def add_chips(mesh, chip_mat, coll):
+    out = []
+    for i, (polar, azimuth) in enumerate(CHIPS):
+        loc, normal = surface_point(mesh, polar, azimuth)
+        bm = bmesh.new()
+        bmesh.ops.create_icosphere(bm, subdivisions=1, radius=CHIP_RADIUS)
+        me = bpy.data.meshes.new(f'chip-{i + 1}')
+        bm.to_mesh(me)
+        bm.free()
+        me.materials.append(chip_mat)
+        chip = bpy.data.objects.new(f'{mesh.name}-chip-{i + 1}', me)
+        coll.objects.link(chip)
+        chip.parent = mesh
+        chip.location = loc + normal * CHIP_RADIUS * CHIP_RAISE
+        out.append(chip)
+    return out
+
+
+def add_strawberry(mesh, coll):
+    objs = import_new(bpy.ops.import_scene.gltf, filepath=STRAWBERRY_GLB)
+    berry = next((o for o in objs if o.type == 'MESH'), None)
+    if berry is None:
+        fail('strawberry.glb has no mesh')
+    for o in objs:
+        if o is not berry and o.type != 'MESH':
+            bpy.data.objects.remove(o, do_unlink=True)
+    move_to(berry, coll)
+    berry.name = f'{mesh.name}-strawberry'
+    height = max(v.co.z for v in berry.data.vertices) - min(v.co.z for v in berry.data.vertices)
+    berry.parent = mesh
+    berry.scale = (STRAWBERRY_SCALE,) * 3
+    berry.location = (0.0, 0.0, local_top(mesh) - height * STRAWBERRY_SCALE * STRAWBERRY_SINK)
+    return [berry]
+
+
+def add_leaves(mesh, leaf_mat, coll):
+    out = []
+    hl, hw = LEAF_SIZE
+    for i, (yaw, dx) in enumerate(LEAVES):
+        me = bpy.data.meshes.new(f'leaf-{i + 1}')
+        me.from_pydata([(-hl, 0, 0), (0, -hw, 0), (hl, 0, 0), (0, hw, 0)], [], [(0, 1, 2, 3)])
+        me.materials.append(leaf_mat)
+        leaf = bpy.data.objects.new(f'{mesh.name}-leaf-{i + 1}', me)
+        coll.objects.link(leaf)
+        mod = leaf.modifiers.new('solidify', 'SOLIDIFY')
+        mod.thickness = LEAF_THICKNESS
+        leaf.parent = mesh
+        leaf.location = (dx + math.copysign(hl * 0.7, dx), 0.0, local_top(mesh))
+        leaf.rotation_euler = (0.0, math.radians(-LEAF_TILT_DEG if dx > 0 else LEAF_TILT_DEG), math.radians(yaw))
+        out.append(leaf)
+    return out
+
+
+def visible_bottom_z(screen, x, y, z0, z1, y_max):
+    """Lowest z of the vertical segment (x, y, z0..z1) that projects at or above design y `y_max`."""
+    if screen.project((x, y, z0))[1] <= y_max:
+        return z0
+    lo, hi = z0, z1
+    for _ in range(40):
+        mid = (lo + hi) / 2
+        if screen.project((x, y, mid))[1] > y_max:
+            lo = mid
+        else:
+            hi = mid
+    return hi
+
+
+def counter_upper_points(body, top, screen, y_max):
+    """Top slab vertices plus the upper half of the body's front face as seen on screen: the front
+    face runs past the bottom of the frame, so its half is taken down to design y `y_max` (the
+    interactive rect's bottom)."""
+    (x0, x1), (y0, _y1), (z0, z1) = bounds([body.matrix_world @ v.co for v in body.data.vertices])
+    zm = (visible_bottom_z(screen, (x0 + x1) / 2, y0, z0, z1, y_max) + z1) / 2
+    front = [Vector((x, y0, z)) for x in (x0, x1) for z in (zm, z1)]
+    return [top.matrix_world @ v.co for v in top.data.vertices] + front
+
+
+def visible_vertices(scene, depsgraph, objs):
+    """World vertices of `objs` that the camera sees (no other object in between)."""
+    cam = scene.camera.matrix_world.translation
+    own = {o.name for o in objs}
+    out = []
+    for p in eval_world_verts(objs, depsgraph):
+        d = p - cam
+        dist = d.length
+        hit, _loc, _n, _i, obj, _m = scene.ray_cast(depsgraph, cam, d.normalized(), distance=dist - 1e-3)
+        if not hit or obj.original.name in own:
+            out.append(p)
+    return out
+
+
+def thin(points, limit):
+    step = max(1, math.ceil(len(points) / limit))
+    return points[::step]
+
+
+def main():
+    args = parse_args('build_ice_cream')
+    params = args['params']
+    colours, art = params['colours'], params['art']
+    colours = {**colours, 'creatureLight': art['creatureLight']}
+    scene = bpy.context.scene
+    scene.render.resolution_x, scene.render.resolution_y = RENDER_SIZE
+    scene.render.resolution_percentage = 100
+
+    prune()
+    aim_camera(scene)
+
+    plate = bpy.data.collections.new('IceCreamShop')
+    scene.collection.children.link(plate)
+    sprites = bpy.data.collections.new('sprites')
+    scene.collection.children.link(sprites)
+
+    # Counter: the pink body and the white top slab.
+    pink = flat_material('counter-pink', colours['counterPink'])
+    white = flat_material('counter-top', colours['counterTop'])
+    cx, cy = COUNTER_CENTRE
+    w, d, h = COUNTER_SIZE
+    body = box('counter-pink', (cx, cy, COUNTER_BASE_Z + h / 2), (w, d, h), pink, pink, plate)
+    top_z = COUNTER_BASE_Z + h + COUNTER_TOP_THICKNESS
+    o2 = 2 * COUNTER_TOP_OVERHANG
+    top = box('counter-top', (cx, cy, COUNTER_BASE_Z + h + COUNTER_TOP_THICKNESS / 2), (w + o2, d + o2, COUNTER_TOP_THICKNESS), white, white, plate)
+
+    # Shiba.
+    shiba_coll = bpy.data.collections.new('sprite.shiba')
+    sprites.children.link(shiba_coll)
+    shiba_coll['states'] = json.dumps(SHIBA_STATES, separators=(',', ':'))
+    shiba_coll['holdout_occluders'] = 1
+    # It bounces and breathes at runtime and stands on nothing the camera sees: no shadow in the plate.
+    shiba_coll['movable'] = 1
+    shiba = build_shiba(scene, params, shiba_coll)
+
+    bpy.context.view_layer.update()
+    screen = Screen(scene, params)
+
+    # Scoop scale: the projected width at the row is at least draggableMinSize × margin.
+    probe = import_scoop('scoop-probe', 1.0, white, (cx, ROW_Y, top_z))
+    bpy.context.view_layer.update()
+    (px0, px1), _y, _z = bounds([probe.matrix_world @ v.co for v in probe.data.vertices])
+    unit_px = abs(screen.project((px1, ROW_Y, top_z))[0] - screen.project((px0, ROW_Y, top_z))[0])
+    bpy.data.objects.remove(probe, do_unlink=True)
+    scoop_scale = params['draggableMinSize'] * SCOOP_WIDTH_MARGIN / unit_px
+
+    # Row x positions: rowGap design px apart at the row depth.
+    px_per_m = abs(screen.project((cx + 1.0, ROW_Y, top_z))[0] - screen.project((cx, ROW_Y, top_z))[0])
+    gap = params['rowGap'] / px_per_m
+    row = {'scoop-1': cx - 2 * gap, 'scoop-2': cx - gap, 'cone': cx, 'scoop-3': cx + gap, 'scoop-4': cx + 2 * gap}
+
+    # Cone (plate).
+    cone_objs = import_new(bpy.ops.import_scene.gltf, filepath=CONE_GLB)
+    cone = next((o for o in cone_objs if o.type == 'MESH'), None)
+    if cone is None:
+        fail('ice-cream-cne.glb has no mesh')
+    for o in cone_objs:
+        move_to(o, plate)
+    cone.parent = None
+    cone.location = (row['cone'], ROW_Y, top_z)
+    cone.scale = (scoop_scale * CONE_SCALE_OF_SCOOP,) * 3
+
+    bpy.context.view_layer.update()
+    depsgraph = bpy.context.evaluated_depsgraph_get()
+
+    layout = bpy.data.collections.new('layout')
+    scene.collection.children.link(layout)
+    layout.hide_render = True
+
+    # Shiba: visible hull and ground pivot.
+    shiba_meshes = [o for o in shiba if o.type == 'MESH']
+    seen = visible_vertices(scene, depsgraph, shiba_meshes)
+    if len(seen) < 3:
+        fail('Shiba is not visible from the camera')
+    hull_object('hit.shiba', thin(seen, MAX_SHIBA_HULL_VERTS), layout)
+    all_shiba = eval_world_verts(shiba_meshes, depsgraph)
+    (x0, x1), (y0, y1), (z0, _z1) = bounds(all_shiba)
+    add_empty('anchor.shiba', ((x0 + x1) / 2, (y0 + y1) / 2, z0), layout)
+
+    # Scoops: one sprite per flavour, all posed at slot.scoop-2.
+    chip_mat = flat_material('scoop-chip', art['chip'])
+    leaf_mat = flat_material('scoop-leaf', colours['creatureGreen'])
+    scoop_meshes = {}
+    for f in FLAVOURS:
+        coll = bpy.data.collections.new(f'sprite.scoop-{f}')
+        sprites.children.link(coll)
+        coll['movable'] = 1
+        mesh = import_scoop(f'scoop-{f}', scoop_scale, flat_material(f'scoop-{f}', art['flavour'][f]), (row['scoop-2'], ROW_Y, top_z))
+        move_to(mesh, coll)
+        if f == 'strawberry':
+            add_strawberry(mesh, coll)
+        elif f == 'chocolate':
+            add_chips(mesh, chip_mat, coll)
+        elif f == 'mint':
+            add_leaves(mesh, leaf_mat, coll)
+        scoop_meshes[f] = mesh
+
+    bpy.context.view_layer.update()
+    depsgraph = bpy.context.evaluated_depsgraph_get()
+
+    # Cone: ground pivot and the stacked scoop centres.
+    cone_pts = eval_world_verts([cone], depsgraph)
+    (x0, x1), (y0, y1), (z0, z1) = bounds(cone_pts)
+    add_empty('anchor.cone', ((x0 + x1) / 2, (y0 + y1) / 2, z0), layout)
+    scoop_pts = eval_world_verts(descendants(scoop_meshes['vanilla']), depsgraph)
+    _x, _y, (sz0, sz1) = bounds(scoop_pts)
+    scoop_h = sz1 - sz0
+    for n in range(1, CONE_SLOTS + 1):
+        z = z1 + scoop_h * (SCOOP_SEAT + SCOOP_STACK * (n - 1))
+        add_empty(f'slot.cone-{n}', ((x0 + x1) / 2, (y0 + y1) / 2, z), layout)
+
+    # Scoop homes on the counter top.
+    for k in range(1, 5):
+        add_empty(f'slot.scoop-{k}', (row[f'scoop-{k}'], ROW_Y, top_z), layout)
+
+    # Counter areas.
+    hull_object('hit.counter', eval_world_verts([body, top], depsgraph), layout)
+    hull_object('hit.counter-upper', counter_upper_points(body, top, screen, params['rect']['y1']), layout)
+
+    # Diagnostics (design px).
+    for name in ['anchor.shiba', 'anchor.cone', 'slot.scoop-1', 'slot.scoop-2', 'slot.cone-1', 'slot.scoop-4']:
+        o = bpy.data.objects[name]
+        print(f'build_ice_cream: {name} → {tuple(round(v, 1) for v in screen.project(o.location))}')
+    sp = [screen.project(p) for p in seen]
+    print(f'build_ice_cream: Shiba visible y {min(p[1] for p in sp):.1f}..{max(p[1] for p in sp):.1f}, scoop scale {scoop_scale:.3f}, gap {gap:.3f} m')
+
+    scene.frame_set(IDLE_FRAME)
+    bpy.ops.wm.save_as_mainfile(filepath=args['out'], compress=True)
+    print(f'build_ice_cream: saved {args["out"]}')
+
+
+main()
diff --git a/app/tools/render/blender/render_screen.py b/app/tools/render/blender/render_screen.py
new file mode 100644
index 0000000..9e48260
--- /dev/null
+++ b/app/tools/render/blender/render_screen.py
@@ -0,0 +1,196 @@
+# Renders one screen's .blend (Story 1.4). Generic: works for any art/<screen>.blend that follows
+# the naming contract. Run by `npm run render -- <screen>` (tools/render/render.ts), never by hand:
+#   blender -b --factory-startup art/<screen>.blend --python-exit-code 1 --python render_screen.py -- \
+#     --out <tmp dir> --screen <screen>
+#
+# Writes into --out:
+# (`--images 0` skips the renders and writes raw.json only, for diagnosis.)
+#   bg.png                          the plate: the whole scene from the scene camera; sprite objects
+#                                   have visible_camera = False but still cast their shadows,
+#                                   except moving sprites (occlude = 0, the kart): no shadow
+#   frames/<object>/<state>/<nn>.png  full-frame transparent renders per `sprite.<object>` collection.
+#                                   Collection props (all optional, Story 1.8 adds the last three):
+#                                   - `occlude` (Story 1.4) / `holdout_occluders` = 1: plate objects
+#                                     become holdouts, so plate objects in front of the sprite cut it;
+#                                     otherwise the sprite renders alone;
+#                                   - `movable` = 1: no shadow in the plate (default: not holdout);
+#                                   - `states` = JSON {state: [timeline frames]} → <state>/<nn> per
+#                                     frame in order (default {"idle": [1]}).
+#                                   The plate renders at timeline frame 1.
+#   raw.json                        every object of the `layout` collection projected to render px:
+#                                   hit = every evaluated vertex, anchor/slot = the origin,
+#                                   path = the evaluated spline points (in order). Each point is
+#                                   [x, y, depth]; x/y from the top-left, y down; depth <= 0 is
+#                                   behind the camera. tools/layout/to-layout.ts checks everything.
+import json
+import os
+import sys
+
+import bpy
+from bpy_extras.object_utils import world_to_camera_view
+
+
+def fail(msg):
+    raise RuntimeError(f'render_screen: {msg}')
+
+
+def parse_args():
+    argv = sys.argv[sys.argv.index('--') + 1:] if '--' in sys.argv else []
+    args = {}
+    for i in range(0, len(argv) - 1, 2):
+        args[argv[i].lstrip('-')] = argv[i + 1]
+    for key in ('out', 'screen'):
+        if key not in args:
+            fail(f'missing --{key}')
+    return args
+
+
+DEFAULT_STATES = {'idle': [1]}
+PLATE_FRAME = 1
+
+
+def holdout_of(c):
+    return bool(c.get('holdout_occluders', c.get('occlude', 0)))
+
+
+def movable_of(c):
+    return bool(c.get('movable', not holdout_of(c)))
+
+
+def states_of(c):
+    raw = c.get('states')
+    if raw is None:
+        return DEFAULT_STATES
+    states = json.loads(raw) if isinstance(raw, str) else dict(raw)
+    if not states or any(not isinstance(v, list) or not v for v in states.values()):
+        fail(f'collection "{c.name}": prop "states" must map each state to a non-empty frame list')
+    return states
+
+
+def sprite_collections():
+    return sorted((c for c in bpy.data.collections if c.name.startswith('sprite.')), key=lambda c: c.name)
+
+
+def project_layout(scene, depsgraph):
+    layout = bpy.data.collections.get('layout')
+    if layout is None:
+        fail('no "layout" collection')
+    if not layout.hide_render:
+        fail('the "layout" collection must have hide_render = True')
+    cam = scene.camera
+    w, h = scene.render.resolution_x, scene.render.resolution_y
+
+    def proj(co):
+        v = world_to_camera_view(scene, cam, co)
+        return [round(v.x * w, 3), round((1 - v.y) * h, 3), round(v.z, 4)]
+
+    objects = []
+    for o in sorted(layout.all_objects, key=lambda o: o.name):
+        ev = o.evaluated_get(depsgraph)
+        mw = ev.matrix_world
+        if o.type == 'MESH':
+            me = ev.to_mesh()
+            pts = [proj(mw @ v.co) for v in me.vertices]
+            ev.to_mesh_clear()
+        elif o.type == 'CURVE':
+            pts = []
+            for spline in ev.data.splines:
+                if spline.type == 'POLY':
+                    pts.extend(proj(mw @ p.co.xyz) for p in spline.points)
+                else:
+                    pts.extend(proj(mw @ p.co) for p in spline.bezier_points)
+        else:
+            pts = [proj(mw.translation)]
+        objects.append({'name': o.name, 'type': o.type, 'points': pts})
+    return objects
+
+
+def render_to(scene, path):
+    scene.render.filepath = path
+    bpy.ops.render.render(write_still=True)
+    if not os.path.isfile(path):
+        fail(f'render did not write {path}')
+
+
+def main():
+    args = parse_args()
+    out = os.path.abspath(args['out'])
+    scene = bpy.context.scene
+    if scene.camera is None:
+        fail('the scene has no camera')
+    r = scene.render
+    r.resolution_percentage = 100
+    r.image_settings.file_format = 'PNG'
+    r.image_settings.color_mode = 'RGBA'
+    r.image_settings.color_depth = '8'
+    r.image_settings.compression = 15
+    r.use_file_extension = False
+
+    bpy.context.view_layer.update()
+    depsgraph = bpy.context.evaluated_depsgraph_get()
+    sprites = sprite_collections()
+    sprite_objs = {c.name: list(c.all_objects) for c in sprites}
+    in_sprite = {o for objs in sprite_objs.values() for o in objs}
+    layout = bpy.data.collections['layout']
+    # Plate geometry only: lights and cameras stay as they are in every pass.
+    plate_objs = [o for o in scene.objects if o not in in_sprite and o.name not in layout.all_objects and o.type not in ('LIGHT', 'CAMERA', 'LIGHT_PROBE')]
+    # Sprites that move at runtime (occlude = 0, e.g. the kart) must not leave a shadow in the plate.
+    moving = {o for c in sprites if movable_of(c) for o in sprite_objs[c.name]}
+    scene.frame_set(PLATE_FRAME)
+
+    raw = {
+        'screenId': args['screen'],
+        'render': {'width': r.resolution_x, 'height': r.resolution_y},
+        'objects': project_layout(scene, depsgraph),
+        'frames': [],
+    }
+
+    if args.get('images', '1') == '0':  # diagnosis only: projection without renders
+        with open(os.path.join(out, 'raw.json'), 'w', encoding='utf8') as f:
+            json.dump(raw, f, indent=1, sort_keys=True)
+        return
+
+    # Plate: sprites hidden from the camera, still casting shadows.
+    film = r.film_transparent
+    for o in in_sprite:
+        o.visible_camera = False
+    for o in moving:
+        o.visible_shadow = False
+    render_to(scene, os.path.join(out, 'bg.png'))
+    for o in in_sprite:
+        o.visible_camera = True
+    for o in moving:
+        o.visible_shadow = True
+
+    # Full-frame transparent renders per sprite collection and state frame.
+    r.film_transparent = True
+    for c in sprites:
+        name = c.name[len('sprite.'):]
+        holdout = holdout_of(c)
+        saved = [(o, o.hide_render, o.is_holdout) for o in scene.objects]
+        for o in in_sprite:
+            if o not in sprite_objs[c.name]:
+                o.hide_render = True
+        for o in plate_objs:
+            if holdout:
+                o.is_holdout = True
+            else:
+                o.hide_render = True
+        for state, timeline in states_of(c).items():
+            for n, f in enumerate(timeline):
+                scene.frame_set(int(f))
+                frame = f'{name}/{state}/{n:02d}'
+                render_to(scene, os.path.join(out, 'frames', name, state, f'{n:02d}.png'))
+                raw['frames'].append(frame)
+        scene.frame_set(PLATE_FRAME)
+        for o, hide, hold in saved:
+            o.hide_render = hide
+            o.is_holdout = hold
+    r.film_transparent = film
+
+    with open(os.path.join(out, 'raw.json'), 'w', encoding='utf8') as f:
+        json.dump(raw, f, indent=1, sort_keys=True)
+    print(f'render_screen: wrote {len(raw["frames"])} frames and {len(raw["objects"])} layout objects')
+
+
+main()
