--- /dev/null
+++ b/app/src/scenes/PlayAgainOverlay.ts
@@ -0,0 +1,147 @@
+// PlayAgainOverlay (Story 2.4, FR25 / UX-DR53): "Hỏi chơi tiếp". Launched by Map at the end of a
+// completed round's post-round chain, above Map (and below Hud, so the Speaker is never dimmed).
+// Wiring only — the question sequence, idle clock, re-ask, ring swap and the four closes live in
+// core/play-again.ts (PlayAgainController, built by Map), the placement in core/play-again-layout.ts.
+//   - a 15% dim over the visible rect, NOT interactive: a station tap falls through to Map, which emits
+//     `overlay:close`; empty map and decoration taps leave the overlay open;
+//   - `button-replay` (green, the game's character + a circular arrow) and `button-back-to-map` (blue,
+//     a little island with the kart), both 160 px, on the `overlay` input layer;
+//   - any primary press anywhere (the guard runs every router's onAnyTap) counts as activity;
+//   - the controller ticks on this scene's `time` (Timing.hintTickMs) and hears `speech:ended`, so the
+//     AudioUnlockOverlay pause and a hidden page freeze the clock, bobs, ring and fades.
+// No text, no praise, no confetti, no music, no setTimeout.
+import { Scene, type GameObjects, type Tweens } from 'phaser';
+import { audio } from '../core/audio-director';
+import { bus } from '../core/bus';
+import { createHintRing, type HintRing } from '../core/hint-visuals';
+import { createTapRouter } from '../core/input/tap-router';
+import { createTapTarget, type TapTarget } from '../core/input/tap-target';
+import { currentView, visibleDesignRect } from '../core/input/space';
+import type { PlayAgainButton, PlayAgainController, PlayAgainView } from '../core/play-again';
+import type { PlayAgainPlacement } from '../core/play-again-layout';
+import { amplitude, prefersReducedMotion } from '../core/reduced-motion';
+import { Tokens } from '../core/tokens';
+import { mapIconChildren, replayIconChildren } from '../core/ui/play-again-icons';
+import { createRoundButton, pressButton, startBob } from '../core/ui/round-button';
+
+export const PLAY_AGAIN_KEY = 'PlayAgainOverlay';
+const POP_SFX = 'sfx.shell.pop';
+
+export interface PlayAgainData {
+  readonly controller: PlayAgainController;
+  readonly gameId: string;
+  readonly placement: PlayAgainPlacement;
+}
+
+interface ButtonView {
+  readonly body: GameObjects.Container;
+  readonly target: TapTarget;
+  readonly baseY: number;
+  bob: Tweens.Tween | undefined;
+}
+
+export class PlayAgainOverlay extends Scene {
+  constructor() {
+    super(PLAY_AGAIN_KEY);
+  }
+
+  create(data: PlayAgainData): void {
+    const { controller, gameId, placement } = data;
+    // Closed before this scene could create (a station tap in the launch gap): draw and say nothing.
+    if (controller.closed) {
+      this.scene.stop();
+      return;
+    }
+    const reduced = prefersReducedMotion(window);
+    const view0 = currentView();
+    const vis = view0 ? visibleDesignRect(view0) : { x: 0, y: 0, w: Tokens.design.width, h: Tokens.design.height };
+    const dim = Tokens.components.playAgainOverlay.backdrop;
+    // Visual only: no interactive backdrop.
+    const backdrop = this.add.rectangle(vis.x, vis.y, vis.w, vis.h, dim.value, dim.alpha).setOrigin(0);
+
+    const router = createTapRouter(this, { layer: 'overlay' });
+    router.onAnyTap = () => controller.activity();
+
+    const spec = {
+      replay: Tokens.components.buttonReplay,
+      map: Tokens.components.buttonBackToMap,
+    } as const;
+    const make = (which: PlayAgainButton, at: { x: number; y: number }, onPress: () => void): ButtonView => {
+      const s = spec[which];
+      const body = createRoundButton(this, { x: at.x, y: at.y, size: s.size, fill: s.background, icon: 'none' });
+      body.add(which === 'replay' ? replayIconChildren(this, gameId, s.size) : mapIconChildren(this, s.size));
+      const target = createTapTarget(router, {
+        circle: { x: at.x, y: at.y, r: s.size / 2 + Tokens.spacing.hitPad },
+        onPress: () => {
+          // Feedback in the same handler (≤ Timing.feedbackMaxMs), then the close.
+          pressButton(this, body);
+          audio.sfx(POP_SFX);
+          onPress();
+        },
+      });
+      return { body, target, baseY: at.y, bob: undefined };
+    };
+    const buttons: Record<PlayAgainButton, ButtonView> = {
+      replay: make('replay', placement.replay, () => controller.replay()),
+      map: make('map', placement.map, () => controller.backToMap()),
+    };
+
+    // Fade in over sceneFadeMs.
+    const drawn: Array<GameObjects.Rectangle | GameObjects.Container> = [backdrop, buttons.replay.body, buttons.map.body];
+    for (const o of drawn) o.setAlpha(0);
+    const fadeIn = this.tweens.add({ targets: drawn, alpha: 1, duration: Tokens.Timing.sceneFadeMs });
+
+    // The bob height goes through the reduced-motion amplitude (as a scale amplitude around 1).
+    const bobPx = amplitude(1 + Tokens.ui.playBobPx, reduced) - 1;
+    let ring: HintRing | undefined;
+    let fading = false;
+    const view: PlayAgainView = {
+      bob: (which, on) => {
+        const b = buttons[which];
+        if (on) {
+          if (b.bob) return;
+          b.bob = startBob(this, b.body, bobPx);
+          return;
+        }
+        if (!b.bob) return;
+        b.bob.stop();
+        b.bob = undefined;
+        b.body.setY(b.baseY);
+      },
+      ring: (which) => {
+        ring?.destroy();
+        ring = undefined;
+        if (which === null) return;
+        const b = buttons[which];
+        const d = spec[which].size + 2 * Tokens.ui.hintRingPad;
+        ring = createHintRing(this, { x: b.body.x - d / 2, y: b.baseY - d / 2, width: d, height: d }, { reduced });
+      },
+      disable: () => {
+        buttons.replay.target.setEnabled(false);
+        buttons.map.target.setEnabled(false);
+      },
+      fadeOut: (ms) => {
+        if (fading) return;
+        fading = true;
+        fadeIn.stop();
+        this.tweens.add({
+          targets: drawn,
+          alpha: 0,
+          duration: ms,
+          onComplete: () => this.scene.stop(),
+        });
+      },
+    };
+
+    bus.scoped(this).on('speech:ended', (e) => controller.speechEnded(e.token, e.completed));
+    const tick = Tokens.Timing.hintTickMs;
+    this.time.addEvent({ delay: tick, loop: true, callback: () => controller.tick(tick) });
+    this.events.once('shutdown', () => {
+      ring?.destroy();
+      ring = undefined;
+    });
+
+    controller.attach(view);
+    controller.open();
+  }
+}
