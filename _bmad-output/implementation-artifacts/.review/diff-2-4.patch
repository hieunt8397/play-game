@@ -0,0 +1,128 @@
+// Play-again button icons (Story 2.4). Children added to `createRoundButton(…, icon: 'none')`:
+//   - replay: the game's character, frame `icon/<gameId>/00` of `atlas.map` (falling back to the station
+//     frame `<gameId>/idle/00`, with one warning), pivoted at its trimmed centre (spec-1-8) and scaled
+//     so its trimmed longest side is ui.playAgainIconPx; plus a small circular arrow badge
+//     (ui.playAgainArrowPx, buttonRound.icon ink, Graphics) at the lower right;
+//   - map: a little island (a `sand` ellipse under a `grass` ellipse, on a `sea` disc, Graphics) with
+//     `kart/idle/00` scaled to ui.playAgainKartPx on top.
+// The fit maths is pure (`iconFit`); the rest is thin Phaser wiring.
+import type { GameObjects, Scene } from 'phaser';
+import { ATLASES, MAP_KART } from '../../content/assets';
+import { playAgainIconFrame } from '../../content/play-again';
+import { stationFrame } from '../../content/stations';
+import { LAYOUTS } from '../../content/layouts';
+import { Tokens } from '../tokens';
+import { originFor, trimmedCentre, type TrimmedRect } from './sprite-pivot';
+
+export interface IconFit {
+  readonly originX: number;
+  readonly originY: number;
+  readonly scale: number;
+}
+
+/**
+ * Places a full-frame trimmed sprite so its visible centre sits at the image position and its trimmed
+ * longest side measures `targetPx` design px. `frame` is in render px (spriteSourceSize).
+ */
+export function iconFit(frame: TrimmedRect, renderScale: number, design: { readonly width: number; readonly height: number }, targetPx: number): IconFit {
+  const origin = originFor(trimmedCentre(frame, renderScale), design);
+  const longest = Math.max(frame.width, frame.height);
+  return { originX: origin.x, originY: origin.y, scale: longest > 0 ? targetPx / longest : 1 };
+}
+
+/** The replay frame to use for `gameId`: its icon frame, else its station frame (`fallback: true`). */
+export function replayIconFrame(gameId: string, has: (frame: string) => boolean): { frame: string; fallback: boolean } | undefined {
+  const icon = playAgainIconFrame(gameId);
+  if (has(icon)) return { frame: icon, fallback: false };
+  const station = stationFrame(gameId);
+  return has(station) ? { frame: station, fallback: true } : undefined;
+}
+
+interface FrameData {
+  readonly spriteSourceSize?: { x: number; y: number; w: number; h: number };
+}
+
+const warned = new Set<string>();
+
+function warnOnce(msg: string): void {
+  if (warned.has(msg)) return;
+  warned.add(msg);
+  console.warn(msg);
+}
+
+/** A trimmed atlas frame as an image centred at (0, 0), its trimmed longest side `px`; undefined when missing. */
+function fittedImage(scene: Scene, frame: string, px: number): GameObjects.Image | undefined {
+  const key = ATLASES.map.key;
+  if (!scene.textures.exists(key) || !scene.textures.get(key).has(frame)) return undefined;
+  const ss = (scene.textures.get(key).get(frame).customData as FrameData | undefined)?.spriteSourceSize;
+  if (!ss) return scene.add.image(0, 0, key, frame).setDisplaySize(px, px);
+  const fit = iconFit({ x: ss.x, y: ss.y, width: ss.w, height: ss.h }, LAYOUTS.map.renderScale, Tokens.design, px);
+  return scene.add.image(0, 0, key, frame).setOrigin(fit.originX, fit.originY).setScale(fit.scale);
+}
+
+// Badge proportions (visual only): its centre relative to the button radius, the arrow arc.
+const BADGE_AT = 0.5;
+const ARC = { from: -0.35 * Math.PI, to: 1.25 * Math.PI, radius: 0.5, width: 0.16, head: 0.3 } as const;
+
+/** The circular-arrow badge: a white disc with an ink arc and arrow head, centred at (0, 0). */
+function arrowBadge(scene: Scene): GameObjects.Graphics {
+  const d = Tokens.ui.playAgainArrowPx;
+  const r = d / 2;
+  const ink = Tokens.components.buttonRound.icon;
+  const white = Tokens.components.buttonRound.highlight;
+  const g = scene.add.graphics();
+  g.fillStyle(white.value, white.alpha);
+  g.fillCircle(0, 0, r);
+  const ar = r * ARC.radius;
+  g.lineStyle(d * ARC.width, ink.value, ink.alpha);
+  g.beginPath();
+  g.arc(0, 0, ar, ARC.from, ARC.to);
+  g.strokePath();
+  // Arrow head at the arc's end, pointing along the turn.
+  const ex = ar * Math.cos(ARC.to);
+  const ey = ar * Math.sin(ARC.to);
+  const h = d * ARC.head;
+  const tx = -Math.sin(ARC.to);
+  const ty = Math.cos(ARC.to);
+  g.fillStyle(ink.value, ink.alpha);
+  g.fillTriangle(ex + tx * h, ey + ty * h, ex - ty * h * 0.6, ey + tx * h * 0.6, ex + ty * h * 0.6, ey - tx * h * 0.6);
+  return g;
+}
+
+/** The replay button's children: the character and the arrow badge. */
+export function replayIconChildren(scene: Scene, gameId: string, buttonSize: number): GameObjects.GameObject[] {
+  const key = ATLASES.map.key;
+  const has = (frame: string): boolean => scene.textures.exists(key) && scene.textures.get(key).has(frame);
+  const out: GameObjects.GameObject[] = [];
+  const pick = replayIconFrame(gameId, has);
+  if (pick?.fallback) warnOnce(`play-again: atlas "map" has no "${playAgainIconFrame(gameId)}" — using "${pick.frame}"`);
+  if (!pick) warnOnce(`play-again: atlas "map" has neither "${playAgainIconFrame(gameId)}" nor "${stationFrame(gameId)}" — no icon`);
+  const image = pick ? fittedImage(scene, pick.frame, Tokens.ui.playAgainIconPx) : undefined;
+  if (image) out.push(image);
+  const badge = arrowBadge(scene);
+  const at = (buttonSize / 2) * BADGE_AT;
+  badge.setPosition(at, at);
+  out.push(badge);
+  return out;
+}
+
+// Island proportions relative to the button radius (visual only).
+const ISLAND = { sea: 0.62, sandW: 1.0, sandH: 0.5, grassW: 0.8, grassH: 0.36, y: 0.12, grassLift: 0.06, kartLift: 0.12 } as const;
+
+/** The map button's children: the little island and the kart. */
+export function mapIconChildren(scene: Scene, buttonSize: number): GameObjects.GameObject[] {
+  const r = buttonSize / 2;
+  const c = Tokens.colors;
+  const g = scene.add.graphics();
+  g.fillStyle(c.sea.value, c.sea.alpha);
+  g.fillCircle(0, 0, r * ISLAND.sea);
+  g.fillStyle(c.sand.value, c.sand.alpha);
+  g.fillEllipse(0, r * ISLAND.y, r * ISLAND.sandW, r * ISLAND.sandH);
+  g.fillStyle(c.grass.value, c.grass.alpha);
+  g.fillEllipse(0, r * (ISLAND.y - ISLAND.grassLift), r * ISLAND.grassW, r * ISLAND.grassH);
+  const out: GameObjects.GameObject[] = [g];
+  const kart = fittedImage(scene, MAP_KART.frame, Tokens.ui.playAgainKartPx);
+  if (kart) out.push(kart.setY(-r * ISLAND.kartLift));
+  else warnOnce(`play-again: atlas "map" has no "${MAP_KART.frame}" — the map icon has no kart`);
+  return out;
+}
