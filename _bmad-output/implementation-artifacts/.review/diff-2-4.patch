+// "Hỏi chơi tiếp" overlay content (Story 2.4). Data only, plus two pure name helpers.
+// - Voice: `ask` is `vo.shell.play-again-ask.<gameId>` ("Chơi nữa với bạn <character> nhé?") when that
+//   line exists, else the generic `vo.shell.play-again-ask`; `elsewhere` is `vo.shell.play-again-elsewhere`.
+// - Icons: `PLAY_AGAIN_ICONS` lists the replay-button characters that tools/render/build.ts hands to
+//   build_map.py. Each becomes `state.<gameId>` under the detached `sprite.icon` group of art/map.blend,
+//   rendered as frame `icon/<gameId>/00` of `atlas.map` (trimmed longest side ÷ renderScale ≥
+//   ui.playAgainIconPx, checked by tools/layout/rules.ts). A game without an entry falls back to its
+//   station frame `<gameId>/idle/00` (core/ui/play-again-icons.ts), so the overlay works for every game.
+// Epics 3/4 add their own line and icon entry. `.ts` specifiers: tools/ import this under Node.
+import type { GameId } from './types.ts';
+import { isVoiceLineId } from './voice-lines.ts';
+
+export interface PlayAgainIcon {
+  /** Relative to the project's `assets/` folder (Quaternius, CC0). */
+  readonly model: string;
+  /** Creature colour token (Tokens.colors) for spec-1-8's `recolor_creature` (`Main` material). */
+  readonly creature: string;
+}
+
+export const PLAY_AGAIN_ICONS: Readonly<Partial<Record<GameId, PlayAgainIcon>>> = {
+  'ice-cream': { model: 'quaternius/animals/ShibaInu.fbx', creature: 'creatureOrange' },
+};
+
+export const PLAY_AGAIN_ASK = 'vo.shell.play-again-ask';
+export const PLAY_AGAIN_ELSEWHERE = 'vo.shell.play-again-elsewhere';
+
+/** The per-game ask line id (may not exist). */
+export const playAgainAskLine = (gameId: string): string => `${PLAY_AGAIN_ASK}.${gameId}`;
+
+/** The replay icon frame of a game in `atlas.map`. */
+export const playAgainIconFrame = (gameId: string): string => `icon/${gameId}/00`;
+
+export interface PlayAgainLines {
+  readonly ask: string;
+  readonly elsewhere: string;
+}
+
+/** The two lines of the question for `gameId`: its own ask line when it exists, else the generic one. */
+export function playAgainLines(gameId: string, isLine: (id: string) => boolean = isVoiceLineId): PlayAgainLines {
+  const own = playAgainAskLine(gameId);
+  return { ask: isLine(own) ? own : PLAY_AGAIN_ASK, elsewhere: PLAY_AGAIN_ELSEWHERE };
+}
