+// "Hỏi chơi tiếp" controller (Story 2.4, FR25 / UX-DR53), pure. Map builds it synchronously at chain
+// end (so an `overlay:close` from a station tap can never race the scene launch); the overlay scene
+// attaches its view, feeds `tick(hintTickMs)` from its own `time` and forwards `speech:ended`.
+//
+//   idle (built) → open() → asking → waiting ⇄ reasking → closed
+//
+// - open(): setPrompt([ask, elsewhere]) (the Speaker replays both lines), the replay button bobs, say(ask).
+// - Own token ends: `ask` completed → replay bob off, map bob on, say(elsewhere). `elsewhere` ends, or
+//   `ask` ends completed:false (the Speaker cut it; its replay already holds `elsewhere`) → every bob off,
+//   `waiting`, idle 0. Foreign tokens (Speaker replays included) are ignored.
+// - Clock: tick(ms) advances idle only in waiting / reasking, so it starts when the question has ended;
+//   activity() (any primary press anywhere) resets idle without changing the phase.
+// - Re-ask, at most once per opening: at Timing.playAgainRepromptMs of idle the two lines play again as
+//   `reasking`, the ring on `replay` during ask and on `map` during elsewhere (no bob). Afterwards the one
+//   ring swaps replay ⇄ map every Timing.playAgainRingSwapMs (counted by ticks) until close; it never blinks.
+// - Auto close at Timing.playAgainAutoCloseMs of idle. replay() / backToMap() / `overlay:close` close too.
+// - close(reason), first call only: stop own live voice → clearPrompt(ask) (own prompt only) → ring off, bobs off, disable →
+//   fadeOut (auto: playAgainFadeOutMs, else sceneFadeMs) → unsubscribe overlay:close → onClosed(reason).
+import type { PlayAgainLines } from '../content/play-again';
+import type { ChainEnd } from './post-round-chain';
+import { Tokens } from './tokens';
+
+export type CloseReason = 'replay' | 'back' | 'station' | 'auto';
+export type PlayAgainButton = 'replay' | 'map';
+export type PlayAgainPhase = 'idle' | 'asking' | 'waiting' | 'reasking' | 'closed';
+
+/** What the overlay scene draws (all calls are idempotent). */
+export interface PlayAgainView {
+  bob(button: PlayAgainButton, on: boolean): void;
+  /** The one hint ring around a button, or none. */
+  ring(button: PlayAgainButton | null): void;
+  /** Input off at once: taps then fall through to Map. */
+  disable(): void;
+  /** Fades the overlay out over `ms`, then stops the scene. */
+  fadeOut(ms: number): void;
+}
+
+export interface PlayAgainPorts {
+  say(id: string): number;
+  setPrompt(ids: readonly string[]): void;
+  /** Clears the prompt only when it is (a chain holding) `id`: the overlay's own question. */
+  clearPrompt(id: string): void;
+  stopVoice(token: number): void;
+  /** Subscribes to the Bus `overlay:close`; returns the unsubscribe. */
+  onOverlayClose(handler: () => void): () => void;
+  onClosed(reason: CloseReason): void;
+}
+
+export interface PlayAgainTiming {
+  readonly repromptMs: number;
+  readonly autoCloseMs: number;
+  readonly ringSwapMs: number;
+  readonly fadeOutMs: number;
+  readonly closeFadeMs: number;
+}
+
+export const DEFAULT_PLAY_AGAIN_TIMING: PlayAgainTiming = {
+  repromptMs: Tokens.Timing.playAgainRepromptMs,
+  autoCloseMs: Tokens.Timing.playAgainAutoCloseMs,
+  ringSwapMs: Tokens.Timing.playAgainRingSwapMs,
+  fadeOutMs: Tokens.Timing.playAgainFadeOutMs,
+  closeFadeMs: Tokens.Timing.sceneFadeMs,
+};
+
+/**
+ * Whether a chain end opens the overlay: only `complete` (never `round:abandon` nor Map's create-time
+ * chain, which is also `abandon`), never for touch-talk, and only for a registered game.
+ */
+export function opensPlayAgain(e: ChainEnd, isGame: (id: string) => boolean): boolean {
+  return e.kind === 'complete' && e.gameId !== 'touch-talk' && isGame(e.gameId);
+}
+
+type Line = 'ask' | 'elsewhere';
+
+export class PlayAgainController {
+  private _phase: PlayAgainPhase = 'idle';
+  private view: PlayAgainView | undefined;
+  private live: { token: number; line: Line } | undefined;
+  private _idleMs = 0;
+  private reasked = false;
+  /** The alternating ring after the re-ask (undefined before). */
+  private swapRing: PlayAgainButton | undefined;
+  private swapMs = 0;
+  private off: (() => void) | undefined;
+  private readonly lines: PlayAgainLines;
+  private readonly ports: PlayAgainPorts;
+  private readonly timing: PlayAgainTiming;
+
+  constructor(lines: PlayAgainLines, ports: PlayAgainPorts, timing: PlayAgainTiming = DEFAULT_PLAY_AGAIN_TIMING) {
+    this.lines = lines;
+    this.ports = ports;
+    this.timing = timing;
+    this.off = ports.onOverlayClose(() => this.close('station'));
+  }
+
+  get phase(): PlayAgainPhase {
+    return this._phase;
+  }
+
+  get closed(): boolean {
+    return this._phase === 'closed';
+  }
+
+  get idleMs(): number {
+    return this._idleMs;
+  }
+
+  /** The overlay scene's view (it arrives after construction, from the scene's create). */
+  attach(view: PlayAgainView): void {
+    if (this.closed) return;
+    this.view = view;
+  }
+
+  /** Starts the question (once). */
+  open(): void {
+    if (this._phase !== 'idle') return;
+    this._phase = 'asking';
+    this.ports.setPrompt([this.lines.ask, this.lines.elsewhere]);
+    this.view?.bob('replay', true);
+    this.speak('ask');
+  }
+
+  speechEnded(token: number, completed: boolean): void {
+    const live = this.live;
+    if (this.closed || live === undefined || live.token !== token) return;
+    this.live = undefined;
+    const reasking = this._phase === 'reasking';
+    if (live.line === 'ask' && completed) {
+      if (reasking) this.view?.ring('map');
+      else {
+        this.view?.bob('replay', false);
+        this.view?.bob('map', true);
+      }
+      this.speak('elsewhere');
+      return;
+    }
+    // The question has ended (or its ask was cut: the Speaker's replay already holds `elsewhere`).
+    this.view?.bob('replay', false);
+    this.view?.bob('map', false);
+    this._phase = 'waiting';
+    if (reasking) {
+      // The idle clock runs through the re-ask; the ring now swaps between the buttons.
+      this.swapRing = live.line === 'ask' ? 'replay' : 'map';
+      this.swapMs = 0;
+      this.view?.ring(this.swapRing);
+    } else {
+      this._idleMs = 0;
+    }
+  }
+
+  tick(ms: number): void {
+    if (this._phase !== 'waiting' && this._phase !== 'reasking') return;
+    const d = Math.max(0, Number.isFinite(ms) ? ms : 0);
+    this._idleMs += d;
+    if (this._idleMs >= this.timing.autoCloseMs) {
+      this.close('auto');
+      return;
+    }
+    if (this._phase === 'waiting' && this.swapRing !== undefined) {
+      this.swapMs += d;
+      while (this.swapMs >= this.timing.ringSwapMs) {
+        this.swapMs -= this.timing.ringSwapMs;
+        this.swapRing = this.swapRing === 'replay' ? 'map' : 'replay';
+        this.view?.ring(this.swapRing);
+      }
+    }
+    if (this._phase === 'waiting' && !this.reasked && this._idleMs >= this.timing.repromptMs) this.reask();
+  }
+
+  /** Any primary press anywhere: the child is not idle. */
+  activity(): void {
+    if (this._phase === 'idle' || this.closed) return;
+    this._idleMs = 0;
+  }
+
+  replay(): void {
+    this.close('replay');
+  }
+
+  backToMap(): void {
+    this.close('back');
+  }
+
+  close(reason: CloseReason): void {
+    if (this.closed) return;
+    this._phase = 'closed';
+    const live = this.live;
+    this.live = undefined;
+    if (live) this.ports.stopVoice(live.token);
+    this.ports.clearPrompt(this.lines.ask);
+    const view = this.view;
+    if (view) {
+      view.ring(null);
+      view.bob('replay', false);
+      view.bob('map', false);
+      view.disable();
+      view.fadeOut(reason === 'auto' ? this.timing.fadeOutMs : this.timing.closeFadeMs);
+    }
+    this.off?.();
+    this.off = undefined;
+    this.ports.onClosed(reason);
+  }
+
+  private reask(): void {
+    this.reasked = true;
+    this._phase = 'reasking';
+    this.view?.ring('replay');
+    this.speak('ask');
+  }
+
+  private speak(line: Line): void {
+    const token = this.ports.say(line === 'ask' ? this.lines.ask : this.lines.elsewhere);
+    // A port may close us synchronously (never in practice); keep no token then.
+    if (!this.closed) this.live = { token, line };
+  }
+}
+
+/** What Map does when the overlay closes (Story 2.4). */
+export type PlayAgainCloseRoute<C> =
+  | { readonly action: 'replay'; readonly commands: readonly C[] }
+  | { readonly action: 'idle-visit' };
+
+/**
+ * `replay` with trip commands (KartTrip.replay accepted) → replay: clear the resume point and apply them.
+ * back / auto / station, or a refused replay (no commands) → a new idle visit (invitations restart).
+ */
+export function routePlayAgainClose<C>(reason: CloseReason, replayCommands: readonly C[]): PlayAgainCloseRoute<C> {
+  return reason === 'replay' && replayCommands.length > 0 ? { action: 'replay', commands: replayCommands } : { action: 'idle-visit' };
+}
