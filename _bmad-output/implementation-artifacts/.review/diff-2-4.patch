+    const p = playAgainPlacement([{ x: 400, y: 500, width: 100, height: 100 }], AREA, M, noWarn);
+    expect(centreDist(p)).toBe(Tokens.components.buttonReplay.size + Tokens.components.playAgainOverlay.gap);
+    expect(p.replay.y).toBe(p.map.y);
