@@ -0,0 +1,129 @@
+// Play-again button placement (Story 2.4), pure. The replay button sits left and the map button right,
+// on one row, centres `size + gap` apart (160 + 48 = 208 design px). Each button's box is its circle
+// plus ui.playBobPx above and below (the bob). Obstacles are the station just played: the bbox of its
+// hit polygon and the footprints of the decorations drawn at its slots (so the new item stays visible).
+// Candidates, first fit wins:
+//   1. the pair centred at x = design centre, its bottom edge ui.playAgainClearPx above the obstacles;
+//   2. the same, centred below them (top edge playAgainClearPx under the obstacles);
+//   3. candidates 1 and 2 with x at the centre of the screen half away from the station.
+// Fit: both boxes inside the interactive rect (safeRect minus the edge dead bands, spec-2-2's rule) and
+// clear of every obstacle. No fit: candidate 1 clamped into the interactive rect, with a console.warn.
+import type { Point } from '../content/layout-types';
+import type { Rect } from './decoration-plan';
+import { Tokens } from './tokens';
+
+export type { Rect };
+
+/** x∈[x0,x1], y∈[y0,y1] (design px). */
+export interface InteractiveRect {
+  readonly x0: number;
+  readonly y0: number;
+  readonly x1: number;
+  readonly y1: number;
+}
+
+export interface PlayAgainPlacement {
+  readonly replay: Point;
+  readonly map: Point;
+  /** Index (0-based) of the candidate that fit, or -1 when candidate 1 was clamped. */
+  readonly candidate: number;
+}
+
+export interface PlayAgainMetrics {
+  /** Button diameter (components.buttonReplay.size; buttonBackToMap has the same size). */
+  readonly size: number;
+  /** Gap between the two circles (components.playAgainOverlay.gap). */
+  readonly gap: number;
+  /** Vertical bob room on each side (ui.playBobPx). */
+  readonly bob: number;
+  /** Clearance from the obstacles (ui.playAgainClearPx). */
+  readonly clear: number;
+  /** Design width: x = width / 2 is the screen centre; the halves are centred at width / 4 and 3·width / 4. */
+  readonly width: number;
+}
+
+export const DEFAULT_PLAY_AGAIN_METRICS: PlayAgainMetrics = {
+  size: Tokens.components.buttonReplay.size,
+  gap: Tokens.components.playAgainOverlay.gap,
+  bob: Tokens.ui.playBobPx,
+  clear: Tokens.ui.playAgainClearPx,
+  width: Tokens.design.width,
+};
+
+/** safeRect inset by the edge dead bands (side 24, top 32, bottom 40): the interactive rect. */
+export function playAgainInteractiveRect(): InteractiveRect {
+  const s = Tokens.safeRect;
+  const sp = Tokens.spacing;
+  return { x0: s.x + sp.edgeDeadSide, y0: s.y + sp.edgeDeadTop, x1: s.x + s.w - sp.edgeDeadSide, y1: s.y + s.h - sp.edgeDeadBottom };
+}
+
+/** The box of a button centred at `c`: its circle plus the bob above and below. */
+export function buttonBox(c: Point, m: PlayAgainMetrics = DEFAULT_PLAY_AGAIN_METRICS): Rect {
+  const r = m.size / 2;
+  return { x: c.x - r, y: c.y - r - m.bob, width: m.size, height: m.size + 2 * m.bob };
+}
+
+/** The two centres of a pair centred at (cx, cy): replay left, map right. */
+export function pairAt(cx: number, cy: number, m: PlayAgainMetrics = DEFAULT_PLAY_AGAIN_METRICS): { replay: Point; map: Point } {
+  const half = (m.size + m.gap) / 2;
+  return { replay: { x: cx - half, y: cy }, map: { x: cx + half, y: cy } };
+}
+
+const overlaps = (a: Rect, b: Rect): boolean => a.x < b.x + b.width && b.x < a.x + a.width && a.y < b.y + b.height && b.y < a.y + a.height;
+
+const inside = (r: Rect, area: InteractiveRect): boolean => r.x >= area.x0 && r.y >= area.y0 && r.x + r.width <= area.x1 && r.y + r.height <= area.y1;
+
+function union(rects: readonly Rect[]): Rect | undefined {
+  if (rects.length === 0) return undefined;
+  let x0 = Infinity;
+  let y0 = Infinity;
+  let x1 = -Infinity;
+  let y1 = -Infinity;
+  for (const r of rects) {
+    x0 = Math.min(x0, r.x);
+    y0 = Math.min(y0, r.y);
+    x1 = Math.max(x1, r.x + r.width);
+    y1 = Math.max(y1, r.y + r.height);
+  }
+  return { x: x0, y: y0, width: x1 - x0, height: y1 - y0 };
+}
+
+/** True when both buttons of the pair lie inside `area` and clear of every obstacle. */
+export function pairFits(pair: { replay: Point; map: Point }, obstacles: readonly Rect[], area: InteractiveRect, m: PlayAgainMetrics = DEFAULT_PLAY_AGAIN_METRICS): boolean {
+  return [pair.replay, pair.map].every((c) => {
+    const box = buttonBox(c, m);
+    return inside(box, area) && obstacles.every((o) => !overlaps(box, o));
+  });
+}
+
+/** The candidate pair centres in order (see the header). */
+export function playAgainCandidates(obstacles: readonly Rect[], m: PlayAgainMetrics = DEFAULT_PLAY_AGAIN_METRICS): Array<{ replay: Point; map: Point }> {
+  const u = union(obstacles) ?? { x: m.width / 2, y: 0, width: 0, height: 0 };
+  const r = m.size / 2;
+  const above = u.y - m.clear - m.bob - r;
+  const below = u.y + u.height + m.clear + m.bob + r;
+  const centre = m.width / 2;
+  // The half away from the station: a station on the left puts the pair in the right half.
+  const away = u.x + u.width / 2 < centre ? (3 * m.width) / 4 : m.width / 4;
+  return [pairAt(centre, above, m), pairAt(centre, below, m), pairAt(away, above, m), pairAt(away, below, m)];
+}
+
+export function playAgainPlacement(
+  obstacles: readonly Rect[],
+  interactive: InteractiveRect = playAgainInteractiveRect(),
+  m: PlayAgainMetrics = DEFAULT_PLAY_AGAIN_METRICS,
+  warn: (msg: string) => void = (msg) => console.warn(msg),
+): PlayAgainPlacement {
+  const candidates = playAgainCandidates(obstacles, m);
+  const i = candidates.findIndex((c) => pairFits(c, obstacles, interactive, m));
+  const fit = candidates[i];
+  if (fit) return { ...fit, candidate: i };
+  const first = candidates[0]!;
+  const r = m.size / 2;
+  const half = (m.size + m.gap) / 2;
+  const clamp = (v: number, lo: number, hi: number): number => Math.min(Math.max(v, lo), Math.max(lo, hi));
+  const cx = clamp((first.replay.x + first.map.x) / 2, interactive.x0 + half + r, interactive.x1 - half - r);
+  const cy = clamp(first.replay.y, interactive.y0 + r + m.bob, interactive.y1 - r - m.bob);
+  warn('play-again: no clear spot for the buttons — candidate 1 clamped into the interactive rect');
+  return { ...pairAt(cx, cy, m), candidate: -1 };
+}
