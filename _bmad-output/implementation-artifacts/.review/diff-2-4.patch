+
+  it('candidate 1: centred at x 512, bottom edge 24 px above the obstacles (bob included)', () => {
+    const obstacle: Rect = { x: 100, y: 400, width: 200, height: 100 };
+    const p = playAgainPlacement([obstacle], AREA, M, noWarn);
