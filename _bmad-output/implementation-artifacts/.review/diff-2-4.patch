   games?: GamesInput;
   /** Decoration catalogue and slots (content/decorations.ts, stations.ts; Story 2.2). */
   decorations?: DecorationCatalogueInput;
+  /** Play-again overlay lines and icons (content/play-again.ts; Story 2.4). */
+  playAgain?: PlayAgainInput;
+}
+
+/** Story 2.4: the play-again voice lines and the replay-icon list. */
+export interface PlayAgainInput {
+  gameIds: readonly string[];
+  /** Every voice-line id. */
+  voiceIds: readonly string[];
+  /** `PLAY_AGAIN_ICONS` keys. */
+  iconIds: readonly string[];
+}
+
+/** The game that never gets the play-again overlay (it ends through `reward:earned`, Epic 4). */
+const NO_PLAY_AGAIN = "touch-talk";
+
+/**
+ * Play-again rules (Story 2.4): the generic ask and the elsewhere line exist; every per-game ask line
+ * `vo.shell.play-again-ask.<x>` and every `PLAY_AGAIN_ICONS` key is a GameId other than touch-talk.
+ */
+export function validatePlayAgain(input: PlayAgainInput): string[] {
+  const problems: string[] = [];
+  const ids = new Set(input.voiceIds);
+  for (const line of [PLAY_AGAIN_ASK, PLAY_AGAIN_ELSEWHERE]) {
+    if (!ids.has(line)) problems.push(`play-again: voice line "${line}" is missing`);
+  }
+  const allowed = (x: string): boolean => input.gameIds.includes(x) && x !== NO_PLAY_AGAIN;
+  const prefix = `${PLAY_AGAIN_ASK}.`;
+  for (const id of input.voiceIds) {
+    if (!id.startsWith(prefix)) continue;
+    const gameId = id.slice(prefix.length);
+    if (!allowed(gameId)) problems.push(`play-again: voice line "${id}" names "${gameId}", which is not a GameId with the overlay (touch-talk has none)`);
+  }
+  for (const gameId of input.iconIds) {
+    if (!allowed(gameId)) problems.push(`play-again: PLAY_AGAIN_ICONS key "${gameId}" is not a GameId with the overlay (touch-talk has none)`);
+  }
+  return problems;
 }
 
 /** Story 2.2: the decoration catalogue per station and each station's slot ids. */
@@ -314,5 +352,6 @@ export function validateContent(input: ContentInput): string[] {
   if (input.stations) problems.push(...validateStations(input.stations));
   if (input.games) problems.push(...validateGames(input.games));
   if (input.decorations) problems.push(...validateDecorationCatalogue(input.decorations));
+  if (input.playAgain) problems.push(...validatePlayAgain(input.playAgain));
   return problems;
 }
