+import { describe, expect, it } from 'vitest';
+import { SHAPE_ITEMS, type ItemId } from '../../content/games/shadow-match';
+import { levelIndex, roundQuestions } from './questions';
+
+const group = (id: ItemId): string => SHAPE_ITEMS.find((i) => i.id === id)!.shapeGroup;
+
+describe('roundQuestions (Story 3.5)', () => {
+  it('same seed and level → the same round', () => {
+    expect(roundQuestions(7, 0)).toEqual(roundQuestions(7, 0));
+  });
+
+  it('seeds 0…999: 4 distinct held items; 2 distinct shadows from different groups; the right one at correctSlot; the slot alternates', () => {
+    const firstSlots = new Set<number>();
+    const held = new Set<ItemId>();
+    for (let seed = 0; seed < 1000; seed++) {
+      const qs = roundQuestions(seed, 0);
+      expect(qs).toHaveLength(4);
+      expect(new Set(qs.map((q) => q.item)).size).toBe(4);
+      qs.forEach((q, i) => {
+        expect(q.shadows).toHaveLength(2);
+        expect(new Set(q.shadows).size).toBe(2);
+        expect(new Set(q.shadows.map(group)).size).toBe(2);
+        expect(q.shadows[q.correctSlot]).toBe(q.item);
+        expect(q.shadows.filter((s) => s === q.item)).toHaveLength(1);
+        if (i > 0) expect(q.correctSlot).not.toBe(qs[i - 1]!.correctSlot);
+        held.add(q.item);
+      });
+      firstSlots.add(qs[0]!.correctSlot);
+    }
+    // Every item is held somewhere, and the first question's slot is not fixed.
+    expect(held.size).toBe(SHAPE_ITEMS.length);
+    expect(firstSlots).toEqual(new Set([0, 1]));
+  });
+
+  it('clamps the level (7, −1, NaN → 0) and handles a non-finite seed', () => {
+    expect(levelIndex(7)).toBe(0);
+    expect(levelIndex(-1)).toBe(0);
+    expect(levelIndex(Number.NaN)).toBe(0);
+    expect(roundQuestions(3, 7)).toEqual(roundQuestions(3, 0));
+    expect(roundQuestions(Number.NaN, 0)).toEqual(roundQuestions(0, 0));
+  });
+
+  it('different seeds give different rounds', () => {
+    const rounds = new Set(Array.from({ length: 50 }, (_, s) => JSON.stringify(roundQuestions(s, 0))));
+    expect(rounds.size).toBeGreaterThan(10);
+  });
+});
diff --git a/app/src/games/shadow-match/questions.ts b/app/src/games/shadow-match/questions.ts
new file mode 100644
index 0000000..3401b63
--- /dev/null
+++ b/app/src/games/shadow-match/questions.ts
@@ -0,0 +1,60 @@
+// Hang tìm bóng questions (Story 3.5), pure: which item the triceratops holds in each question, which
+// shadows show and where the right one is. Derived from the round seed and level only, so a round is
+// reproducible (resume, tests). One rng draws, in order: the held items, then per question its decoys
+// and its correct slot. No retry loops.
+import { SHAPE_ITEMS, ladder, type ItemId, type ShadowLevel } from '../../content/games/shadow-match.ts';
+import { mulberry32, randInt, shuffled } from '../../core/rng.ts';
+
+export interface ShadowQuestion {
+  /** The item the triceratops holds (the child drags it). */
+  readonly item: ItemId;
+  /** The shadows left to right (slot k + 1 = `slot.shadow-<n>-<k+1>`); `shadows[correctSlot] === item`. */
+  readonly shadows: readonly ItemId[];
+  readonly correctSlot: number;
+}
+
+/** The level index, clamped to the ladder (a non-finite level → 0). */
+export function levelIndex(level: number): number {
+  const l = Math.floor(level);
+  return Number.isFinite(l) ? Math.max(0, Math.min(ladder.length - 1, l)) : 0;
+}
+
+export function levelOf(level: number): ShadowLevel {
+  return ladder[levelIndex(level)]!;
+}
+
+/**
+ * The round's questions: `rng = mulberry32(seed)`; the held items are the first `questions` of a
+ * Fisher–Yates over SHAPE_ITEMS (distinct in a round). Per question (`groups: 'distinct'`): the decoys
+ * are the first `shadows − 1` of a shuffle of the items of another shape group; the correct slot is
+ * uniform over [0, n) without the previous question's slot; the decoys fill the other slots in their
+ * shuffled order. Deterministic.
+ */
+export function roundQuestions(seed: number, level: number): ShadowQuestion[] {
+  const lv = levelOf(level);
+  const n = lv.shadows;
+  const rng = mulberry32((Number.isFinite(seed) ? Math.floor(seed) : 0) >>> 0);
+  const held = shuffled(SHAPE_ITEMS, rng).slice(0, lv.questions);
+  const out: ShadowQuestion[] = [];
+  let prev: number | undefined;
+  for (const item of held) {
+    const decoys = shuffled(
+      SHAPE_ITEMS.filter((o) => o.shapeGroup !== item.shapeGroup),
+      rng,
+    )
+      .slice(0, n - 1)
+      .map((o) => o.id);
+    let correctSlot: number;
+    if (prev === undefined) correctSlot = randInt(rng, n);
+    else {
+      const k = randInt(rng, n - 1);
+      correctSlot = k >= prev ? k + 1 : k;
+    }
+    const shadows: ItemId[] = [];
+    let d = 0;
+    for (let k = 0; k < n; k++) shadows.push(k === correctSlot ? item.id : decoys[d++]!);
+    out.push({ item: item.id, shadows, correctSlot });
+    prev = correctSlot;
+  }
+  return out;
+}
