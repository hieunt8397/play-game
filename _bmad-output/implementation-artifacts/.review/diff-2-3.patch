+import { describe, expect, it, vi } from 'vitest';
+import type { GrantResult, RoundOutcome } from '../content/types';
+import { newestPerSlot, PostRoundChain, routeRoundAbandon, routeRoundComplete, type ChainDeps, type ChainFinish } from './post-round-chain';
+import { ProgressStoreService } from './progress-store';
+import { SessionStore } from './session-store';
+import { Timing } from './timing';
+
+/** Lets every pending promise callback run. */
+const flush = (): Promise<void> => new Promise((r) => setImmediate(r));
+
+function grant(slotId: string, decorationId: string, seq: number, replaced?: string): GrantResult {
+  const stationId = slotId.replace(/-[0-9]+$/, '') as GrantResult['slot']['stationId'];
+  return { slot: { slotId, stationId, decorationId, seq }, ...(replaced ? { replaced: { decorationId: replaced } } : {}) };
+}
+
+const PERFECT: RoundOutcome = { gameId: 'ice-cream', questions: 4, firstTryCorrect: 4, maxHintLevel: 0 };
+
+/**
+ * Fake deps on a fake scene clock: `wait` and each fly-in (decorationFlyInMs) run on `advance`;
+ * stopGameAndWake and pullBack resolve when the test says so (or at once with `auto`).
+ */
+function harness(opts: { pending?: GrantResult[]; auto?: boolean } = {}) {
+  let clock = 0;
+  let timers: { at: number; fn: () => void }[] = [];
+  const calls: string[] = [];
+  const session = new SessionStore();
+  session.pendingFlyIns.push(...(opts.pending ?? []));
+  const ends: ChainFinish[] = [];
+  const logs: string[] = [];
+  const warns: string[] = [];
+  const flyStarts: { id: string; at: number }[] = [];
+  let wake: () => void = () => {};
+  let pulled: () => void = () => {};
+
+  const wait = (ms: number): Promise<void> =>
+    new Promise((resolve) => {
+      timers.push({ at: clock + ms, fn: resolve });
+    });
+
+  const deps: ChainDeps = {
+    setDifficulty: vi.fn((id, l) => calls.push(`setDifficulty ${id} ${l}`)),
+    clearResume: vi.fn((id) => {
+      calls.push(`clearResume ${id}`);
+      session.clearResume(id);
+    }),
+    ladderLength: (id) => (id === 'ice-cream' ? 4 : id === 'touch-talk' ? undefined : 5),
+    stopGameAndWake: vi.fn(() => {
+      calls.push('stopGameAndWake');
+      return opts.auto ? Promise.resolve() : new Promise<void>((r) => (wake = r));
+    }),
+    pullBack: vi.fn((focus) => {
+      calls.push(`pullBack ${focus}`);
+      return opts.auto ? Promise.resolve() : new Promise<void>((r) => (pulled = r));
+    }),
+    flyIn: vi.fn(async (e: GrantResult) => {
+      calls.push(`flyIn ${e.slot.decorationId}`);
+      flyStarts.push({ id: e.slot.decorationId, at: clock });
+      await wait(Timing.decorationFlyInMs);
+      calls.push(`landed ${e.slot.decorationId}`);
+    }),
+    wait,
+    pending: () => session.pendingFlyIns,
+    end: vi.fn((e: ChainFinish) => {
+      calls.push(`end ${e.kind}`);
+      ends.push(e);
+    }),
+    now: () => clock,
+    log: (line) => logs.push(line),
+    warn: (msg) => warns.push(msg),
+  };
+
+  let paused = false;
+
+  /**
+   * Advances the fake scene clock in timer order, flushing promise callbacks after each timer. While
+   * paused (scene.pause()) frames go by but the scene clock does not move.
+   */
+  async function advance(ms: number): Promise<void> {
+    if (paused) {
+      await flush();
+      return;
+    }
+    const target = clock + ms;
+    await flush();
+    for (;;) {
+      const due = timers.filter((t) => t.at <= target).sort((a, b) => a.at - b.at)[0];
+      if (!due) break;
+      timers = timers.filter((t) => t !== due);
+      clock = due.at;
+      due.fn();
+      await flush();
+    }
+    clock = target;
+    await flush();
+  }
+
+  return {
+    deps,
+    chain: new PostRoundChain(deps),
+    session,
+    calls,
+    ends,
+    logs,
+    warns,
+    flyStarts,
+    advance,
+    pause: () => void (paused = true),
+    resume: () => void (paused = false),
+    sceneTime: () => clock,
+    wake: async () => {
+      wake();
+      await flush();
+    },
+    pulled: async () => {
+      pulled();
+      await flush();
+    },
+  };
+}
+
+describe('PostRoundChain › complete', () => {
+  it('L1, 4/4 first try, one pending: setDifficulty + clearResume synchronously, then the exact order 1 → 6', async () => {
+    const h = harness({ pending: [grant('ice-cream-1', 'parasol', 1)] });
+    h.session.resume['ice-cream'] = { v: 1, level: 1, seed: 1, questionIndex: 0, partial: null };
+    const p = h.chain.start({ kind: 'complete', gameId: 'ice-cream', outcome: PERFECT, startedLevel: 1 });
+    // Steps 1–3 ran before `start` returned its promise.
+    expect(h.calls).toEqual(['setDifficulty ice-cream 2', 'clearResume ice-cream', 'stopGameAndWake']);
+    expect(h.session.resume).toEqual({});
+    expect(h.chain.active).toBe(true);
+    await flush();
+    expect(h.deps.pullBack).not.toHaveBeenCalled();
+    await h.wake();
+    expect(h.calls.at(-1)).toBe('pullBack ice-cream');
+    expect(h.deps.flyIn).not.toHaveBeenCalled();
+    await h.pulled();
+    expect(h.calls.at(-1)).toBe('flyIn parasol');
+    expect(h.deps.end).not.toHaveBeenCalled();
+    await h.advance(Timing.decorationFlyInMs);
+    await p;
+    expect(h.calls).toEqual([
+      'setDifficulty ice-cream 2',
+      'clearResume ice-cream',
+      'stopGameAndWake',
+      'pullBack ice-cream',
+      'flyIn parasol',
+      'landed parasol',
+      'end complete',
+    ]);
+    expect(h.session.pendingFlyIns).toEqual([]);
+    expect(h.ends).toEqual([{ kind: 'complete', gameId: 'ice-cream', queuedStation: undefined }]);
+    expect(h.chain.active).toBe(false);
+  });
+
+  it('the level written comes from nextLevel (−1 after full help; clamped at the ladder top)', () => {
+    const a = harness({ auto: true });
+    void a.chain.start({ kind: 'complete', gameId: 'ice-cream', outcome: { ...PERFECT, firstTryCorrect: 2, maxHintLevel: 4 }, startedLevel: 2 });
+    expect(a.deps.setDifficulty).toHaveBeenCalledWith('ice-cream', 1);
+    const b = harness({ auto: true });
+    void b.chain.start({ kind: 'complete', gameId: 'ice-cream', outcome: PERFECT, startedLevel: 3 });
+    expect(b.deps.setDifficulty).toHaveBeenCalledWith('ice-cream', 3);
