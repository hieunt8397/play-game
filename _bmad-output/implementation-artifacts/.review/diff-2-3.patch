+import { readFileSync } from 'node:fs';
+import { describe, expect, it, vi } from 'vitest';
+import { installDevHooks, type BhcDev } from './dev-hooks';
+
+describe('installDevHooks (Story 2.3)', () => {
+  it('flyInTouchTalk emits reward:earned for touch-talk, then restarts Map', () => {
+    const order: string[] = [];
+    const bus = { emit: vi.fn((ev: string, payload: unknown) => order.push(`${ev} ${JSON.stringify(payload)}`)) };
+    const game = { scene: { start: vi.fn((key: string) => order.push(`start ${key}`)) } };
+    const target: { bhcDev?: BhcDev } = {};
+    const hooks = installDevHooks(game, target, bus as never);
+    expect(target.bhcDev).toBe(hooks);
+    hooks.flyInTouchTalk();
+    expect(order).toEqual(['reward:earned {"gameId":"touch-talk"}', 'start Map']);
+  });
+
+  it('main.ts loads it only behind import.meta.env.DEV, through a dynamic import', () => {
+    const main = readFileSync(new URL('../main.ts', import.meta.url), 'utf8');
+    expect(main).not.toMatch(/^import .*dev-hooks/m);
+    expect(main).toMatch(/if \(import\.meta\.env\.DEV\) \{\s*void import\('\.\/core\/dev-hooks'\)/);
+  });
+});
