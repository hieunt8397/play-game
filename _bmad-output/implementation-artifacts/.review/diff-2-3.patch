diff --git a/app/src/core/fly-in.test.ts b/app/src/core/fly-in.test.ts
new file mode 100644
index 0000000..dde77e1
--- /dev/null
+++ b/app/src/core/fly-in.test.ts
@@ -0,0 +1,178 @@
+import { describe, expect, it } from 'vitest';
+import { arcPoint, easeOut, flyInPlan, itemAt, oldAt, planEndMs, sparkleAt, type FlyInPlan } from './fly-in';
+import { Tokens } from './tokens';
+
+const T = Tokens.Timing;
+const ui = Tokens.ui;
+const from = { x: 300, y: 400 };
+const to = { x: 500, y: 420 };
+const FLIGHT = T.decorationFlyInMs - T.flyInLandMs;
+
+const variants: Array<[string, FlyInPlan]> = [
+  ['normal', flyInPlan({ from, to, hasOld: false, reduced: false })],
+  ['normal + replace', flyInPlan({ from, to, hasOld: true, reduced: false })],
+  ['reduced', flyInPlan({ from, to, hasOld: false, reduced: true })],
+  ['reduced + replace', flyInPlan({ from, to, hasOld: true, reduced: true })],
+];
+
+/** Samples t = 0..totalMs every `step` ms (both ends included). */
+function samples(totalMs: number, step = 10): number[] {
+  const out: number[] = [];
+  for (let t = 0; t <= totalMs; t += step) out.push(t);
+  return out;
+}
+
+describe('flyInPlan › totals', () => {
+  it.each(variants)('%s: every timeline ends at or before decorationFlyInMs', (_name, plan) => {
+    expect(plan.totalMs).toBe(T.decorationFlyInMs);
+    expect(planEndMs(plan)).toBeLessThanOrEqual(T.decorationFlyInMs);
+    expect(plan.landMs).toBeLessThanOrEqual(T.decorationFlyInMs);
+  });
+
+  it.each(variants)('%s: at the end the item is at its slot, full size and opaque', (_name, plan) => {
+    expect(itemAt(plan.item, plan.totalMs)).toEqual({ x: to.x, y: to.y, scale: 1, alpha: 1, landed: true });
+    if (plan.old) expect(oldAt(plan.old, plan.totalMs)).toMatchObject({ alpha: 0, gone: true });
+  });
+});
+
+describe('flyInPlan › normal flight', () => {
+  const plan = flyInPlan({ from, to, hasOld: false, reduced: false });
+
+  it('starts at the station at flyInStartScale, above the sprites (not landed)', () => {
+    expect(itemAt(plan.item, 0)).toEqual({ x: from.x, y: from.y, scale: ui.flyInStartScale, alpha: 1, landed: false });
+    expect(plan.landMs).toBe(FLIGHT);
+    expect(plan.old).toBeUndefined();
+  });
+
+  it('the arc peaks flyInArcPx above the straight line', () => {
+    if (plan.item.kind !== 'fly') throw new Error('fly track expected');
+    const { control } = plan.item;
+    let maxAbove = 0;
+    for (let i = 0; i <= 1000; i++) {
+      const u = i / 1000;
+      const p = arcPoint(from, control, to, u);
+      const lineY = from.y + (to.y - from.y) * u;
+      maxAbove = Math.max(maxAbove, lineY - p.y);
+    }
+    expect(maxAbove).toBeCloseTo(ui.flyInArcPx, 6);
+    const mid = arcPoint(from, control, to, 0.5);
+    expect(mid.x).toBeCloseTo((from.x + to.x) / 2, 9);
+    expect((from.y + to.y) / 2 - mid.y).toBeCloseTo(ui.flyInArcPx, 9);
+  });
+
+  it('ease-out: more than half the way at half the flight; the scale grows monotonically to 1', () => {
+    expect(easeOut(0.5)).toBeGreaterThan(0.5);
+    let last = 0;
+    for (const t of samples(FLIGHT)) {
+      const s = itemAt(plan.item, t).scale;
+      expect(s).toBeGreaterThanOrEqual(last);
+      last = s;
+    }
+    expect(itemAt(plan.item, FLIGHT).scale).toBe(1);
+  });
+
+  it('lands with a 1 → flyInLandScale → 1 bounce over flyInLandMs, at the slot depth', () => {
+    const mid = itemAt(plan.item, FLIGHT + T.flyInLandMs / 2);
+    expect(mid.scale).toBeCloseTo(ui.flyInLandScale, 9);
+    expect(mid).toMatchObject({ x: to.x, y: to.y, landed: true });
+    for (const t of samples(T.decorationFlyInMs).filter((t) => t >= FLIGHT)) {
+      const s = itemAt(plan.item, t).scale;
+      expect(s).toBeGreaterThanOrEqual(1);
+      expect(s).toBeLessThanOrEqual(ui.flyInLandScale + 1e-9);
+    }
+    expect(itemAt(plan.item, FLIGHT - 1).landed).toBe(false);
+  });
+});
+
+describe('flyInPlan › balloon (replace)', () => {
+  const plan = flyInPlan({ from, to, hasOld: true, reduced: false });
+
+  it('rises balloonRisePx while fading out from t = 0 over balloonOutMs', () => {
+    const old = plan.old!;
+    expect(old).toEqual({ kind: 'balloon', risePx: ui.balloonRisePx, startMs: 0, endMs: T.balloonOutMs });
+    expect(oldAt(old, 0)).toEqual({ rise: 0, alpha: 1, gone: false });
+    expect(oldAt(old, T.balloonOutMs / 2)).toMatchObject({ rise: ui.balloonRisePx / 2, alpha: 0.5, gone: false });
+    expect(oldAt(old, T.balloonOutMs)).toEqual({ rise: ui.balloonRisePx, alpha: 0, gone: true });
+  });
+
+  it('overlaps the flight and has left the slot before the new item lands', () => {
+    const old = plan.old!;
+    expect(old.startMs).toBeLessThan(FLIGHT);
+    expect(old.endMs).toBeLessThan(plan.landMs);
+    let last = 1;
+    for (const t of samples(T.decorationFlyInMs)) {
+      const a = oldAt(old, t).alpha;
+      expect(a).toBeLessThanOrEqual(last);
+      last = a;
+    }
+  });
+});
+
+describe('flyInPlan › sparkles', () => {
+  const plan = flyInPlan({ from, to, hasOld: false, reduced: false });
+
+  it('sparkleCount stars at evenly spaced fixed angles around the slot, from flight/2 to the end', () => {
+    expect(plan.sparkles).toHaveLength(ui.sparkleCount);
+    const step = (2 * Math.PI) / ui.sparkleCount;
+    plan.sparkles.forEach((s, i) => {
+      expect(s.angle - plan.sparkles[0]!.angle).toBeCloseTo(i * step, 9);
+      expect(s.from).toEqual(to);
+      expect(Math.hypot(s.to.x - to.x, s.to.y - to.y)).toBeCloseTo(ui.sparkleSpreadPx, 9);
+      expect(s.startMs).toBe(FLIGHT / 2);
+      expect(s.endMs).toBeLessThanOrEqual(T.decorationFlyInMs);
+      expect(s.radius).toBe(ui.sparkleRadiusPx);
+    });
+  });
+
+  it('alpha never rises (no blink): invisible, then 1 → 0, then gone', () => {
+    for (const s of plan.sparkles) {
+      expect(sparkleAt(s, s.startMs - 1).visible).toBe(false);
+      expect(sparkleAt(s, s.startMs)).toMatchObject({ alpha: 1, visible: true });
+      let last = 1;
+      for (const t of samples(T.decorationFlyInMs, 5).filter((t) => t >= s.startMs)) {
+        const st = sparkleAt(s, t);
+        const a = st.visible ? st.alpha : 0;
+        expect(a).toBeLessThanOrEqual(last);
+        last = a;
+      }
+      expect(sparkleAt(s, T.decorationFlyInMs).visible).toBe(false);
+    }
+  });
+
+  it('each sparkle drifts outward only', () => {
+    for (const s of plan.sparkles) {
+      let last = -1;
+      for (const t of samples(s.endMs - 1, 5).filter((t) => t >= s.startMs)) {
+        const p = sparkleAt(s, t);
+        const d = Math.hypot(p.x - to.x, p.y - to.y);
+        expect(d).toBeGreaterThanOrEqual(last);
+        last = d;
+      }
+    }
+  });
+});
+
+describe('flyInPlan › reduced motion', () => {
+  it('with an old item: old fades out over [0, 500], new fades in over [500, 1000], in place, no sparkles', () => {
+    const plan = flyInPlan({ from, to, hasOld: true, reduced: true });
+    const half = T.decorationFlyInMs / 2;
+    expect(plan.sparkles).toEqual([]);
+    expect(plan.old).toEqual({ kind: 'fade', startMs: 0, endMs: half });
+    expect(plan.item).toEqual({ kind: 'fade', at: to, startMs: half, endMs: T.decorationFlyInMs });
+    expect(oldAt(plan.old!, half / 2)).toEqual({ rise: 0, alpha: 0.5, gone: false });
+    expect(itemAt(plan.item, half).alpha).toBe(0);
+    expect(itemAt(plan.item, half + half / 2)).toEqual({ x: to.x, y: to.y, scale: 1, alpha: 0.5, landed: true });
+    for (const t of samples(T.decorationFlyInMs)) {
+      const s = itemAt(plan.item, t);
+      expect([s.x, s.y, s.scale]).toEqual([to.x, to.y, 1]);
+    }
+  });
+
+  it('without an old item: the new one fades in over the whole fly-in', () => {
+    const plan = flyInPlan({ from, to, hasOld: false, reduced: true });
+    expect(plan.old).toBeUndefined();
+    expect(plan.item).toEqual({ kind: 'fade', at: to, startMs: 0, endMs: T.decorationFlyInMs });
+    expect(plan.landMs).toBe(0);
+    expect(itemAt(plan.item, T.decorationFlyInMs / 2).alpha).toBe(0.5);
+  });
+});
