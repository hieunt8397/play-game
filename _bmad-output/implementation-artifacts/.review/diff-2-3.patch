+// Map's post-round chain (Story 2.3, AD-1), pure: every effect is injected, so Vitest checks the order,
+// the stagger and the queued tap without Phaser. One awaited sequence per return to the island:
+//   1. `complete` only: deps.setDifficulty(gameId, nextLevel(startedLevel, outcome, ladderLength));
+//   2. `complete` only: deps.clearResume(gameId);
+//   3. await deps.stopGameAndWake() (resolves on Map's `wake`; at once when no game runs);
+//      — steps 1–3 start synchronously inside `start`, before its first await —
+//   4. await deps.pullBack(gameId) (the camera; the kart stays parked at the station);
+//   5. fly-ins: a copy of deps.pending(); item i starts after i × Timing.flyInStaggerMs (deps.wait) and
+//      plays through deps.flyIn; once it resolves, that same object leaves the live pending list.
+//      Entries added meanwhile stay pending for the next return. All items are awaited. Only the
+//      newest (highest-seq) entry per slotId plays; older ones for that slot are dropped unplayed;
+//   6. deps.end({ kind, gameId, queuedStation }).
+// `active` is true from `start` until `end`; a second `start` meanwhile warns and is ignored. Station
+// taps during the chain are queued (`queueTap`, the last one wins) and handed to `end`. deps.wait and
+// every animation run on the scene clock and tweens (never setTimeout), so a paused scene freezes the
+// chain mid-step. In a dev build `log` prints `post-round: <kind> <gameId> → onChainEnd <ms> ms`.
+import type { GameId, GrantResult, RoundOutcome } from '../content/types';
+import { nextLevel } from './difficulty';
+import { Tokens } from './tokens';
+
+export type ChainKind = 'complete' | 'abandon';
+
+export interface ChainStart {
+  readonly kind: ChainKind;
+  readonly gameId: GameId;
+  /** `complete` only: the outcome and the level the round started at. */
+  readonly outcome?: RoundOutcome;
+  readonly startedLevel?: number;
+}
+
+/** What Map's `onChainEnd` hook receives (Story 2.4 opens its overlay from it). */
+export interface ChainEnd {
+  readonly kind: ChainKind;
+  readonly gameId: GameId;
+}
+
+/** What the runner hands to deps.end: the hook payload plus the last station tapped mid-chain. */
+export interface ChainFinish extends ChainEnd {
+  readonly queuedStation: string | undefined;
+}
+
+export interface ChainDeps {
+  setDifficulty(gameId: GameId, level: number): void;
+  clearResume(gameId: GameId): void;
+  /** The game's ladder length (undefined: unknown game, no difficulty write). */
+  ladderLength(gameId: GameId): number | undefined;
+  stopGameAndWake(): Promise<void>;
+  pullBack(focus: GameId): Promise<void>;
+  flyIn(entry: GrantResult): Promise<void>;
+  /** Resolves after `ms` on the scene clock. */
+  wait(ms: number): Promise<void>;
+  /** The live SessionStore.pendingFlyIns array. */
+  pending(): GrantResult[];
+  end(e: ChainFinish): void;
+  now(): number;
+  /** Dev builds: the timing log line (omit in production). */
+  log?: ((line: string) => void) | undefined;
+  /** Default console.warn. */
+  warn?: (msg: string, ...rest: unknown[]) => void;
+  /** Default Timing.flyInStaggerMs. */
+  staggerMs?: number;
+}
+
+/**
+ * Splits pending grants into the ones to play (the newest, highest-seq entry per slotId, in pending
+ * order) and the superseded older ones for the same slot, which are dropped without animation.
+ */
+export function newestPerSlot(pending: readonly GrantResult[]): { play: GrantResult[]; superseded: GrantResult[] } {
+  const newest = new Map<string, GrantResult>();
+  for (const e of pending) {
+    const kept = newest.get(e.slot.slotId);
+    if (!kept || e.slot.seq > kept.slot.seq) newest.set(e.slot.slotId, e);
+  }
+  const keep = new Set(newest.values());
+  return { play: pending.filter((e) => keep.has(e)), superseded: pending.filter((e) => !keep.has(e)) };
+}
+
+/** The game Map started from a station and that has not ended yet. */
+export interface RunningGame {
+  readonly id: GameId;
+  readonly level: number;
+}
+
+/** What Map does with a terminal event of a game. */
+export type TerminalRoute =
+  | { readonly action: 'ignore' }
+  | { readonly action: 'chain'; readonly start: ChainStart }
+  | { readonly action: 'fade'; readonly gameId: GameId };
+
+/** `round:complete`: only the running game's event starts a `complete` chain, with its outcome and started level. */
+export function routeRoundComplete(running: RunningGame | undefined, outcome: RoundOutcome): TerminalRoute {
+  if (!running || outcome.gameId !== running.id) return { action: 'ignore' };
+  return { action: 'chain', start: { kind: 'complete', gameId: running.id, outcome, startedLevel: running.level } };
+}
+
+/**
+ * `round:abandon` of the running game: pending fly-ins (and no chain running) → an `abandon` chain;
+ * otherwise the Story 1.7 fade return. Another game's event (or none running) is ignored.
+ */
+export function routeRoundAbandon(running: RunningGame | undefined, gameId: GameId, pendingCount: number, chainActive: boolean): TerminalRoute {
+  if (!running || gameId !== running.id) return { action: 'ignore' };
+  if (pendingCount > 0 && !chainActive) return { action: 'chain', start: { kind: 'abandon', gameId } };
+  return { action: 'fade', gameId };
+}
+
+export class PostRoundChain {
+  private activeFlag = false;
+  private queued: string | undefined;
+  private readonly deps: ChainDeps;
+
+  constructor(deps: ChainDeps) {
+    this.deps = deps;
+  }
+
+  get active(): boolean {
+    return this.activeFlag;
+  }
+
+  /** The station tapped last while the chain runs (applied at its end). */
+  get queuedStation(): string | undefined {
+    return this.queued;
+  }
+
+  /** A station tap during the chain: remembered, any earlier queued tap is dropped. */
+  queueTap(id: string): void {
+    if (this.activeFlag) this.queued = id;
+  }
+
+  start(req: ChainStart): Promise<void> {
+    const warn = this.deps.warn ?? ((msg: string, ...rest: unknown[]) => console.warn(msg, ...rest));
+    if (this.activeFlag) {
+      warn(`post-round: a ${req.kind} chain for "${req.gameId}" was ignored — a chain is already running`);
+      return Promise.resolve();
+    }
+    this.activeFlag = true;
+    this.queued = undefined;
+    const t0 = this.deps.now();
+    if (req.kind === 'complete') {
+      const len = this.deps.ladderLength(req.gameId);
+      if (req.outcome && req.startedLevel !== undefined && len !== undefined) {
+        this.deps.setDifficulty(req.gameId, nextLevel(req.startedLevel, req.outcome, len));
+      } else {
+        warn(
+          `post-round: complete "${req.gameId}" without ${!req.outcome ? 'an outcome' : req.startedLevel === undefined ? 'a started level' : 'a known ladder'} — difficulty unchanged`,
+        );
+      }
+      this.deps.clearResume(req.gameId);
+    }
+    return this.run(req, t0, warn);
+  }
+
+  private async run(req: ChainStart, t0: number, warn: (msg: string, ...rest: unknown[]) => void): Promise<void> {
+    const deps = this.deps;
+    try {
+      // Called synchronously (before the first await) by `start`.
+      await deps.stopGameAndWake();
+      await deps.pullBack(req.gameId);
+      const { play, superseded } = newestPerSlot(deps.pending());
+      // An older grant for a slot that a newer pending grant replaces is never shown: drop it unplayed.
+      for (const entry of superseded) {
+        const live = deps.pending();
+        const at = live.indexOf(entry);
+        if (at >= 0) live.splice(at, 1);
+      }
+      const items = play;
+      const stagger = deps.staggerMs ?? Tokens.Timing.flyInStaggerMs;
+      await Promise.all(
+        items.map(async (entry, i) => {
+          if (i > 0) await deps.wait(i * stagger);
+          try {
+            await deps.flyIn(entry);
+          } catch (err) {
+            warn(`post-round: the fly-in of "${entry.slot.decorationId}" failed`, err);
+          }
+          const live = deps.pending();
+          const at = live.indexOf(entry);
+          if (at >= 0) live.splice(at, 1);
+        }),
+      );
+    } catch (err) {
+      warn('post-round: the chain failed', err);
+    } finally {
+      const queuedStation = this.queued;
+      this.activeFlag = false;
+      this.queued = undefined;
+      deps.log?.(`post-round: ${req.kind} ${req.gameId} → onChainEnd ${Math.round(deps.now() - t0)} ms`);
+      deps.end({ kind: req.kind, gameId: req.gameId, queuedStation });
+    }
+  }
+}
