+++ b/app/src/core/fly-in.ts
@@ -0,0 +1,201 @@
+// Decoration fly-in plan (Story 2.3), pure. Every value comes from Tokens / Timing; the Phaser player
+// (core/ui/decoration-fly.ts) drives one scene tween over `totalMs` and samples the tracks below, so a
+// paused scene freezes the whole fly-in where it is.
+//   Normal motion (flight = decorationFlyInMs − flyInLandMs):
+//   - new item: from its station anchor at ui.flyInStartScale, above every sprite, along a quadratic
+//     arc that peaks ui.flyInArcPx above the straight line to its slot (ease-out), growing to 1 over
+//     the flight; then a 1 → ui.flyInLandScale → 1 bounce over flyInLandMs, at the slot depth;
+//   - old item (a replacement): from t = 0 it rises ui.balloonRisePx while its alpha goes 1 → 0 over
+//     balloonOutMs, so it has left the slot before the new one lands;
+//   - sparkles: ui.sparkleCount stars at fixed, evenly spaced angles around the slot, from flight/2;
+//     each drifts out ui.sparkleSpreadPx while its alpha falls 1 → 0 (never blinks), gone by the end.
+//   Reduced motion: nothing moves and there are no sparkles. With an old item it fades out over
+//   [0, ½] and the new one fades in over [½, 1] × decorationFlyInMs, both in place; without one the new
+//   item fades in over the whole fly-in.
+// Every timeline ends at or before Timing.decorationFlyInMs.
+import type { Point } from '../content/layout-types';
+import { Tokens } from './tokens';
+
+export interface FlyInInput {
+  /** The station anchor the item leaves from. */
+  readonly from: Point;
+  /** The slot's draw position (core/decoration-plan). */
+  readonly to: Point;
+  /** Whether an old item stands at the slot (a replacement). */
+  readonly hasOld: boolean;
+  readonly reduced: boolean;
+}
+
+export type ItemTrack =
+  | {
+      readonly kind: 'fly';
+      readonly from: Point;
+      /** Quadratic Bézier control point: the arc peaks `arcPx` above the chord's midpoint. */
+      readonly control: Point;
+      readonly to: Point;
+      readonly startScale: number;
+      readonly flightMs: number;
+      readonly landScale: number;
+      readonly landStartMs: number;
+      readonly landEndMs: number;
+    }
+  | { readonly kind: 'fade'; readonly at: Point; readonly startMs: number; readonly endMs: number };
+
+export type OldTrack =
+  | { readonly kind: 'balloon'; readonly risePx: number; readonly startMs: number; readonly endMs: number }
+  | { readonly kind: 'fade'; readonly startMs: number; readonly endMs: number };
+
+export interface SparkleTrack {
+  /** Fixed angle (radians) around the slot. */
+  readonly angle: number;
+  readonly from: Point;
+  readonly to: Point;
+  readonly startMs: number;
+  readonly endMs: number;
+  /** Outer star radius (design px). */
+  readonly radius: number;
+}
+
+export interface FlyInPlan {
+  readonly totalMs: number;
+  /** When the item is "in": touchdown (normal) or the start of its fade-in (reduced). The land sound. */
+  readonly landMs: number;
+  readonly item: ItemTrack;
+  readonly old: OldTrack | undefined;
+  readonly sparkles: readonly SparkleTrack[];
+}
+
+export interface ItemState {
+  readonly x: number;
+  readonly y: number;
+  /** Relative to the item's base scale. */
+  readonly scale: number;
+  readonly alpha: number;
+  /** True once the item sits at its slot (depth: the slot's). */
+  readonly landed: boolean;
+}
+
+export interface OldState {
+  /** Upward offset from the slot (design px). */
+  readonly rise: number;
+  readonly alpha: number;
+  readonly gone: boolean;
+}
+
+export interface SparkleState {
+  readonly x: number;
+  readonly y: number;
+  readonly alpha: number;
+  readonly visible: boolean;
+}
+
+const clamp01 = (v: number): number => (v <= 0 ? 0 : v >= 1 ? 1 : v);
+const lerp = (a: number, b: number, u: number): number => a + (b - a) * u;
+const progress = (t: number, startMs: number, endMs: number): number => (endMs > startMs ? clamp01((t - startMs) / (endMs - startMs)) : t >= endMs ? 1 : 0);
+const FULL_TURN = 2 * Math.PI;
+/** Sparkle 0 sits straight above the slot. */
+const FIRST_SPARKLE_ANGLE = -Math.PI / 2;
+
+/** Cubic ease-out on [0, 1]. */
+export function easeOut(u: number): number {
+  const v = 1 - clamp01(u);
+  return 1 - v * v * v;
+}
+
+/** Point at parameter `u` (0..1) of the quadratic Bézier from → control → to. */
+export function arcPoint(from: Point, control: Point, to: Point, u: number): Point {
+  const a = (1 - u) * (1 - u);
+  const b = 2 * u * (1 - u);
+  const c = u * u;
+  return { x: a * from.x + b * control.x + c * to.x, y: a * from.y + b * control.y + c * to.y };
+}
+
+export function flyInPlan(input: FlyInInput): FlyInPlan {
+  const T = Tokens.Timing;
+  const ui = Tokens.ui;
+  const total = T.decorationFlyInMs;
+  const { from, to, hasOld } = input;
+
+  if (input.reduced) {
+    const half = total / 2;
+    return {
+      totalMs: total,
+      landMs: hasOld ? half : 0,
+      item: { kind: 'fade', at: to, startMs: hasOld ? half : 0, endMs: total },
+      old: hasOld ? { kind: 'fade', startMs: 0, endMs: half } : undefined,
+      sparkles: [],
+    };
+  }
+
+  const flight = total - T.flyInLandMs;
+  // B(½) − chord midpoint = ½ (control − midpoint): the control sits 2 × arcPx above the midpoint.
+  const control = { x: (from.x + to.x) / 2, y: (from.y + to.y) / 2 - 2 * ui.flyInArcPx };
+  const sparkles: SparkleTrack[] = [];
+  for (let i = 0; i < ui.sparkleCount; i++) {
+    const angle = FIRST_SPARKLE_ANGLE + (i * FULL_TURN) / ui.sparkleCount;
+    sparkles.push({
+      angle,
+      from: { x: to.x, y: to.y },
+      to: { x: to.x + Math.cos(angle) * ui.sparkleSpreadPx, y: to.y + Math.sin(angle) * ui.sparkleSpreadPx },
+      startMs: flight / 2,
+      endMs: total,
+      radius: ui.sparkleRadiusPx,
+    });
+  }
+  return {
+    totalMs: total,
+    landMs: flight,
+    item: {
+      kind: 'fly',
+      from,
+      control,
+      to,
+      startScale: ui.flyInStartScale,
+      flightMs: flight,
+      landScale: ui.flyInLandScale,
+      landStartMs: flight,
+      landEndMs: total,
+    },
+    old: hasOld ? { kind: 'balloon', risePx: ui.balloonRisePx, startMs: 0, endMs: Math.min(T.balloonOutMs, flight) } : undefined,
+    sparkles,
+  };
+}
+
+/** The new item at time `t` (ms since the fly-in started). */
+export function itemAt(track: ItemTrack, t: number): ItemState {
+  if (track.kind === 'fade') {
+    return { x: track.at.x, y: track.at.y, scale: 1, alpha: progress(t, track.startMs, track.endMs), landed: true };
+  }
+  if (t < track.flightMs) {
+    const u = easeOut(progress(t, 0, track.flightMs));
+    const p = arcPoint(track.from, track.control, track.to, u);
+    return { x: p.x, y: p.y, scale: lerp(track.startScale, 1, u), alpha: 1, landed: false };
+  }
+  const v = progress(t, track.landStartMs, track.landEndMs);
+  // 1 → landScale → 1 (a half sine: smooth, one bounce).
+  const scale = v >= 1 ? 1 : 1 + (track.landScale - 1) * Math.sin(Math.PI * v);
+  return { x: track.to.x, y: track.to.y, scale, alpha: 1, landed: true };
+}
+
+/** The old item at time `t`. */
+export function oldAt(track: OldTrack, t: number): OldState {
+  const v = progress(t, track.startMs, track.endMs);
+  return { rise: track.kind === 'balloon' ? track.risePx * v : 0, alpha: 1 - v, gone: v >= 1 };
+}
+
+/** One sparkle at time `t`: invisible before its start and from its end on; alpha only falls. */
+export function sparkleAt(s: SparkleTrack, t: number): SparkleState {
+  if (t < s.startMs || t >= s.endMs) {
+    return { x: s.from.x, y: s.from.y, alpha: 0, visible: false };
+  }
+  const v = progress(t, s.startMs, s.endMs);
+  const u = easeOut(v);
+  return { x: lerp(s.from.x, s.to.x, u), y: lerp(s.from.y, s.to.y, u), alpha: 1 - v, visible: true };
+}
+
+/** The last end time of every track (≤ decorationFlyInMs; tested). */
+export function planEndMs(plan: FlyInPlan): number {
+  const ends = [plan.item.kind === 'fly' ? plan.item.landEndMs : plan.item.endMs, ...plan.sparkles.map((s) => s.endMs)];
+  if (plan.old) ends.push(plan.old.endMs);
+  return Math.max(...ends);
+}
