@@ -0,0 +1,98 @@
+// Decoration fly-in player (Story 2.3): plays a pure core/fly-in plan with one scene tween (a counter
+// over `plan.totalMs`) that samples every track each frame. Scene tweens stop while the scene is
+// paused (AudioUnlockOverlay), so the flight freezes and continues where it stopped. Sparkles are small
+// Graphics stars in `components.decorationItem.sparkle` that only fade (never blink). The old item
+// (a replacement) is destroyed once its balloon / fade-out ends; the new item is left at its slot, at
+// the slot depth and base scale, for the caller to hand to Map's decoration registry.
+import type { GameObjects, Scene } from 'phaser';
+import { itemAt, oldAt, sparkleAt, type FlyInPlan } from '../fly-in';
+import { Tokens } from '../tokens';
+
+export interface FlySprites {
+  /** The new item, already placed at its slot with its frame origin. */
+  readonly item: GameObjects.Image;
+  /** The item's static scale (1 / renderScale); the plan's scales are relative to it. */
+  readonly baseScale: number;
+  /** The item standing at the slot now (replaced), if any. Destroyed by the player. */
+  readonly old?: GameObjects.Image | undefined;
+  /** Depth while flying (above every sprite) and once landed (the slot's). */
+  readonly flyDepth: number;
+  readonly slotDepth: number;
+  /** Runs once when the item lands (plan.landMs): the happy sound. */
+  readonly onLand?: () => void;
+}
+
+/** Inner radius of a sparkle star relative to its outer radius. */
+const STAR_INNER_RATIO = 0.45;
+const STAR_POINTS = 5;
+
+function drawStar(g: GameObjects.Graphics, radius: number): void {
+  const colour = Tokens.components.decorationItem.sparkle;
+  const pts: { x: number; y: number }[] = [];
+  for (let i = 0; i < STAR_POINTS * 2; i++) {
+    const r = i % 2 === 0 ? radius : radius * STAR_INNER_RATIO;
+    const a = -Math.PI / 2 + (i * Math.PI) / STAR_POINTS;
+    pts.push({ x: Math.cos(a) * r, y: Math.sin(a) * r });
+  }
+  g.fillStyle(colour.value, colour.alpha);
+  // Phaser reads only x and y of each point.
+  g.fillPoints(pts as unknown as Parameters<GameObjects.Graphics['fillPoints']>[0], true);
+}
+
+/** Plays `plan` on `sprites`; resolves when every track has ended. */
+export function playFlyIn(scene: Scene, plan: FlyInPlan, sprites: FlySprites): Promise<void> {
+  const { item, old } = sprites;
+  const oldY = old?.y ?? 0;
+  let oldLeft = old;
+  let landed = false;
+  const stars = plan.sparkles.map((s) => {
+    const g = scene.add.graphics();
+    drawStar(g, s.radius);
+    g.setDepth(sprites.flyDepth).setVisible(false);
+    return g;
+  });
+
+  const apply = (t: number): void => {
+    const st = itemAt(plan.item, t);
+    item
+      .setPosition(st.x, st.y)
+      .setScale(sprites.baseScale * st.scale)
+      .setAlpha(st.alpha)
+      .setDepth(st.landed ? sprites.slotDepth : sprites.flyDepth);
+    if (!landed && t >= plan.landMs) {
+      landed = true;
+      sprites.onLand?.();
+    }
+    if (oldLeft) {
+      const o = plan.old ? oldAt(plan.old, t) : { rise: 0, alpha: 0, gone: true };
+      if (o.gone) {
+        oldLeft.destroy();
+        oldLeft = undefined;
+      } else {
+        oldLeft.setY(oldY - o.rise).setAlpha(o.alpha);
+      }
+    }
+    plan.sparkles.forEach((s, i) => {
+      const sp = sparkleAt(s, t);
+      stars[i]!.setVisible(sp.visible).setPosition(sp.x, sp.y).setAlpha(sp.alpha);
+    });
+  };
+
+  apply(0);
+  return new Promise((resolve) => {
+    scene.tweens.addCounter({
+      from: 0,
+      to: plan.totalMs,
+      duration: plan.totalMs,
+      onUpdate: (tween) => apply(tween.getValue() ?? 0),
+      onComplete: () => {
+        apply(plan.totalMs);
+        oldLeft?.destroy();
+        oldLeft = undefined;
+        for (const g of stars) g.destroy();
+        item.setScale(sprites.baseScale).setAlpha(1).setDepth(sprites.slotDepth);
+        resolve();
+      },
+    });
+  });
+}
