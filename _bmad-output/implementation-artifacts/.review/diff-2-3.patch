@@ -0,0 +1,36 @@
+// Dev-only console hooks (Story 2.3). main.ts imports this module dynamically only when
+// `import.meta.env.DEV`, so it never reaches a production bundle.
+//   window.bhcDev.flyInTouchTalk(): emits `reward:earned { gameId: 'touch-talk' }` (core/reward-service
+//   grants and queues the fly-in, as Chạm là nói will in Epic 4), then restarts Map, which exercises
+//   the `create` + abandon path of the post-round chain: pull-back on the fire station and a fly-in to
+//   `touch-talk-1`. No difficulty is written and no overlay path but the default `onChainEnd` runs.
+import { bus as appBus, type Bus } from './bus';
+
+/** The slice of Phaser.Game the hooks use. */
+export interface DevGameLike {
+  readonly scene: { start(key: string): unknown };
+}
+
+export interface BhcDev {
+  flyInTouchTalk(): void;
+}
+
+declare global {
+  interface Window {
+    bhcDev?: BhcDev;
+  }
+}
+
+const MAP_KEY = 'Map';
+
+export function installDevHooks(game: DevGameLike, target: { bhcDev?: BhcDev } = window, bus: Pick<Bus, 'emit'> = appBus): BhcDev {
+  const hooks: BhcDev = {
+    flyInTouchTalk() {
+      bus.emit('reward:earned', { gameId: 'touch-talk' });
+      // SceneManager.start restarts a running Map (shutdown, then create).
+      game.scene.start(MAP_KEY);
+    },
+  };
+  target.bhcDev = hooks;
+  return hooks;
+}
