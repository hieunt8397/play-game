@@ -0,0 +1,147 @@
+// Story 2.3: playFlyIn drives one counter tween and samples the core/fly-in plan.
+import { describe, expect, it, vi } from 'vitest';
+import type { GameObjects, Scene } from 'phaser';
+import { flyInPlan } from '../fly-in';
+import { Tokens } from '../tokens';
+import { playFlyIn } from './decoration-fly';
+
+type Fake = Record<string, unknown> & { destroyed: boolean };
+
+function fakeImage(x: number, y: number): Fake {
+  const img: Fake = { x, y, scale: 1, alpha: 1, depth: 0, destroyed: false };
+  img.setPosition = (nx: number, ny: number) => ((img.x = nx), (img.y = ny), img);
+  img.setY = (ny: number) => ((img.y = ny), img);
+  img.setScale = (s: number) => ((img.scale = s), img);
+  img.setAlpha = (a: number) => ((img.alpha = a), img);
+  img.setDepth = (d: number) => ((img.depth = d), img);
+  img.destroy = () => void (img.destroyed = true);
+  return img;
+}
+
+function fakePhaser() {
+  const graphics: Fake[] = [];
+  let counter: { onUpdate: (t: { getValue(): number }) => void; onComplete: () => void; duration: number } | undefined;
+  const scene = {
+    add: {
+      graphics: vi.fn(() => {
+        const g = fakeImage(0, 0);
+        g.visible = true;
+        g.fillStyle = vi.fn(() => g);
+        g.fillPoints = vi.fn(() => g);
+        g.setVisible = (v: boolean) => ((g.visible = v), g);
+        graphics.push(g);
+        return g;
+      }),
+    },
+    tweens: {
+      addCounter: vi.fn((cfg: typeof counter) => {
+        counter = cfg;
+        return {};
+      }),
+    },
+  };
+  return {
+    scene: scene as unknown as Scene,
+    graphics,
+    /** One frame at tween time `t` (ms). */
+    step: (t: number) => counter!.onUpdate({ getValue: () => t }),
+    complete: () => counter!.onComplete(),
+    duration: () => counter!.duration,
+  };
+}
+
+const from = { x: 100, y: 300 };
+const to = { x: 400, y: 320 };
+const BASE = 0.5;
+const FLY_DEPTH = 900;
+const SLOT_DEPTH = 320;
+
+describe('playFlyIn', () => {
+  it('normal replace: steps the counter, lands once, destroys the old image and the sparkles, ends at base scale / alpha 1 / slot depth', async () => {
+    const f = fakePhaser();
+    const item = fakeImage(to.x, to.y);
+    const old = fakeImage(to.x, to.y);
+    const onLand = vi.fn();
+    const plan = flyInPlan({ from, to, hasOld: true, reduced: false });
+    const done = vi.fn();
+    const p = playFlyIn(f.scene, plan, {
+      item: item as unknown as GameObjects.Image,
+      old: old as unknown as GameObjects.Image,
+      baseScale: BASE,
+      flyDepth: FLY_DEPTH,
+      slotDepth: SLOT_DEPTH,
+      onLand,
+    }).then(done);
+    expect(f.duration()).toBe(Tokens.Timing.decorationFlyInMs);
+    expect(f.graphics).toHaveLength(Tokens.ui.sparkleCount);
+    // t = 0: at the station, small, above every sprite.
+    expect(item).toMatchObject({ x: from.x, y: from.y, scale: BASE * Tokens.ui.flyInStartScale, depth: FLY_DEPTH });
+    expect(f.graphics.every((g) => g.visible === false)).toBe(true);
+
+    f.step(Tokens.Timing.balloonOutMs / 2);
+    expect(old.destroyed).toBe(false);
+    expect(old.y as number).toBeLessThan(to.y);
+    expect(old.alpha as number).toBeCloseTo(0.5, 9);
+    f.step(Tokens.Timing.balloonOutMs);
+    expect(old.destroyed).toBe(true);
+    expect(onLand).not.toHaveBeenCalled();
+
+    const land = plan.landMs;
+    f.step(land - 1);
+    expect(onLand).not.toHaveBeenCalled();
+    expect(item.depth).toBe(FLY_DEPTH);
+    expect(f.graphics.every((g) => g.visible === true)).toBe(true);
+    f.step(land);
+    f.step(land + 50);
+    f.step(plan.totalMs - 1);
+    expect(onLand).toHaveBeenCalledTimes(1);
+    expect(item.depth).toBe(SLOT_DEPTH);
+
+    expect(done).not.toHaveBeenCalled();
+    f.complete();
+    await p;
+    expect(done).toHaveBeenCalled();
+    expect(onLand).toHaveBeenCalledTimes(1);
+    expect(f.graphics.every((g) => g.destroyed)).toBe(true);
+    expect(item).toMatchObject({ x: to.x, y: to.y, scale: BASE, alpha: 1, depth: SLOT_DEPTH, destroyed: false });
+  });
+
+  it('reduced, no old item: no sparkles, lands at t = 0 once, fades in place, ends opaque at the slot', async () => {
+    const f = fakePhaser();
+    const item = fakeImage(to.x, to.y);
+    const onLand = vi.fn();
+    const plan = flyInPlan({ from, to, hasOld: false, reduced: true });
+    const p = playFlyIn(f.scene, plan, {
+      item: item as unknown as GameObjects.Image,
+      baseScale: BASE,
+      flyDepth: FLY_DEPTH,
+      slotDepth: SLOT_DEPTH,
+      onLand,
+    });
+    expect(f.graphics).toHaveLength(0);
+    expect(onLand).toHaveBeenCalledTimes(1);
+    expect(item).toMatchObject({ x: to.x, y: to.y, alpha: 0, scale: BASE, depth: SLOT_DEPTH });
+    f.step(plan.totalMs / 2);
+    expect(item.alpha).toBe(0.5);
+    f.complete();
+    await p;
+    expect(onLand).toHaveBeenCalledTimes(1);
+    expect(item).toMatchObject({ scale: BASE, alpha: 1, depth: SLOT_DEPTH });
+  });
+
+  it('an old image whose track has not ended is still destroyed on complete', async () => {
+    const f = fakePhaser();
+    const old = fakeImage(to.x, to.y);
+    const plan = flyInPlan({ from, to, hasOld: true, reduced: false });
+    const p = playFlyIn(f.scene, plan, {
+      item: fakeImage(to.x, to.y) as unknown as GameObjects.Image,
+      old: old as unknown as GameObjects.Image,
+      baseScale: BASE,
+      flyDepth: FLY_DEPTH,
+      slotDepth: SLOT_DEPTH,
+    });
+    f.complete();
+    await p;
+    expect(old.destroyed).toBe(true);
+  });
+});
